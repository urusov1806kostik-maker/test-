			<Item class="ModuleScript" referent="RBX32E739BF70238E1540BC550858CBB2DC">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Net
-- Имена сетевых объектов и протокол. Сервер создаёт папку VoidTD.Remotes (Net.Setup),
-- клиент и сервер получают её через Net.Remotes().
--
-- Протокол (не менять — клиент и сервер читают одинаково):
--   EnemySpawn  { id, typeId, maxHp, speed, lateral, dist [, hp] }
--   Sync        { T, E = {id, dist, hp, flag, ...}, DMG = {{id, amount, flag}}, RM = {{id, reason}},
--                 AL = {id, dist, hp, allyIndex (Config.AllyOrder), maxHp, ...} | nil, RA = {{id, reason}} | nil }
--   Attack      { U, T = {enemyIds}, L, D, AB, EC, PW, TR, TRS, SG, TT, I, E, SP, ST }
--   Impact      { K, P, R, L, U, N, DUR, DL, I, A, S, G, E, F, H }
--   Notify      { Type = Toast|WaveStart|WaveClear|BossDown|CoreHit|Victory|Defeat|Fade|Purchase|Reset, ... }
--   Profile     { Gems, Inventory, Equipped ("1".."6"), Stats, Settings, DailyReadyAt, HalloweenCoins, Runes, RuneSlots }
--   Request     RemoteFunction (action, data) -> ok, resultOrError

local Net = {}

Net.FolderName = "Remotes"

-- RemoteEvent'ы (порядок создания как в legacy)
Net.Events = { "EnemySpawn", "Sync", "Attack", "Impact", "Notify", "Profile" }

-- RemoteFunction для запросов клиента
Net.Function = "Request"

-- действия запроса Request(action, data)
Net.Actions = {
	"GetProfile", "GetEnemies", "Place", "Upgrade", "Sell", "SetTarget", "JoinMatch", "LeaveMatch", "GetMatchInfo",
	"SetLite", "ClaimDaily", "BuyGems", "StartWave", "Summon", "Equip", "EquipRune", "Teleport",
	"QueueDifficulty", "QueueStart", "QueueLeave",
}

Net.ActionSet = {}
for _, name in ipairs(Net.Actions) do
	Net.ActionSet[name] = true
end

-- флаг врага в Sync.E
Net.EnemyFlag = { Normal = 0, Slowed = 1, Frozen = 2 }
-- флаг урона в Sync.DMG
Net.DamageFlag = { Normal = 0, Crit = 1, Dodge = 2 }

-- причины удаления врага (Sync.RM) и союзника (Sync.RA)
Net.RemoveReasons = { "kill", "core", "clear" }
Net.AllyRemoveReasons = { "dead", "portal", "sold", "replaced", "clear" }

local function shared()
	return game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
end

function Net.IsAction(name)
	return type(name) == "string" and Net.ActionSet[name] == true
end

-- Сервер: создать (или переиспользовать) папку Remotes со всеми событиями и функцией.
-- Существующие объекты не пересоздаются, чтобы клиент не схватил устаревшую копию.
function Net.Setup()
	local root = shared()
	local folder = root:FindFirstChild(Net.FolderName)
	if folder and not folder:IsA("Folder") then
		folder:Destroy()
		folder = nil
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Net.FolderName
		folder.Parent = root
	end
	local function ensure(name, class)
		local obj = folder:FindFirstChild(name)
		if obj and not obj:IsA(class) then
			obj:Destroy()
			obj = nil
		end
		if not obj then
			obj = Instance.new(class)
			obj.Name = name
			obj.Parent = folder
		end
		return obj
	end
	for _, name in ipairs(Net.Events) do
		ensure(name, "RemoteEvent")
	end
	ensure(Net.Function, "RemoteFunction")
	return folder
end

-- Клиент/сервер: папка Remotes. Дожидается всех событий и функции,
-- поэтому дальше можно обращаться напрямую: Remotes.Sync, Remotes.Request.
function Net.Remotes()
	local folder = shared():WaitForChild(Net.FolderName)
	for _, name in ipairs(Net.Events) do
		folder:WaitForChild(name)
	end
	folder:WaitForChild(Net.Function)
	return folder
end

-- Один объект по имени ("Sync", "Request", ...)
function Net.Get(name)
	return Net.Remotes():WaitForChild(name)
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7A61E9F0D5EC819792B32B7E82ADE227">
				<Properties>
					<string name="Name">Path</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Path
-- Общая математика дороги. Сервер и клиент считают позиции врагов одинаково.
--
-- Активная дорога (одна на процесс) переключается через Path.SetMap(key); функции модуля
-- (PositionAt, DistanceToPath, IsPlacementClear, ...) всегда работают с активной картой.
-- Path.Get(key) отдаёт дорогу любой карты с теми же функциями — без переключения активной
-- (удобно строителям мира и проверкам).
--
-- Точки дороги в Config — (X, Z) от Center карты (у Void Center = 0,60,0, так что это мировые
-- координаты). Высота точек — GroundY.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Path = {}

local EDGE_MARGIN = 3       -- отступ от края острова при установке
local END_CLEARANCE = 14    -- нельзя ставить ближе к порталу / ядру
local FALLBACK_DIR = Vector3.new(0, 0, -1)

local roads = {}            -- таблица карты -> дорога (кэш)
local active                -- активная дорога

local sqrt = math.sqrt

local function flatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return sqrt(dx * dx + dz * dz)
end

------------------------------------------------------------------------
-- Математика одной дороги
------------------------------------------------------------------------

-- Позиция и направление на расстоянии d от начала дороги
local function positionAt(road, d)
	local points, cum, dirs = road.Points, road.Cumulative, road.Dirs
	local n = #points
	if d <= 0 then
		return points[1], dirs[2]
	end
	if d >= road.Length then
		return points[n], dirs[n]
	end
	for i = 2, n do
		if d <= cum[i] then
			-- отрезок нулевой длины сюда не попадает: d <= cum[i-1] сработало бы раньше
			local alpha = (d - cum[i - 1]) / (cum[i] - cum[i - 1])
			return points[i - 1] + road.Segs[i] * alpha, dirs[i]
		end
	end
	-- d = NaN: как в legacy — конец дороги
	return points[n], dirs[n]
end

-- Позиция с боковым смещением (чтобы враги не шли одной ниткой). right = (-dir.Z, 0, dir.X)
local function offsetPositionAt(road, d, lateral)
	local pos, dir = positionAt(road, d)
	if lateral and lateral ~= 0 then
		pos = pos + Vector3.new(-dir.Z, 0, dir.X) * lateral
	end
	return pos, dir
end

-- Горизонтальное расстояние от точки до ближайшего участка дороги
local function distanceToPath(road, pos)
	local best = math.huge
	local px, pz = pos.X, pos.Z
	local ax, az, abx, abz, lenSq = road.AX, road.AZ, road.ABX, road.ABZ, road.LenSq
	for i = 2, #road.Points do
		local t = 0
		local l = lenSq[i]
		if l > 0 then
			t = math.clamp(((px - ax[i]) * abx[i] + (pz - az[i]) * abz[i]) / l, 0, 1)
		end
		local dx = px - (ax[i] + abx[i] * t)
		local dz = pz - (az[i] + abz[i] * t)
		local d = sqrt(dx * dx + dz * dz)
		if d < best then
			best = d
		end
	end
	return best
end

-- Доля пройденного пути (без зажима: 0..1 внутри дороги)
local function fraction(road, d)
	if road.Length <= 0 then return 0 end
	return d / road.Length
end

-- Проверка позиции для установки (клиент — для превью, сервер — для проверки).
-- Не проверяет высоту, расстояние до других юнитов, деньги и лимиты.
local function isPlacementClear(road, pos)
	local map = road.Map
	local s = Config.Settings
	if distanceToPath(road, pos) < map.PathWidth / 2 + s.PathClearance then
		return false, "Нельзя ставить на дорогу"
	end
	local size = map.IslandSize -- Vector2: Y — размер по мировой оси Z
	local c = road.Center
	if math.abs(pos.X - c.X) > size.X / 2 - EDGE_MARGIN or math.abs(pos.Z - c.Z) > size.Y / 2 - EDGE_MARGIN then
		return false, "Слишком близко к краю"
	end
	local points = road.Points
	if flatDistance(pos, points[1]) < END_CLEARANCE then
		return false, "Слишком близко к порталу"
	end
	if flatDistance(pos, points[#points]) < END_CLEARANCE then
		return false, "Слишком близко к ядру"
	end
	return true
end

------------------------------------------------------------------------
-- Сборка дороги из конфига карты
------------------------------------------------------------------------
local function build(key, map)
	assert(type(map) == "table" and type(map.Path) == "table", "[Path] у карты нет Path: " .. tostring(key))
	assert(#map.Path >= 2, "[Path] в дороге меньше 2 точек: " .. tostring(key))
	local c = map.Center or Vector3.new()
	local y = map.GroundY or c.Y

	local road = {
		MapKey = key,
		Map = map,
		Center = c,
		Points = {},
		Cumulative = { 0 },
		Segs = {},
		Dirs = {},
		AX = {}, AZ = {}, ABX = {}, ABZ = {}, LenSq = {},
	}
	local points = road.Points
	for i, p in ipairs(map.Path) do
		points[i] = Vector3.new(c.X + p[1], y, c.Z + p[2])
	end

	local n = #points
	for i = 2, n do
		local a, b = points[i - 1], points[i]
		local seg = b - a
		local len = seg.Magnitude
		road.Segs[i] = seg
		road.Cumulative[i] = road.Cumulative[i - 1] + len
		road.Dirs[i] = len > 0 and seg.Unit or nil
		road.AX[i], road.AZ[i] = a.X, a.Z
		road.ABX[i], road.ABZ[i] = b.X - a.X, b.Z - a.Z
		road.LenSq[i] = road.ABX[i] * road.ABX[i] + road.ABZ[i] * road.ABZ[i]
	end
	-- у отрезков нулевой длины направление берём от соседей (без NaN)
	local last = nil
	for i = 2, n do
		if road.Dirs[i] then last = road.Dirs[i] elseif last then road.Dirs[i] = last end
	end
	local nextDir = nil
	for i = n, 2, -1 do
		if road.Dirs[i] then nextDir = road.Dirs[i] else road.Dirs[i] = nextDir or FALLBACK_DIR end
	end
	road.Length = road.Cumulative[n]

	-- функции дороги (вызов через точку, как у модуля)
	road.PositionAt = function(d) return positionAt(road, d) end
	road.OffsetPositionAt = function(d, lateral) return offsetPositionAt(road, d, lateral) end
	road.DistanceToPath = function(pos) return distanceToPath(road, pos) end
	road.Fraction = function(d) return fraction(road, d) end
	road.IsPlacementClear = function(pos) return isPlacementClear(road, pos) end
	road.FlatDistance = flatDistance
	return road
end

local function resolve(key)
	local maps = Config.Maps
	local map = (maps and key ~= nil and maps[key]) or Config.Map
	return map.Key or "Void", map
end

------------------------------------------------------------------------
-- API модуля
------------------------------------------------------------------------

-- Дорога карты key (неизвестный ключ — Void). Активную карту не меняет.
function Path.Get(key)
	local k, map = resolve(key)
	local road = roads[map]
	if not road then
		road = build(k, map)
		roads[map] = road
	end
	return road
end

-- Сделать карту активной (Void / Halloween). Сервер и клиент вызывают при смене карты.
function Path.SetMap(key)
	active = Path.Get(key)
	Path.Road = active
	Path.Points = active.Points
	Path.Length = active.Length
	Path.MapKey = active.MapKey
	Path.Map = active.Map
	return active
end

function Path.Fraction(d)
	return fraction(active, d)
end

function Path.PositionAt(d)
	return positionAt(active, d)
end

function Path.OffsetPositionAt(d, lateral)
	return offsetPositionAt(active, d, lateral)
end

function Path.DistanceToPath(pos)
	return distanceToPath(active, pos)
end

function Path.FlatDistance(a, b)
	return flatDistance(a, b)
end

function Path.IsPlacementClear(pos)
	return isPlacementClear(active, pos)
end

Path.SetMap("Void")

return Path
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX336E2317306E95824ABF1B85472DC665">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Util
-- Мелкие общие помощники (без состояния). Сервер и клиент.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Util = {}

-- Та же функция, что и Config.FormatNumber: 1234 -> "1,234", 15000 -> "15.0K", 1500000 -> "1.5M"
Util.FormatNumber = Config.FormatNumber

------------------------------------------------------------------------
-- Таблицы
------------------------------------------------------------------------

-- Глубокая копия простых таблиц. Таблицы с метатаблицей и значения Roblox
-- (Vector3, Color3, ...) копируются ссылкой. Циклы и общие подтаблицы сохраняются.
function Util.DeepCopy(t, seen)
	if type(t) ~= "table" or getmetatable(t) ~= nil then
		return t
	end
	seen = seen or {}
	if seen[t] then
		return seen[t]
	end
	local copy = {}
	seen[t] = copy
	for k, v in pairs(t) do
		copy[Util.DeepCopy(k, seen)] = Util.DeepCopy(v, seen)
	end
	return copy
end

function Util.ShallowCopy(t)
	local copy = {}
	for k, v in pairs(t) do
		copy[k] = v
	end
	return copy
end

-- Число ключей в словаре
function Util.Count(t)
	local n = 0
	for _ in pairs(t) do
		n = n + 1
	end
	return n
end

-- Индекс значения в массиве (или nil)
function Util.IndexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

------------------------------------------------------------------------
-- Случайность
------------------------------------------------------------------------

local function rand01(rng)
	if rng == nil then
		return math.random()
	elseif type(rng) == "function" then
		return rng()
	end
	return rng:NextNumber()
end

local function weightOf(entry, weightKey)
	local w
	if type(weightKey) == "function" then
		w = weightKey(entry)
	elseif weightKey ~= nil then
		w = entry[weightKey]
	else
		w = entry
	end
	w = tonumber(w) or 0
	if w ~= w or w < 0 then w = 0 end
	return w
end

-- Взвешенный выбор: roll = roll01 * сумма весов, первый элемент с roll < накопленной суммы.
-- weightKey — имя поля ("Rate"), функция entry -> вес или nil (элементы — сами числа).
-- roll01 — число 0..1 (по умолчанию math.random()). Возвращает entry, index (nil для пустого списка).
function Util.WeightedPick(list, weightKey, roll01)
	local total = 0
	local lastIndex = nil
	for i, entry in ipairs(list) do
		local w = weightOf(entry, weightKey)
		total = total + w
		if w > 0 then lastIndex = i end
	end
	if not lastIndex then
		return nil, nil
	end
	local roll = (roll01 or math.random()) * total
	local acc = 0
	for i, entry in ipairs(list) do
		acc = acc + weightOf(entry, weightKey)
		if roll < acc then
			return entry, i
		end
	end
	-- roll01 >= 1 или погрешность суммы — последний элемент с весом
	return list[lastIndex], lastIndex
end

-- Перемешать массив на месте (Фишер — Йетс). rng — Random, функция 0..1 или nil.
function Util.Shuffle(list, rng)
	for i = #list, 2, -1 do
		local j = math.min(i, math.floor(rand01(rng) * i) + 1)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Случайный элемент массива (nil для пустого)
function Util.Pick(list, rng)
	local n = #list
	if n == 0 then return nil end
	return list[math.min(n, math.floor(rand01(rng) * n) + 1)]
end

------------------------------------------------------------------------
-- Числа и проверки (для валидации аргументов клиента)
------------------------------------------------------------------------

-- Конечное число (не NaN и не ±inf)
function Util.IsFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Vector3 с конечными координатами
function Util.IsFiniteVector3(v)
	return typeof(v) == "Vector3" and Util.IsFinite(v.X) and Util.IsFinite(v.Y) and Util.IsFinite(v.Z)
end

-- Целое число в диапазоне [lo, hi]
function Util.IsIntInRange(n, lo, hi)
	return Util.IsFinite(n) and n % 1 == 0 and n >= lo and n <= hi
end

function Util.Round(n, step)
	step = step or 1
	return math.floor(n / step + 0.5) * step
end

function Util.Lerp(a, b, t)
	return a + (b - a) * t
end

-- Горизонтальное расстояние (XZ)
function Util.FlatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Цвет -> "#rrggbb" (для RichText <font color>)
function Util.ColorHex(c)
	return string.format("#%02x%02x%02x",
		math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),
		math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),
		math.clamp(math.floor(c.B * 255 + 0.5), 0, 255))
end

return Util
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX70F93E12E8103C04149FB4F6115592D8">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
	</Item>
	<Item class="StarterPlayer" referent="RBX6608B3506A23002BFA3FC182FAB89A06">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX0E8379FC9437CE022ED61BE62F36879A">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX77611F322CF069DE6E42019D76913304">
				<Properties>
					<string name="Name">VoidTDClient</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX6A51EA28B4810D72F750D7E2F60C1B1B">
					<Properties>
						<string name="Name">Anims</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Anims (клиент)
-- Анимации юнитов ключевыми кадрами (углы в градусах) и вторичное движение (дыхание, крылья,
-- шея, плащи, орбиты, шестерёнки). Те же позы и тайминги, что в легаси Renderer + HalloweenAnims.
--
-- ФОРМАТ КЛИПА
--   Anims.Clips[name](h, hits, interval) -> frames
--   frames = { { time, { Joint = { xDeg, yDeg, zDeg [, dy] } } }, ... }, время по возрастанию,
--   первый кадр {0, {}}, последний обычно {T, {}} (возврат в idle). Клип заканчивается, когда
--   прошло >= времени последнего кадра. Сустав, которого нет в кадре, берётся из rig.Idle
--   (а если и там нет — {0,0,0,0}). Суставы: RS LS Neck Root WingR WingL; у Root 4-е число —
--   смещение по вертикали (в studs, умножается на rig.Scale).
--   h = HitDelay (момент удара). Способности (TimeBreak, LanternBeam, ...) h игнорируют.
--
-- API
--   Anims.Clips[name]                         -- все клипы (атаки, способности, разминки, PowerUp/Land/Cheer)
--   Anims.Fidgets[attackAnim] = { names }     -- разминки в простое по def.Anim юнита
--   Anims.Has(name) -> bool
--   Anims.FidgetsFor(attackAnim) -> { names } -- список или { "LookAround" }
--   Anims.PickFidget(attackAnim) -> name      -- случайная разминка (math.random)
--   Anims.Play(state, name, h, hits, interval [, start]) -> bool
--        state.Anim = { Start = start or os.clock(), Frames = clip(h, hits, interval), Name = name }
--   Anims.PlayFidget(state, attackAnim [, start]) -> name
--   Anims.Stop(state)                         -- state.Anim = nil
--   Anims.IsPlaying(state) -> bool
--   Anims.Eval(state, t) -> pose              -- state = { Rig, Anim = {Start, Frames}, Phase };
--        по окончании клипа сбрасывает state.Anim = nil и возвращает rig.Idle.
--        Возвращаемая поза — переиспользуемый буфер state.PoseBuf (валиден до следующего Eval).
--   Anims.Apply(rig, pose, t, phase)          -- пишет motor.C0 всех моторов rig.Motors (от rig.Base):
--        Root: dy*Scale + дыхание; RS/LS: дыхание; Wing*: взмахи; Neck: покачивание;
--        Cape/Scarf/Cape2: колыхание + порыв rig.Gust; Orbit*: вращение по Y;
--        rig.SpinRates[motor] (рад/с, Clock*/Gear*): накопленный угол по Z, ×3 при rig.Storm,
--        ×6 пока os.clock() < rig.SpinBoostUntil. Пишет rig.SpinT, rig.SpinAngle.
--   Anims.Step(state, t)                      -- Apply(state.Rig, Eval(state, t), t, state.Phase or 0)
--   Anims.Register(name, builder [, fidgets]) -- добавить/заменить клип
--   Anims.Ease(a)                             -- smoothstep a*a*(3-2a)
--   t — os.clock() (тот же источник времени, что Start и SpinBoostUntil).
--   Для совместимости Anims[name] тоже отдаёт клип (Anims.Slash == Anims.Clips.Slash).

local Anims = {}
local Clips = {}
local Fidgets = {}
Anims.Clips = Clips
Anims.Fidgets = Fidgets

local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local sin = math.sin
local clamp = math.clamp

local EMPTY = {}
local ZERO = { 0, 0, 0, 0 }
local DEFAULT_FIDGETS = { "LookAround" }

------------------------------------------------------------------------
-- АТАКИ (h = HitDelay)
------------------------------------------------------------------------
function Clips.Slash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.75, { RS = { 150, 0, 12 }, Root = { 0, -15, 0 } } },
		{ h, { RS = { 25, 0, -12 }, LS = { -20, 0, 0 }, Root = { 4, 15, 0 } } },
		{ h + 0.2, { RS = { 15, 0, -5 } } },
		{ h + 0.5, {} },
	}
end

function Clips.HeavySlash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.8, { RS = { 168, 0, 15 }, LS = { 40, 0, -10 }, Root = { -8, -22, 0 } } },
		{ h, { RS = { 18, 0, -15 }, LS = { 30, 0, 0 }, Root = { 12, 20, 0, -0.15 } } },
		{ h + 0.3, { RS = { 15, 0, -5 }, Root = { 6, 10, 0 } } },
		{ h + 0.65, {} },
	}
end

function Clips.Bow(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.6, { LS = { 90, 0, 0 }, RS = { 90, 0, -30 }, Root = { 0, -20, 0 } } },
		{ h, { LS = { 90, 0, 0 }, RS = { 75, 0, -65 }, Root = { 0, -20, 0 } } },
		{ h + 0.06, { LS = { 92, 0, 0 }, RS = { 95, 0, -15 }, Root = { 0, -20, 0 } } },
		{ h + 0.45, {} },
	}
end

function Clips.Cast(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 145, 0, 0 }, LS = { 30, 0, -20 }, Neck = { 12, 0, 0 } } },
		{ h, { RS = { 90, 0, 0 }, LS = { 55, 0, -25 } } },
		{ h + 0.45, {} },
	}
end

function Clips.Gun(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h, { RS = { 92, 0, 0 }, LS = { 88, 0, -30 } } },
		{ h + 0.05, { RS = { 104, 0, 0 }, LS = { 98, 0, -30 }, Root = { -5, 0, 0 } } },
		{ h + 0.18, { RS = { 92, 0, 0 }, LS = { 88, 0, -30 } } },
		{ h + 0.5, {} },
	}
end

function Clips.Reap(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 60, 0, 25 }, LS = { 50, 0, -10 }, Root = { 0, -70, 0 } } },
		{ h, { RS = { 75, 0, -15 }, LS = { 65, 0, 10 }, Root = { 6, 80, 0 } } },
		{ h + 0.25, { RS = { 60, 0, -10 }, Root = { 3, 60, 0 } } },
		{ h + 0.65, {} },
	}
end

-- серия ударов: каждый следующий — в обратную сторону
function Clips.Katana(h, hits, interval)
	h = h or 0.2
	hits = math.max(1, math.floor(hits or 1))
	interval = interval or 0.16
	local k = { { 0, {} }, { h * 0.7, { RS = { 125, 0, 40 }, Root = { 0, -25, 0 } } } }
	for i = 1, hits do
		local t = h + (i - 1) * interval
		local dir = (i % 2 == 1) and 1 or -1
		k[#k + 1] = { t, { RS = { 45, 0, -50 * dir }, Root = { 4, 30 * dir, 0 } } }
		if i < hits then
			k[#k + 1] = { t + interval * 0.6, { RS = { 120, 0, 40 * -dir }, Root = { 0, -20 * dir, 0 } } }
		end
	end
	local last = h + (hits - 1) * interval
	k[#k + 1] = { last + 0.15, { RS = { 30, 0, -30 } } }
	k[#k + 1] = { last + 0.4, {} }
	return k
end

function Clips.Slam(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.65, { RS = { 172, 0, 10 }, LS = { 165, 0, -10 }, Root = { -10, 0, 0, 0.15 }, Neck = { -10, 0, 0 } } },
		{ h, { RS = { 55, 0, 0 }, LS = { 50, 0, 0 }, Root = { 16, 0, 0, -0.45 } } },
		{ h + 0.35, { RS = { 48, 0, 0 }, LS = { 45, 0, 0 }, Root = { 12, 0, 0, -0.35 } } },
		{ h + 0.85, {} },
	}
end

function Clips.Beam(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.6, { RS = { 55, 0, 0 }, Root = { -6, 0, 0 }, WingR = { 0, 25, 0 }, WingL = { 0, -25, 0 } } },
		{ h, { RS = { 96, 0, 0 }, LS = { 60, 0, -20 }, Root = { 4, 0, 0 }, WingR = { 0, -15, 10 }, WingL = { 0, 15, -10 } } },
		{ h + 0.45, { RS = { 94, 0, 0 }, LS = { 55, 0, -20 } } },
		{ h + 0.85, {} },
	}
end

-- рука держится поднятой, пока идут все удары серии
function Clips.Judgement(h, hits, interval)
	h = h or 0.2
	local hold = h + math.max(0, hits or 3) * (interval or 0.18)
	return {
		{ 0, {} },
		{ h * 0.8, { RS = { 178, 0, 5 }, LS = { 35, 0, -35 }, Neck = { 18, 0, 0 }, Root = { -6, 0, 0, 0.2 } } },
		{ hold, { RS = { 172, 0, 5 }, LS = { 40, 0, -40 }, Neck = { 15, 0, 0 }, Root = { -4, 0, 0, 0.2 } } },
		{ hold + 0.2, { RS = { 40, 0, -10 }, Root = { 10, 0, 0 } } },
		{ hold + 0.6, {} },
	}
end

function Clips.Smash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 160, 0, 10 }, Root = { -8, -18, 0 } } },
		{ h, { RS = { 40, 0, -10 }, LS = { 30, 0, 0 }, Root = { 14, 18, 0, -0.3 } } },
		{ h + 0.45, {} },
	}
end

function Clips.BlackHoleCast(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 150, 0, 30 }, LS = { 150, 0, -30 }, Neck = { 25, 0, 0 }, Root = { -8, 0, 0, 0.2 } } },
		{ h, { RS = { 110, 0, 40 }, LS = { 110, 0, -40 }, Root = { 6, 0, 0 } } },
		{ h + 0.5, {} },
	}
end

function Clips.DualDagger(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.6, { RS = { 110, 0, 20 }, LS = { 40, 0, -10 }, Root = { 0, -20, 0 } } },
		{ h, { RS = { 60, 0, -20 }, LS = { 100, 0, -20 }, Root = { 4, 20, 0 } } },
		{ h + 0.12, { RS = { 75, 0, 0 }, LS = { 70, 0, 0 } } },
		{ h + 0.3, {} },
	}
end

function Clips.Crossbow(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h, { RS = { 88, 0, 0 }, LS = { 82, 0, -28 }, Neck = { 6, 0, 0 } } },
		{ h + 0.06, { RS = { 105, 0, 0 }, LS = { 96, 0, -28 }, Root = { -6, 0, 0 } } },
		{ h + 0.3, { RS = { 88, 0, 0 }, LS = { 82, 0, -28 } } },
		{ h + 0.6, {} },
	}
end

function Clips.Puppet(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 85, 0, 35 }, LS = { 85, 0, -35 }, Neck = { 10, 0, 0 } } },
		{ h, { RS = { 105, 0, 12 }, LS = { 105, 0, -12 } } },
		{ h + 0.15, { RS = { 90, 0, 28 }, LS = { 90, 0, -28 } } },
		{ h + 0.5, {} },
	}
end

-- Проклятый Часовщик: замах Хроносекирой из-за плеча и горизонтальный взмах
function Clips.ChronoSlash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.75, { RS = { 160, 0, 35 }, LS = { 40, 0, -20 }, Root = { -4, -28, 0 } } },
		{ h, { RS = { 70, 0, -70 }, LS = { 20, 0, -10 }, Root = { 6, 32, 0, -0.1 } } },
		{ h + 0.25, { RS = { 45, 0, -40 }, Root = { 3, 18, 0 } } },
		{ h + 0.6, {} },
	}
end

-- два выстрела: правая, затем левая рука
function Clips.Revolver(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h, { RS = { 95, 0, 0 }, LS = { 70, 0, 0 } } },
