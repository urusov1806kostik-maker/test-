			<Item class="Folder" referent="RBX865531A2E16041C7E544DBF2856EEDC9">
				<Properties>
					<string name="Name">Models</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX0CD06E50DD764790E1981795A95E8399">
					<Properties>
						<string name="Name">Kit</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Models/Kit
-- Основа процедурных моделей: класс Rig (R6-скелет на Motor6D + приваренные детали) и угловатый набор
-- деталей в стиле концепта: блоки с фаской и светлым кантом, клинья-шипы, ромбы, ступенчатые наплечники,
-- рваная ткань, цепи. Используется Units (юниты, союзники), Enemies (враги) и Cases.
--
-- ФЛАГИ
--   Kit.Lite (bool) / Kit.IsLite()  облегчённый режим (клиент): фаска = 1 брусок, без лохмотьев, частиц, света,
--                                   шлейфов, лиц. UnitModels.Lite и EnemyModels.Lite читают/пишут Kit.Lite.
--   Kit.Cheap (bool)                дешёвая фаска (2 детали) и плоские шипы — для толп врагов и союзников;
--                                   выставляется только на время сборки (Enemies.Build / Units.BuildAlly).
-- ПАЛИТРЫ
--   Kit.Colors (= AC) Armor ArmorMid Edge Cloth ClothDark;  Kit.C  Neon Steel;  Kit.P — палитра юнитов
--   (Black Coal Dark Steel Gray Pale Violet DeepViolet Purple Neon NeonSoft NeonPink Maroon Crimson White
--   Gold DarkGold Skin);  Kit.M  материалы Plastic(SmoothPlastic) Metal Neon Fabric Slate Glass Wood Grass;  Kit.rgb(r,g,b)
--
-- RIG  (r = Kit.Rig.new(o); все offset/pivot — в локальных координатах детали-основы limb, до масштаба)
--   Kit.Rig.new{Name, HeadSize=V(1.3)^3, Torso, TorsoMat, Head, Arm, Leg, RoundHead} -> R6: HumanoidRootPart (якорь),
--       Torso, Head, "Right Arm", "Left Arm", "Right Leg", "Left Leg"; моторы Root Neck RS LS RH LH
--   Kit.Rig.bare(name)                    пустой rig (только Model и таблицы) — для существ (Enemies/Base)
--   поля: Model Root Torso Head RArm LArm RLeg LLeg HeadSize Motors{name->Motor6D} Base{name->C0} Parts{...}
--         после Finish: Scale HipHeight Height Idle Muzzle (по умолчанию RArm)
--   r:Add(limb, class, size, offset, color, mat, props) -> part   деталь "Detail" на Weld к limb (props копируются)
--   r:Box / r:Wedge (limb, size, offset, color, mat, props)        Part / WedgePart
--   r:Neon(limb, size, offset, color=P.Neon, props)                неоновый брусок
--   r:Cyl(limb, len, d, offset, color, mat, axis="X"|"Y"|"Z", props)   цилиндр длиной len вдоль оси
--   r:Ball(limb, d, offset, color, mat, props)                     шар
--   r:Sphere(limb, size, offset, color, mat, props)                эллипсоид (SpecialMesh добавляется в Finish)
--   r:Seg(limb, a, b, thick, color, mat, props) -> part            брусок от точки a до b; thick число или V2(x,y);
--                                                                  props.Round = true -> цилиндр
--   r:Rod(limb, a, b, d, color, mat, props)                        круглый стержень a..b
--   r:Chain(limb, points, thick, color, mat, taper?, round?) -> {parts}
--   r:Joint(name, limb, size, pivot, fromPivot, color, mat) -> part   подвижная деталь на своём Motor6D name
--   r:Orbit(name, limb, offset, radius, count, size, color=P.Neon, mat=Neon, transp=0) -> hub
--                                    невидимый узел-мотор (имя "Orbit*" — крутится по Y в Anims) + count кристаллов
--   r:Cape(width, length, color=P.DeepViolet, tatter?) -> cape     плащ на моторах "Cape" + "Cape2", золотые застёжки
--   r:Glow(part, color=P.Neon, range=8, brightness=1.5) -> PointLight | nil (Lite)
--   r:Sparkles(part, color, {Rate=8, Size=0.25, LifeMin=0.5, LifeMax=1, SpeedMin=0.5, SpeedMax=1.5, Up?}) -> emitter | nil (Lite)
--   r:WeaponTrail(limb, a, b, color=P.NeonSoft)                    шлейф "WeaponTrail" (Enabled=false), создаётся в Finish; не в Lite
--   r:Eyes(color, {Y, Spacing, Size, Inset, LeftLift, Tilt, RightSize})   неоновые глаза на Head
--   r:Face{Mood="angry"|"calm"|"old", EyeY, Spacing, BrowColor, MouthColor, Mouth}   брови/рот (не в Lite)
--   r:Hands(color, mat)  r:Horn(limb, side, base, size, color)  r:Pouch(limb, offset, color)
--   r:Pauldron(limb, side, size, color, rim, lift, rimMat)  r:Sword(limb, {Length, Width, Y, ...}) -> blade (ставит Muzzle)
--   r:Mark() -> n ; r:Since(n) -> {parts}   все детали, созданные после метки (явная пометка, напр. StormFX)
--   r:BakePose(pose)                 повернуть конечности в позу {Motor = {x,y,z}} (градусы) прямо в CFrame деталей
--   r:Finish(scale=1, idle?) -> r    ScaleTo, меши эллипсоидов, шлейфы, Base = C0 (до позы), BakePose(idle),
--                                    HipHeight = 3*scale (+ атрибут модели), Idle, Muzzle. Частицы/свет масштабируются
--                                    вручную (одинаково в Studio и в моке).
-- ДЕТАЛИ (r — rig, limb — деталь-основа; возвращают список созданных деталей, если не сказано иное)
--   Kit.bevel(r, limb, size, cf, color, edge?, mat=Metal, e?) -> parts, edgePart
--        блок с фаской: 3 тёмных бруска + светлый внутри (кант по 12 рёбрам). Cheap: брусок + кант сверху.
--        Lite или edge == false: один брусок (edgePart = nil). Последний элемент списка (вне Lite) — кант.
--   Kit.spike(r, limb, base, tip, w, color, mat=Plastic, flat?, thick=w*0.34)   шип из клиньев (крестовой, если не flat и не Cheap)
--   Kit.bar(r, limb, a, b, t, color, mat=Plastic) -> part           брусок a..b с запасом на стыках
--   Kit.hornA(r, limb, pts, t0, color, mat)                         рог: сужающиеся бруски + шип
--   Kit.gem(r, limb, s, cf, color=C.Neon, frame?)                   кристалл-ромб (в оправе, если frame)
--   Kit.tatter(r, limb, y, z, w, n, color, mat=Fabric, seed=0)      рваный край из n лоскутов вниз ({} в Lite)
--   Kit.pauldron(r, A, side, s, color, edge, glow?, spikes=2)       ступенчатый наплечник (side 1 правый, -1 левый)
--   Kit.bootA(r, L, color, edge, w=1.15)                            латный сапог
--   Kit.squareRing(r, limb, cf, w, t, color)                        квадратное кольцо из 4 брусков
--   Kit.chain(r, limb, n, size, color=C.Steel, at=CF())             цепь из n звеньев вниз
--   Kit.crack(r, limb, pts, thick=0.08, color=C.Neon)               светящаяся трещина-ломаная
--   Kit.ring(r, limb, cf, radius, count, thick, depth, color, mat=Metal, skip?)   кольцо в плоскости XY cf (skip(i) — разрыв)
--   Kit.hide(parts, target?) -> parts   спрятать (Transparency 1, атрибут "PT" = целевая прозрачность для Reveal)
--   Kit.join(...) -> parts              склеить списки (nil пропускаются)
--   Kit.Calm(root, amount=0.3)          приглушить неон/свет/частицы (один раз на модель — повтор ничего не делает)

local Kit = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local PI = math.pi

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
Kit.rgb = rgb

local M = {
	Plastic = Enum.Material.SmoothPlastic,
	Metal = Enum.Material.Metal,
	Neon = Enum.Material.Neon,
	Fabric = Enum.Material.Fabric,
	Slate = Enum.Material.Slate,
	Glass = Enum.Material.Glass,
	Wood = Enum.Material.Wood,
	Grass = Enum.Material.Grass,
}
Kit.M = M

local C = { Neon = rgb(180, 80, 255), Steel = rgb(110, 110, 128) }
Kit.C = C

-- палитра брони (AC)
local AC = {
	Armor = rgb(34, 32, 42),
	ArmorMid = rgb(52, 50, 64),
	Edge = rgb(122, 118, 138),
	Cloth = rgb(62, 30, 104),
	ClothDark = rgb(36, 17, 62),
}
Kit.Colors = AC

-- палитра юнитов (UnitModels.Palette)
local P = {
	Black = rgb(20, 18, 26), Coal = rgb(33, 30, 41), Dark = rgb(48, 44, 58), Steel = rgb(74, 72, 86),
	Gray = rgb(108, 106, 120), Pale = rgb(168, 163, 180), Violet = rgb(70, 30, 110), DeepViolet = rgb(42, 18, 66),
	Purple = rgb(112, 52, 172), Neon = rgb(180, 80, 255), NeonSoft = rgb(210, 150, 255), NeonPink = rgb(255, 60, 170),
	Maroon = rgb(88, 20, 36), Crimson = rgb(140, 28, 48), White = rgb(245, 240, 255), Gold = rgb(200, 156, 60),
	DarkGold = rgb(140, 104, 40), Skin = rgb(140, 132, 146),
}
Kit.P = P

Kit.Lite = false
Kit.Cheap = false
function Kit.IsLite()
	return Kit.Lite == true
end
local function lite()
	return Kit.Lite == true
end

------------------------------------------------------------------------
-- RIG
------------------------------------------------------------------------
local Rig = {}
Rig.__index = Rig
Kit.Rig = Rig

local AXIS = { X = CF(), Y = ANG(0, 0, rad(90)), Z = ANG(0, rad(90), 0) }
local LIMB_MOTORS = { Root = true, Neck = true, RS = true, LS = true, RH = true, LH = true }

local function newPart(className, size, color, material)
	local p = Instance.new(className)
	p.Size = size
	p.Color = color or P.Dark
	p.Material = material or M.Plastic
	p.Anchored = false
	p.CanCollide = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

local function copyProps(props)
	return props and table.clone(props) or {}
end

function Rig.bare(name)
	local self = setmetatable({}, Rig)
	local model = Instance.new("Model")
	model.Name = name or "Unit"
	self.Model = model
	self.Motors = {}
	self.Base = {}
	self.Parts = {}
	self.Pending = {}
	self.PendingTrails = {}
	return self
end

function Rig.new(o)
	o = o or {}
	local self = Rig.bare(o.Name or "Unit")
	local model = self.Model
	local root = newPart("Part", V(2, 2, 1), Color3.new(), M.Plastic)
	root.Name = "HumanoidRootPart"
	root.Transparency = 1
	root.Anchored = true
	root.CFrame = CF()
	root.Parent = model
	self.Root = root

	local hs = o.HeadSize or V(1.3, 1.3, 1.3)
	self.HeadSize = hs
	local function limb(name, size, cf, color, mat)
		local p = newPart("Part", size, color, mat)
		p.Name = name
		p.CFrame = cf
		p.Parent = model
		self.Parts[#self.Parts + 1] = p
		return p
	end
	self.Torso = limb("Torso", V(2, 2, 1), CF(), o.Torso or P.Dark, o.TorsoMat)
	self.Head = limb("Head", hs, CF(0, 1 + hs.Y / 2, 0), o.Head or P.Skin)
	self.RArm = limb("Right Arm", V(1, 2, 1), CF(1.5, 0, 0), o.Arm or o.Torso or P.Dark)
	self.LArm = limb("Left Arm", V(1, 2, 1), CF(-1.5, 0, 0), o.Arm or o.Torso or P.Dark)
	self.RLeg = limb("Right Leg", V(1, 2, 1), CF(0.5, -2, 0), o.Leg or P.Black)
	self.LLeg = limb("Left Leg", V(1, 2, 1), CF(-0.5, -2, 0), o.Leg or P.Black)

	self:Motor("Root", root, self.Torso, CF(), CF())
	self:Motor("Neck", self.Torso, self.Head, CF(0, 1, 0), CF(0, -hs.Y / 2, 0))
	self:Motor("RS", self.Torso, self.RArm, CF(1.5, 0.5, 0), CF(0, 0.5, 0))
	self:Motor("LS", self.Torso, self.LArm, CF(-1.5, 0.5, 0), CF(0, 0.5, 0))
	self:Motor("RH", self.Torso, self.RLeg, CF(0.5, -1, 0), CF(0, 1, 0))
	self:Motor("LH", self.Torso, self.LLeg, CF(-0.5, -1, 0), CF(0, 1, 0))
	if o.RoundHead then
		-- круглая голова-цилиндр; детали крепятся к невидимому кубу Head
		self.Head.Transparency = 1
		self:Cyl(self.Head, hs.Y, math.max(hs.X, hs.Z), CF(), o.Head or P.Skin, M.Plastic, "Y").Name = "HeadShape"
	end
	return self
end

-- Motor6D между готовыми деталями (родитель — Part0)
function Rig:Motor(name, p0, p1, c0, c1)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = p0
	m.Part1 = p1
	m.C0 = c0
	m.C1 = c1
	m.Parent = p0
	self.Motors[name] = m
	return m
end

-- Деталь, приваренная к limb; offset — в локальных координатах limb
function Rig:Add(limb, className, size, offset, color, material, props)
	local p = newPart(className, size, color, material)
	p.Name = "Detail"
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	p.CFrame = limb.CFrame * offset
	local w = Instance.new("Weld")
	w.Part0 = limb
	w.Part1 = p
	w.C0 = offset
	w.Parent = p
	p.Parent = self.Model
	self.Parts[#self.Parts + 1] = p
	return p
end

function Rig:Box(limb, size, offset, color, material, props)
	return self:Add(limb, "Part", size, offset, color, material, props)
end

function Rig:Wedge(limb, size, offset, color, material, props)
	return self:Add(limb, "WedgePart", size, offset, color, material, props)
end

function Rig:Neon(limb, size, offset, color, props)
	return self:Add(limb, "Part", size, offset, color or P.Neon, M.Neon, props)
end

function Rig:Cyl(limb, len, d, offset, color, material, axis, props)
	local pr = copyProps(props)
	pr.Shape = Enum.PartType.Cylinder
	return self:Add(limb, "Part", V(len, d, d), offset * AXIS[axis or "X"], color, material, pr)
end

function Rig:Ball(limb, d, offset, color, material, props)
	local pr = copyProps(props)
	pr.Shape = Enum.PartType.Ball
	return self:Add(limb, "Part", V(d, d, d), offset, color, material, pr)
end

-- Эллипсоид: SpecialMesh(Sphere) ставится в Finish после масштабирования (иначе масштаб применится дважды)
function Rig:Sphere(limb, size, offset, color, material, props)
	local p = self:Add(limb, "Part", size, offset, color, material, props)
	self.Pending[#self.Pending + 1] = p
	return p
end

-- Брусок от a до b (точки в координатах limb)
function Rig:Seg(limb, a, b, thick, color, material, props)
	local dir = b - a
	local len = dir.Magnitude
	local tx, ty = thick, thick
	if typeof(thick) == "Vector2" then
		tx, ty = thick.X, thick.Y
	end
	local cf
	if len < 1e-4 then
		cf, len = CF(a), 0.05
	else
		local up = math.abs(dir.Y / len) > 0.98 and V(0, 0, 1) or V(0, 1, 0)
		cf = CFrame.lookAt((a + b) / 2, b, up)
	end
	if props and props.Round then
		local pr = copyProps(props)
		pr.Round = nil
		pr.Shape = Enum.PartType.Cylinder
		return self:Add(limb, "Part", V(len, tx, tx), cf * AXIS.Z, color, material, pr)
	end
	return self:Add(limb, "Part", V(tx, ty, len), cf, color, material, props)
end

function Rig:Rod(limb, a, b, d, color, material, props)
	local pr = copyProps(props)
	pr.Round = true
	return self:Seg(limb, a, b, d, color, material, pr)
end

-- Цепочка брусков по точкам (рога, щупальца, изогнутые лезвия)
function Rig:Chain(limb, points, thick, color, material, taper, round)
	local parts = {}
	local t = thick
	for i = 1, #points - 1 do
		parts[#parts + 1] = self:Seg(limb, points[i], points[i + 1], t, color, material, round and { Round = true } or nil)
		if round and i > 1 then
			self:Ball(limb, t * 1.02, CF(points[i]), color, material)
		end
		if taper then
			t = math.max(t * taper, 0.08)
		end
	end
	return parts
end

-- Подвижная деталь на собственном Motor6D: C0 = pivot (в limb), C1 = fromPivot:Inverse()
function Rig:Joint(name, limb, size, pivot, fromPivot, color, material)
	local p = newPart("Part", size, color, material)
	p.Name = name
	p.CFrame = limb.CFrame * pivot * fromPivot
	p.Parent = self.Model
	self.Parts[#self.Parts + 1] = p
	self:Motor(name, limb, p, pivot, fromPivot:Inverse())
	return p
end

-- Кольцо вращающихся деталей; мотор с именем "Orbit*" крутится вокруг своей оси Y (Anims.Apply)
function Rig:Orbit(name, limb, offset, radius, count, size, color, material, transparency)
	local hub = self:Joint(name, limb, V(0.2, 0.2, 0.2), offset, CF(), P.Black)
	hub.Transparency = 1
	for i = 0, count - 1 do
		local a = i / count * PI * 2
		self:Add(hub, "Part", V(size, size * 1.3, size), CF(math.cos(a) * radius, math.sin(a * 2) * 0.15, math.sin(a) * radius) * ANG(rad(45), a, rad(30)),
			color or P.Neon, material or M.Neon, { Transparency = transparency or 0 })
	end
	return hub
end

-- Плащ из двух частей на моторах Cape/Cape2 (нижняя колышется с запаздыванием)
function Rig:Cape(width, length, color, tatter)
	local T = self.Torso
	color = color or P.DeepViolet
	local l1 = length * 0.58
	local l2 = length - l1
	local cape = self:Joint("Cape", T, V(width, l1, 0.12), CF(0, 0.95, 0.58), ANG(rad(7), 0, 0) * CF(0, -l1 / 2, 0.02), color, M.Fabric)
	local cape2 = self:Joint("Cape2", cape, V(width * 0.98, l2, 0.12), CF(0, -l1 / 2, 0), CF(0, -l2 / 2, 0), color, M.Fabric)
	for _, s in ipairs({ -1, 1 }) do
		self:Box(T, V(0.3, 0.3, 0.2), CF(0.75 * s, 0.85, 0.55), P.Gold, M.Metal) -- застёжки
	end
	if tatter and not lite() then
		for i = -2, 2 do
			local seed = i + 3
			local h = 0.4 + ((seed * 37) % 5) * 0.12
			self:Wedge(cape2, V(width / 5.2, h, 0.12), CF(i * width / 5, -l2 / 2 - h / 2 + 0.02, 0) * ANG(0, 0, PI), color, M.Fabric)
		end
		self:Box(cape, V(width + 0.04, 0.12, 0.14), CF(0, l1 / 2 - 0.25, 0), color:Lerp(P.Black, 0.4), M.Fabric) -- тёмная кайма
		self:Box(cape2, V(width * 0.98 + 0.04, 0.1, 0.14), CF(0, -l2 / 2 + 0.15, 0), color:Lerp(P.White, 0.25), M.Fabric) -- светлый подол
	end
	return cape
end

function Rig:Glow(part, color, range, brightness)
	if lite() then
		return nil
	end
	local l = Instance.new("PointLight")
	l.Color = color or P.Neon
	l.Range = range or 8
	l.Brightness = brightness or 1.5
	l.Shadows = false
	l.Parent = part
	return l
end

function Rig:Sparkles(part, color, o)
	if lite() then
		return nil
	end
	o = o or {}
	local e = Instance.new("ParticleEmitter")
	e.Name = "Sparkles"
	e.Color = ColorSequence.new(color or P.Neon)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Rate = o.Rate or 8
	e.Lifetime = NumberRange.new(o.LifeMin or 0.5, o.LifeMax or 1)
	e.Speed = NumberRange.new(o.SpeedMin or 0.5, o.SpeedMax or 1.5)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, o.Size or 0.25), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	if o.Up then
		e.EmissionDirection = Enum.NormalId.Top
		e.SpreadAngle = Vector2.new(25, 25)
		e.Acceleration = V(0, o.Up, 0)
	end
	e.Parent = part
	return e
end

-- Шлейф оружия (Renderer включает его во время анимаций атаки)
function Rig:WeaponTrail(limb, a, b, color)
	if lite() then
		return
	end
	self.PendingTrails[#self.PendingTrails + 1] = { limb, a, b, color or P.NeonSoft }
end

function Rig:Eyes(color, o)
	o = o or {}
	local hs = self.HeadSize
	local y, sp = o.Y or 0.08, o.Spacing or 0.3
	local size = o.Size or V(0.28, 0.14, 0.06)
	local z = -hs.Z / 2 - 0.02 + (o.Inset or 0)
	local l = self:Neon(self.Head, size, CF(-sp, y + (o.LeftLift or 0), z) * ANG(0, 0, rad(o.Tilt or 0)), color)
	local r = self:Neon(self.Head, o.RightSize or size, CF(sp, y, z) * ANG(0, 0, rad(-(o.Tilt or 0))), color)
	return l, r
end

-- Брови и рот: Mood "angry" | "calm" | "old"
function Rig:Face(o)
	if lite() then
		return
	end
	o = o or {}
	local z = -self.HeadSize.Z / 2 - 0.03
	local y = (o.EyeY or 0.08) + 0.2
	local sp = o.Spacing or 0.3
	local tilt = o.Mood == "angry" and 18 or (o.Mood == "old" and -10 or 4)
	local size = o.Mood == "old" and V(0.36, 0.13, 0.08) or V(0.3, 0.08, 0.06)
	self:Box(self.Head, size, CF(-sp, y, z) * ANG(0, 0, rad(-tilt)), o.BrowColor or P.Black)
	self:Box(self.Head, size, CF(sp, y, z) * ANG(0, 0, rad(tilt)), o.BrowColor or P.Black)
	if o.Mouth ~= false then
		self:Box(self.Head, V(o.Mood == "angry" and 0.4 or 0.3, 0.07, 0.06), CF(0, -0.32, z), o.MouthColor or P.Coal)
	end
end

function Rig:Hands(color, material)
	if lite() then
		return
	end
	for _, A in ipairs({ self.RArm, self.LArm }) do
		self:Sphere(A, V(1.08, 0.52, 1.08), CF(0, -0.93, 0), color or P.Coal, material or M.Plastic)
	end
end

function Rig:Horn(limb, side, base, size, color)
	local s = size or 1
	color = color or P.Black
	local pts = { base, base + V(0.35 * side, 0.45, 0.05) * s, base + V(0.55 * side, 0.95, 0.2) * s, base + V(0.45 * side, 1.4, 0.45) * s }
	self:Ball(limb, 0.4 * s, CF(base), color)
	self:Chain(limb, pts, 0.34 * s, color, M.Plastic, 0.72, true)
	local d = pts[4] - pts[3]
	self:Rod(limb, pts[4], pts[4] + d.Unit * 0.35 * s, 0.12 * s, color, M.Plastic)
end

function Rig:Pouch(limb, offset, color)
	color = color or P.Maroon
	self:Box(limb, V(0.42, 0.42, 0.28), offset, color, M.Fabric)
	self:Box(limb, V(0.44, 0.14, 0.3), offset * CF(0, 0.2, -0.01), color:Lerp(P.Black, 0.35), M.Fabric)
end

-- Круглый наплечник: купол-эллипсоид + обод
function Rig:Pauldron(limb, side, size, color, rim, lift, rimMat)
	size = size or 1
	local off = CF(0.12 * side, 0.82 + (lift or 0), 0) * ANG(0, 0, rad(-14 * side))
	self:Sphere(limb, V(1.55, 1.0, 1.5) * size, off, color or P.Black, M.Metal)
	if rim then
		self:Cyl(limb, 0.16, 1.6 * size, off * CF(0, -0.18 * size, 0), rim, rimMat or M.Metal, "Y")
	end
end

-- Классический меч (клинок вперёд по -Z руки); ставит Muzzle на остриё
function Rig:Sword(limb, o)
	o = o or {}
	local len, w, y = o.Length or 3, o.Width or 0.42, o.Y or -1.05
	local guard = o.Guard or P.Steel
	self:Cyl(limb, 0.9, 0.26, CF(0, y, 0.05), o.Handle or P.Black, M.Fabric, "Z")
	self:Ball(limb, 0.4, CF(0, y, 0.55), o.Pommel or guard, M.Metal)
	local gw = o.GuardWidth or w + 0.6
	self:Box(limb, V(0.3, gw, 0.26), CF(0, y, -0.45), guard, M.Metal)
	self:Ball(limb, 0.34, CF(0, y + gw / 2, -0.45), guard, M.Metal)
	self:Ball(limb, 0.34, CF(0, y - gw / 2, -0.45), guard, M.Metal)
	self:Ball(limb, 0.34, CF(0, y, -0.45), o.Gem or o.Edge or P.Neon, M.Neon)
	local blade = self:Box(limb, V(0.14, w, len), CF(0, y, -0.58 - len / 2), o.Blade or P.Gray, o.BladeMat or M.Metal)
	blade.Name = "Blade"
	if not o.Core then
		self:Box(limb, V(0.16, math.max(w * 0.22, 0.07), len * 0.72), CF(0, y, -0.58 - len * 0.42), P.Black, M.Metal)
	end
	for i = 1, (o.Runes or 0) do
		self:Neon(limb, V(0.17, 0.1, 0.18), CF(0, y - w * 0.22, -0.58 - len * (0.15 + i * 0.16)), o.Edge or P.Neon)
	end
	self:WeaponTrail(limb, V(0, y, -0.75), V(0, y, -0.58 - len), o.Edge or o.Core or P.NeonSoft)
	self:Wedge(limb, V(0.14, w, w * 1.3), CF(0, y, -0.58 - len - w * 0.65) * ANG(0, PI, 0), o.Blade or P.Gray, o.BladeMat or M.Metal)
	if o.Edge then
		self:Neon(limb, V(0.16, 0.09, len), CF(0, y + w / 2 - 0.02, -0.58 - len / 2), o.Edge)
	end
	if o.Core then
		self:Neon(limb, V(0.17, math.max(w * 0.25, 0.08), len * 0.8), CF(0, y, -0.58 - len * 0.45), o.Core)
	end
	self.Muzzle = self:Box(limb, V(0.2, 0.2, 0.2), CF(0, y, -0.58 - len), P.Black, M.Plastic, { Transparency = 1, Name = "Muzzle" })
	return blade
end

-- Метки для явной пометки деталей (вместо порядка GetChildren)
function Rig:Mark()
	return #self.Parts
end

function Rig:Since(mark)
	return table.move(self.Parts, mark + 1, #self.Parts, 1, {})
end

-- Поворачивает конечности в позу прямо в CFrame деталей (ViewportFrame и призрак размещения выглядят как в игре)
function Rig:BakePose(pose)
	if not pose then
		return
	end
	local attached = {}
	for _, d in ipairs(self.Model:GetDescendants()) do
		if (d:IsA("Weld") or (d:IsA("Motor6D") and not LIMB_MOTORS[d.Name])) and d.Part0 and d.Part1 then
			local list = attached[d.Part0]
			if not list then
				list = {}
				attached[d.Part0] = list
			end
			list[#list + 1] = d.Part1
		end
	end
	-- детерминированный порядок: сначала конечности, затем прочие моторы по имени
	local names = {}
	for name in pairs(pose) do
		if name ~= "Root" and self.Motors[name] then
			names[#names + 1] = name
		end
	end
	table.sort(names, function(a, b)
		local la, lb = LIMB_MOTORS[a] and 0 or 1, LIMB_MOTORS[b] and 0 or 1
		if la ~= lb then
			return la < lb
		end
		return a < b
	end)
	for _, name in ipairs(names) do
		local ang = pose[name]
		local m = self.Motors[name]
		local rot = ANG(rad(ang[1] or 0), rad(ang[2] or 0), rad(ang[3] or 0))
		local delta = (m.Part0.CFrame * m.C0 * rot * m.C1:Inverse()) * m.Part1.CFrame:Inverse()
		local seen = {}
		local function move(p)
			if seen[p] then
				return
			end
			seen[p] = true
			p.CFrame = delta * p.CFrame
			for _, c in ipairs(attached[p] or {}) do
				move(c)
			end
		end
		move(m.Part1)
		m.C0 = m.C0 * rot
	end
end

-- ScaleTo в Roblox масштабирует и частицы/свет, а мок — нет. Чтобы результат был одинаковым, на время
-- ScaleTo эффекты снимаются с модели и масштабируются вручную.
local FX_CLASSES = { ParticleEmitter = true, PointLight = true, SpotLight = true, SurfaceLight = true, Beam = true }

local function scaleSeq(seq, f)
	local kps = {}
	for i, k in ipairs(seq.Keypoints) do
		kps[i] = NumberSequenceKeypoint.new(k.Time, k.Value * f, k.Envelope * f)
	end
	return NumberSequence.new(kps)
end

local function scaleFx(d, f)
	if d:IsA("ParticleEmitter") then
		d.Size = scaleSeq(d.Size, f)
		d.Speed = NumberRange.new(d.Speed.Min * f, d.Speed.Max * f)
		d.Acceleration = d.Acceleration * f
	elseif d:IsA("Beam") then
		d.Width0 = d.Width0 * f
		d.Width1 = d.Width1 * f
	else
		d.Range = math.min(d.Range * f, 60)
	end
end

function Rig:Finish(scale, idle)
	local model = self.Model
	model.PrimaryPart = self.Root
	scale = scale or 1
	if scale ~= 1 then
		local fx = {}
		for _, d in ipairs(model:GetDescendants()) do
			if FX_CLASSES[d.ClassName] then
				fx[#fx + 1] = { d, d.Parent }
			end
		end
		for _, e in ipairs(fx) do
			e[1].Parent = nil
		end
		model:ScaleTo(scale)
		for _, e in ipairs(fx) do
			scaleFx(e[1], scale)
			e[1].Parent = e[2]
		end
	end
	for _, p in ipairs(self.Pending) do
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	self.Pending = {}
	for _, t in ipairs(self.PendingTrails) do
		local limb = t[1]
		local a0 = Instance.new("Attachment")
		a0.Name = "TrailA"
		a0.Position = t[2] * scale
		a0.Parent = limb
		local a1 = Instance.new("Attachment")
		a1.Name = "TrailB"
		a1.Position = t[3] * scale
		a1.Parent = limb
		local trail = Instance.new("Trail")
		trail.Name = "WeaponTrail"
		trail.Attachment0 = a0
		trail.Attachment1 = a1
		trail.Color = ColorSequence.new(t[4])
		trail.LightEmission = 1
		trail.LightInfluence = 0
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		trail.Lifetime = 0.22
		trail.MinLength = 0.05
		trail.Enabled = false
		trail.Parent = limb
	end
	self.PendingTrails = {}
	self.Scale = scale
	-- Base — C0 в позе покоя (до BakePose): Anims считает C0 = Base * поза
	for name, m in pairs(self.Motors) do
		self.Base[name] = m.C0
	end
	self:BakePose(idle)
	self.HipHeight = 3 * scale
	model:SetAttribute("HipHeight", self.HipHeight)
	if self.HeadSize and not self.Height then
		self.Height = (3 + 1 + self.HeadSize.Y + 0.6) * scale
	end
	self.Idle = idle or {}
	self.Muzzle = self.Muzzle or self.RArm
	return self
end

------------------------------------------------------------------------
-- УГЛОВАТЫЕ ДЕТАЛИ
------------------------------------------------------------------------

-- Острый шип из клиньев: flat = 2 клина (плоский коготь/зуб), иначе 4 (крестовой шип)
local function spike(r, limb, base, tip, w, color, mat, flat, thick)
	local dir = tip - base
	local h = dir.Magnitude
	if h < 1e-4 then
		return {}
	end
	local up = math.abs(dir.Y / h) > 0.98 and V(0, 0, 1) or V(0, 1, 0)
	local F = CFrame.lookAt(base, tip, up) * ANG(-PI / 2, 0, 0)
	local t = thick or w * 0.34
	mat = mat or M.Plastic
	local parts = {}
	local function fin(rot)
		parts[#parts + 1] = r:Wedge(limb, V(t, h, w / 2), F * rot * CF(0, h / 2, -w / 4), color, mat)
		parts[#parts + 1] = r:Wedge(limb, V(t, h, w / 2), F * rot * CF(0, h / 2, w / 4) * ANG(0, PI, 0), color, mat)
	end
	fin(CF())
	if not flat and not Kit.Cheap then
		fin(ANG(0, PI / 2, 0))
	end
	return parts
end
Kit.spike = spike

local function crack(r, limb, pts, thick, color)
	local parts = {}
	for i = 1, #pts - 1 do
		parts[#parts + 1] = r:Seg(limb, pts[i], pts[i + 1], thick or 0.08, color or C.Neon, M.Neon)
	end
	return parts
end
Kit.crack = crack

local function ring(r, limb, cf, radius, count, thick, depth, color, mat, skip)
	local parts = {}
	local segLen = 2 * PI * radius / count * 1.06
	for i = 0, count - 1 do
		if not (skip and skip(i)) then
			local a = i / count * PI * 2
			parts[#parts + 1] = r:Box(limb, V(segLen, thick, depth), cf * CF(math.cos(a) * radius, math.sin(a) * radius, 0) * ANG(0, 0, a + PI / 2), color, mat or M.Metal)
		end
	end
	return parts
end
Kit.ring = ring

function Kit.hide(parts, target)
	for _, p in ipairs(parts or {}) do
		p:SetAttribute("PT", target or p.Transparency)
		p.Transparency = 1
	end
	return parts or {}
end

function Kit.join(...)
	local out = {}
	for i = 1, select("#", ...) do
		local list = select(i, ...)
		if list then
			for _, p in ipairs(list) do
				out[#out + 1] = p
			end
		end
	end
	return out
end

-- Блок с фаской: три тёмных бруска «выкусывают» рёбра, светлый брусок внутри даёт тонкий кант по 12 рёбрам
local function bevel(r, limb, size, cf, color, edge, mat, e)
	mat = mat or M.Metal
	if lite() or edge == false then
		return { r:Box(limb, size, cf, color, mat) }, nil
	end
	local x, y, z = size.X, size.Y, size.Z
	e = e or math.min(0.09, math.min(x, y, z) * 0.2)
	if Kit.Cheap then
		local strip = r:Box(limb, V(x + 0.03, e, z + 0.03), cf * CF(0, y / 2 - e * 0.62, 0), edge or AC.Edge, mat)
		return { r:Box(limb, size, cf, color, mat), strip }, strip
	end
	local parts = {
		r:Box(limb, V(x, y - 2 * e, z - 2 * e), cf, color, mat),
		r:Box(limb, V(x - 2 * e, y, z - 2 * e), cf, color, mat),
		r:Box(limb, V(x - 2 * e, y - 2 * e, z), cf, color, mat),
	}
	local inner = r:Box(limb, V(x - e, y - e, z - e), cf, edge or AC.Edge, mat)
	parts[4] = inner
	return parts, inner
end
Kit.bevel = bevel

local function bar(r, limb, a, b, t, color, mat)
	local d = b - a
	d = d.Magnitude > 1e-6 and d.Unit or V(0, 1, 0)
	local tt = typeof(t) == "Vector2" and math.min(t.X, t.Y) or t
	return r:Seg(limb, a - d * tt * 0.4, b + d * tt * 0.4, t, color, mat or M.Plastic)
end
Kit.bar = bar

function Kit.hornA(r, limb, pts, t0, color, mat)
	local parts = {}
	local t = t0
	for i = 1, #pts - 2 do
		parts[#parts + 1] = bar(r, limb, pts[i], pts[i + 1], t, color, mat)
		t = t * 0.78
	end
	for _, p in ipairs(spike(r, limb, pts[#pts - 1], pts[#pts], t * 1.15, color, mat)) do
		parts[#parts + 1] = p
	end
	return parts
end

local function gem(r, limb, s, cf, color, frame)
	local parts = {}
	if frame then
		parts[#parts + 1] = r:Box(limb, V(s * 1.3, s * 1.3, 0.12), cf * CF(0, 0, 0.04) * ANG(0, 0, rad(45)), frame, M.Metal)
	end
	parts[#parts + 1] = r:Neon(limb, V(s, s, 0.14), cf * ANG(0, 0, rad(45)), color or C.Neon)
	return parts
end
Kit.gem = gem

-- Рваный край: n треугольных лоскутов вниз вдоль ширины w (в Lite — пустой список)
function Kit.tatter(r, limb, y, z, w, n, color, mat, seed)
	local parts = {}
	if lite() then
		return parts
	end
	for i = 0, n - 1 do
		local x = -w / 2 + (i + 0.5) * w / n
		local h = 0.3 + (((i + (seed or 0)) * 37) % 5) * 0.12
		for _, p in ipairs(spike(r, limb, V(x, y, z), V(x + 0.05, y - h, z), w / n * 1.05, color, mat or M.Fabric, true, 0.08)) do
			parts[#parts + 1] = p
		end
	end
	return parts
end

-- Ступенчатый наплечник: верхняя пластина, две ступени, боковой щиток, козырёк, шипы, самоцвет
function Kit.pauldron(r, A, side, s, color, edge, glow, spikes)
	local parts = {}
	local function add(list)
		for _, p in ipairs(list) do
			parts[#parts + 1] = p
		end
	end
	add(bevel(r, A, V(1.55, 0.5, 1.5) * s, CF(0.18 * side, 1.08, 0) * ANG(0, 0, rad(-14 * side)), color, edge))
	add(bevel(r, A, V(1.3, 0.32, 1.38) * s, CF(0.42 * side, 0.74, 0) * ANG(0, 0, rad(-26 * side)), AC.ArmorMid, edge))
	add(bevel(r, A, V(1.15, 0.3, 1.28) * s, CF(0.55 * side, 0.46, 0) * ANG(0, 0, rad(-34 * side)), color, edge))
	add(bevel(r, A, V(0.3, 1.05, 1.42) * s, CF(0.82 * side * s, 0.62, 0) * ANG(0, 0, rad(-10 * side)), color, edge))
	parts[#parts + 1] = r:Wedge(A, V(1.2 * s, 0.4 * s, 0.45 * s), CF(0.22 * side, 1.12, -0.92 * s) * ANG(0, PI, 0) * ANG(0, 0, rad(14 * side)), color, M.Metal)
	if glow then
		add(gem(r, A, 0.34 * s, CF(0.99 * side * s, 0.62, 0) * ANG(0, -side * PI / 2, 0) * ANG(0, 0, rad(10 * side)), glow, edge))
	end
	local n = spikes or 2
	for k = 1, n do
		local z = n == 1 and 0 or (-0.45 + (k - 1) * 0.9 / (n - 1))
		add(spike(r, A, V(0.4 * side, 1.3, z * s), V((0.85 + 0.1 * k) * side, 2.05 - 0.12 * k, z * 1.3 * s), 0.4 * s, color, M.Metal))
	end
	return parts
end

function Kit.bootA(r, L, color, edge, w)
	w = w or 1.15
	local parts = bevel(r, L, V(w, 0.5, 1.25), CF(0, -0.75, -0.08), color, edge)
	parts[#parts + 1] = r:Wedge(L, V(w * 0.9, 0.4, 0.55), CF(0, -0.8, -0.95), color, M.Metal)
	return parts
end

function Kit.squareRing(r, limb, cf, w, t, color)
	local parts = {}
	for i = 0, 3 do
		parts[#parts + 1] = r:Box(limb, V(w, t, t), cf * ANG(0, i * PI / 2, 0) * CF(0, 0, -w / 2 + t / 2), color, M.Metal)
	end
	return parts
end

function Kit.chain(r, limb, n, size, color, at)
	at = at or CF()
	color = color or C.Steel
	local parts = {}
	for i = 0, n - 1 do
		local cf = at * CF(0, -i * size * 1.1, 0) * ANG(0, i % 2 == 0 and 0 or PI / 2, 0)
		parts[#parts + 1] = r:Box(limb, V(size * 0.18, size * 1.2, size * 0.7), cf, color, M.Metal)
		parts[#parts + 1] = r:Box(limb, V(size * 0.18, size * 0.18, size * 0.7), cf * CF(0, size * 0.5, 0), color, M.Metal)
	end
	return parts
end

------------------------------------------------------------------------
-- ПРИГЛУШЕНИЕ: неон темнее, подсветка и частицы слабее (меньше «кислотности»)
------------------------------------------------------------------------
local CALM_DARK = rgb(14, 10, 22)
Kit.CALM_LIGHT = 0.65 -- множитель яркости PointLight
Kit.CALM_EMISSION = 0.6 -- множитель LightEmission частиц

function Kit.Calm(root, amount)
	if not root or root:GetAttribute("Calmed") then
		return
	end
	amount = amount or 0.3
	root:SetAttribute("Calmed", amount)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Material == M.Neon then
				d.Color = d.Color:Lerp(CALM_DARK, amount)
			end
		elseif d:IsA("PointLight") then
			d.Brightness = d.Brightness * Kit.CALM_LIGHT
		elseif d:IsA("ParticleEmitter") then
			d.LightEmission = d.LightEmission * Kit.CALM_EMISSION
		end
	end
end

return Kit
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX17FE494C9B0E15007ECDD6711F2535FA">
					<Properties>
						<string name="Name">Parts</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Models/Parts
-- Детали R6-фигур юнитов в угловатом стиле (тело — блоки R6 с фаской и светлым кантом; поверх — броня,
-- капюшоны, шлемы, плащи и оружие из блоков, клиньев и ромбов). Строится на Kit (Rig + bevel/spike/gem...).
-- Модули семейств (Units/Void, Shattered, Blood, Clockmaker, Halloween, Allies) используют ТОЛЬКО этот API.
--
-- Соглашения: r — rig из Parts.figure / Kit.Rig.new; A — рука (r.RArm / r.LArm), L — нога; перед фигуры — -Z.
--   Оружие в правой руке: клинок вперёд по -Z на высоте хвата GRIP; древковое — вертикально перед кулаком (z -0.5).
--   AIM = CF(0, GRIP, 0) * ANG(-90°, 0, 0) — рамка «вперёд оружия» для поднятой руки (idle RS ≈ 75°).
--   Каждый строитель оружия ставит r.Muzzle (невидимый "Muzzle" на острие/кристалле) и возвращает его;
--   o.Secondary = true — второе оружие: деталь-острие "Tip", r.Muzzle не меняется.
--
-- ПАЛИТРЫ / КОНСТАНТЫ
--   Parts.P (палитра юнитов = Kit.P), Parts.AC (= Kit.Colors), Parts.M (материалы), Parts.rgb, Parts.GRIP (-1.05), Parts.AIM
--   Parts.VOID (= P.Neon)
--   Parts.SH  Shattered: Blue BlueSoft Navy NavyD Edge
--   Parts.BL  Blood: Blood BloodSoft Crimson CrimsonD Edge Dark
--   Parts.CLK Clockmaker: Black Suit Gold GoldDark Bronze Silver Steel Dial Orange OrangeDim
--   Parts.HW  Halloween: Black Coal Night Purple PurpleDeep Violet Orange OrangeDim Pumpkin PumpkinDark Burgundy BurgDark
--             Gold GoldDark Edge EdgeCool Bone Straw StrawDark Burlap Wood WoodLight Leather Iron Green GreenDim Ghost
--             GhostDeep Red Pale Flame
--
-- ФИГУРА
--   figure(name, pal{Torso, Arm, Leg, Skin, Edge}) -> r   R6 (HeadSize 1.2), видимое тело — bevel-блоки; r.Pal, r.HeadBox (куб головы)
--   eyes(r, color, glow?, y=0.08)                       две щели-глаза (неон, если glow)
--   chest(r, color, edge, gemColor?)                    нагрудник (+ ромб)
--   belt(r, color, buckle, gemColor?)                   пояс с пряжкой (+ ромб)
--   tassets(r, color, edge)                             набедренники
--   robe(r, color, trim?, len=1.8)                      юбка-мантия с рваным краем (+ полоса trim)
--   mantle(r, color, edge)                              накидка на плечи + наплечья
--   hood(r, color, edge, eyeColor, peak=true)           капюшон с тёмным лицом и светящимися глазами (peak=false — без хвоста)
--   helm(r, color, edge, visor, crest?, tall?)          шлем с Т-визором (crest — цвет гребня)
--   wizardHat(r, color, band, edge)                     изогнутая остроконечная шляпа
--   crown(r, color, gemColor, h=0.75)                   корона с 8 зубцами
--   kabuto(r, color, edge, horn, mask)                  самурайский шлем с рогами и маской
--   plateShoulders(r, color, edge, s=1)                 простые наплечники-плиты
--   bigShoulders(r, color, edge, glow?, size=1, spikes=1)   ступенчатые наплечники Kit.pauldron на обе руки
--   bracers(r, color, edge)   greaves(r, color, edge, boots?)
--   wings(r, color, edge, glow?, span=1)                крылья из перьев на моторах WingR / WingL
--   capeWith(r, w, len, color, emblem?) -> cape         плащ с лохмотьями (+ ромб-эмблема)
--   levelAura(r, lv, color=P.Neon)                      эффекты уровня (вызывать перед Finish, после оружия):
--                                                       L4 искры на Muzzle, L5 кольцо "AuraRing" у ног + искры вверх + свет
-- ОРУЖИЕ (o — таблица опций; все цвета необязательны, по умолчанию палитра брони)
--   muzzle(r, limb, cf, secondary?) -> part
--   blade(r, A, {Y=GRIP, Len=3, W=0.5, Grip, Guard, GuardW=W+0.7, Blade, Edge, Glow, Core, Trail, Secondary})
--   dagger(r, A, glow?, len=1.2, color?, secondary?)
--   shaft(r, A, bottom, top, color=rgb(44,32,30), d=0.2) -> topPoint   древко (Wood)
--   staff(r, A, {Top=2.4, Wood, Prong, Glow, Big}) -> crystal
--   scythe(r, A, {Wood, Blade, Glow})   spear(r, A, {Top=2.6, Wood, Metal, Head, Edge, Glow, Axe, Wing})
--   hammer(r, A, {Head, Edge, Trim, Glow, Wood})   axe(r, A, {Wood, Head, Edge, Glow})
--   bow(r, A, {Wood, Glow, Tip, Grip, String})     (левая рука)   quiver(r, color, tipsColor)  (на спине)
--   crossbow(r, A, {Stock, Edge, Prong, Glow})   rifle(r, A, {Body, Edge, Glow, Barrel})   (рамка AIM)
--   shield(r, A, {Color, Edge, H=2.0, W=1.4, Rim, Gem})   (левая рука)
-- ЧАСОВЩИК (моторы с вращением по Z регистрируются в r.SpinRates[name] = rate)
--   octa(r, limb, a, depth, cf, color, mat=Metal) -> parts        восьмиугольник (a — до грани)
--   gear(r, limb, name?, pivot, a, depth, color, hubColor=CLK.Black, rate=1, mat) -> host, hub
--   clockFace(r, limb, cf, a, frame, prefix, handColor, glowHands?) -> hands   стрелки на моторах <prefix>Hour/<prefix>Minute
--   miniClock(r, limb, cf, a)
-- ХЭЛЛОУИН
--   tri(r, limb, cf, w, h, color, mat=Neon, depth=0.05) -> {2 parts}   треугольник в плоскости XY cf, вершина вверх
--   hideHead(r)                     спрятать куб головы фигуры (r.HeadBox)
--   downIn(pose{x,y,z}) -> Vector3   «вниз по миру» в координатах руки в позе idle (висящие предметы, нити)
--   pumpkin(r, limb, cf, R, h, color, edge, faceColor?, {Cheap, Stem}) -> faceParts   тыква из 8 долек с лицом
--   lantern(r, limb, cf, s, frame, glow, glass=rgb(255,170,70)) -> flame
--   kingCrown(r, limb, cf, R, h, color, gemColor?, n=8)           корона-кольцо (4 или 8 граней) с зубцами
--   brimHat(r, color, band?, {Y=0.62, Brim=2.1, W=1.3, Hgt=0.6, Tilt, Edge})
--   crow(r, limb, cf, s, eye=HW.Orange)   star(r, limb, cf, s, color)   flask(r, limb, cf, s, liquid) -> liquid
--   bell(r, limb, cf, s, color, rim, glow) -> clapper   card(r, limb, cf, s, suit, back?)
--   thread(r, limb, a, b, color, d=0.035) -> part   embers(r, part, color, rate=8, size=0.25) -> emitter | nil

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Kit = require(Shared.Models.Kit)

local Parts = {}

local V = Vector3.new
local V2 = Vector2.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local PI = math.pi

local rgb = Kit.rgb
local M = Kit.M
local P = Kit.P
local AC = Kit.Colors
local bevel, spike, gem, bar = Kit.bevel, Kit.spike, Kit.gem, Kit.bar

local GRIP = -1.05 -- точка хвата в кисти (локально в руке)
local AIM = CF(0, GRIP, 0) * ANG(rad(-90), 0, 0)

Parts.P, Parts.AC, Parts.M, Parts.rgb, Parts.GRIP, Parts.AIM = P, AC, M, rgb, GRIP, AIM
Parts.VOID = P.Neon
Parts.SH = { Blue = rgb(90, 150, 255), BlueSoft = rgb(170, 210, 255), Navy = rgb(30, 40, 84), NavyD = rgb(18, 22, 46), Edge = rgb(110, 130, 176) }
Parts.BL = { Blood = rgb(235, 40, 56), BloodSoft = rgb(255, 130, 140), Crimson = rgb(96, 14, 24), CrimsonD = rgb(52, 9, 16), Edge = rgb(160, 110, 116), Dark = rgb(28, 20, 24) }
local CLK = {
	Black = rgb(20, 18, 24), Suit = rgb(34, 30, 40), Gold = rgb(214, 168, 72), GoldDark = rgb(150, 112, 50), Bronze = rgb(160, 106, 52),
	Silver = rgb(172, 174, 188), Steel = rgb(58, 54, 64), Dial = rgb(14, 12, 18), Orange = rgb(255, 140, 40), OrangeDim = rgb(140, 70, 24),
}
Parts.CLK = CLK
local HW = {
	Black = rgb(18, 14, 22), Coal = rgb(32, 26, 38), Night = rgb(26, 22, 40), Purple = rgb(58, 30, 86), PurpleDeep = rgb(36, 18, 54),
	Violet = rgb(150, 70, 230), Orange = rgb(255, 130, 30), OrangeDim = rgb(170, 78, 22), Pumpkin = rgb(214, 104, 28),
	PumpkinDark = rgb(150, 66, 18), Burgundy = rgb(98, 22, 38), BurgDark = rgb(58, 14, 24), Gold = rgb(214, 168, 70),
	GoldDark = rgb(146, 108, 46), Edge = rgb(150, 124, 96), EdgeCool = rgb(120, 112, 140), Bone = rgb(222, 212, 192),
	Straw = rgb(206, 166, 82), StrawDark = rgb(150, 112, 52), Burlap = rgb(150, 118, 78), Wood = rgb(74, 48, 30),
	WoodLight = rgb(120, 82, 50), Leather = rgb(62, 40, 30), Iron = rgb(70, 68, 78), Green = rgb(120, 255, 110),
	GreenDim = rgb(60, 140, 60), Ghost = rgb(110, 190, 255), GhostDeep = rgb(40, 80, 150), Red = rgb(235, 30, 50),
	Pale = rgb(196, 190, 200), Flame = rgb(255, 190, 80),
}
Parts.HW = HW

local SIDES = { -1, 1 }

------------------------------------------------------------------------
-- ФИГУРА
------------------------------------------------------------------------
function Parts.figure(name, pal)
	local arm, leg = pal.Arm or pal.Torso, pal.Leg or pal.Torso
	local r = Kit.Rig.new({ Name = name, HeadSize = V(1.2, 1.2, 1.2), Torso = pal.Torso, Arm = arm, Leg = leg, Head = pal.Skin or pal.Torso })
	for _, L in ipairs({ r.Torso, r.Head, r.RArm, r.LArm, r.RLeg, r.LLeg }) do
		L.Transparency = 1
	end
	local e = pal.Edge or AC.Edge
	bevel(r, r.Torso, V(2, 2, 1), CF(), pal.Torso, e)
	bevel(r, r.RArm, V(1, 2, 1), CF(), arm, e)
	bevel(r, r.LArm, V(1, 2, 1), CF(), arm, e)
	bevel(r, r.RLeg, V(1, 2, 1), CF(), leg, e)
	bevel(r, r.LLeg, V(1, 2, 1), CF(), leg, e)
	r.HeadBox = r:Box(r.Head, V(1.2, 1.2, 1.2), CF(), pal.Skin or rgb(70, 62, 80), M.Plastic)
	r.Pal = pal
	return r
end

function Parts.eyes(r, color, glow, y)
	for _, s in ipairs(SIDES) do
		if glow then
			r:Neon(r.Head, V(0.22, 0.12, 0.05), CF(0.24 * s, y or 0.08, -0.61), color)
		else
			r:Box(r.Head, V(0.22, 0.12, 0.05), CF(0.24 * s, y or 0.08, -0.61), color)
		end
	end
end

function Parts.chest(r, color, edge, gemColor)
	bevel(r, r.Torso, V(2.14, 1.05, 1.16), CF(0, 0.5, 0), color, edge)
	if gemColor then
		gem(r, r.Torso, 0.36, CF(0, 0.5, -0.62), gemColor, edge)
	end
end

function Parts.belt(r, color, buckle, gemColor)
	bevel(r, r.Torso, V(2.1, 0.3, 1.12), CF(0, -0.82, 0), color, false, M.Fabric)
	bevel(r, r.Torso, V(0.42, 0.4, 0.12), CF(0, -0.82, -0.6), buckle, false)
	if gemColor then
		gem(r, r.Torso, 0.16, CF(0, -0.82, -0.68), gemColor)
	end
end

function Parts.tassets(r, color, edge)
	for _, s in ipairs(SIDES) do
		bevel(r, r.Torso, V(0.85, 0.75, 0.2), CF(0.5 * s, -1.32, -0.56) * ANG(rad(-6), 0, 0), color, edge)
	end
end

function Parts.robe(r, color, trim, len)
	len = len or 1.8
	bevel(r, r.Torso, V(2.12, len, 1.14), CF(0, -1 - len / 2 + 0.1, 0), color, trim, M.Fabric)
	Kit.tatter(r, r.Torso, -1 - len + 0.1, -0.57, 2.1, 5, color, M.Fabric, 3)
	if trim then
		r:Box(r.Torso, V(0.3, len, 0.05), CF(0, -1 - len / 2 + 0.1, -0.58), trim, M.Fabric)
	end
end

function Parts.mantle(r, color, edge)
	bevel(r, r.Torso, V(2.35, 0.4, 1.3), CF(0, 0.88, 0), color, edge, M.Fabric)
	for _, s in ipairs(SIDES) do
		bevel(r, s == 1 and r.RArm or r.LArm, V(1.18, 0.7, 1.18), CF(0.05 * s, 0.68, 0), color, edge, M.Fabric)
	end
end

function Parts.hood(r, color, edge, eyeColor, peak)
	local H = r.Head
	bevel(r, H, V(1.44, 0.28, 1.44), CF(0, 0.72, 0.03), color, edge, M.Fabric)
	for _, s in ipairs(SIDES) do
		bevel(r, H, V(0.22, 1.32, 1.44), CF(0.72 * s, 0.06, 0.03), color, edge, M.Fabric)
	end
	bevel(r, H, V(1.44, 1.32, 0.22), CF(0, 0.06, 0.72), color, edge, M.Fabric)
	r:Wedge(H, V(1.44, 0.32, 0.4), CF(0, 0.58, -0.62), color, M.Fabric)
	if peak ~= false then
		spike(r, H, V(0, 0.8, 0.45), V(0, 1.15, 1.0), 0.7, color, M.Fabric, true, 0.2)
	end
	r:Box(H, V(1.04, 1.02, 0.05), CF(0, -0.02, -0.61), rgb(12, 9, 18), M.Plastic)
	Parts.eyes(r, eyeColor, true, 0.06)
end

function Parts.helm(r, color, edge, visor, crest, tall)
	local H = r.Head
	bevel(r, H, V(1.32, tall and 1.45 or 1.32, 1.34), CF(0, tall and 0.1 or 0.03, 0), color, edge)
	r:Neon(H, V(0.6, 0.09, 0.05), CF(0, 0.14, -0.68), visor)
	r:Neon(H, V(0.09, 0.42, 0.05), CF(0, -0.08, -0.68), visor)
	if crest then
		local lift = tall and 0.1 or 0
		spike(r, H, V(0, 0.6 + lift, -0.25), V(0, 1.25 + (tall and 0.15 or 0), 0.25), 0.75, crest, M.Metal, true, 0.12)
	end
end

function Parts.wizardHat(r, color, band, edge)
	local H = r.Head
	bevel(r, H, V(2.3, 0.14, 2.3), CF(0, 0.64, 0), color, edge, M.Fabric)
	bevel(r, H, V(1.4, 0.24, 1.4), CF(0, 0.82, 0), band, false, M.Fabric)
	bevel(r, H, V(1.3, 0.55, 1.3), CF(0, 1.18, 0), color, edge, M.Fabric)
	bevel(r, H, V(0.95, 0.5, 0.95), CF(0.06, 1.6, 0.08) * ANG(rad(-8), 0, rad(-6)), color, edge, M.Fabric)
	bevel(r, H, V(0.6, 0.45, 0.6), CF(0.18, 1.98, 0.22) * ANG(rad(-18), 0, rad(-14)), color, edge, M.Fabric)
	spike(r, H, V(0.26, 2.15, 0.3), V(0.55, 2.55, 0.65), 0.5, color, M.Fabric)
end

function Parts.crown(r, color, gemColor, h)
	local H = r.Head
	h = h or 0.75
	for i = 0, 3 do
		r:Box(H, V(1.42, 0.26, 0.12), CF(0, 0.72, 0) * ANG(0, i * PI / 2, 0) * CF(0, 0, -0.66), color, M.Metal)
	end
	for i = 0, 7 do
		local a = i / 8 * PI * 2
		local p = V(math.sin(a) * 0.66, 0.8, -math.cos(a) * 0.66)
		spike(r, H, p, p + V(0, i % 2 == 0 and h or h * 0.6, 0), 0.32, color, M.Metal, true, 0.1)
	end
	gem(r, H, 0.24, CF(0, 0.74, -0.73), gemColor)
end

function Parts.kabuto(r, color, edge, horn, mask)
	local H = r.Head
	bevel(r, H, V(1.38, 0.62, 1.42), CF(0, 0.5, 0.02), color, edge)
	for i = 0, 1 do -- сикоро: пластины на затылке и по бокам
		bevel(r, H, V(1.62 + i * 0.2, 0.26, 0.26), CF(0, 0.05 - i * 0.26, 0.74 + i * 0.08) * ANG(rad(25), 0, 0), color, edge)
		for _, s in ipairs(SIDES) do
			bevel(r, H, V(0.26, 0.26, 1.2 + i * 0.15), CF(s * (0.78 + i * 0.08), 0.05 - i * 0.26, 0.12) * ANG(0, 0, rad(-25 * s)), color, edge)
		end
	end
	r:Box(H, V(0.96, 0.46, 0.08), CF(0, -0.3, -0.63), mask, M.Metal)
	r:Neon(H, V(0.46, 0.05, 0.05), CF(0, -0.36, -0.68), horn)
	for _, s in ipairs(SIDES) do
		Kit.hornA(r, H, { V(0.2 * s, 0.6, -0.7), V(0.45 * s, 0.95, -0.85), V(0.7 * s, 1.45, -0.8), V(0.75 * s, 1.85, -0.65) }, 0.14, horn, M.Metal)
	end
	Parts.eyes(r, horn, true, 0.12)
end

function Parts.plateShoulders(r, color, edge, s)
	s = s or 1
	for _, side in ipairs({ 1, -1 }) do
		bevel(r, side == 1 and r.RArm or r.LArm, V(1.3, 0.5, 1.25) * s, CF(0.12 * side, 0.9, 0) * ANG(0, 0, rad(-12 * side)), color, edge)
	end
end

function Parts.bigShoulders(r, color, edge, glow, size, spikes)
	Kit.pauldron(r, r.RArm, 1, size or 1, color, edge, glow, spikes or 1)
	Kit.pauldron(r, r.LArm, -1, size or 1, color, edge, glow, spikes or 1)
end

function Parts.bracers(r, color, edge)
	for _, A in ipairs({ r.RArm, r.LArm }) do
		bevel(r, A, V(1.14, 0.75, 1.14), CF(0, -0.55, 0), color, edge)
	end
end

function Parts.greaves(r, color, edge, boots)
	for _, L in ipairs({ r.RLeg, r.LLeg }) do
		bevel(r, L, V(1.12, 0.7, 1.14), CF(0, -0.35, 0), color, edge)
		if boots then
			Kit.bootA(r, L, color, edge, 1.12)
		end
	end
end

local FEATHERS = { 2.8, 2.5, 2.1, 1.7, 1.3 }
function Parts.wings(r, color, edge, glow, span)
	span = span or 1
	for _, side in ipairs({ 1, -1 }) do
		local w = r:Joint(side == 1 and "WingR" or "WingL", r.Torso, V(0.3, 0.3, 0.3), CF(0.45 * side, 0.6, 0.6), CF(), color)
		w.Transparency = 1
		for i, L in ipairs(FEATHERS) do
			local th = rad(28 + (i - 1) * 24)
			L = L * span
			local at = CF(side * math.sin(th) * L / 2, math.cos(th) * L / 2, 0.15 + i * 0.03) * ANG(0, 0, -side * th)
			bevel(r, w, V(0.5, L, 0.16), at, color, edge, M.Plastic)
			if glow and i <= 2 then
				r:Neon(w, V(0.08, L * 0.8, 0.18), at * CF(0.2 * side, 0, 0), glow)
			end
		end
	end
end

function Parts.capeWith(r, w, len, color, emblem)
	local cape = r:Cape(w, len, color, true)
	if emblem then
		gem(r, cape, 0.5, CF(0, 0.1, 0.08) * ANG(0, PI, 0), emblem)
	end
	return cape
end

-- Эффекты прокачки: L4 искры на оружии, L5 светящееся кольцо у ног, искры вверх и подсветка
function Parts.levelAura(r, lv, color)
	color = color or P.Neon
	local mz = r.Muzzle
	if lv >= 4 and mz and mz:IsA("BasePart") then
		local own = mz:FindFirstChild("Sparkles")
		if own and own:IsA("ParticleEmitter") then
			own.Rate = own.Rate + 6 -- уже искрит (VoidKnight L3): гуще, без второго эмиттера
		else
			r:Sparkles(mz, color, { Rate = 6, Size = 0.25 })
		end
	end
	if lv >= 5 then
		r:Add(r.Torso, "Part", V(0.08, 3.8, 3.8), CF(0, -2.96, 0) * ANG(0, 0, rad(90)), color, M.Neon,
			{ Shape = Enum.PartType.Cylinder, Transparency = 0.78, Name = "AuraRing" })
		r:Sparkles(r.Torso, color, { Rate = 10, Up = 3, Size = 0.3, LifeMin = 0.8, LifeMax = 1.4 })
		r:Glow(r.Torso, color, 10, 1.2)
	end
end

------------------------------------------------------------------------
-- ОРУЖИЕ
------------------------------------------------------------------------
local function muzzle(r, limb, cf, secondary)
	local m = r:Box(limb, V(0.2, 0.2, 0.2), cf, P.Black, M.Plastic, { Transparency = 1, Name = secondary and "Tip" or "Muzzle" })
	if not secondary then
		r.Muzzle = m
	end
	return m
end
Parts.muzzle = muzzle

function Parts.blade(r, A, o)
	o = o or {}
	local y = o.Y or GRIP
	local len, w = o.Len or 3, o.W or 0.5
	local z0 = -0.56
	local bladeC = o.Blade or AC.ArmorMid
	r:Box(A, V(0.22, 0.22, 0.85), CF(0, y, 0.1), o.Grip or AC.ClothDark, M.Fabric)
	r:Box(A, V(0.3, 0.3, 0.25), CF(0, y, 0.6) * ANG(0, 0, rad(45)), o.Guard or AC.Armor, M.Metal)
	bevel(r, A, V(0.28, o.GuardW or (w + 0.7), 0.28), CF(0, y, -0.42), o.Guard or AC.Armor, o.Edge)
	r:Box(A, V(0.12, w, len), CF(0, y, z0 - len / 2), bladeC, M.Metal)
	if o.Glow then
		for _, s in ipairs(SIDES) do
			r:Neon(A, V(0.14, 0.07, len * 0.96), CF(0, y + s * (w / 2 - 0.03), z0 - len / 2), o.Glow)
		end
	end
	if o.Core then
		r:Neon(A, V(0.14, 0.08, len * 0.7), CF(0, y, z0 - len * 0.42), o.Core)
	end
	spike(r, A, V(0, y, z0 - len + 0.02), V(0, y, z0 - len - w * 1.2), w, bladeC, M.Metal, true, 0.12)
	r:WeaponTrail(A, V(0, y, z0 - 0.15), V(0, y, z0 - len - w), o.Trail or o.Glow or P.NeonSoft)
	return muzzle(r, A, CF(0, y, z0 - len - w), o.Secondary)
end

function Parts.dagger(r, A, glow, len, color, secondary)
	return Parts.blade(r, A, { Len = len or 1.2, W = 0.32, GuardW = 0.7, Blade = color or AC.ArmorMid, Glow = glow, Guard = AC.Armor, Secondary = secondary })
end

-- Вертикальное древко перед кулаком; возвращает верхнюю точку
local function shaft(r, A, bottom, top, color, d)
	d = d or 0.2
	r:Box(A, V(d, top - bottom, d), CF(0, (top + bottom) / 2, -0.5), color or rgb(44, 32, 30), M.Wood)
	return V(0, top, -0.5)
end
Parts.shaft = shaft

function Parts.staff(r, A, o)
	o = o or {}
	local top = shaft(r, A, -2.5, o.Top or 2.4, o.Wood, 0.2)
	local c = top + V(0, 0.45, 0)
	for k = 0, 3 do
		local a = k / 4 * PI * 2 + PI / 4
		local dx, dz = math.cos(a), math.sin(a)
		spike(r, A, top + V(dx * 0.15, -0.1, dz * 0.15), c + V(dx * 0.35, 0.35, dz * 0.35), 0.16, o.Prong or AC.Armor, M.Metal, true, 0.08)
	end
	local g = r:Neon(A, V(0.45, 0.45, 0.45), CF(c) * ANG(rad(45), 0, rad(45)), o.Glow)
	if o.Big then
		r:Box(A, V(0.7, 0.7, 0.7), CF(c) * ANG(rad(45), 0, rad(45)), o.Glow, M.Glass, { Transparency = 0.6 })
	end
	muzzle(r, A, CF(c), o.Secondary)
	return g
end

function Parts.scythe(r, A, o)
	o = o or {}
	local top = shaft(r, A, -2.6, 2.6, o.Wood, 0.2)
	local bladeC = o.Blade or AC.ArmorMid
	local pts = { top + V(0, -0.05, 0.1), top + V(0, 0.25, -0.8), top + V(0, 0.05, -1.7), top + V(0, -0.4, -2.4) }
	for i = 1, #pts - 1 do
		bar(r, A, pts[i], pts[i + 1], V2(0.12, 0.42 - i * 0.07), bladeC)
		if o.Glow then
			bar(r, A, pts[i] + V(0, -0.2 + i * 0.03, 0), pts[i + 1] + V(0, -0.17 + i * 0.03, 0), V2(0.14, 0.06), o.Glow, M.Neon)
		end
	end
	spike(r, A, pts[4], pts[4] + V(0, -0.55, -0.4), 0.26, bladeC, M.Metal, true, 0.12)
	r:WeaponTrail(A, top + V(0, 0, -0.8), pts[4], o.Glow or P.NeonSoft)
	return muzzle(r, A, CF(pts[4]), o.Secondary)
end

function Parts.spear(r, A, o)
	o = o or {}
	local top = shaft(r, A, -2.4, o.Top or 2.6, o.Wood, 0.2)
	local head = o.Head or AC.ArmorMid
	bevel(r, A, V(0.34, 0.3, 0.34), CF(top), o.Metal or AC.Armor, o.Edge)
	spike(r, A, top + V(0, 0.1, 0), top + V(0, 1.1, 0), 0.5, head, M.Metal)
	if o.Glow then
		r:Neon(A, V(0.08, 0.6, 0.08), CF(top + V(0, 0.45, -0.13)), o.Glow)
	end
	if o.Axe then
		bevel(r, A, V(0.12, 0.8, 0.7), CF(top + V(0, -0.2, -0.45)), head, o.Edge)
		spike(r, A, top + V(0, -0.2, -0.75), top + V(0, -0.2, -1.2), 0.8, head, M.Metal, true, 0.12)
	end
	if o.Wing then
		for _, s in ipairs(SIDES) do
			spike(r, A, top + V(0.1 * s, 0, 0), top + V(0.55 * s, 0.35, 0), 0.22, o.Metal or AC.Armor, M.Metal, true, 0.08)
		end
	end
	r:WeaponTrail(A, top, top + V(0, 1.1, 0), o.Glow or P.NeonSoft)
	return muzzle(r, A, CF(top + V(0, 1.1, 0)), o.Secondary)
end

function Parts.hammer(r, A, o)
	o = o or {}
	local top = shaft(r, A, -2.2, 2.0, o.Wood or AC.Armor, 0.24)
	local c = top + V(0, 0.35, 0)
	bevel(r, A, V(0.95, 0.95, 1.8), CF(c), o.Head, o.Edge)
	for _, z in ipairs({ -0.65, 0.65 }) do
		bevel(r, A, V(1.05, 1.05, 0.18), CF(c + V(0, 0, z)), o.Trim or o.Edge, false)
	end
	gem(r, A, 0.45, CF(c + V(-0.49, 0, 0)) * ANG(0, PI / 2, 0), o.Glow)
	gem(r, A, 0.45, CF(c + V(0.49, 0, 0)) * ANG(0, -PI / 2, 0), o.Glow)
	spike(r, A, c + V(0, 0.45, 0), c + V(0, 1.0, 0), 0.4, o.Trim or o.Head, M.Metal)
	r:WeaponTrail(A, top, c + V(0, 0, -0.9), o.Glow)
	return muzzle(r, A, CF(c), o.Secondary)
end

function Parts.axe(r, A, o)
	o = o or {}
	local top = shaft(r, A, -2.2, 2.2, o.Wood, 0.22)
	bevel(r, A, V(0.14, 1.3, 1.0), CF(top + V(0, -0.35, -0.55)), o.Head, o.Edge)
	spike(r, A, top + V(0, -0.35, -1.0), top + V(0, -0.35, -1.6), 1.5, o.Head, M.Metal, true, 0.14)
	if o.Glow then
		r:Neon(A, V(0.16, 1.4, 0.08), CF(top + V(0, -0.35, -1.08)), o.Glow)
	end
	spike(r, A, top, top + V(0, 0.6, 0), 0.3, o.Head, M.Metal)
	r:WeaponTrail(A, top + V(0, -0.35, -0.8), top + V(0, -0.35, -1.6), o.Glow or P.NeonSoft)
	return muzzle(r, A, CF(top + V(0, -0.35, -1.5)), o.Secondary)
end

-- Лук в левой руке: вертикально, тетива к стрелку
function Parts.bow(r, A, o)
	o = o or {}
	local g = V(0, GRIP, -0.45)
	r:Box(A, V(0.2, 0.5, 0.2), CF(g), o.Grip or AC.ClothDark, M.Fabric)
	local tips = {}
	for _, s in ipairs({ 1, -1 }) do
		local m = g + V(0, 0.9 * s, -0.2)
		local t = g + V(0, 1.75 * s, 0.25)
		bar(r, A, g, m, V2(0.14, 0.2), o.Wood)
		bar(r, A, m, t, V2(0.12, 0.16), o.Wood)
		if o.Glow then
			bar(r, A, g + V(0, 0.1 * s, -0.08), m + V(0, 0, -0.08), V2(0.15, 0.05), o.Glow, M.Neon)
		end
		spike(r, A, t, t + V(0, 0.3 * s, 0.15), 0.16, o.Tip or o.Wood, M.Metal, true, 0.08)
		tips[#tips + 1] = t
	end
	r:Box(A, V(0.04, (tips[1] - tips[2]).Magnitude, 0.04), CF((tips[1] + tips[2]) / 2), o.String or rgb(220, 210, 230), M.Plastic)
	return muzzle(r, A, CF(g + V(0, 0, -0.2)), o.Secondary)
end

function Parts.quiver(r, color, tips)
	bevel(r, r.Torso, V(0.5, 1.6, 0.5), CF(0.45, 0.2, 0.75) * ANG(0, 0, rad(-25)), color, false, M.Fabric)
	for k = -1, 1 do
		spike(r, r.Torso, V(0.75 + k * 0.1, 1.05, 0.75 + k * 0.08), V(0.95 + k * 0.1, 1.45, 0.75 + k * 0.08), 0.18, tips, M.Plastic, true, 0.05)
	end
end

-- Оружие для вытянутых вперёд рук строится в рамке AIM (ствол вперёд при поднятой руке)
function Parts.crossbow(r, A, o)
	o = o or {}
	local F = AIM
	bevel(r, A, V(0.32, 0.32, 1.9), F * CF(0, 0, -0.75), o.Stock, o.Edge)
	local f = -1.55
	for _, s in ipairs(SIDES) do
		bar(r, A, F * V(0, 0.05, f), F * V(0.6 * s, 0.05, f + 0.15), V2(0.18, 0.14), o.Prong)
		bar(r, A, F * V(0.6 * s, 0.05, f + 0.15), F * V(1.1 * s, 0.05, f + 0.4), V2(0.14, 0.12), o.Prong)
		spike(r, A, F * V(1.1 * s, 0.05, f + 0.4), F * V(1.35 * s, 0.05, f + 0.25), 0.2, o.Glow, M.Neon, true, 0.08)
	end
	r:Box(A, V(2.2, 0.03, 0.03), F * CF(0, 0.05, f + 0.4), rgb(200, 220, 255), M.Plastic)
	r:Neon(A, V(0.1, 0.1, 1.2), F * CF(0, 0.22, -1.1), o.Glow)
	spike(r, A, F * V(0, 0.22, -1.7), F * V(0, 0.22, -2.1), 0.22, o.Glow, M.Neon)
	return muzzle(r, A, F * CF(0, 0.22, -2.1), o.Secondary)
end

function Parts.rifle(r, A, o)
	o = o or {}
	local F = AIM
	bevel(r, A, V(0.42, 0.55, 1.9), F * CF(0, 0.05, -0.75), o.Body, o.Edge)
	bevel(r, A, V(0.32, 0.5, 0.75), F * CF(0, -0.05, 0.45), o.Body, o.Edge)
	r:Box(A, V(0.24, 0.24, 1.5), F * CF(0, 0.15, -2.4), o.Barrel or AC.ArmorMid, M.Metal)
	bevel(r, A, V(0.2, 0.2, 0.8), F * CF(0, 0.45, -0.7), o.Body, o.Edge)
	r:Neon(A, V(0.08, 0.08, 0.08), F * CF(0, 0.45, -1.12), o.Glow)
	for k = 0, 2 do
		r:Neon(A, V(0.32, 0.32, 0.08), F * CF(0, 0.15, -1.9 - k * 0.38), o.Glow)
	end
	r:Box(A, V(0.3, 0.6, 0.2), F * CF(0, -0.45, -0.6), o.Body, M.Metal)
	return muzzle(r, A, F * CF(0, 0.15, -3.2), o.Secondary)
end

function Parts.shield(r, A, o)
	o = o or {}
	local x, h, w = -0.68, o.H or 2.0, o.W or 1.4
	bevel(r, A, V(0.24, h, w), CF(x, -0.5, -0.1), o.Color, o.Edge)
	spike(r, A, V(x, -0.5 - h / 2 + 0.02, -0.1), V(x, -0.5 - h / 2 - 0.6, -0.1), w, o.Color, M.Metal, true, 0.24)
	if o.Rim then
		r:Box(A, V(0.26, h * 0.8, 0.12), CF(x - 0.01, -0.5, -0.1), o.Rim, M.Metal)
		r:Box(A, V(0.26, 0.12, w * 0.8), CF(x - 0.01, -0.3, -0.1), o.Rim, M.Metal)
	end
	if o.Gem then
		gem(r, A, 0.45, CF(x - 0.14, -0.3, -0.1) * ANG(0, PI / 2, 0), o.Gem, o.Edge)
	end
end

------------------------------------------------------------------------
-- ЧАСОВЩИК: восьмиугольники, шестерни, циферблаты (моторы вращения — в r.SpinRates)
------------------------------------------------------------------------
local function octa(r, limb, a, depth, cf, color, mat)
	local parts = {}
	for k = 0, 3 do
		parts[#parts + 1] = r:Box(limb, V(2 * a, 0.8284 * a, depth), cf * ANG(0, 0, k * PI / 4), color, mat or M.Metal)
	end
	return parts
end
Parts.octa = octa

-- Шестерня в плоскости XY; с именем — на своём моторе, крутится вокруг оси Z узла со скоростью rate
function Parts.gear(r, limb, name, pivot, a, depth, color, hubColor, rate, mat)
	local host, base = limb, pivot
	if name then
		host = r:Joint(name, limb, V(0.1, 0.1, 0.1), pivot, CF(), color)
		host.Transparency = 1
		base = CF()
		r.SpinRates = r.SpinRates or {}
		r.SpinRates[name] = rate or 1
	end
	octa(r, host, a, depth, base, color, mat)
	for k = 0, 7 do
		local ang = k * PI / 4
		r:Box(host, V(a * 0.36, a * 0.34, depth), base * CF(math.cos(ang) * a * 1.08, math.sin(ang) * a * 1.08, 0) * ANG(0, 0, ang), color, mat or M.Metal)
	end
	hubColor = hubColor or CLK.Black
	local hub = r:Box(host, V(a * 0.42, a * 0.42, depth + 0.04), base * ANG(0, 0, PI / 4), hubColor, hubColor == CLK.Orange and M.Neon or M.Metal)
	return host, hub
end

local HANDS = { { "Hour", 0.45, 0.11, 0.22 }, { "Minute", 0.68, 0.07, 1.6 } }
function Parts.clockFace(r, limb, cf, a, frame, prefix, handColor, glowHands)
	octa(r, limb, a, 0.5, cf, frame)
	octa(r, limb, a * 0.84, 0.54, cf, CLK.Dial, M.Plastic)
	for k = 0, 11 do
		local ang = k * PI / 6
		local big = k % 3 == 0
		r:Box(limb, V(a * 0.07, a * (big and 0.2 or 0.12), 0.04), cf * CF(math.cos(ang) * a * 0.68, math.sin(ang) * a * 0.68, -0.28) * ANG(0, 0, ang + PI / 2), handColor, M.Metal)
	end
	r.SpinRates = r.SpinRates or {}
	local hands = {}
	for i, h in ipairs(HANDS) do
		local name = prefix .. h[1]
		local hub = r:Joint(name, limb, V(0.1, 0.1, 0.1), cf * CF(0, 0, -0.3 - i * 0.02), CF(), handColor)
		hub.Transparency = 1
		r.SpinRates[name] = h[4]
		local size, at = V(a * h[3], a * h[2], 0.04), CF(0, a * h[2] * 0.42, 0)
		hands[i] = glowHands and r:Neon(hub, size, at, CLK.Orange) or r:Box(hub, size, at, handColor, M.Plastic)
	end
	r:Box(limb, V(a * 0.16, a * 0.16, 0.08), cf * CF(0, 0, -0.36) * ANG(0, 0, PI / 4), CLK.Gold, M.Metal)
	return hands
end

function Parts.miniClock(r, limb, cf, a)
	octa(r, limb, a, 0.12, cf, CLK.Gold)
	octa(r, limb, a * 0.8, 0.14, cf, CLK.Dial, M.Plastic)
	r:Box(limb, V(a * 0.12, a * 0.6, 0.04), cf * CF(0, a * 0.25, -0.09), CLK.Gold, M.Metal)
	r:Box(limb, V(a * 0.5, a * 0.1, 0.04), cf * CF(a * 0.2, 0, -0.1), CLK.Gold, M.Metal)
end

------------------------------------------------------------------------
-- ХЭЛЛОУИН
------------------------------------------------------------------------
local function tri(r, limb, cf, w, h, color, mat, depth)
	local F = cf * ANG(0, PI / 2, 0)
	local d = depth or 0.05
	return {
		r:Wedge(limb, V(d, h, w / 2), F * CF(0, 0, -w / 4), color, mat or M.Neon),
		r:Wedge(limb, V(d, h, w / 2), F * CF(0, 0, w / 4) * ANG(0, PI, 0), color, mat or M.Neon),
	}
end
Parts.tri = tri

function Parts.hideHead(r)
	if r.HeadBox then
		r.HeadBox.Transparency = 1
	end
end

function Parts.downIn(pose)
	local rot = ANG(rad(pose[1] or 0), rad(pose[2] or 0), rad(pose[3] or 0))
	return (rot:Inverse() * V(0, -1, 0)).Unit
end

-- Тыква из 8 долек вокруг оси Y; лицо смотрит в -Z. Возвращает детали лица
function Parts.pumpkin(r, limb, cf, R, h, color, edge, faceColor, o)
	o = o or {}
	local w = 2 * R * math.tan(rad(22.5)) * 1.12
	local mid = color:Lerp(edge, 0.35)
	for k = 0, 7 do
		local a = k * PI / 4
		local even = k % 2 == 0
		r:Box(limb, V(w, even and h or h * 0.9, R * 0.8), cf * CF(math.sin(a) * R * 0.6, 0, -math.cos(a) * R * 0.6) * ANG(0, -a, 0), even and color or mid, M.Plastic)
		if not o.Cheap and not Kit.IsLite() then -- тёмные бороздки
			local g = a + PI / 8
			r:Box(limb, V(0.06, h * 0.86, 0.06), cf * CF(math.sin(g) * R * 0.97, 0, -math.cos(g) * R * 0.97) * ANG(0, -g, 0), edge, M.Plastic)
		end
	end
	r:Box(limb, V(R * 1.3, h * 0.1, R * 1.3), cf * CF(0, h / 2 - h * 0.02, 0) * ANG(0, PI / 4, 0), edge, M.Plastic)
	bar(r, limb, cf * V(0, h / 2, 0), cf * V(0.08 * R, h / 2 + h * 0.26, 0.05 * R), V2(0.16 * R, 0.16 * R), o.Stem or rgb(66, 74, 34), M.Wood)
	local face = {}
	if faceColor then
		local z = -R - 0.03
		local function add(list)
			for _, p in ipairs(list) do
				face[#face + 1] = p
			end
		end
		for _, s in ipairs(SIDES) do
			add(tri(r, limb, cf * CF(0.3 * R * s, h * 0.14, z) * ANG(0, 0, rad(8 * s)), 0.36 * R, 0.3 * R, faceColor, M.Neon, 0.06))
		end
		if not o.Cheap then
			add(tri(r, limb, cf * CF(0, -h * 0.02, z), 0.14 * R, 0.13 * R, faceColor, M.Neon, 0.06))
		end
		face[#face + 1] = r:Neon(limb, V(0.95 * R, 0.17 * R, 0.06), cf * CF(0, -h * 0.22, z), faceColor)
		if not o.Cheap then -- зубы
			for _, x in ipairs({ -0.24, 0.24 }) do
				r:Box(limb, V(0.14 * R, 0.1 * R, 0.07), cf * CF(x * R, -h * 0.19, z - 0.01), color, M.Plastic)
			end
			r:Box(limb, V(0.14 * R, 0.1 * R, 0.07), cf * CF(0, -h * 0.25, z - 0.01), color, M.Plastic)
		end
	end
	return face
end

-- Фонарь: крыша, кольцо, стойки, стекло, огонёк. cf — центр стекла
function Parts.lantern(r, limb, cf, s, frame, glow, glass)
	bevel(r, limb, V(0.72, 0.16, 0.72) * s, cf * CF(0, 0.42 * s, 0), frame, false)
	spike(r, limb, cf * V(0, 0.48 * s, 0), cf * V(0, 0.8 * s, 0), 0.52 * s, frame, M.Metal)
	r:Box(limb, V(0.06, 0.3, 0.3) * s, cf * CF(0, 0.92 * s, 0), frame, M.Metal)
	r:Box(limb, V(0.06, 0.06, 0.3) * s, cf * CF(0, 1.06 * s, 0), frame, M.Metal)
	for _, x in ipairs(SIDES) do
		for _, z in ipairs(SIDES) do
			r:Box(limb, V(0.07, 0.7, 0.07) * s, cf * CF(0.27 * s * x, 0, 0.27 * s * z), frame, M.Metal)
		end
	end
	r:Box(limb, V(0.5, 0.6, 0.5) * s, cf, glass or rgb(255, 170, 70), M.Glass, { Transparency = 0.45 })
	local flame = r:Neon(limb, V(0.22, 0.32, 0.22) * s, cf * CF(0, -0.03 * s, 0) * ANG(0, PI / 4, 0), glow)
	bevel(r, limb, V(0.66, 0.14, 0.66) * s, cf * CF(0, -0.38 * s, 0), frame, false)
	r:Glow(flame, glow, 9, 1.4)
	return flame
end

-- Корона-кольцо (4 или 8 граней) с зубцами-треугольниками; cf — центр низа
function Parts.kingCrown(r, limb, cf, R, h, color, gemColor, n)
	n = n or 8
	local sides = n <= 4 and 4 or 8
	local w = 2 * R * math.tan(PI / sides) * 1.1
	for k = 0, sides - 1 do
		local a = k * 2 * PI / sides
		r:Box(limb, V(w, h * 0.32, 0.12), cf * CF(math.sin(a) * R, h * 0.16, -math.cos(a) * R) * ANG(0, -a, 0), color, M.Metal)
	end
	for k = 0, n - 1 do
		local a = k * 2 * PI / n
		local hh = k % 2 == 0 and h or h * 0.62
		tri(r, limb, cf * CF(math.sin(a) * R, h * 0.3 + hh / 2, -math.cos(a) * R) * ANG(0, -a, 0), 0.36, hh, color, M.Metal, 0.12)
	end
	if gemColor then
		gem(r, limb, 0.22, cf * CF(0, h * 0.16, -R - 0.07), gemColor)
		if sides == 8 then
			gem(r, limb, 0.15, cf * CF(R * 0.72, h * 0.16, -R * 0.72 - 0.07) * ANG(0, rad(-45), 0), gemColor)
			gem(r, limb, 0.15, cf * CF(-R * 0.72, h * 0.16, -R * 0.72 - 0.07) * ANG(0, rad(45), 0), gemColor)
		end
	end
end

function Parts.brimHat(r, color, band, o)
	o = o or {}
	local Hd = r.Head
	local y, w, hgt = o.Y or 0.62, o.W or 1.3, o.Hgt or 0.6
	local tilt = ANG(rad(o.Tilt or 0), 0, 0)
	bevel(r, Hd, V(o.Brim or 2.1, 0.12, o.Brim or 2.1), CF(0, y, 0) * tilt, color, o.Edge or false, M.Fabric)
	bevel(r, Hd, V(w, hgt, w), CF(0, y + hgt / 2, 0) * tilt, color, o.Edge or false, M.Fabric)
	if band then
		r:Box(Hd, V(w + 0.04, 0.14, w + 0.04), CF(0, y + 0.12, 0) * tilt, band, M.Fabric)
	end
end

-- Ворона сидит на limb в точке cf (клюв в -Z cf)
function Parts.crow(r, limb, cf, s, eye)
	bevel(r, limb, V(0.36, 0.34, 0.6) * s, cf * CF(0, 0.17 * s, 0), HW.Black, rgb(60, 54, 70), M.Plastic)
	r:Box(limb, V(0.3, 0.28, 0.3) * s, cf * CF(0, 0.42 * s, -0.3 * s), HW.Black, M.Plastic)
	spike(r, limb, cf * V(0, 0.4 * s, -0.44 * s), cf * V(0, 0.36 * s, -0.72 * s), 0.14 * s, rgb(70, 60, 50), M.Plastic, true, 0.06)
	for _, x in ipairs(SIDES) do
		r:Neon(limb, V(0.04, 0.06, 0.06) * s, cf * CF(0.15 * s * x, 0.47 * s, -0.38 * s), eye or HW.Orange)
		r:Wedge(limb, V(0.06, 0.24, 0.5) * s, cf * CF(0.2 * s * x, 0.24 * s, 0.05 * s), rgb(30, 26, 38), M.Plastic)
	end
	spike(r, limb, cf * V(0, 0.2 * s, 0.28 * s), cf * V(0, 0.12 * s, 0.62 * s), 0.26 * s, HW.Black, M.Plastic, true, 0.05)
end

-- Пятиконечная звезда (значок шерифа) в плоскости XY
function Parts.star(r, limb, cf, s, color)
	for k = 0, 4 do
		tri(r, limb, cf * ANG(0, 0, k * 2 * PI / 5) * CF(0, 0.18 * s, 0), 0.22 * s, 0.32 * s, color, M.Metal, 0.05)
	end
	r:Box(limb, V(0.2, 0.2, 0.06) * s, cf * ANG(0, 0, rad(45)), color, M.Metal)
end

function Parts.flask(r, limb, cf, s, liquid)
	local glass = rgb(180, 220, 200)
	r:Box(limb, V(0.36, 0.42, 0.36) * s, cf, glass, M.Glass, { Transparency = 0.5 })
	local l = r:Neon(limb, V(0.3, 0.26, 0.3) * s, cf * CF(0, -0.06 * s, 0), liquid)
	r:Box(limb, V(0.14, 0.2, 0.14) * s, cf * CF(0, 0.3 * s, 0), glass, M.Glass, { Transparency = 0.5 })
	r:Box(limb, V(0.12, 0.08, 0.12) * s, cf * CF(0, 0.43 * s, 0), HW.Wood, M.Wood)
	return l
end

-- Колокол из уступов: cf — точка подвеса, колокол висит вниз; возвращает светящийся язычок
function Parts.bell(r, limb, cf, s, color, rim, glow)
	bevel(r, limb, V(0.3, 0.2, 0.3) * s, cf * CF(0, -0.1 * s, 0), color, false)
	bevel(r, limb, V(0.55, 0.3, 0.55) * s, cf * CF(0, -0.32 * s, 0), color, rim)
	bevel(r, limb, V(0.72, 0.34, 0.72) * s, cf * CF(0, -0.62 * s, 0), color, rim)
	bevel(r, limb, V(0.95, 0.18, 0.95) * s, cf * CF(0, -0.86 * s, 0), rim, false)
	r:Box(limb, V(0.5, 0.1, 0.5) * s, cf * CF(0, -0.96 * s, 0), rgb(10, 8, 14), M.Plastic)
	return r:Neon(limb, V(0.2, 0.2, 0.2) * s, cf * CF(0, -1.04 * s, 0) * ANG(rad(45), 0, rad(45)), glow)
end

function Parts.card(r, limb, cf, s, suit, back)
	r:Box(limb, V(0.42, 0.6, 0.03) * s, cf, back and HW.Purple or rgb(236, 232, 240), M.Plastic)
	if back then
		r:Neon(limb, V(0.18, 0.18, 0.035) * s, cf * ANG(0, 0, rad(45)), HW.Violet)
	else
		r:Box(limb, V(0.14, 0.14, 0.035) * s, cf * ANG(0, 0, rad(45)), suit, M.Plastic)
	end
end

function Parts.thread(r, limb, a, b, color, d)
	return r:Seg(limb, a, b, d or 0.035, color, M.Neon)
end

function Parts.embers(r, part, color, rate, size)
	return r:Sparkles(part, color, { Rate = rate or 8, Up = 3, Size = size or 0.25, LifeMin = 0.5, LifeMax = 1.1 })
end

return Parts
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX32E739BF70238E1540BC550858CBB2DC">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Net
-- Имена сетевых объектов и протокол. Сервер создаёт папку VoidTD.Remotes (Net.Setup),
-- клиент и сервер получают её через Net.Remotes().
--
-- Протокол (не менять — клиент и сервер читают одинаково):
--   EnemySpawn  { id, typeId, maxHp, speed, lateral, dist [, hp] }
--   Sync        { T, E = {id, dist, hp, flag, ...}, DMG = {{id, amount, flag}}, RM = {{id, reason}},
--                 AL = {id, dist, hp, allyIndex (Config.AllyOrder), maxHp, ...} | nil, RA = {{id, reason}} | nil }
--   Attack      { U, T = {enemyIds}, L, D, AB, EC, PW, TR, TRS, SG, TT, I, E, SP, ST }
--   Impact      { K, P, R, L, U, N, DUR, DL, I, A, S, G, E, F, H }
--   Notify      { Type = Toast|WaveStart|WaveClear|BossDown|CoreHit|Victory|Defeat|Fade|Purchase|Reset, ... }
--   Profile     { Gems, Inventory, Equipped ("1".."6"), Stats, Settings, DailyReadyAt, HalloweenCoins, Runes, RuneSlots }
--   Request     RemoteFunction (action, data) -> ok, resultOrError

local Net = {}

Net.FolderName = "Remotes"

-- RemoteEvent'ы (порядок создания как в legacy)
Net.Events = { "EnemySpawn", "Sync", "Attack", "Impact", "Notify", "Profile" }

-- RemoteFunction для запросов клиента
Net.Function = "Request"

-- действия запроса Request(action, data)
Net.Actions = {
	"GetProfile", "GetEnemies", "Place", "Upgrade", "Sell", "SetTarget", "JoinMatch", "LeaveMatch", "GetMatchInfo",
	"SetLite", "ClaimDaily", "BuyGems", "StartWave", "Summon", "Equip", "EquipRune", "Teleport",
	"QueueDifficulty", "QueueStart", "QueueLeave",
}

Net.ActionSet = {}
for _, name in ipairs(Net.Actions) do
	Net.ActionSet[name] = true
end

-- флаг врага в Sync.E
Net.EnemyFlag = { Normal = 0, Slowed = 1, Frozen = 2 }
-- флаг урона в Sync.DMG
Net.DamageFlag = { Normal = 0, Crit = 1, Dodge = 2 }

-- причины удаления врага (Sync.RM) и союзника (Sync.RA)
Net.RemoveReasons = { "kill", "core", "clear" }
Net.AllyRemoveReasons = { "dead", "portal", "sold", "replaced", "clear" }

local function shared()
	return game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
end

function Net.IsAction(name)
	return type(name) == "string" and Net.ActionSet[name] == true
end

-- Сервер: создать (или переиспользовать) папку Remotes со всеми событиями и функцией.
-- Существующие объекты не пересоздаются, чтобы клиент не схватил устаревшую копию.
function Net.Setup()
	local root = shared()
	local folder = root:FindFirstChild(Net.FolderName)
	if folder and not folder:IsA("Folder") then
		folder:Destroy()
		folder = nil
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Net.FolderName
		folder.Parent = root
	end
	local function ensure(name, class)
		local obj = folder:FindFirstChild(name)
		if obj and not obj:IsA(class) then
			obj:Destroy()
			obj = nil
		end
		if not obj then
			obj = Instance.new(class)
			obj.Name = name
			obj.Parent = folder
		end
		return obj
	end
	for _, name in ipairs(Net.Events) do
		ensure(name, "RemoteEvent")
	end
	ensure(Net.Function, "RemoteFunction")
	return folder
end

-- Клиент/сервер: папка Remotes. Дожидается всех событий и функции,
-- поэтому дальше можно обращаться напрямую: Remotes.Sync, Remotes.Request.
function Net.Remotes()
	local folder = shared():WaitForChild(Net.FolderName)
	for _, name in ipairs(Net.Events) do
		folder:WaitForChild(name)
	end
	folder:WaitForChild(Net.Function)
	return folder
end

-- Один объект по имени ("Sync", "Request", ...)
function Net.Get(name)
	return Net.Remotes():WaitForChild(name)
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7A61E9F0D5EC819792B32B7E82ADE227">
				<Properties>
					<string name="Name">Path</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Path
-- Общая математика дороги. Сервер и клиент считают позиции врагов одинаково.
--
-- Активная дорога (одна на процесс) переключается через Path.SetMap(key); функции модуля
-- (PositionAt, DistanceToPath, IsPlacementClear, ...) всегда работают с активной картой.
-- Path.Get(key) отдаёт дорогу любой карты с теми же функциями — без переключения активной
-- (удобно строителям мира и проверкам).
--
-- Точки дороги в Config — (X, Z) от Center карты (у Void Center = 0,60,0, так что это мировые
-- координаты). Высота точек — GroundY.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Path = {}

local EDGE_MARGIN = 3       -- отступ от края острова при установке
local END_CLEARANCE = 14    -- нельзя ставить ближе к порталу / ядру
local FALLBACK_DIR = Vector3.new(0, 0, -1)

local roads = {}            -- таблица карты -> дорога (кэш)
local active                -- активная дорога

local sqrt = math.sqrt

local function flatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return sqrt(dx * dx + dz * dz)
end

------------------------------------------------------------------------
-- Математика одной дороги
------------------------------------------------------------------------

-- Позиция и направление на расстоянии d от начала дороги
local function positionAt(road, d)
	local points, cum, dirs = road.Points, road.Cumulative, road.Dirs
	local n = #points
	if d <= 0 then
		return points[1], dirs[2]
	end
	if d >= road.Length then
		return points[n], dirs[n]
	end
	for i = 2, n do
		if d <= cum[i] then
			-- отрезок нулевой длины сюда не попадает: d <= cum[i-1] сработало бы раньше
			local alpha = (d - cum[i - 1]) / (cum[i] - cum[i - 1])
			return points[i - 1] + road.Segs[i] * alpha, dirs[i]
		end
	end
	-- d = NaN: как в legacy — конец дороги
	return points[n], dirs[n]
end

-- Позиция с боковым смещением (чтобы враги не шли одной ниткой). right = (-dir.Z, 0, dir.X)
local function offsetPositionAt(road, d, lateral)
	local pos, dir = positionAt(road, d)
	if lateral and lateral ~= 0 then
		pos = pos + Vector3.new(-dir.Z, 0, dir.X) * lateral
	end
	return pos, dir
end

-- Горизонтальное расстояние от точки до ближайшего участка дороги
local function distanceToPath(road, pos)
	local best = math.huge
	local px, pz = pos.X, pos.Z
	local ax, az, abx, abz, lenSq = road.AX, road.AZ, road.ABX, road.ABZ, road.LenSq
	for i = 2, #road.Points do
		local t = 0
		local l = lenSq[i]
		if l > 0 then
			t = math.clamp(((px - ax[i]) * abx[i] + (pz - az[i]) * abz[i]) / l, 0, 1)
		end
		local dx = px - (ax[i] + abx[i] * t)
		local dz = pz - (az[i] + abz[i] * t)
		local d = sqrt(dx * dx + dz * dz)
		if d < best then
			best = d
		end
	end
	return best
end

-- Доля пройденного пути (без зажима: 0..1 внутри дороги)
local function fraction(road, d)
	if road.Length <= 0 then return 0 end
	return d / road.Length
end

-- Проверка позиции для установки (клиент — для превью, сервер — для проверки).
-- Не проверяет высоту, расстояние до других юнитов, деньги и лимиты.
local function isPlacementClear(road, pos)
	local map = road.Map
	local s = Config.Settings
	if distanceToPath(road, pos) < map.PathWidth / 2 + s.PathClearance then
		return false, "Нельзя ставить на дорогу"
	end
	local size = map.IslandSize -- Vector2: Y — размер по мировой оси Z
	local c = road.Center
	if math.abs(pos.X - c.X) > size.X / 2 - EDGE_MARGIN or math.abs(pos.Z - c.Z) > size.Y / 2 - EDGE_MARGIN then
		return false, "Слишком близко к краю"
	end
	local points = road.Points
	if flatDistance(pos, points[1]) < END_CLEARANCE then
		return false, "Слишком близко к порталу"
	end
	if flatDistance(pos, points[#points]) < END_CLEARANCE then
		return false, "Слишком близко к ядру"
	end
	return true
end

------------------------------------------------------------------------
-- Сборка дороги из конфига карты
------------------------------------------------------------------------
local function build(key, map)
	assert(type(map) == "table" and type(map.Path) == "table", "[Path] у карты нет Path: " .. tostring(key))
	assert(#map.Path >= 2, "[Path] в дороге меньше 2 точек: " .. tostring(key))
	local c = map.Center or Vector3.new()
	local y = map.GroundY or c.Y

	local road = {
		MapKey = key,
		Map = map,
		Center = c,
		Points = {},
		Cumulative = { 0 },
		Segs = {},
		Dirs = {},
		AX = {}, AZ = {}, ABX = {}, ABZ = {}, LenSq = {},
	}
	local points = road.Points
	for i, p in ipairs(map.Path) do
		points[i] = Vector3.new(c.X + p[1], y, c.Z + p[2])
	end

	local n = #points
	for i = 2, n do
		local a, b = points[i - 1], points[i]
		local seg = b - a
		local len = seg.Magnitude
		road.Segs[i] = seg
		road.Cumulative[i] = road.Cumulative[i - 1] + len
		road.Dirs[i] = len > 0 and seg.Unit or nil
		road.AX[i], road.AZ[i] = a.X, a.Z
		road.ABX[i], road.ABZ[i] = b.X - a.X, b.Z - a.Z
		road.LenSq[i] = road.ABX[i] * road.ABX[i] + road.ABZ[i] * road.ABZ[i]
	end
	-- у отрезков нулевой длины направление берём от соседей (без NaN)
	local last = nil
	for i = 2, n do
		if road.Dirs[i] then last = road.Dirs[i] elseif last then road.Dirs[i] = last end
	end
	local nextDir = nil
	for i = n, 2, -1 do
		if road.Dirs[i] then nextDir = road.Dirs[i] else road.Dirs[i] = nextDir or FALLBACK_DIR end
	end
	road.Length = road.Cumulative[n]

	-- функции дороги (вызов через точку, как у модуля)
	road.PositionAt = function(d) return positionAt(road, d) end
	road.OffsetPositionAt = function(d, lateral) return offsetPositionAt(road, d, lateral) end
	road.DistanceToPath = function(pos) return distanceToPath(road, pos) end
	road.Fraction = function(d) return fraction(road, d) end
	road.IsPlacementClear = function(pos) return isPlacementClear(road, pos) end
	road.FlatDistance = flatDistance
	return road
end

local function resolve(key)
	local maps = Config.Maps
	local map = (maps and key ~= nil and maps[key]) or Config.Map
	return map.Key or "Void", map
end

------------------------------------------------------------------------
-- API модуля
------------------------------------------------------------------------

-- Дорога карты key (неизвестный ключ — Void). Активную карту не меняет.
function Path.Get(key)
	local k, map = resolve(key)
	local road = roads[map]
	if not road then
		road = build(k, map)
		roads[map] = road
	end
	return road
end

-- Сделать карту активной (Void / Halloween). Сервер и клиент вызывают при смене карты.
function Path.SetMap(key)
	active = Path.Get(key)
	Path.Road = active
	Path.Points = active.Points
	Path.Length = active.Length
	Path.MapKey = active.MapKey
	Path.Map = active.Map
	return active
end

function Path.Fraction(d)
	return fraction(active, d)
end

function Path.PositionAt(d)
	return positionAt(active, d)
end

function Path.OffsetPositionAt(d, lateral)
	return offsetPositionAt(active, d, lateral)
end

function Path.DistanceToPath(pos)
	return distanceToPath(active, pos)
end

function Path.FlatDistance(a, b)
	return flatDistance(a, b)
end

function Path.IsPlacementClear(pos)
	return isPlacementClear(active, pos)
end

Path.SetMap("Void")

return Path
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX336E2317306E95824ABF1B85472DC665">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Util
-- Мелкие общие помощники (без состояния). Сервер и клиент.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Util = {}

-- Та же функция, что и Config.FormatNumber: 1234 -> "1,234", 15000 -> "15.0K", 1500000 -> "1.5M"
Util.FormatNumber = Config.FormatNumber

------------------------------------------------------------------------
-- Таблицы
------------------------------------------------------------------------

-- Глубокая копия простых таблиц. Таблицы с метатаблицей и значения Roblox
-- (Vector3, Color3, ...) копируются ссылкой. Циклы и общие подтаблицы сохраняются.
function Util.DeepCopy(t, seen)
	if type(t) ~= "table" or getmetatable(t) ~= nil then
		return t
	end
	seen = seen or {}
	if seen[t] then
		return seen[t]
	end
	local copy = {}
	seen[t] = copy
	for k, v in pairs(t) do
		copy[Util.DeepCopy(k, seen)] = Util.DeepCopy(v, seen)
	end
	return copy
end

function Util.ShallowCopy(t)
	local copy = {}
	for k, v in pairs(t) do
		copy[k] = v
	end
	return copy
end

-- Число ключей в словаре
function Util.Count(t)
	local n = 0
	for _ in pairs(t) do
		n = n + 1
	end
	return n
end

-- Индекс значения в массиве (или nil)
function Util.IndexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

------------------------------------------------------------------------
-- Случайность
------------------------------------------------------------------------

local function rand01(rng)
	if rng == nil then
		return math.random()
	elseif type(rng) == "function" then
		return rng()
	end
	return rng:NextNumber()
end

local function weightOf(entry, weightKey)
	local w
	if type(weightKey) == "function" then
		w = weightKey(entry)
	elseif weightKey ~= nil then
		w = entry[weightKey]
	else
		w = entry
	end
	w = tonumber(w) or 0
	if w ~= w or w < 0 then w = 0 end
	return w
end

-- Взвешенный выбор: roll = roll01 * сумма весов, первый элемент с roll < накопленной суммы.
-- weightKey — имя поля ("Rate"), функция entry -> вес или nil (элементы — сами числа).
-- roll01 — число 0..1 (по умолчанию math.random()). Возвращает entry, index (nil для пустого списка).
function Util.WeightedPick(list, weightKey, roll01)
	local total = 0
	local lastIndex = nil
	for i, entry in ipairs(list) do
		local w = weightOf(entry, weightKey)
		total = total + w
		if w > 0 then lastIndex = i end
	end
	if not lastIndex then
		return nil, nil
	end
	local roll = (roll01 or math.random()) * total
	local acc = 0
	for i, entry in ipairs(list) do
		acc = acc + weightOf(entry, weightKey)
		if roll < acc then
			return entry, i
		end
	end
	-- roll01 >= 1 или погрешность суммы — последний элемент с весом
	return list[lastIndex], lastIndex
end

-- Перемешать массив на месте (Фишер — Йетс). rng — Random, функция 0..1 или nil.
function Util.Shuffle(list, rng)
	for i = #list, 2, -1 do
		local j = math.min(i, math.floor(rand01(rng) * i) + 1)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Случайный элемент массива (nil для пустого)
function Util.Pick(list, rng)
	local n = #list
	if n == 0 then return nil end
	return list[math.min(n, math.floor(rand01(rng) * n) + 1)]
end

------------------------------------------------------------------------
-- Числа и проверки (для валидации аргументов клиента)
------------------------------------------------------------------------

-- Конечное число (не NaN и не ±inf)
function Util.IsFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Vector3 с конечными координатами
function Util.IsFiniteVector3(v)
	return typeof(v) == "Vector3" and Util.IsFinite(v.X) and Util.IsFinite(v.Y) and Util.IsFinite(v.Z)
end

-- Целое число в диапазоне [lo, hi]
function Util.IsIntInRange(n, lo, hi)
	return Util.IsFinite(n) and n % 1 == 0 and n >= lo and n <= hi
end

function Util.Round(n, step)
	step = step or 1
	return math.floor(n / step + 0.5) * step
end

function Util.Lerp(a, b, t)
	return a + (b - a) * t
end

-- Горизонтальное расстояние (XZ)
function Util.FlatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Цвет -> "#rrggbb" (для RichText <font color>)
function Util.ColorHex(c)
	return string.format("#%02x%02x%02x",
		math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),
		math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),
		math.clamp(math.floor(c.B * 255 + 0.5), 0, 255))
end

return Util
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX70F93E12E8103C04149FB4F6115592D8">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
	</Item>
	<Item class="StarterPlayer" referent="RBX6608B3506A23002BFA3FC182FAB89A06">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX0E8379FC9437CE022ED61BE62F36879A">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX77611F322CF069DE6E42019D76913304">
				<Properties>
					<string name="Name">VoidTDClient</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX6A51EA28B4810D72F750D7E2F60C1B1B">
					<Properties>
						<string name="Name">Anims</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Anims (клиент)
-- Анимации юнитов ключевыми кадрами (углы в градусах) и вторичное движение (дыхание, крылья,
-- шея, плащи, орбиты, шестерёнки). Те же позы и тайминги, что в легаси Renderer + HalloweenAnims.
--
-- ФОРМАТ КЛИПА
--   Anims.Clips[name](h, hits, interval) -> frames
--   frames = { { time, { Joint = { xDeg, yDeg, zDeg [, dy] } } }, ... }, время по возрастанию,
--   первый кадр {0, {}}, последний обычно {T, {}} (возврат в idle). Клип заканчивается, когда
--   прошло >= времени последнего кадра. Сустав, которого нет в кадре, берётся из rig.Idle
--   (а если и там нет — {0,0,0,0}). Суставы: RS LS Neck Root WingR WingL; у Root 4-е число —
--   смещение по вертикали (в studs, умножается на rig.Scale).
--   h = HitDelay (момент удара). Способности (TimeBreak, LanternBeam, ...) h игнорируют.
--
-- API
--   Anims.Clips[name]                         -- все клипы (атаки, способности, разминки, PowerUp/Land/Cheer)
--   Anims.Fidgets[attackAnim] = { names }     -- разминки в простое по def.Anim юнита
--   Anims.Has(name) -> bool
--   Anims.FidgetsFor(attackAnim) -> { names } -- список или { "LookAround" }
--   Anims.PickFidget(attackAnim) -> name      -- случайная разминка (math.random)
--   Anims.Play(state, name, h, hits, interval [, start]) -> bool
--        state.Anim = { Start = start or os.clock(), Frames = clip(h, hits, interval), Name = name }
--   Anims.PlayFidget(state, attackAnim [, start]) -> name
--   Anims.Stop(state)                         -- state.Anim = nil
--   Anims.IsPlaying(state) -> bool
--   Anims.Eval(state, t) -> pose              -- state = { Rig, Anim = {Start, Frames}, Phase };
--        по окончании клипа сбрасывает state.Anim = nil и возвращает rig.Idle.
--        Возвращаемая поза — переиспользуемый буфер state.PoseBuf (валиден до следующего Eval).
--   Anims.Apply(rig, pose, t, phase)          -- пишет motor.C0 всех моторов rig.Motors (от rig.Base):
--        Root: dy*Scale + дыхание; RS/LS: дыхание; Wing*: взмахи; Neck: покачивание;
--        Cape/Scarf/Cape2: колыхание + порыв rig.Gust; Orbit*: вращение по Y;
--        rig.SpinRates[motor] (рад/с, Clock*/Gear*): накопленный угол по Z, ×3 при rig.Storm,
--        ×6 пока os.clock() < rig.SpinBoostUntil. Пишет rig.SpinT, rig.SpinAngle.
--   Anims.Step(state, t)                      -- Apply(state.Rig, Eval(state, t), t, state.Phase or 0)
--   Anims.Register(name, builder [, fidgets]) -- добавить/заменить клип
--   Anims.Ease(a)                             -- smoothstep a*a*(3-2a)
--   t — os.clock() (тот же источник времени, что Start и SpinBoostUntil).
--   Для совместимости Anims[name] тоже отдаёт клип (Anims.Slash == Anims.Clips.Slash).

local Anims = {}
local Clips = {}
local Fidgets = {}
Anims.Clips = Clips
Anims.Fidgets = Fidgets

local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local sin = math.sin
local clamp = math.clamp

local EMPTY = {}
local ZERO = { 0, 0, 0, 0 }
local DEFAULT_FIDGETS = { "LookAround" }

------------------------------------------------------------------------
-- АТАКИ (h = HitDelay)
------------------------------------------------------------------------
function Clips.Slash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.75, { RS = { 150, 0, 12 }, Root = { 0, -15, 0 } } },
		{ h, { RS = { 25, 0, -12 }, LS = { -20, 0, 0 }, Root = { 4, 15, 0 } } },
		{ h + 0.2, { RS = { 15, 0, -5 } } },
		{ h + 0.5, {} },
	}
end

function Clips.HeavySlash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.8, { RS = { 168, 0, 15 }, LS = { 40, 0, -10 }, Root = { -8, -22, 0 } } },
		{ h, { RS = { 18, 0, -15 }, LS = { 30, 0, 0 }, Root = { 12, 20, 0, -0.15 } } },
		{ h + 0.3, { RS = { 15, 0, -5 }, Root = { 6, 10, 0 } } },
		{ h + 0.65, {} },
	}
end

function Clips.Bow(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.6, { LS = { 90, 0, 0 }, RS = { 90, 0, -30 }, Root = { 0, -20, 0 } } },
		{ h, { LS = { 90, 0, 0 }, RS = { 75, 0, -65 }, Root = { 0, -20, 0 } } },
		{ h + 0.06, { LS = { 92, 0, 0 }, RS = { 95, 0, -15 }, Root = { 0, -20, 0 } } },
		{ h + 0.45, {} },
	}
end

function Clips.Cast(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 145, 0, 0 }, LS = { 30, 0, -20 }, Neck = { 12, 0, 0 } } },
		{ h, { RS = { 90, 0, 0 }, LS = { 55, 0, -25 } } },
		{ h + 0.45, {} },
	}
end

function Clips.Gun(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h, { RS = { 92, 0, 0 }, LS = { 88, 0, -30 } } },
		{ h + 0.05, { RS = { 104, 0, 0 }, LS = { 98, 0, -30 }, Root = { -5, 0, 0 } } },
		{ h + 0.18, { RS = { 92, 0, 0 }, LS = { 88, 0, -30 } } },
		{ h + 0.5, {} },
	}
end

function Clips.Reap(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 60, 0, 25 }, LS = { 50, 0, -10 }, Root = { 0, -70, 0 } } },
		{ h, { RS = { 75, 0, -15 }, LS = { 65, 0, 10 }, Root = { 6, 80, 0 } } },
		{ h + 0.25, { RS = { 60, 0, -10 }, Root = { 3, 60, 0 } } },
		{ h + 0.65, {} },
	}
end

-- серия ударов: каждый следующий — в обратную сторону
function Clips.Katana(h, hits, interval)
	h = h or 0.2
	hits = math.max(1, math.floor(hits or 1))
	interval = interval or 0.16
	local k = { { 0, {} }, { h * 0.7, { RS = { 125, 0, 40 }, Root = { 0, -25, 0 } } } }
	for i = 1, hits do
		local t = h + (i - 1) * interval
		local dir = (i % 2 == 1) and 1 or -1
		k[#k + 1] = { t, { RS = { 45, 0, -50 * dir }, Root = { 4, 30 * dir, 0 } } }
		if i < hits then
			k[#k + 1] = { t + interval * 0.6, { RS = { 120, 0, 40 * -dir }, Root = { 0, -20 * dir, 0 } } }
		end
	end
	local last = h + (hits - 1) * interval
	k[#k + 1] = { last + 0.15, { RS = { 30, 0, -30 } } }
	k[#k + 1] = { last + 0.4, {} }
	return k
end

function Clips.Slam(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.65, { RS = { 172, 0, 10 }, LS = { 165, 0, -10 }, Root = { -10, 0, 0, 0.15 }, Neck = { -10, 0, 0 } } },
		{ h, { RS = { 55, 0, 0 }, LS = { 50, 0, 0 }, Root = { 16, 0, 0, -0.45 } } },
		{ h + 0.35, { RS = { 48, 0, 0 }, LS = { 45, 0, 0 }, Root = { 12, 0, 0, -0.35 } } },
		{ h + 0.85, {} },
	}
end

function Clips.Beam(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.6, { RS = { 55, 0, 0 }, Root = { -6, 0, 0 }, WingR = { 0, 25, 0 }, WingL = { 0, -25, 0 } } },
		{ h, { RS = { 96, 0, 0 }, LS = { 60, 0, -20 }, Root = { 4, 0, 0 }, WingR = { 0, -15, 10 }, WingL = { 0, 15, -10 } } },
		{ h + 0.45, { RS = { 94, 0, 0 }, LS = { 55, 0, -20 } } },
		{ h + 0.85, {} },
	}
end

-- рука держится поднятой, пока идут все удары серии
function Clips.Judgement(h, hits, interval)
	h = h or 0.2
	local hold = h + math.max(0, hits or 3) * (interval or 0.18)
	return {
		{ 0, {} },
		{ h * 0.8, { RS = { 178, 0, 5 }, LS = { 35, 0, -35 }, Neck = { 18, 0, 0 }, Root = { -6, 0, 0, 0.2 } } },
		{ hold, { RS = { 172, 0, 5 }, LS = { 40, 0, -40 }, Neck = { 15, 0, 0 }, Root = { -4, 0, 0, 0.2 } } },
		{ hold + 0.2, { RS = { 40, 0, -10 }, Root = { 10, 0, 0 } } },
		{ hold + 0.6, {} },
	}
end

function Clips.Smash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 160, 0, 10 }, Root = { -8, -18, 0 } } },
		{ h, { RS = { 40, 0, -10 }, LS = { 30, 0, 0 }, Root = { 14, 18, 0, -0.3 } } },
		{ h + 0.45, {} },
	}
end

function Clips.BlackHoleCast(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 150, 0, 30 }, LS = { 150, 0, -30 }, Neck = { 25, 0, 0 }, Root = { -8, 0, 0, 0.2 } } },
		{ h, { RS = { 110, 0, 40 }, LS = { 110, 0, -40 }, Root = { 6, 0, 0 } } },
		{ h + 0.5, {} },
	}
end

function Clips.DualDagger(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.6, { RS = { 110, 0, 20 }, LS = { 40, 0, -10 }, Root = { 0, -20, 0 } } },
		{ h, { RS = { 60, 0, -20 }, LS = { 100, 0, -20 }, Root = { 4, 20, 0 } } },
		{ h + 0.12, { RS = { 75, 0, 0 }, LS = { 70, 0, 0 } } },
		{ h + 0.3, {} },
	}
end

function Clips.Crossbow(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h, { RS = { 88, 0, 0 }, LS = { 82, 0, -28 }, Neck = { 6, 0, 0 } } },
		{ h + 0.06, { RS = { 105, 0, 0 }, LS = { 96, 0, -28 }, Root = { -6, 0, 0 } } },
		{ h + 0.3, { RS = { 88, 0, 0 }, LS = { 82, 0, -28 } } },
		{ h + 0.6, {} },
	}
end

function Clips.Puppet(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 85, 0, 35 }, LS = { 85, 0, -35 }, Neck = { 10, 0, 0 } } },
		{ h, { RS = { 105, 0, 12 }, LS = { 105, 0, -12 } } },
		{ h + 0.15, { RS = { 90, 0, 28 }, LS = { 90, 0, -28 } } },
		{ h + 0.5, {} },
	}
end

-- Проклятый Часовщик: замах Хроносекирой из-за плеча и горизонтальный взмах
function Clips.ChronoSlash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.75, { RS = { 160, 0, 35 }, LS = { 40, 0, -20 }, Root = { -4, -28, 0 } } },
		{ h, { RS = { 70, 0, -70 }, LS = { 20, 0, -10 }, Root = { 6, 32, 0, -0.1 } } },
		{ h + 0.25, { RS = { 45, 0, -40 }, Root = { 3, 18, 0 } } },
		{ h + 0.6, {} },
	}
end

-- два выстрела: правая, затем левая рука
function Clips.Revolver(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h, { RS = { 95, 0, 0 }, LS = { 70, 0, 0 } } },
		{ h + 0.05, { RS = { 112, 0, 0 }, LS = { 70, 0, 0 }, Root = { -3, 0, 0 } } },
		{ h + 0.12, { RS = { 92, 0, 0 }, LS = { 95, 0, 0 } } },
		{ h + 0.17, { RS = { 92, 0, 0 }, LS = { 112, 0, 0 }, Root = { -3, 0, 0 } } },
		{ h + 0.45, {} },
	}
end

------------------------------------------------------------------------
-- СПОСОБНОСТИ ЧАСОВЩИКА (фиксированное время, h не нужен)
------------------------------------------------------------------------
-- Поломка времени: секира над головой, затем удар о землю
function Clips.TimeBreak()
	return {
		{ 0, {} },
		{ 0.35, { RS = { 175, 0, 5 }, LS = { 165, 0, -5 }, Neck = { -15, 0, 0 }, Root = { -8, 0, 0, 0.3 } } },
		{ 0.5, { RS = { 30, 0, 0 }, LS = { 30, 0, 0 }, Neck = { 15, 0, 0 }, Root = { 20, 0, 0, -0.45 } } },
		{ 0.95, { RS = { 30, 0, 0 }, LS = { 30, 0, 0 }, Root = { 16, 0, 0, -0.4 } } },
		{ 1.35, {} },
	}
end

-- Ускорение времени: секира вертикально вверх
function Clips.TimeHaste()
	return {
		{ 0, {} },
		{ 0.4, { RS = { 178, 0, 0 }, Neck = { -18, 0, 0 }, Root = { 0, 0, 0, 0.25 } } },
		{ 1.1, { RS = { 178, 0, 0 }, Neck = { -18, 0, 0 }, Root = { 0, 0, 0, 0.25 } } },
		{ 1.5, {} },
	}
end

-- Временная буря: медленный подъём, вспышка, удар о землю
function Clips.TimeStorm()
	return {
		{ 0, {} },
		{ 0.9, { RS = { 172, 0, 10 }, LS = { 150, 0, -15 }, Neck = { -22, 0, 0 }, Root = { -8, 0, 0, 0.4 } } },
		{ 1.15, { RS = { 176, 0, 10 }, LS = { 155, 0, -15 }, Neck = { -24, 0, 0 }, Root = { -9, 0, 0, 0.45 } } },
		{ 1.3, { RS = { 25, 0, 0 }, LS = { 25, 0, 0 }, Neck = { 18, 0, 0 }, Root = { 22, 0, 0, -0.55 } } },
		{ 1.8, { RS = { 25, 0, 0 }, LS = { 25, 0, 0 }, Root = { 15, 0, 0, -0.4 } } },
		{ 2.2, {} },
	}
end

------------------------------------------------------------------------
-- ПРОСТОЙ, ПОВЫШЕНИЕ, ПРАЗДНОВАНИЕ, ПРИЗЕМЛЕНИЕ
------------------------------------------------------------------------
function Clips.LookAround()
	return { { 0, {} }, { 0.5, { Neck = { 0, 40, 0 } } }, { 1.2, { Neck = { 5, -40, 0 } } }, { 1.8, {} } }
end

-- вращение оружия: последний кадр (15, 360, 0) — тот же угол, что idle; интерполяция идёт по
-- градусам Эйлера, поэтому 0 -> 360 даёт полный оборот
function Clips.Twirl()
	return {
		{ 0, {} },
		{ 0.25, { RS = { 85, 0, 0 } } },
		{ 0.45, { RS = { 85, 120, 0 } } },
		{ 0.65, { RS = { 85, 240, 0 } } },
		{ 0.85, { RS = { 85, 360, 0 } } },
		{ 1.2, { RS = { 15, 360, 0 } } },
	}
end

function Clips.Flex()
	return {
		{ 0, {} },
