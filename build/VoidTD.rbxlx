				<Item class="ModuleScript" referent="RBX252225134A9E090BABE18ABBA7DB7B0E">
					<Properties>
						<string name="Name">FX</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: FX (клиент) — ядро эффектов
-- Только картинка и звук: урон/броски считает сервер. Эффекты способностей пишутся в детях
-- FX/Void.lua, FX/Chrono.lua, FX/Halloween.lua (каждый `return function(FX) ... end`), которые
-- подключаются в FX.Init и регистрируют свои функции (FX.Xxx / FX.Fn.Xxx / FX.RegisterImpact).
--
-- ПОЛЯ
--   FX.Lite                     -- облегчённый режим (меньше частиц/обломков), ставит ctx.SetLite
--   FX.Colors                   -- Neon Soft Pink White Red Gold Blue Orange (+ CGold Bronze Dial Dust)
--   FX.Folder                   -- workspace.VoidTD_FX (создаётся лениво / в Init)
--   FX.Env                      -- { Renderer, Config, Path, Ctx }; недостающее берётся из ctx
--   FX.Fn                       -- именованные эффекты детей (FX.Fn.GearDisc, FX.Fn.EchoGhost, ...)
--   FX.ProjectileMakers[kind]   -- function(lv) -> part, trailColor?, tipOffset? (CFrame детали "Tip"
--                                  относительно снаряда; по умолчанию CFrame.new(0, 0, -Size.Z/2))
--   FX.Rng                      -- общий Random
--
-- ИНФРАСТРУКТУРА
--   FX.Init(ctx?)                         -- папка, тряска камеры, FX.Env, дети Void/Chrono/Halloween (один раз)
--   FX.SetLite(on)
--   FX.Sound(name, volume?, pitch?, pos?) -- Config.Sounds[name] {Id, Volume, Pitch, Custom}; volume/pitch —
--        множители; pos -> затухание по расстоянию до камеры (>140 studs — тишина); троттлинг 0.07 с на имя
--   FX.Shake(mag, dur)                    -- тряски складываются по максимуму (сильная короткая не теряется)
--   FX.Tween(obj, time, goal, style=Quad, dir=Out) -> Tween
--   FX.Part(props) -> BasePart            -- Class="Part", Anchored, без коллизий/запросов/тени, Neon,
--        Color=Neon, Size=1, Shape?, Transparency=0, CFrame, Parent=FX.Folder; прочие ключи props — как свойства
--   FX.Light(parent, color, range, brightness, life?) -> PointLight (life: яркость гаснет до 0)
--   FX.Cleanup(obj, t)                    -- уничтожить через t с
--   FX.Fade(part, life, goal?)            -- твин goal + Transparency=1, уничтожить через life+0.05
--   FX.Run(fn) -> job                     -- fn(elapsed, dt, now) каждый кадр (общий RenderStepped);
--        вернуть true = закончить; job:Stop(). Ошибка в fn пишет warn и снимает задачу.
--   FX.Ground(pos) -> Vector3             -- (x, Map.GroundY + 0.15, z) активной карты
--   FX.CamFacing(pos) -> CFrame           -- в pos, лицевая сторона (-Z) смотрит на камеру (по горизонтали)
--   FX.EnemyCenter(id), FX.EnemyPosition(id), FX.UnitView(uid), FX.MuzzlePos(view) -- через FX.Env.Renderer
--
-- БАЗОВЫЕ ЭФФЕКТЫ
--   FX.Burst(pos, color=Neon, count=8, size=0.4, speed=6, life=0.45)
--   FX.Ring(pos, radius, color=Neon, life=0.5, height=0.3, startRadius=0.5, transparency=0.15) -> part
--   FX.Sphere(pos, radius, color=Neon, life, material=Neon, startT=0.1) -> part
--   FX.Arc(cf, radius, a0, a1, color=Neon, thickness=0.35, life=0.35, horizontal?)
--   FX.SlashMark(pos, angle, length, width, color=Neon, life=0.35)
--   FX.Cracks(pos, radius, color=Neon, count=8, life=1.4)        -- в Lite не рисуется
--   FX.Projectile(kind, from, getTarget, travel, onHit?, lv=1) -> part
--        getTarget() -> Vector3|nil (или сразу Vector3); встроенные kind: Arrow Orb Crystal Bullet Moon,
--        остальные (Bolt, ...) — стандартный болт; FX.ProjectileMakers[kind] имеют приоритет
--   FX.Beam(from, to, width, color=Neon, life=0.45, big?)
--   FX.Thread(from, to, color=Soft)
--   FX.Poof(pos, color=Neon, size=1)
--   FX.Place(pos) ; FX.LevelUp(pos, color=Neon) ; FX.Summon(pos, radius=6)
--   FX.DamageNumber(pos, amount, flag)    -- flag 1 крит ("N!"), 2 фаза ("PHASE"), иначе обычный
--   FX.Debris(pos, color, count, size, speed, life, material=Slate) -- куски с гравитацией до земли
--   FX.Smoke(pos, color, n, size, life, rise=2)
--   FX.Flash(pos, color, radius, life)    -- шар + вспышка света
--   FX.RuneRing(pos, r, color, life) -> { parts }
--   FX.PortalDisc(pos, r, color, life, edge=(255,235,170))
--
-- УДАРЫ (Impact)
--   FX.RegisterImpact(kind, fn(p))        -- p = payload Impact {K, P, R, L, U, ...}
--   FX.Impact(p) -> handled               -- вызывает зарегистрированный обработчик (pcall)
--   Ядро само регистрирует Smash и Summon (дети могут переопределить).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local FX = {}
FX.Lite = false
FX.Fn = {}
FX.ProjectileMakers = {}
FX.Rng = Random.new()

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local rng = FX.Rng

local NEON = Color3.fromRGB(180, 80, 255)
local SOFT = Color3.fromRGB(215, 160, 255)
local PINK = Color3.fromRGB(255, 60, 170)
local WHITE = Color3.fromRGB(250, 245, 255)
local RED = Color3.fromRGB(255, 35, 55)
local GOLD = Color3.fromRGB(255, 205, 80)
local BLUE = Color3.fromRGB(90, 180, 255)
local ORANGE = Color3.fromRGB(255, 140, 40)
local PORTAL_EDGE = Color3.fromRGB(255, 235, 170)
FX.Colors = {
	Neon = NEON, Soft = SOFT, Pink = PINK, White = WHITE, Red = RED, Gold = GOLD, Blue = BLUE, Orange = ORANGE,
	CGold = Color3.fromRGB(230, 178, 74), Bronze = Color3.fromRGB(170, 112, 52), Dial = Color3.fromRGB(16, 12, 20),
	Dust = Color3.fromRGB(70, 60, 82),
}

------------------------------------------------------------------------
-- ОКРУЖЕНИЕ (Renderer/Config/Path для эффектов, которым нужны позиции врагов)
------------------------------------------------------------------------
FX.Env = setmetatable({ Config = Config }, {
	__index = function(env, k)
		local c = rawget(env, "Ctx")
		if c and c[k] ~= nil then
			return c[k]
		end
		if k == "Path" then
			local p = require(Shared:WaitForChild("Path"))
			rawset(env, "Path", p)
			return p
		end
		-- Init без ctx: Renderer — соседний модуль Render (к моменту эффектов уже загружен)
		if k == "Renderer" then
			local mod = script.Parent and script.Parent:FindFirstChild("Render")
			if mod and mod:IsA("ModuleScript") then
				local ok, r = pcall(require, mod)
				if ok and type(r) == "table" then
					rawset(env, "Renderer", r)
					return r
				end
			end
		end
		return nil
	end,
})

local function groundY()
	local path = FX.Env.Path
	local map = path and path.Map
	return (map and map.GroundY) or (Config.Map and Config.Map.GroundY) or 0
end

function FX.Ground(pos)
	return V(pos.X, groundY() + 0.15, pos.Z)
end

-- позиции врагов/юнитов через Renderer (nil, если его ещё нет или объекта нет)
local function rend(key)
	local r = FX.Env.Renderer
	return r and r[key]
end
function FX.EnemyCenter(id) local f = rend("EnemyCenter"); return f and f(id) or nil end
function FX.EnemyPosition(id) local f = rend("EnemyPosition"); return f and f(id) or nil end
function FX.UnitView(uid) local t = rend("UnitViews"); return t and t[uid] or nil end
function FX.MuzzlePos(view) local f = rend("MuzzlePos"); return (f and view and view.Rig) and f(view) or nil end

function FX.CamFacing(pos)
	local cam = workspace.CurrentCamera
	local c = cam and cam.CFrame.Position or (pos + V(0, 10, 20))
	local flat = V(c.X, pos.Y, c.Z)
	if (flat - pos).Magnitude < 0.1 then
		return CF(pos)
	end
	return CFrame.lookAt(pos, flat)
end

------------------------------------------------------------------------
-- ИНФРАСТРУКТУРА
------------------------------------------------------------------------
local function getFolder()
	local f = FX.Folder
	if f and f.Parent then
		return f
	end
	f = workspace:FindFirstChild("VoidTD_FX")
	if not f then
		f = Instance.new("Folder")
		f.Name = "VoidTD_FX"
		f.Parent = workspace
	end
	FX.Folder = f
	return f
end

function FX.SetLite(on)
	FX.Lite = on and true or false
end

local function tween(obj, time, goal, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
FX.Tween = tween

local PART_KEYS = { Class = true, Parent = true, Shape = true, Size = true, Material = true, Color = true, Transparency = true, CFrame = true }

function FX.Part(props)
	props = props or {}
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if props.Shape and p:IsA("Part") then
		p.Shape = props.Shape
	end
	p.Material = props.Material or Enum.Material.Neon
	p.Color = props.Color or NEON
	p.Size = props.Size or V(1, 1, 1)
	p.Transparency = props.Transparency or 0
	p.CFrame = props.CFrame or CF()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if not PART_KEYS[k] then
			p[k] = v
		end
	end
	p.Parent = props.Parent or getFolder()
	return p
end

local function cleanup(obj, t)
	task.delay(t, function()
		if obj then
			obj:Destroy()
		end
	end)
end
FX.Cleanup = cleanup

local function light(parent, color, range, brightness, life)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	if life then
		tween(l, life, { Brightness = 0 })
	end
	return l
end
FX.Light = light

function FX.Fade(p, life, goal)
	goal = goal or {}
	goal.Transparency = 1
	tween(p, life, goal)
	cleanup(p, life + 0.05)
end

-- Общий покадровый цикл: одна подписка RenderStepped на все движущиеся эффекты
local jobs = {}
local stepConn

local function stopJob(job)
	job.Dead = true
end

local function stepJobs(dt)
	local now = os.clock()
	local i = 1
	while i <= #jobs do
		local job = jobs[i]
		local done = job.Dead
		if not done then
			local ok, res = pcall(job.Fn, now - job.T0, dt, now)
			if not ok then
				warn("[FX] " .. tostring(res))
				done = true
			else
				done = res == true
			end
		end
		if done then
			job.Dead = true
			jobs[i] = jobs[#jobs]
			jobs[#jobs] = nil
		else
			i += 1
		end
	end
end

function FX.Run(fn)
	local job = { Fn = fn, T0 = os.clock(), Dead = false, Stop = stopJob }
	jobs[#jobs + 1] = job
	if not stepConn then
		stepConn = RunService.RenderStepped:Connect(stepJobs)
	end
	return job
end

------------------------------------------------------------------------
-- ЗВУКИ (встроенные звуки Roblox; Custom = свой ассет)
------------------------------------------------------------------------
local lastSound = {}

function FX.Sound(name, volume, pitch, pos)
	local def = Config.Sounds and Config.Sounds[name]
	if not def then
		return
	end
	local t = os.clock()
	local last = lastSound[name]
	if last and t - last < 0.07 then
		return
	end
	volume = (volume or 1) * (def.Volume or 0.4)
	-- далёкие звуки тише
	if pos then
		local cam = workspace.CurrentCamera
		local d = cam and (cam.CFrame.Position - pos).Magnitude or 0
		if d > 140 then
			return
		end
		volume *= math.clamp(1 - d / 140, 0.15, 1)
	end
	lastSound[name] = t
	local custom = type(def.Custom) == "string" and def.Custom ~= ""
	local s = Instance.new("Sound")
	s.Name = "VoidTD_" .. tostring(name)
	s.SoundId = custom and def.Custom or (def.Id or "")
	s.Volume = volume
	s.PlaybackSpeed = (pitch or 1) * (custom and 1 or (def.Pitch or 1))
	s.Parent = SoundService
	s:Play()
	cleanup(s, 4)
end

------------------------------------------------------------------------
-- ТРЯСКА КАМЕРЫ
------------------------------------------------------------------------
-- активные тряски; сила в момент t = (Until - t) / Dur * Mag, итог — максимум
local shakes = {}
local MAX_SHAKES = 8
local shakeOffset, shakeApplied -- что добавили к камере в этом кадре (снимаем в начале следующего)

function FX.Shake(mag, dur)
	if type(mag) ~= "number" or type(dur) ~= "number" or mag <= 0 or dur <= 0 then
		return
	end
	local t = os.clock()
	for i = #shakes, 1, -1 do
		if t >= shakes[i].Until then
			table.remove(shakes, i)
		end
	end
	if #shakes >= MAX_SHAKES then
		table.remove(shakes, 1) -- самая старая
	end
	shakes[#shakes + 1] = { Until = t + dur, Dur = dur, Mag = mag }
end

local function shakeAmount(t)
	local k = 0
	for i = #shakes, 1, -1 do
		local s = shakes[i]
		if t >= s.Until then
			table.remove(shakes, i)
		else
			local v = (s.Until - t) / s.Dur * s.Mag
			if v > k then
				k = v
			end
		end
	end
	return k
end

local function sameCFrame(a, b)
	return (a.Position - b.Position).Magnitude < 1e-3 and a.LookVector:Dot(b.LookVector) > 0.99999 and a.UpVector:Dot(b.UpVector) > 0.99999
end

-- до камерных скриптов: снять прошлое смещение (иначе Scriptable-камера «уплывает»)
local function shakeUndo()
	local cam = workspace.CurrentCamera
	if shakeApplied and cam and sameCFrame(cam.CFrame, shakeApplied) then
		cam.CFrame = shakeApplied * shakeOffset:Inverse()
	end
	shakeApplied, shakeOffset = nil, nil
end

-- после камерных скриптов: добавить смещение
local function shakeApply()
	local k = shakeAmount(os.clock())
	if k <= 0 then
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local off = CF(rng:NextNumber(-k, k), rng:NextNumber(-k, k), 0) * ANG(0, 0, rng:NextNumber(-k, k) * 0.03)
	local cf = cam.CFrame * off
	cam.CFrame = cf
	shakeOffset, shakeApplied = off, cf
end

------------------------------------------------------------------------
-- БАЗОВЫЕ ЭФФЕКТЫ
------------------------------------------------------------------------
function FX.Burst(pos, color, count, size, speed, life)
	count = count or 8
	if FX.Lite then
		count = math.min(math.ceil(count / 3), 4)
	end
	size = size or 0.4
	speed = speed or 6
	life = life or 0.45
	for _ = 1, count do
		local dir = V(rng:NextNumber(-1, 1), rng:NextNumber(-0.2, 1), rng:NextNumber(-1, 1)).Unit
		local p = FX.Part({ Size = V(size, size, size), CFrame = CF(pos) * ANG(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0), Color = color or NEON })
		tween(p, life, {
			CFrame = CF(pos + dir * speed * life) * ANG(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0),
			Transparency = 1,
			Size = V(0.05, 0.05, 0.05),
		})
		cleanup(p, life + 0.05)
	end
end

-- плоское кольцо, расширяющееся по земле
function FX.Ring(pos, radius, color, life, height, startRadius, transparency)
	life = life or 0.5
	height = height or 0.3
	local r0 = startRadius or 0.5
	local p = FX.Part({
		Shape = Enum.PartType.Cylinder,
		Size = V(height, r0 * 2, r0 * 2),
		CFrame = CF(pos) * ANG(0, 0, rad(90)),
		Color = color or NEON,
		Transparency = transparency or 0.15,
	})
	tween(p, life, { Size = V(height * 0.4, radius * 2, radius * 2), Transparency = 1 })
	cleanup(p, life + 0.05)
	return p
end

function FX.Sphere(pos, radius, color, life, material, startT)
	life = life or 0.35
	local p = FX.Part({
		Shape = Enum.PartType.Ball,
		Size = V(0.5, 0.5, 0.5),
		CFrame = CF(pos),
		Color = color or NEON,
		Material = material or Enum.Material.Neon,
		Transparency = startT or 0.1,
	})
	tween(p, life, { Size = V(radius * 2, radius * 2, radius * 2), Transparency = 1 })
	cleanup(p, life + 0.05)
	return p
end

-- дуга из 9 сегментов (след оружия); horizontal — в плоскости XZ кадра cf
function FX.Arc(cf, radius, a0, a1, color, thickness, life, horizontal)
	local segs = 9
	thickness = thickness or 0.35
	life = life or 0.35
	local prev
	for i = 0, segs do
		local a = a0 + (a1 - a0) * (i / segs)
		local pt
		if horizontal then
			pt = (cf * CF(math.sin(a) * radius, 0, -math.cos(a) * radius)).Position
		else
			pt = (cf * CF(0, math.cos(a) * radius, -math.sin(a) * radius)).Position
		end
		if prev then
			local len = (pt - prev).Magnitude
			local w = thickness * (0.35 + 0.65 * math.sin(math.pi * i / segs))
			local p = FX.Part({ Size = V(w, w * 0.5, len + w), CFrame = CFrame.lookAt((pt + prev) / 2, pt), Color = color or NEON, Transparency = 0.05 })
			local delay = i / segs * 0.06
			task.delay(delay, function()
				tween(p, life, { Transparency = 1, Size = V(w * 0.2, w * 0.1, len) })
			end)
			cleanup(p, life + delay + 0.05)
		end
		prev = pt
	end
end

-- полоса-разрез с белой сердцевиной
function FX.SlashMark(pos, angle, length, width, color, life)
	life = life or 0.35
	local cf = CF(pos) * ANG(0, rng:NextNumber(0, math.pi), 0) * ANG(0, 0, angle)
	local p = FX.Part({ Size = V(width, length * 0.3, 0.12), CFrame = cf, Color = color or NEON })
	local core = FX.Part({ Size = V(width * 0.35, length * 0.3, 0.14), CFrame = cf, Color = WHITE })
	tween(p, life * 0.35, { Size = V(width, length, 0.12) }, Enum.EasingStyle.Back)
	tween(core, life * 0.35, { Size = V(width * 0.35, length, 0.14) }, Enum.EasingStyle.Back)
	task.delay(life * 0.35, function()
		tween(p, life * 0.65, { Transparency = 1, Size = V(0.05, length * 1.1, 0.05) })
		tween(core, life * 0.65, { Transparency = 1, Size = V(0.02, length * 1.1, 0.02) })
	end)
	cleanup(p, life + 0.05)
	cleanup(core, life + 0.05)
end

-- трещины в земле с ответвлениями и тёмное пятно
function FX.Cracks(pos, radius, color, count, life)
	if FX.Lite then
		return
	end
	count = count or 8
	life = life or 1.4
	for i = 1, count do
		local a = (i / count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local len = radius * rng:NextNumber(0.5, 0.95)
		local dir = V(math.cos(a), 0, math.sin(a))
		local mid = pos + dir * (len / 2 + 0.6)
		local p = FX.Part({
			Size = V(rng:NextNumber(0.25, 0.5), 0.08, len),
			CFrame = CFrame.lookAt(mid, mid + dir) * ANG(0, rng:NextNumber(-0.15, 0.15), 0),
			Color = color or NEON,
		})
		local bdir = (dir + V(-dir.Z, 0, dir.X) * rng:NextNumber(-0.8, 0.8)).Unit
		local bmid = pos + dir * len * 0.6 + bdir * len * 0.2
		local b = FX.Part({ Size = V(0.2, 0.08, len * 0.4), CFrame = CFrame.lookAt(bmid, bmid + bdir), Color = color or NEON })
		task.delay(life * 0.5, function()
			tween(p, life * 0.5, { Transparency = 1 })
			tween(b, life * 0.5, { Transparency = 1 })
		end)
		cleanup(p, life + 0.05)
		cleanup(b, life + 0.05)
	end
	local scorch = FX.Part({
		Shape = Enum.PartType.Cylinder,
		Size = V(0.06, radius * 0.9, radius * 0.9),
		CFrame = CF(pos) * ANG(0, 0, rad(90)),
		Color = Color3.fromRGB(10, 5, 15),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.3,
	})
	tween(scorch, life, { Transparency = 1 })
	cleanup(scorch, life + 0.05)
end

------------------------------------------------------------------------
-- СНАРЯДЫ И ЛУЧИ
------------------------------------------------------------------------
local function tipPart(parent, size, color)
	local tip = FX.Part({ Size = size, Color = color, Parent = parent })
	tip.Name = "Tip"
	return tip
end

-- встроенные снаряды легаси
local function builtinProjectile(kind, lv)
	if kind == "Arrow" then
		local p = FX.Part({ Size = V(0.18, 0.18, 2.2), Color = lv >= 4 and NEON or SOFT })
		tipPart(p, V(0.35, 0.35, 0.35), NEON)
		return p
	elseif kind == "Orb" then
		local s = 0.7 + lv * 0.1
		local p = FX.Part({ Shape = Enum.PartType.Ball, Size = V(s, s, s), Color = NEON })
		light(p, NEON, 8, 2)
		return p
	elseif kind == "Crystal" then
		local p = FX.Part({ Size = V(0.4, 0.4, 1.3), Color = Color3.fromRGB(110, 190, 255) })
		light(p, Color3.fromRGB(80, 170, 255), 7, 2)
		return p
	elseif kind == "Bullet" then
		return FX.Part({ Size = V(0.15, 0.15, 0.9), Color = Color3.fromRGB(255, 90, 80) })
	elseif kind == "Moon" then
		local p = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.2, 1.2, 1.2), Color = Color3.fromRGB(255, 200, 215) })
		light(p, Color3.fromRGB(255, 120, 150), 8, 2)
		return p
	end
	-- Bolt и прочие
	return FX.Part({ Size = V(0.25, 0.25, 1.4 + lv * 0.15), Color = lv >= 5 and PINK or SOFT })
end

-- getTarget() -> Vector3|nil (текущая позиция цели) или Vector3
function FX.Projectile(kind, from, getTarget, travel, onHit, lv)
	lv = lv or 1
	local p, trailColor, tipOffset
	local maker = FX.ProjectileMakers[kind]
	if maker then
		p, trailColor, tipOffset = maker(lv)
	end
	if not p then
		p = builtinProjectile(kind, lv)
	end
	local a0 = Instance.new("Attachment")
	a0.Position = V(0, 0.12, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = V(0, -0.12, 0)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(trailColor or (kind == "Orb" and NEON or SOFT))
	trail.LightEmission = 1
	trail.Lifetime = 0.18
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.WidthScale = NumberSequence.new(kind == "Orb" and 3 or 1, 0)
	trail.Parent = p

	-- деталь "Tip" (наконечник/лицо/пробка) якорная — двигаем вручную вместе со снарядом
	local tip = p:FindFirstChild("Tip")
	if tip then
		tipOffset = tipOffset or CF(0, 0, -p.Size.Z / 2)
	end
	local fixed = typeof(getTarget) == "Vector3" and getTarget or nil
	local function target()
		if fixed then
			return fixed
		end
		return getTarget and getTarget() or nil
	end
	local function place(pos, aim)
		local cf = ((aim - pos).Magnitude > 0.01) and CFrame.lookAt(pos, aim) or CF(pos)
		p.CFrame = cf
		if tip then
			tip.CFrame = cf * tipOffset
		end
	end

	local last = target() or from
	place(from, last)
	local arc = kind == "Arrow"
	local dur = math.max(travel or 0.2, 0.01)
	FX.Run(function(el)
		if not p.Parent then
			return true
		end
		local alpha = math.clamp(el / dur, 0, 1)
		local tg = target() or last
		last = tg
		local pos = from:Lerp(tg, alpha)
		if arc then
			pos += V(0, math.sin(alpha * math.pi) * 1.2, 0)
		end
		place(pos, tg)
		if alpha >= 1 then
			p:Destroy()
			if onHit then
				onHit(tg)
			end
			return true
		end
		return false
	end)
	return p
end

function FX.Beam(from, to, width, color, life, big)
	life = life or 0.45
	color = color or NEON
	local len = (to - from).Magnitude
	local cf = CFrame.lookAt((from + to) / 2, to) * ANG(0, rad(90), 0)
	local outer = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(len, width * 0.2, width * 0.2), CFrame = cf, Color = color, Transparency = 0.15 })
	local inner = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(len, width * 0.1, width * 0.1), CFrame = cf, Color = WHITE })
	tween(outer, 0.1, { Size = V(len, width, width) }, Enum.EasingStyle.Back)
	tween(inner, 0.1, { Size = V(len, width * 0.45, width * 0.45) }, Enum.EasingStyle.Back)
	light(inner, color, 16, 4, life)
	task.delay(0.12, function()
		tween(outer, life, { Size = V(len, 0.05, 0.05), Transparency = 1 })
		tween(inner, life, { Size = V(len, 0.02, 0.02), Transparency = 1 })
	end)
	cleanup(outer, life + 0.2)
	cleanup(inner, life + 0.2)
	-- кольца вдоль луча
	local rings = FX.Lite and 1 or (big and 6 or 3)
	for i = 1, rings do
		local pt = from:Lerp(to, i / (rings + 1))
		local ring = FX.Part({
			Shape = Enum.PartType.Cylinder,
			Size = V(0.15, width * 1.6, width * 1.6),
			CFrame = (((to - pt).Magnitude > 0.01) and CFrame.lookAt(pt, to) or CF(pt)) * ANG(0, rad(90), 0),
			Color = color,
			Transparency = 0.3,
		})
		tween(ring, life, { Size = V(0.05, width * 3.5, width * 3.5), Transparency = 1 })
		cleanup(ring, life + 0.05)
	end
	FX.Sphere(to, width * 1.8, color, 0.35)
	FX.Burst(to, color, big and 16 or 8, 0.5, 10)
	FX.Sphere(from, width, WHITE, 0.25)
end

-- нить от руки к цели
function FX.Thread(from, to, color)
	local len = (to - from).Magnitude
	if len < 0.1 then
		return
	end
	local p = FX.Part({ Size = V(0.08, 0.08, len), CFrame = CFrame.lookAt((from + to) / 2, to), Color = color or SOFT })
	tween(p, 0.5, { Transparency = 1, Size = V(0.02, 0.02, len) })
	cleanup(p, 0.55)
	FX.Ring(to - V(0, 1, 0), 2, color or NEON, 0.35, 0.2)
end

------------------------------------------------------------------------
-- ОБЩИЕ СОБЫТИЯ
------------------------------------------------------------------------
function FX.Summon(pos, radius)
	FX.Ring(V(pos.X, pos.Y + 0.2, pos.Z), radius or 6, NEON, 0.6, 0.4)
	FX.Burst(pos + V(0, 1, 0), NEON, 12, 0.5, 8)
end

function FX.Poof(pos, color, size)
	size = size or 1
	FX.Sphere(pos, 1.5 * size, color or NEON, 0.35)
	FX.Burst(pos, color or NEON, math.floor(6 + size * 4), 0.35 * size, 6 * size, 0.5)
end

function FX.LevelUp(pos, color)
	FX.Sound("Upgrade", 1, 1, pos)
	FX.Ring(pos + V(0, 0.2, 0), 4, color or NEON, 0.6, 0.3)
	local col = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.2, 3, 3), CFrame = CF(pos + V(0, 0.3, 0)) * ANG(0, 0, rad(90)), Color = color or NEON, Transparency = 0.2 })
	tween(col, 0.7, { CFrame = CF(pos + V(0, 7, 0)) * ANG(0, 0, rad(90)), Transparency = 1, Size = V(0.1, 4.5, 4.5) })
	cleanup(col, 0.75)
	FX.Burst(pos + V(0, 3, 0), color or SOFT, 14, 0.35, 7, 0.7)
end

function FX.Place(pos)
	FX.Sound("Place", 1, 1, pos)
	FX.Ring(pos + V(0, 0.2, 0), 3.5, SOFT, 0.45, 0.25)
	FX.Burst(pos + V(0, 0.5, 0), Color3.fromRGB(70, 60, 80), 8, 0.4, 5)
end

------------------------------------------------------------------------
-- ЦИФРЫ УРОНА
------------------------------------------------------------------------
local numberCount = 0
local NUMBER_STYLE = {
	[0] = { Suffix = "", Color = Color3.fromRGB(240, 220, 255), Size = UDim2.fromOffset(90, 30) },
	[1] = { Suffix = "!", Color = Color3.fromRGB(255, 210, 70), Size = UDim2.fromOffset(150, 50) },
	[2] = { Suffix = "", Color = Color3.fromRGB(170, 170, 200), Size = UDim2.fromOffset(80, 26) },
}

function FX.DamageNumber(pos, amount, flag)
	if numberCount > (FX.Lite and 20 or 70) then
		return
	end
	numberCount += 1
	local anchor = FX.Part({ Size = V(0.1, 0.1, 0.1), CFrame = CF(pos), Transparency = 1 })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 40)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 220
	gui.StudsOffsetWorldSpace = V(rng:NextNumber(-0.8, 0.8), 0, rng:NextNumber(-0.8, 0.8))
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(20, 0, 30)
	-- 2 = уклонение фазой, 1 = крит, иначе обычный урон
	local st = NUMBER_STYLE[flag] or NUMBER_STYLE[0]
	label.Text = flag == 2 and "PHASE" or (tostring(amount) .. st.Suffix)
	label.TextColor3 = st.Color
	gui.Size = st.Size
	label.Parent = gui
	gui.Parent = anchor
	tween(gui, 0.8, { StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + V(0, 2.5, 0) })
	task.delay(0.35, function()
		tween(label, 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	task.delay(0.85, function()
		numberCount -= 1
		anchor:Destroy()
	end)
end

------------------------------------------------------------------------
-- ОБЛОМКИ, ДЫМ, ВСПЫШКИ, РУНЫ, ПОРТАЛЫ
------------------------------------------------------------------------
-- куски с гравитацией (камни, кость, солома, щепки); не проваливаются ниже земли
function FX.Debris(pos, color, count, size, speed, life, material)
	count = count or 6
	if FX.Lite then
		count = math.min(3, count)
	end
	size = size or 0.5
	speed = speed or 8
	life = life or 0.9
	local floor = groundY()
	local pieces = {}
	for i = 1, count do
		local s = size * rng:NextNumber(0.6, 1.3)
		pieces[i] = {
			P = FX.Part({ Size = V(s, s * 0.8, s * 1.1), CFrame = CF(pos) * ANG(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0), Color = color, Material = material or Enum.Material.Slate }),
			S = s,
			Vel = V(rng:NextNumber(-1, 1), rng:NextNumber(0.6, 1.4), rng:NextNumber(-1, 1)) * speed,
			SpinX = rng:NextNumber(-8, 8),
			SpinY = rng:NextNumber(-8, 8),
		}
	end
	local fadeFrom = life * 0.6
	FX.Run(function(t)
		local over = t >= life
		for _, d in ipairs(pieces) do
			local p = d.P
			if over then
				p:Destroy()
			elseif p.Parent then
				local q = pos + d.Vel * t + V(0, -30 * t * t, 0)
				q = V(q.X, math.max(q.Y, floor + d.S * 0.4), q.Z)
				p.CFrame = CF(q) * ANG(d.SpinX * t, d.SpinY * t, 0)
				if t > fadeFrom then
					p.Transparency = (t - fadeFrom) / (life * 0.4)
				end
			end
		end
		return over
	end)
end

-- дымное облако из полупрозрачных шаров
function FX.Smoke(pos, color, n, size, life, rise)
	n = n or 3
	if FX.Lite then
		n = math.min(n, 2)
	end
	size = size or 2
	life = life or 1
	for _ = 1, n do
		local s = size * rng:NextNumber(0.7, 1.2)
		local p = FX.Part({
			Shape = Enum.PartType.Ball,
			Size = V(s, s, s),
			CFrame = CF(pos + V(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)) * size * 0.4),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.45,
		})
		FX.Fade(p, life * rng:NextNumber(0.8, 1.2), { Size = V(s, s, s) * 1.9, CFrame = p.CFrame + V(rng:NextNumber(-1, 1), rise or 2, rng:NextNumber(-1, 1)) })
	end
end

-- вспышка: шар + точечный свет
function FX.Flash(pos, color, radius, life)
	FX.Sphere(pos, radius, color, life or 0.3)
	local a = FX.Part({ Size = V(0.2, 0.2, 0.2), CFrame = CF(pos), Transparency = 1 })
	light(a, color, radius * 4, 4, life or 0.35)
	cleanup(a, (life or 0.35) + 0.05)
end

-- кольцо рун на земле: 8 знаков, крест и диск; гаснет в последние 40% жизни
function FX.RuneRing(pos, r, color, life)
	local g = FX.Ground(pos)
	local list = {}
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		list[#list + 1] = FX.Part({ Size = V(0.4, 0.06, 1.2), CFrame = CF(g + V(math.cos(a) * r, 0.05, math.sin(a) * r)) * ANG(0, -a, 0), Color = color })
	end
	for i = 0, 1 do
		list[#list + 1] = FX.Part({ Size = V(r * 1.5, 0.05, 0.22), CFrame = CF(g + V(0, 0.04, 0)) * ANG(0, i * math.pi / 2 + rad(45), 0), Color = color, Transparency = 0.3 })
	end
	list[#list + 1] = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.06, r * 2.2, r * 2.2), CFrame = CF(g) * ANG(0, 0, rad(90)), Color = color, Transparency = 0.55 })
	task.delay(life * 0.6, function()
		for _, p in ipairs(list) do
			FX.Fade(p, life * 0.4)
		end
	end)
	return list
end

-- вертикальный диск портала, повёрнутый к камере
function FX.PortalDisc(pos, r, color, life, edge)
	local cam = workspace.CurrentCamera
	local look = cam and (cam.CFrame.Position - pos) or V(0, 0, 1)
	local flat = V(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = V(0, 0, 1)
	end
	local cf = CFrame.lookAt(pos, pos + flat) * ANG(0, rad(90), 0)
	local disc = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.2, 0.2, 0.2), CFrame = cf, Color = color, Transparency = 0.2 })
	tween(disc, 0.25, { Size = V(0.2, r * 2, r * 2) }, Enum.EasingStyle.Back)
	local rim = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.15, 0.3, 0.3), CFrame = cf * CF(-0.05, 0, 0), Color = edge or PORTAL_EDGE, Transparency = 0.1 })
	tween(rim, 0.25, { Size = V(0.15, r * 2.25, r * 2.25) }, Enum.EasingStyle.Back)
	light(disc, color, r * 5, 3, life)
	task.delay(life * 0.7, function()
		FX.Fade(disc, life * 0.3, { Size = V(0.2, 0.2, 0.2) })
		FX.Fade(rim, life * 0.3, { Size = V(0.15, 0.3, 0.3) })
	end)
	return disc, rim
end

------------------------------------------------------------------------
-- РЕЕСТР УДАРОВ (Impact)
------------------------------------------------------------------------
local impacts = {}
FX.Impacts = impacts

function FX.RegisterImpact(kind, fn)
	impacts[kind] = fn
end

function FX.Impact(p)
	if type(p) ~= "table" or p.K == nil then
		return false
	end
	local fn = impacts[p.K]
	if not fn then
		return false
	end
	local ok, err = pcall(fn, p)
	if not ok then
		warn("[FX] Impact " .. tostring(p.K) .. ": " .. tostring(err))
	end
	return true
end

-- удары, которым хватает ядра (дети могут переопределить)
FX.RegisterImpact("Smash", function(p)
	local lv = p.L or 1
	local R = p.R or 6
	local g = V(p.P.X, p.P.Y + 0.2, p.P.Z)
	FX.Ring(g, R, NEON, 0.4, 0.4, 1, 0.1)
	FX.Cracks(g, R, NEON, 5 + lv, 1.0)
	FX.Burst(g + V(0, 1, 0), Color3.fromRGB(60, 50, 70), 8 + lv, 0.5, 9)
end)

FX.RegisterImpact("Summon", function(p)
	FX.Summon(p.P, p.R)
end)

------------------------------------------------------------------------
-- ИНИЦИАЛИЗАЦИЯ
------------------------------------------------------------------------
local CHILDREN = { "Void", "Chrono", "Halloween" }
local inited = false

function FX.Init(ctx)
	local env = FX.Env
	if ctx then
		rawset(env, "Ctx", ctx)
		for _, k in ipairs({ "Config", "Path", "Renderer" }) do
			if ctx[k] then
				rawset(env, k, ctx[k])
			end
		end
		if ctx.Lite ~= nil then
			FX.SetLite(ctx.Lite)
		end
	end
	getFolder()
	if inited then
		return FX
	end
	inited = true
	if RunService:IsClient() then
		RunService:BindToRenderStep("VoidTD_ShakeUndo", Enum.RenderPriority.First.Value, shakeUndo)
		RunService:BindToRenderStep("VoidTD_Shake", Enum.RenderPriority.Camera.Value + 1, shakeApply)
	end
	-- эффекты способностей
	for _, name in ipairs(CHILDREN) do
		local mod = script:FindFirstChild(name)
		if mod and mod:IsA("ModuleScript") then
			local ok, install = pcall(require, mod)
			if not ok then
				warn("[FX] " .. name .. ": " .. tostring(install))
			elseif type(install) == "function" then
				local ok2, err = pcall(install, FX)
				if not ok2 then
					warn("[FX] " .. name .. ": " .. tostring(err))
				end
			end
		end
	end
	return FX
end

-- локальный игрок (нужен эффектам, которые реагируют только на свои юниты)
FX.LocalPlayer = Players.LocalPlayer

return FX
]]></ProtectedString>
					</Properties>
					<Item class="ModuleScript" referent="RBX13511725BEB971BAC6E2AE73D7799736">
						<Properties>
							<string name="Name">Chrono</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: FX/Chrono — эффекты Проклятого Часовщика (золото, бронза, оранжевые искры)
-- Регистрирует FX.GearDisc, FX.ChronoHit, FX.TinyClock, FX.TimeBreak, FX.TimeHaste, FX.TimeStorm,
-- FX.ChronoBurst, FX.ClockPortal (+ те же в FX.Fn) и удары ChronoHit ChronoBurst TimeBreak TimeHaste TimeStorm.

return function(FX)
	local V = Vector3.new
	local CF = CFrame.new
	local ANG = CFrame.Angles
	local rad = math.rad
	local rng = FX.Rng
	local C = FX.Colors
	local CGOLD, BRONZE, ORANGE, DIAL = C.CGold, C.Bronze, C.Orange, C.Dial
	local METAL = Enum.Material.Metal
	local FLOOR = ANG(rad(-90), 0, 0)

	local function reg(name, fn)
		FX[name] = fn
		FX.Fn[name] = fn
	end

	-- набор деталей, движущихся как одно целое: { {part, offset}, ... }
	local function addRigid(set, props, offset)
		local p = FX.Part(props)
		set[#set + 1] = { p, offset or CF() }
		return p
	end

	local function placeRigid(set, cf)
		for _, it in ipairs(set) do
			it[1].CFrame = cf * it[2]
		end
	end

	local function fadeParts(list, time)
		for _, p in ipairs(list) do
			if p.Parent then
				FX.Tween(p, time, { Transparency = 1 })
			end
			FX.Cleanup(p, time + 0.05)
		end
	end

	local function fadeRigid(set, time)
		for _, it in ipairs(set) do
			if it[1].Parent then
				FX.Tween(it[1], time, { Transparency = 1 })
			end
			FX.Cleanup(it[1], time + 0.05)
		end
	end

	-- шестерня в плоскости XY: восьмиугольник из 4 брусков + 8 зубьев + ступица (последняя деталь)
	local function addGear(set, a, depth, color, hubColor, base)
		base = base or CF()
		for k = 0, 3 do
			addRigid(set, { Size = V(2 * a, 0.83 * a, depth), Color = color, Material = METAL }, base * ANG(0, 0, k * math.pi / 4))
		end
		if not FX.Lite then
			for k = 0, 7 do
				local ang = k * math.pi / 4
				addRigid(set, { Size = V(a * 0.36, a * 0.34, depth), Color = color, Material = METAL },
					base * CF(math.cos(ang) * a * 1.08, math.sin(ang) * a * 1.08, 0) * ANG(0, 0, ang))
			end
		end
		return addRigid(set, { Size = V(a * 0.45, a * 0.45, depth + 0.05), Color = hubColor or ORANGE }, base * ANG(0, 0, math.pi / 4))
	end

	-- циферблат в плоскости XY: рама, тёмный диск, 12 делений
	local function addDial(set, a, depth, transparency)
		local tr = transparency or 0
		for k = 0, 3 do
			local r = ANG(0, 0, k * math.pi / 4)
			addRigid(set, { Size = V(2 * a, 0.83 * a, depth), Color = CGOLD, Material = METAL, Transparency = tr }, r)
			addRigid(set, { Size = V(1.68 * a, 0.7 * a, depth + 0.04), Color = DIAL, Material = Enum.Material.SmoothPlastic, Transparency = tr }, r)
		end
		for k = 0, 11 do
			local ang = k * math.pi / 6
			addRigid(set, { Size = V(a * 0.06, a * (k % 3 == 0 and 0.2 or 0.11), depth + 0.08), Color = CGOLD },
				CF(math.cos(ang) * a * 0.68, math.sin(ang) * a * 0.68, 0) * ANG(0, 0, ang + math.pi / 2))
		end
	end

	-- стрелки: часовая и минутная
	local function makeHands(a, color)
		local h = FX.Part({ Size = V(a * 0.1, a * 0.45, 0.08), Color = color or CGOLD })
		local m = FX.Part({ Size = V(a * 0.06, a * 0.7, 0.08), Color = color or CGOLD })
		return h, m
	end

	local function placeHands(h, m, cf, ha, ma, a, depth)
		h.CFrame = cf * ANG(0, 0, ha) * CF(0, a * 0.2, -depth / 2 - 0.08)
		m.CFrame = cf * ANG(0, 0, ma) * CF(0, a * 0.32, -depth / 2 - 0.1)
	end

	-- кольцо из сегментов радиуса rr (n штук, пропуск по skip(k))
	local function ringSegments(set, rr, n, height, depth, skip)
		for k = 0, n - 1 do
			if not (skip and skip(k)) then
				local ang = k / n * math.pi * 2
				addRigid(set, { Size = V(2 * math.pi * rr / n * 1.05, height, depth), Color = CGOLD, Material = METAL },
					CF(math.cos(ang) * rr, 0, math.sin(ang) * rr) * ANG(0, -ang - math.pi / 2, 0))
			end
		end
	end

	-- разрез секунд: вращающийся зубчатый диск летит по прямой
	reg("GearDisc", function(from, to, duration, lv, storm)
		local set = {}
		local a = 0.75 + (lv or 1) * 0.08
		local hub = addGear(set, a, 0.18, storm and ORANGE or CGOLD, storm and Color3.fromRGB(255, 230, 160) or ORANGE)
		FX.Light(hub, ORANGE, 8, storm and 3 or 1.5)
		local dir = to - from
		local flat = V(dir.X, 0, dir.Z)
		local base = flat.Magnitude > 0.01 and CFrame.lookAt(Vector3.zero, flat).Rotation or CF()
		local dur = math.max(duration or 0.3, 0.05)
		placeRigid(set, CF(from) * base * ANG(rad(90), 0, 0))
		FX.Run(function(el)
			local alpha = math.clamp(el / dur, 0, 1)
			placeRigid(set, CF(from:Lerp(to, alpha)) * base * ANG(rad(90), 0, 0) * ANG(0, 0, el * 16))
			if alpha >= 1 then
				fadeRigid(set, 0.2)
				return true
			end
			return false
		end)
		FX.Sound("Slash", 0.8, 1.4, from)
	end)

	-- попадание диском: искры, оранжевая вспышка, призрачные стрелки
	reg("ChronoHit", function(pos)
		FX.Burst(pos, CGOLD, 5, 0.22, 6, 0.35)
		FX.Burst(pos, BRONZE, 3, 0.3, 4, 0.45)
		FX.Sphere(pos, 1.0, ORANGE, 0.18, nil, 0.3)
		if not FX.Lite then
			local cf = FX.CamFacing(pos + V(0, 1.2, 0))
			local h, m = makeHands(1.2, Color3.fromRGB(255, 220, 150))
			h.Transparency, m.Transparency = 0.3, 0.3
			placeHands(h, m, cf, 0, 0, 1.2, 0)
			FX.Tween(h, 0.4, { CFrame = cf * ANG(0, 0, -2.5) * CF(0, 0.24, -0.1), Transparency = 1 })
			FX.Tween(m, 0.4, { CFrame = cf * ANG(0, 0, 2.8) * CF(0, 0.38, -0.12), Transparency = 1 })
			FX.Cleanup(h, 0.45)
			FX.Cleanup(m, 0.45)
		end
	end)

	-- маленькие часы над точкой: стрелки крутятся со скоростью speed
	reg("TinyClock", function(pos, a, dur, speed)
		local set = {}
		addDial(set, a, 0.12)
		local h, m = makeHands(a)
		local cf = FX.CamFacing(pos)
		placeRigid(set, cf)
		placeHands(h, m, cf, 0, 0, a, 0.12)
		FX.Run(function(el)
			placeHands(h, m, cf, -el * speed * 0.2, -el * speed, a, 0.12)
			if el >= dur then
				fadeRigid(set, 0.25)
				fadeParts({ h, m }, 0.25)
				return true
			end
			return false
		end)
	end)

	-- ПОЛОМКА ВРЕМЕНИ: циферблат на дороге и в небе, стрелки резко останавливаются
	reg("TimeBreak", function(pos, radius, dur)
		dur = dur or 1.5
		local g = V(pos.X, pos.Y + 0.25, pos.Z)
		FX.Sound("Magic", 1, 0.55, pos)
		local floor = {}
		addDial(floor, radius, 0.12, 0.25)
		local floorCF = CF(g) * FLOOR
		placeRigid(floor, floorCF)
		local fh, fm = makeHands(radius)
		local sky = {}
		local skyA = radius * 0.45
		addDial(sky, skyA, 0.3)
		local skyCF = FX.CamFacing(g + V(0, radius * 0.9 + 3, 0))
		placeRigid(sky, skyCF)
		local sh, sm = makeHands(skyA)
		local rings = {}
		if not FX.Lite then
			for i = 1, 2 do
				local set = {}
				ringSegments(set, radius * (0.7 + i * 0.12), 16, 0.12, 0.2, function(k) return k % 4 == 3 end)
				rings[i] = { set, i * 0.9 }
			end
			for _ = 1, 10 do
				local ang = rng:NextNumber(0, math.pi * 2)
				local d = rng:NextNumber(0, radius * 0.9)
				local p = FX.Part({ Size = V(0.25, 0.25, 0.25), CFrame = CF(g + V(math.cos(ang) * d, rng:NextNumber(0.6, 3), math.sin(ang) * d)) * ANG(1, 2, 0),
					Color = rng:NextNumber() < 0.5 and CGOLD or ORANGE, Transparency = 0.15 })
				task.delay(dur, function()
					if p.Parent then
						FX.Tween(p, 0.35, { CFrame = p.CFrame + V(0, -1.5, 0), Transparency = 1 })
					end
				end)
				FX.Cleanup(p, dur + 0.4)
			end
		end
		FX.Run(function(el)
			-- первые 0.45 с стрелки бешено крутятся, затем замирают
			local spin = math.min(el, 0.45)
			local ha, ma = -spin * 14, -spin * 40
			placeHands(fh, fm, floorCF, ha, ma, radius, 0.12)
			placeHands(sh, sm, skyCF, ha * 0.8, ma * 0.8, skyA, 0.3)
			for _, rg in ipairs(rings) do
				placeRigid(rg[1], CF(g + V(0, rg[2], 0)) * ANG(0, spin * 3 * (rg[2] > 1 and -1 or 1), 0))
			end
			if el < dur then
				return false
			end
			FX.Sound("Explosion", 0.6, 1.4, pos)
			FX.Sphere(g + V(0, 1, 0), radius * 0.55, ORANGE, 0.35, nil, 0.3)
			FX.Ring(g, radius * 1.1, ORANGE, 0.45, 0.3, radius * 0.5, 0.2)
			FX.Burst(g + V(0, 1, 0), CGOLD, 12, 0.35, 10, 0.6)
			FX.Burst(g + V(0, 1, 0), BRONZE, 8, 0.4, 7, 0.6)
			fadeRigid(floor, 0.35)
			fadeRigid(sky, 0.35)
			for _, rg in ipairs(rings) do
				fadeRigid(rg[1], 0.3)
			end
			fadeParts({ fh, fm, sh, sm }, 0.3)
			return true
		end)
	end)

	-- УСКОРЕНИЕ ВРЕМЕНИ: золотое кольцо и маленькие часы над союзниками
	reg("TimeHaste", function(pos, radius, allyPositions, dur)
		dur = dur or 2
		local g = V(pos.X, pos.Y + 0.25, pos.Z)
		FX.Sound("Upgrade", 0.9, 1.35, pos)
		FX.Ring(g, radius, CGOLD, 0.8, 0.4, 1, 0.1)
		task.delay(0.12, function()
			FX.Ring(g + V(0, 0.1, 0), radius * 0.8, ORANGE, 0.7, 0.25, 1, 0.3)
		end)
		FX.Burst(g + V(0, 2, 0), CGOLD, 10, 0.3, 8, 0.6)
		for _, ap in ipairs(allyPositions or {}) do
			FX.TinyClock(ap + V(0, 7, 0), 0.7, dur, 18)
			FX.Ring(ap + V(0, 0.3, 0), 2.5, CGOLD, 0.4, 0.2, 0.5, 0.2)
		end
	end)

	-- ВРЕМЕННАЯ БУРЯ: механическое кольцо поднимается и бьёт по земле
	reg("TimeStorm", function(pos, delay)
		delay = delay or 1.2
		local g = V(pos.X, pos.Y + 0.25, pos.Z)
		FX.Sound("Magic", 1, 0.45, pos)
		local set = {}
		local rr = 6.5
		local n = FX.Lite and 8 or 16
		for k = 0, n - 1 do
			local ang = k / n * math.pi * 2
			addRigid(set, { Size = V(2 * math.pi * rr / n * 1.02, 0.5, 0.3), Color = CGOLD, Material = METAL },
				CF(math.cos(ang) * rr, 0, math.sin(ang) * rr) * ANG(0, -ang - math.pi / 2, 0))
			if k % 2 == 0 and not FX.Lite then
				addRigid(set, { Size = V(0.4, 0.8, 0.4), Color = ORANGE }, CF(math.cos(ang) * rr, 0.5, math.sin(ang) * rr) * ANG(0, -ang, math.pi / 4))
			end
		end
		placeRigid(set, CF(g + V(0, 0.5, 0)))
		FX.Run(function(el)
			local rise = math.min(el / delay, 1)
			placeRigid(set, CF(g + V(0, 0.5 + rise * 2, 0)) * ANG(0, el * 2.5 * (0.3 + rise), 0))
			if el < delay then
				return false
			end
			fadeRigid(set, 0.4)
			FX.Shockwave(g, 9, 3, CGOLD, ORANGE)
			FX.Sphere(g + V(0, 2, 0), 4, ORANGE, 0.45, nil, 0.25)
			return true
		end)
	end)

	-- удар во время бури: механический взрыв и часы над целью
	reg("ChronoBurst", function(pos, radius)
		local g = V(pos.X, pos.Y + 0.2, pos.Z)
		FX.Ring(g, radius, CGOLD, 0.45, 0.3, 0.5, 0.1)
		FX.Ring(g + V(0, 0.05, 0), radius * 0.6, ORANGE, 0.35, 0.2, 0.3, 0.3)
		FX.Burst(g + V(0, 1, 0), ORANGE, 8, 0.3, 9, 0.45)
		FX.Burst(g + V(0, 1, 0), BRONZE, 5, 0.35, 6, 0.5)
		if not FX.Lite then
			FX.TinyClock(g + V(0, 4, 0), 0.6, 0.6, 30)
		end
		FX.Sound("Explosion", 0.4, 1.6, pos)
	end)

	-- установка часовщика: циферблат, стрелки назад, золотой портал
	reg("ClockPortal", function(pos, dur)
		dur = dur or 1.3
		local g = V(pos.X, pos.Y + 0.25, pos.Z)
		local set = {}
		local a = 4.5
		addDial(set, a, 0.12, 0.2)
		local cf = CF(g) * FLOOR
		placeRigid(set, cf)
		local h, m = makeHands(a)
		placeHands(h, m, cf, 0, 0, a, 0.12)
		local portal = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.3, 0.5, 0.5), CFrame = CF(g + V(0, 0.2, 0)) * ANG(0, 0, rad(90)), Color = CGOLD, Transparency = 0.2 })
		FX.Tween(portal, dur * 0.6, { Size = V(0.3, a * 1.6, a * 1.6) })
		FX.Light(portal, ORANGE, 14, 2, dur + 0.5)
		FX.Sound("Portal", 0.9, 1.2, pos)
		FX.Run(function(el)
			placeHands(h, m, cf, el * 4, el * 22, a, 0.12)
			if el < dur then
				return false
			end
			fadeRigid(set, 0.5)
			fadeParts({ h, m, portal }, 0.5)
			FX.Burst(g + V(0, 2, 0), CGOLD, 14, 0.35, 8, 0.6)
			FX.Ring(g, 6, ORANGE, 0.5, 0.3, 2, 0.2)
			return true
		end)
	end)

	------------------------------------------------------------------------
	-- УДАРЫ (Impact)
	------------------------------------------------------------------------
	local I = FX.RegisterImpact
	I("ChronoHit", function(p) FX.ChronoHit(p.P + V(0, 1.5, 0)) end)
	I("ChronoBurst", function(p) FX.ChronoBurst(p.P, p.R or 5) end)
	I("TimeBreak", function(p) FX.TimeBreak(p.P, p.R or 9, p.DUR or 1.5) end)
	I("TimeHaste", function(p)
		local dur = p.DUR or 2
		local positions = {}
		for _, uid in ipairs(p.A or {}) do
			local v = FX.UnitView(uid)
			if v and v.Pos then
				positions[#positions + 1] = v.Pos
				if v.Rig then
					v.Rig.SpinBoostUntil = os.clock() + dur
				end
			end
		end
		FX.TimeHaste(p.P, p.R or 14, positions, dur)
	end)
	I("TimeStorm", function(p) FX.TimeStorm(p.P, p.DL or 1.3) end)
end
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX34578E9AC4E7D90BC9EE8BB702F03092">
						<Properties>
							<string name="Name">Halloween</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: FX/Halloween — эффекты события Haunted Hollow
-- Регистрирует: FX.HColors; снаряды FX.ProjectileMakers (CurseBullet Flask Card Pumpkin); удары Impact
-- (LightFlash LanternBeam DirtBurst LeafStorm CurseMark BellWave MidnightToll FlaskSplash Poison PlagueCloud
-- PlagueCloudBurst GhostSlash GhostSword MirrorShatter ThreadSnap FireCrack Execution PumpkinBlast GhostPumpkin
-- LanternHeart CursedThreads PhantomEcho CursedCircle SummonPortal AllyHit Fog Straw Fire EnemyState);
-- именованные эффекты FX.Fn:
--   HalloweenAttack(view, def, p, h, lv) -> handled   -- вылет атаки юнитов события (урон — по Impact)
--   EchoGhost(view)                                   -- «Призрачная корона»: синяя копия юнита
--   ThronePlace(pos)                                  -- трон Короля фонарей при установке
--   EnemyDeath(view, reason) / EnemySpawn(view, atStart) -- по rig.DeathFX / rig.SpawnFX
--   CrowCircle(pos, r, n, life, color) / CrowFly(from, getTarget, travel, onHit)

return function(FX)
	local V = Vector3.new
	local CF = CFrame.new
	local ANG = CFrame.Angles
	local rad = math.rad
	local rng = FX.Rng
	local rgb = Color3.fromRGB
	local Mat = Enum.Material
	local CYL = Enum.PartType.Cylinder
	local FLAT = ANG(0, 0, rad(90))
	local Quad, In = Enum.EasingStyle.Quad, Enum.EasingDirection.In

	local COL = {
		Orange = rgb(255, 140, 40), Ember = rgb(255, 90, 20), Fire = rgb(255, 180, 70), Light = rgb(255, 235, 170),
		Green = rgb(120, 255, 110), Poison = rgb(140, 230, 80), PoisonDark = rgb(60, 110, 40), Blue = rgb(90, 170, 255),
		Ghost = rgb(170, 220, 255), Purple = rgb(180, 90, 255), Red = rgb(230, 30, 50), Gold = rgb(255, 205, 80),
		Straw = rgb(220, 190, 110), Dirt = rgb(110, 85, 60), Stone = rgb(120, 112, 104), Leaf = rgb(230, 140, 40),
		Bell = rgb(190, 160, 255), Bone = rgb(230, 222, 205), Black = rgb(16, 12, 18), Smoke = rgb(90, 90, 96),
		FogC = rgb(160, 170, 160),
	}
	FX.HColors = COL
	local PUMPKIN = rgb(230, 110, 30)
	local GLASS = rgb(220, 210, 255)

	local ground = FX.Ground
	local debris, smoke, flash = FX.Debris, FX.Smoke, FX.Flash
	local function R()
		return FX.Env.Renderer
	end
	local function center(id)
		return FX.EnemyCenter(id)
	end
	local function enemyView(id)
		local r = R()
		return r and r.EnemyViews and r.EnemyViews[id]
	end

	------------------------------------------------------------------------
	-- ВОРОНЫ
	------------------------------------------------------------------------
	local function bird(color)
		local m = Instance.new("Model")
		m.Name = "Crow"
		local body = FX.Part({ Size = V(0.5, 0.45, 0.9), Color = color or COL.Black, Material = Mat.SmoothPlastic, Parent = m })
		for _, s in ipairs({ -1, 1 }) do
			local w = FX.Part({ Class = "WedgePart", Size = V(0.1, 0.5, 1.2), Color = color or COL.Black, Material = Mat.SmoothPlastic, Parent = m })
			w.Name = s == 1 and "WR" or "WL"
		end
		m.PrimaryPart = body
		m.Parent = FX.Folder
		return m
	end

	local function placeBird(m, cf, flap)
		m.PrimaryPart.CFrame = cf
		m.WR.CFrame = cf * CF(0.55, 0.1, 0) * ANG(0, 0, rad(-60 + flap))
		m.WL.CFrame = cf * CF(-0.55, 0.1, 0) * ANG(0, 0, rad(60 - flap))
	end

	-- вороны кружат вокруг точки
	local function crowCircle(pos, r, n, life, color)
		if FX.Lite then
			n = 1
		end
		local birds = {}
		for i = 1, n do
			birds[i] = { bird(color), i / n * math.pi * 2, rng:NextNumber(2, 4.5) }
		end
		FX.Run(function(t)
			if t >= life then
				for _, b in ipairs(birds) do
					b[1]:Destroy()
				end
				return true
			end
			for _, b in ipairs(birds) do
				local a = b[2] + t * 2.4
				local p = pos + V(math.cos(a) * r, b[3] + math.sin(t * 3 + b[2]) * 0.4, math.sin(a) * r)
				placeBird(b[1], CFrame.lookAt(p, p + V(-math.sin(a), 0, math.cos(a))), math.sin(t * 18 + b[2]) * 40)
			end
			return false
		end)
	end
	FX.Fn.CrowCircle = crowCircle

	-- ворон летит к цели (снаряд пугала)
	local function crowFly(from, getTarget, travel, onHit)
		local m = bird()
		local last = getTarget() or from
		local dur = math.max(travel or 0.3, 0.05)
		FX.Run(function(el, _, now)
			local a = math.clamp(el / dur, 0, 1)
			local target = getTarget() or last
			last = target
			local p = from:Lerp(target, a) + V(0, math.sin(a * math.pi) * 2, 0)
			placeBird(m, ((target - p).Magnitude > 0.05) and CFrame.lookAt(p, target) or CF(p), math.sin(now * 25) * 45)
			if a >= 1 then
				m:Destroy()
				if onHit then
					onHit(target)
				end
				return true
			end
			return false
		end)
	end
	FX.Fn.CrowFly = crowFly

	------------------------------------------------------------------------
	-- СНАРЯДЫ
	------------------------------------------------------------------------
	local PM = FX.ProjectileMakers
	PM.CurseBullet = function()
		local p = FX.Part({ Size = V(0.22, 0.22, 1.1), Color = COL.Green })
		FX.Light(p, COL.Green, 6, 2)
		return p, COL.Green
	end
	PM.Flask = function()
		local p = FX.Part({ Size = V(0.5, 0.7, 0.5), Color = COL.Poison, Material = Mat.Glass, Transparency = 0.2 })
		local cork = FX.Part({ Size = V(0.25, 0.25, 0.25), Color = COL.Dirt, Material = Mat.Wood, Parent = p })
		cork.Name = "Tip"
		FX.Light(p, COL.Poison, 6, 1.5)
		return p, COL.Poison, CF(0, 0.45, 0)
	end
	PM.Card = function()
		local p = FX.Part({ Size = V(0.6, 0.06, 0.9), Color = rgb(245, 240, 250), Material = Mat.SmoothPlastic })
		local mark = FX.Part({ Size = V(0.25, 0.08, 0.25), Color = COL.Purple, Parent = p })
		mark.Name = "Tip"
		return p, COL.Purple, CF(0, 0, 0)
	end
	PM.Pumpkin = function(lv)
		local s = 1 + (lv or 1) * 0.08
		local p = FX.Part({ Size = V(1.1 * s, 0.9 * s, 1.1 * s), Color = PUMPKIN, Material = Mat.SmoothPlastic })
		local face = FX.Part({ Size = V(0.6 * s, 0.25 * s, 0.1), Color = COL.Fire, Parent = p })
		face.Name = "Tip"
		FX.Light(p, COL.Orange, 10, 2.5)
		return p, COL.Ember, CF(0, 0, -0.56 * s)
	end

	------------------------------------------------------------------------
	-- УДАРЫ
	------------------------------------------------------------------------
	local I = FX.RegisterImpact

	I("LightFlash", function(p)
		local g = ground(p.P)
		flash(g + V(0, 1.5, 0), COL.Light, p.R * 0.6, 0.3)
		FX.Ring(g, p.R, COL.Light, 0.35, 0.2, 0.5, 0.3)
		FX.Sound("Magic", 0.6, 1.6, g)
	end)

	I("LanternBeam", function(p)
		local g = ground(p.P)
		local beam = FX.Part({ Shape = CYL, Size = V(30, 0.5, 0.5), CFrame = CF(g + V(0, 15, 0)) * FLAT, Color = COL.Light, Transparency = 0.2 })
		FX.Tween(beam, 0.15, { Size = V(30, p.R * 1.2, p.R * 1.2) })
		task.delay(0.2, function()
			FX.Fade(beam, 0.4, { Size = V(30, 0.2, 0.2) })
		end)
		FX.Ring(g, p.R, COL.Fire, 0.5, 0.3, 1, 0.1)
		flash(g + V(0, 2, 0), COL.Light, p.R * 0.7, 0.45)
		FX.Burst(g + V(0, 1, 0), COL.Fire, 12, 0.35, 9)
		FX.Sound("Laser", 0.8, 1.4, g)
	end)

	I("DirtBurst", function(p)
		local g = ground(p.P)
		FX.Ring(g, p.R, COL.Dirt, 0.45, 0.4, 1, 0.1)
		FX.Cracks(g, p.R, rgb(70, 50, 36), 6, 1.1)
		debris(g + V(0, 0.5, 0), COL.Stone, 8, 0.6, 9, 0.9)
		debris(g + V(0, 0.5, 0), COL.Dirt, 6, 0.45, 7, 0.8, Mat.Ground)
		smoke(g + V(0, 1, 0), rgb(120, 100, 80), 4, 3, 0.9, 2.5)
		FX.Sound("HeavyHit", 0.8, 0.8, g)
	end)

	I("LeafStorm", function(p)
		local g = ground(p.P)
		FX.Ring(g, p.R, COL.Leaf, 0.6, 0.25, 1, 0.3)
		local leaves = {}
		for i = 1, FX.Lite and 6 or 18 do
			local part = FX.Part({ Size = V(0.5, 0.06, 0.35), Color = (i % 3 == 0) and COL.Ember or COL.Leaf, Material = Mat.SmoothPlastic, CFrame = CF(g) })
			leaves[i] = { part, rng:NextNumber(0, 6.28), rng:NextNumber(0.5, 1) }
		end
		FX.Run(function(t)
			if t >= 1.3 then
				for _, l in ipairs(leaves) do
					l[1]:Destroy()
				end
				return true
			end
			for _, l in ipairs(leaves) do
				local a = l[2] + t * 7
				local r = p.R * l[3] * (0.4 + t * 0.5)
				l[1].CFrame = CF(g + V(math.cos(a) * r, t * 4 * l[3] + 0.5, math.sin(a) * r)) * ANG(t * 9, a, 0)
				l[1].Transparency = math.clamp((t - 0.9) / 0.4, 0, 1)
			end
			return false
		end)
		crowCircle(g, p.R * 0.6, 2, 1.3)
		FX.Sound("Slash", 0.6, 0.6, g)
	end)

	I("CurseMark", function(p)
		local id = p.I
		local c = center(id) or p.P
		flash(c, COL.Green, 2.5, 0.3)
		FX.Burst(c, COL.Green, 10, 0.35, 8)
		-- знак проклятия над головой врага
		local mark = FX.Part({ Size = V(1, 1, 0.15), Color = COL.Green, CFrame = CF(c) })
		local inner = FX.Part({ Size = V(0.45, 0.45, 0.2), Color = COL.Black, Material = Mat.SmoothPlastic, CFrame = CF(c) })
		local dur = p.DUR or 3
		FX.Run(function(t)
			local view = enemyView(id)
			if t >= dur or not view or not view.Rig.Model.Parent then
				FX.Fade(mark, 0.2)
				FX.Fade(inner, 0.2)
				return true
			end
			local rig = view.Rig
			local cf = CF(rig.Root.Position + V(0, (rig.Height or 5) - (rig.HipHeight or 0) + 1.2, 0)) * ANG(0, t * 3, rad(45))
			mark.CFrame = cf
			inner.CFrame = cf
			return false
		end)
		FX.Sound("Magic", 0.8, 0.6, c)
	end)

	I("BellWave", function(p)
		local g = ground(p.P)
		FX.Ring(g + V(0, 0.2, 0), p.R, COL.Bell, 0.55, 0.5, 1, 0.25)
		task.delay(0.12, function()
			FX.Ring(g + V(0, 0.6, 0), p.R * 0.8, rgb(230, 220, 255), 0.45, 0.3, 1, 0.4)
		end)
		FX.Sound("Magic", 0.8, 0.45, g)
	end)

	I("MidnightToll", function(p)
		local g = ground(p.P)
		for i = 0, 2 do
			task.delay(i * 0.15, function()
				FX.Ring(g + V(0, 0.3 + i * 0.4, 0), p.R * (1 - i * 0.12), i == 1 and COL.Purple or COL.Bell, 0.7, 0.6, 1, 0.15)
			end)
		end
		flash(g + V(0, 3, 0), COL.Bell, 4, 0.5)
		if FX.TinyClock then
			for i = 0, 2 do
				local a = i / 3 * math.pi * 2
				FX.TinyClock(g + V(math.cos(a) * p.R * 0.5, 3.5, math.sin(a) * p.R * 0.5), 1.4, 1.4, 4)
			end
		end
		FX.Shake(0.15, 0.3)
		FX.Sound("Boss", 0.5, 1.6, g)
	end)

	I("FlaskSplash", function(p)
		local g = ground(p.P)
		FX.Burst(g + V(0, 1, 0), COL.Poison, 10, 0.35, 8)
		FX.Ring(g, p.R, COL.Poison, 0.4, 0.25, 0.5, 0.3)
		debris(g + V(0, 1, 0), rgb(200, 255, 200), 4, 0.25, 6, 0.5, Mat.Glass)
		FX.Sound("Magic", 0.6, 1.2, g)
	end)

	-- ядовитое облако: лужа, клубы (шары в Roblox всегда круглые — утоплены в землю), частицы
	local function poisonCloud(p, big)
		local g = ground(p.P)
		local dur = p.DUR or 3
		local pool = FX.Part({ Shape = CYL, Size = V(0.1, 0.5, 0.5), CFrame = CF(g + V(0, 0.05, 0)) * FLAT, Color = COL.PoisonDark, Transparency = 0.35 })
		FX.Tween(pool, 0.3, { Size = V(0.1, p.R * 2, p.R * 2) })
		local balls = {}
		local n = FX.Lite and 2 or (big and 8 or 3)
		for i = 1, n do
			local a = i / n * math.pi * 2
			local s = p.R * (big and 0.9 or 0.7)
			balls[i] = FX.Part({ Shape = Enum.PartType.Ball, Size = V(s, s, s), CFrame = CF(g + V(math.cos(a) * p.R * 0.45, s * 0.1, math.sin(a) * p.R * 0.45)),
				Color = big and rgb(120, 200, 70) or COL.Poison, Material = Mat.SmoothPlastic, Transparency = 0.6 })
		end
		local em
		if not FX.Lite then
			em = Instance.new("ParticleEmitter")
			em.Color = ColorSequence.new(COL.Poison)
			em.LightEmission = 0.6
			em.Rate = big and 30 or 12
			em.Lifetime = NumberRange.new(0.6, 1.2)
			em.Speed = NumberRange.new(1, 3)
			em.SpreadAngle = Vector2.new(30, 30)
			em.EmissionDirection = Enum.NormalId.Right -- у лежащего цилиндра ось X смотрит вверх
			em.Size = NumberSequence.new(0.35, 0)
			em.Parent = pool
		end
		if big then
			crowCircle(g, p.R * 0.8, 3, dur)
		end
		task.delay(dur, function()
			if em then
				em.Enabled = false
			end
			FX.Fade(pool, 0.5)
			for _, b in ipairs(balls) do
				FX.Fade(b, 0.5, { Size = b.Size * 1.3 })
			end
		end)
	end

	I("Poison", function(p) poisonCloud(p, false) end)
	I("PlagueCloud", function(p)
		poisonCloud(p, true)
		FX.Sound("Magic", 0.8, 0.5, p.P)
	end)
	I("PlagueCloudBurst", function(p)
		local g = ground(p.P) + V(0, 1, 0)
		FX.Sphere(g, p.R * 0.8, COL.Poison, 0.45, nil, 0.3)
		FX.Burst(g, COL.Poison, 14, 0.4, 10)
	end)

	I("GhostSlash", function(p)
		local e = p.E or p.P
		local from, to = p.P + V(0, 1.5, 0), V(e.X, p.P.Y + 1.5, e.Z)
		FX.Beam(from, to, 1.1, COL.Blue, 0.35)
		local crescent = FX.Part({ Size = V(3.5, 0.2, 1.2), CFrame = CFrame.lookAt(from, to), Color = COL.Ghost, Transparency = 0.2 })
		FX.Tween(crescent, 0.25, { CFrame = CFrame.lookAt(to, to + (to - from)) })
		task.delay(0.25, function()
			FX.Fade(crescent, 0.2)
		end)
		FX.Sound("Slash", 1, 0.9, (from + to) / 2)
		FX.Sphere(from, 1.6, COL.Blue, 0.25)
	end)

	I("GhostSword", function(p)
		local g = ground(p.P)
		local h = 14
		local list = {
			FX.Part({ Size = V(1.4, h, 0.4), CFrame = CF(g + V(0, h / 2 + 18, 0)), Color = COL.Ghost, Transparency = 0.35 }),
			FX.Part({ Size = V(5, 0.6, 0.8), CFrame = CF(g + V(0, h + 18, 0)), Color = COL.Blue, Transparency = 0.3 }),
			FX.Part({ Size = V(0.6, 3, 0.6), CFrame = CF(g + V(0, h + 19.8, 0)), Color = COL.Blue, Transparency = 0.3 }),
		}
		for _, q in ipairs(list) do
			FX.Tween(q, 0.3, { CFrame = q.CFrame - V(0, 18 + h * 0.3, 0) }, Quad, In)
		end
		task.delay(0.3, function()
			FX.Ring(g, p.R, COL.Blue, 0.6, 0.5, 1, 0.1)
			FX.Cracks(g, p.R, COL.Blue, 8, 1.2)
			flash(g + V(0, 2, 0), COL.Ghost, p.R * 0.6, 0.45)
			FX.Burst(g + V(0, 1, 0), COL.Ghost, 16, 0.4, 12)
			FX.Shake(0.35, 0.35)
			FX.Sound("Explosion", 1, 0.8, g)
			task.delay(0.35, function()
				for _, q in ipairs(list) do
					FX.Fade(q, 0.4)
				end
			end)
		end)
	end)

	I("MirrorShatter", function(p)
		local g = ground(p.P)
		FX.PortalDisc(g + V(0, 3.5, 0), 2.6, COL.Purple, 0.8, rgb(230, 200, 255))
		FX.Ring(g, p.R, COL.Purple, 0.5, 0.3, 1, 0.15)
		debris(g + V(0, 3, 0), GLASS, 10, 0.5, 11, 0.9, Mat.Glass)
		FX.Burst(g + V(0, 2, 0), COL.Purple, 10, 0.35, 10)
		FX.Sound("Explosion", 0.7, 1.3, g)
	end)

	I("ThreadSnap", function(p)
		local g = ground(p.P) + V(0, 2.5, 0)
		for i = 1, FX.Lite and 4 or 8 do
			local a = i / 8 * math.pi * 2
			FX.Thread(g + V(0, 6, 0), g + V(math.cos(a) * p.R, rng:NextNumber(-2, 1), math.sin(a) * p.R), COL.Red)
		end
		FX.Ring(ground(p.P), p.R, COL.Red, 0.4, 0.2, 1, 0.2)
		FX.Burst(g, COL.Red, 14, 0.3, 10)
		FX.Sound("Slash", 1, 1.4, g)
	end)

	I("FireCrack", function(p)
		local g = ground(p.P)
		FX.Cracks(g, p.R, COL.Ember, 6, 1.2)
		FX.Ring(g, p.R, COL.Orange, 0.4, 0.3, 1, 0.2)
		FX.Burst(g + V(0, 1, 0), COL.Fire, 10, 0.4, 8)
		smoke(g + V(0, 1, 0), rgb(60, 40, 36), 3, 2.5, 0.8, 3)
		FX.Sound("HeavyHit", 1, 0.6, g)
	end)

	I("Execution", function(p)
		local g = ground(p.P)
		FX.Cracks(g, p.R, COL.Ember, 12, 1.6)
		FX.Ring(g, p.R, COL.Ember, 0.6, 0.6, 1, 0.05)
		flash(g + V(0, 2, 0), COL.Fire, p.R * 0.5, 0.4)
		for i = 1, FX.Lite and 2 or 5 do
			local a = i / 5 * math.pi * 2
			local q = g + V(math.cos(a) * p.R * 0.6, 0, math.sin(a) * p.R * 0.6)
			local pillar = FX.Part({ Size = V(1.2, 0.5, 1.2), CFrame = CF(q), Color = COL.Orange, Transparency = 0.2 })
			FX.Tween(pillar, 0.25, { Size = V(1.2, 7, 1.2), CFrame = CF(q + V(0, 3.5, 0)) })
			task.delay(0.3, function()
				FX.Fade(pillar, 0.4, { Size = V(0.2, 9, 0.2) })
			end)
		end
		debris(g + V(0, 0.5, 0), COL.Stone, 8, 0.6, 10, 0.9)
		FX.Shake(0.45, 0.4)
		FX.Sound("Explosion", 1, 0.55, g)
	end)

	I("PumpkinBlast", function(p)
		local g = ground(p.P) + V(0, 1, 0)
		FX.Sphere(g, p.R * 0.8, COL.Orange, 0.35)
		FX.Burst(g, COL.Ember, 10, 0.4, 9)
		debris(g, PUMPKIN, 5, 0.5, 8, 0.7, Mat.SmoothPlastic)
		FX.Sound("Explosion", 0.6, 1.1, g)
	end)

	I("GhostPumpkin", function(p)
		local g = ground(p.P)
		local s = 6
		local top = g + V(0, 22, 0)
		local pk = FX.Part({ Size = V(s, s * 0.85, s), CFrame = CF(top), Color = COL.Ghost, Transparency = 0.4 })
		local list = {
			pk,
			FX.Part({ Size = V(s * 0.6, s * 0.25, 0.2), CFrame = CF(top + V(0, -0.3, -s / 2)), Color = COL.Orange }),
			FX.Part({ Size = V(0.9, 0.9, 0.2), CFrame = CF(top + V(-1.2, 1, -s / 2)) * ANG(0, 0, rad(45)), Color = COL.Orange }),
			FX.Part({ Size = V(0.9, 0.9, 0.2), CFrame = CF(top + V(1.2, 1, -s / 2)) * ANG(0, 0, rad(45)), Color = COL.Orange }),
		}
		FX.Light(pk, COL.Orange, 30, 3)
		for _, q in ipairs(list) do
			FX.Tween(q, 0.45, { CFrame = q.CFrame - V(0, 19, 0) }, Quad, In)
		end
		task.delay(0.45, function()
			for _, q in ipairs(list) do
				q:Destroy()
			end
			FX.Sphere(g + V(0, 2, 0), p.R, COL.Orange, 0.6, nil, 0.05)
			FX.Sphere(g + V(0, 2, 0), p.R * 0.7, COL.Ghost, 0.5, nil, 0.3)
			FX.Ring(g, p.R * 1.2, COL.Ember, 0.7, 0.6, 1, 0.05)
			FX.Cracks(g, p.R, COL.Ember, 10, 1.6)
			FX.Burst(g + V(0, 2, 0), COL.Fire, 24, 0.6, 16, 0.8)
			debris(g + V(0, 1, 0), PUMPKIN, 8, 0.8, 12, 1.0, Mat.SmoothPlastic)
			flash(g + V(0, 3, 0), COL.Fire, p.R, 0.6)
			FX.Shake(0.6, 0.5)
			FX.Sound("Explosion", 1, 0.45, g)
		end)
	end)

	-- руны
	I("LanternHeart", function(p)
		local g = ground(p.P) + V(0, 1.2, 0)
		FX.Sphere(g, p.R, COL.Orange, 0.35, nil, 0.15)
		FX.Ring(ground(p.P), p.R, COL.Ember, 0.35, 0.25, 0.5, 0.2)
		FX.Burst(g, COL.Fire, 8, 0.3, 7)
		FX.Sound("Explosion", 0.4, 1.4, g)
	end)

	I("CursedThreads", function(p)
		local c = p.P + V(0, 7, 0)
		for _, id in ipairs(p.A or {}) do
			local e = center(id)
			if e then
				FX.Thread(c, e, COL.Red)
				FX.Ring(ground(e), 1.6, COL.Red, 0.5, 0.2, 0.3, 0.2)
			end
		end
		FX.Sound("Magic", 0.7, 0.5, p.P)
	end)

	-- копия юнита рисуется по атаке с флагом EC; здесь — отблеск
	I("PhantomEcho", function(p)
		FX.Burst(p.P + V(0, 2, 0), COL.Ghost, 5, 0.25, 4)
	end)

	I("CursedCircle", function(p)
		local g = ground(p.P)
		FX.RuneRing(g, 4, COL.Red, 2.2)
		flash(g + V(0, 1.5, 0), COL.Red, 3, 0.5)
		FX.Burst(g + V(0, 1, 0), COL.Red, 12, 0.35, 6)
		FX.Sound("Magic", 0.8, 0.4, g)
	end)

	I("SummonPortal", function(p)
		local g = ground(p.P)
		if p.S == "Illusion" then
			FX.PortalDisc(g + V(0, 4, 0), 3.4, COL.Purple, 1.4, rgb(230, 200, 255))
			FX.RuneRing(g, 3.5, COL.Purple, 1.6)
			debris(g + V(0, 3, 0), GLASS, 6, 0.35, 6, 0.8, Mat.Glass)
		else
			-- кукловод: красные нити опускают марионеток сверху
			for i = 1, 5 do
				local a = i / 5 * math.pi * 2
				FX.Thread(g + V(math.cos(a) * 1.5, 14, math.sin(a) * 1.5), g + V(math.cos(a) * 1.2, 2, math.sin(a) * 1.2), COL.Red)
			end
			FX.RuneRing(g, 3, COL.Red, 1.4)
			if p.G then
				flash(g + V(0, 3, 0), COL.Gold, 5, 0.7)
				FX.Burst(g + V(0, 2, 0), COL.Gold, 20, 0.4, 10, 0.8)
			end
		end
		FX.Sound("Portal", 0.8, 1.2, g)
	end)

	I("AllyHit", function(p)
		local pos = p.P + V(0, 2, 0)
		FX.Burst(pos, p.F and COL.Orange or COL.Light, 6, 0.3, 7)
		FX.Sphere(pos, 1.4, p.F and COL.Ember or rgb(255, 255, 255), 0.18)
		FX.Sound("Slash", 0.5, 1.2, pos)
		local r = R()
		local av = r and r.AllyViews and r.AllyViews[p.I]
		if av then
			av.HitT = os.clock()
		end
	end)

	I("Fog", function(p)
		local g = ground(p.P)
		FX.Ring(g, p.R, COL.FogC, 0.9, 0.2, 1, 0.5)
		smoke(g + V(0, 1, 0), COL.FogC, 5, p.R * 0.6, 1.4, 1)
		local view = enemyView(p.I)
		if view and view.Rig.Model.Parent then
			for _, d in ipairs(view.Rig.Model:GetDescendants()) do
				if d.Name == "FogFX" and d:IsA("ParticleEmitter") then
					d:Emit(18)
				end
			end
		end
	end)

	I("Straw", function(p)
		local g = ground(p.P) + V(0, 1.5, 0)
		debris(g, COL.Straw, 10, 0.35, 8, 0.9, Mat.Fabric)
		FX.Burst(g, COL.Straw, 8, 0.3, 6)
	end)

	I("Fire", function(p)
		local g = ground(p.P)
		FX.Ring(g, 7, COL.Ember, 0.6, 0.4, 1, 0.1)
		FX.Burst(g + V(0, 2, 0), COL.Fire, 18, 0.5, 10)
		flash(g + V(0, 3, 0), COL.Orange, 6, 0.5)
	end)

	------------------------------------------------------------------------
	-- СОСТОЯНИЯ ВРАГОВ (токен: перекрывающиеся состояния не снимаются раньше времени)
	------------------------------------------------------------------------
	local function setPhased(view, on)
		local model = view.Rig.Model
		if on then
			view.PhaseSave = view.PhaseSave or {}
			for _, d in ipairs(model:GetDescendants()) do
				if d:IsA("BasePart") and d.Transparency < 1 and not view.PhaseSave[d] then
					view.PhaseSave[d] = { d.Transparency, d.Color, d.Material }
					if d:GetAttribute("Outline") then
						d.Color = COL.Ghost
						d.Material = Mat.Neon
					else
						d.Transparency = 0.9
					end
				end
			end
		elseif view.PhaseSave then
			for d, s in pairs(view.PhaseSave) do
				if d.Parent then
					d.Transparency, d.Color, d.Material = s[1], s[2], s[3]
				end
			end
			view.PhaseSave = nil
		end
	end

	local function setShield(view, on)
		for _, d in ipairs(view.Rig.Model:GetDescendants()) do
			if d.Name == "ShieldFX" and d:IsA("BasePart") then
				FX.Tween(d, 0.25, { Transparency = on and (d:GetAttribute("PT") or 0.6) or 1 })
			end
		end
	end

	-- снять состояние через dur, если за это время не наложили новое того же вида
	local function expire(view, key, dur, fn)
		local token = (view[key] or 0) + 1
		view[key] = token
		task.delay(dur, function()
			if view[key] == token and view.Rig.Model.Parent then
				fn()
			end
		end)
	end

	I("EnemyState", function(p)
		local view = enemyView(p.I)
		if not view then
			return
		end
		local c = center(p.I) or p.P
		local s = p.S
		if s == "Phase" then
			setPhased(view, true)
			FX.Burst(c, COL.Ghost, 6, 0.25, 4)
			expire(view, "PhaseToken", p.DUR or 1.5, function() setPhased(view, false) end)
		elseif s == "Shield" then
			setShield(view, true)
			FX.Sphere(c, 3 * (view.Rig.Scale or 1), COL.Purple, 0.35, nil, 0.4)
			expire(view, "ShieldToken", p.DUR or 3, function() setShield(view, false) end)
		elseif s == "Haste" then
			view.HasteUntil = os.clock() + (p.DUR or 3)
			FX.Burst(c, COL.Red, 10, 0.3, 10)
			FX.Ring(ground(c), 4, COL.Red, 0.4, 0.2, 1, 0.2)
		elseif s == "Enrage" then
			flash(c, COL.Red, 6, 0.6)
			FX.Ring(ground(c), 10, COL.Red, 0.7, 0.5, 1, 0.1)
			FX.Shake(0.5, 0.6)
			FX.Sound("Boss", 1, 0.9, c)
		elseif s == "ArmorBreak" then
			debris(c, COL.Bone, 8, 0.45, 9, 0.9, Mat.SmoothPlastic)
			debris(c, rgb(90, 88, 100), 5, 0.5, 8, 0.9, Mat.Metal)
			FX.Sound("HeavyHit", 0.8, 1.3, c)
		end
	end)

	------------------------------------------------------------------------
	-- СМЕРТЬ И ПОЯВЛЕНИЕ ВРАГОВ
	------------------------------------------------------------------------
	local DEATH = {
		GreenSmoke = function(pos, s)
			smoke(pos, rgb(90, 200, 100), 5, 2.4 * s, 1.1, 3)
			FX.Burst(pos, COL.Green, 6, 0.3, 4)
		end,
		PumpkinBurst = function(pos, s)
			debris(pos, PUMPKIN, 7, 0.5 * s, 9, 0.9, Mat.SmoothPlastic)
			FX.Burst(pos, COL.Fire, 10, 0.35, 8)
			FX.Sphere(pos, 1.6 * s, COL.Orange, 0.3)
		end,
		Ghost = function(pos, s)
			smoke(pos, COL.Ghost, 4, 2 * s, 0.9, 4)
			FX.Burst(pos, COL.Ghost, 8, 0.3, 5)
		end,
		BoneShards = function(pos, s)
			debris(pos, COL.Bone, 9, 0.4 * s, 9, 1.0, Mat.SmoothPlastic)
		end,
		Straw = function(pos, s)
			debris(pos, COL.Straw, 10, 0.35 * s, 8, 1.0, Mat.Fabric)
		end,
		Fog = function(pos, s)
			smoke(pos, COL.FogC, 6, 2.6 * s, 1.3, 2)
		end,
		Reaper = function(pos, s)
			smoke(pos, rgb(70, 40, 110), 6, 2.6 * s, 1.2, 4)
			FX.Burst(pos, COL.Purple, 14, 0.4, 9)
			FX.Ring(ground(pos), 6, COL.Purple, 0.6, 0.3, 1, 0.2)
		end,
		GraveBreak = function(pos)
			debris(pos, COL.Stone, 14, 0.9, 11, 1.2)
			smoke(pos, rgb(110, 105, 100), 6, 3.5, 1.4, 3)
			FX.Ring(ground(pos), 12, rgb(150, 255, 140), 0.8, 0.5, 1, 0.1)
			FX.Shake(0.5, 0.6)
		end,
		MonarchDeath = function(pos)
			flash(pos + V(0, 4, 0), COL.Fire, 14, 1.2)
			FX.Ring(ground(pos), 20, COL.Ember, 1.2, 0.8, 1, 0.05)
			FX.Burst(pos + V(0, 4, 0), COL.Gold, 24, 0.5, 12, 1)
			debris(pos + V(0, 6, 0), COL.Gold, 10, 0.6, 9, 1.4, Mat.Metal)
			smoke(pos, rgb(60, 30, 20), 8, 5, 2.2, 6)
			FX.Shake(0.9, 1.2)
			FX.Sound("Secret", 0.8, 0.8, pos)
		end,
	}

	FX.Fn.EnemyDeath = function(view, reason)
		local name = view.Rig.DeathFX
		local fn = name and DEATH[name]
		if not fn or reason == "clear" then
			return
		end
		local def = FX.Env.Config.Enemies[view.Type] or {}
		local pos = view.Rig.Root.Position
		if name == "MonarchDeath" then
			-- детали короны отрываются и падают
			for _, d in ipairs(view.Rig.Model:GetDescendants()) do
				if d:IsA("BasePart") and d:GetAttribute("Crown") and d.Transparency < 1 then
					local c = d:Clone()
					c:ClearAllChildren()
					c.Anchored = true
					c.Parent = FX.Folder
					d.Transparency = 1
					FX.Fade(c, 1.4, { CFrame = c.CFrame * CF(rng:NextNumber(-3, 3), -4, rng:NextNumber(-3, 3)) * ANG(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2)) })
				end
			end
		end
		fn(pos, def.Scale or 1)
	end

	FX.Fn.EnemySpawn = function(view, atStart)
		local name = view.Rig.SpawnFX
		if not name or not atStart then
			return
		end
		local g = ground(view.Rig.Root.Position)
		if name == "GraveBreak" then
			-- плита могилы поднимается и раскалывается
			local slab = FX.Part({ Size = V(6, 0.8, 9), CFrame = CF(g + V(0, 0.4, 0)), Color = COL.Stone, Material = Mat.Slate })
			FX.Tween(slab, 0.5, { CFrame = CF(g + V(0, 2.5, 0)) * ANG(rad(25), 0, rad(-10)) })
			task.delay(0.55, function()
				slab:Destroy()
				debris(g + V(0, 2.5, 0), COL.Stone, 12, 1.1, 12, 1.3)
				smoke(g + V(0, 1, 0), rgb(110, 105, 100), 6, 4, 1.4, 3)
				FX.Ring(g, 10, rgb(150, 255, 140), 0.7, 0.4, 1, 0.1)
				FX.Shake(0.6, 0.6)
			end)
		elseif name == "FogVortex" then
			-- вихрь тумана сгущается в жнеца
			local n = FX.Lite and 4 or 12
			local balls = {}
			for i = 1, n do
				balls[i] = { FX.Part({ Shape = Enum.PartType.Ball, Size = V(3, 3, 3), Color = COL.FogC, Material = Mat.SmoothPlastic, Transparency = 0.6, CFrame = CF(g) }), i / n * math.pi * 2, rng:NextNumber(0, 6) }
			end
			FX.Run(function(t)
				if t >= 1.4 then
					for _, b in ipairs(balls) do
						b[1]:Destroy()
					end
					FX.Sphere(g + V(0, 4, 0), 7, COL.Red, 0.4, nil, 0.4)
					return true
				end
				local r = math.max(0.5, 10 - t * 7)
				for _, b in ipairs(balls) do
					local a = b[2] + t * 5
					b[1].CFrame = CF(g + V(math.cos(a) * r, 1 + b[3] * 0.6 + t * 2, math.sin(a) * r))
					b[1].Transparency = 0.6 + math.clamp((t - 1) / 0.4, 0, 0.4)
				end
				return false
			end)
		elseif name == "MonarchPortal" then
			-- монарх выходит из огненного портала
			FX.PortalDisc(g + V(0, 9, 0), 8, rgb(150, 50, 15), 2.0, COL.Fire)
			task.delay(1.1, function()
				FX.Cracks(g, 12, COL.Ember, 12, 2)
				FX.Ring(g, 16, COL.Ember, 0.8, 0.6, 1, 0.05)
				FX.Burst(g + V(0, 1, 0), COL.Fire, 20, 0.5, 12)
				FX.Shake(0.7, 0.7)
				FX.Sound("Explosion", 1, 0.4, g)
			end)
		end
	end

	------------------------------------------------------------------------
	-- АТАКИ ЮНИТОВ СОБЫТИЯ (вылет; урон и области — по Impact)
	------------------------------------------------------------------------
	FX.Fn.HalloweenAttack = function(view, def, p, h, lv)
		if def.Event ~= "Halloween" or def.AttackType == "Chrono" then
			return false
		end
		local rend = R()
		local firstId = p.T and p.T[1]
		local id = view.UnitId
		local kind = def.AttackType
		local muzzle0 = rend.MuzzlePos(view)
		local function alive()
			return view.Rig and view.Rig.Model.Parent ~= nil
		end
		local function at(d, fn)
			task.delay(d, function()
				if alive() then
					fn()
				end
			end)
		end
		local function arcTo(target, up, mult, minR, a0, a1, color, th, life)
			local origin = view.Rig.Root.Position + V(0, up, 0)
			local flat = V(target.X, origin.Y, target.Z)
			FX.Arc(CFrame.lookAt(origin, flat), math.max((flat - origin).Magnitude * mult, minR), rad(a0), rad(a1), color, th, life)
		end
		if kind == "Melee" then
			at(h, function()
				local target = center(firstId)
				if target then
					arcTo(target, 1, 0.6, 3, 20, 150, COL.Dirt, 0.6, 0.3)
					debris(ground(target) + V(0, 0.5, 0), COL.Dirt, 3, 0.35, 5, 0.6, Mat.Ground)
					FX.Sound("HeavyHit", 0.8, 1, target)
				end
			end)
		elseif kind == "Pulse" then
			at(h, function()
				flash(muzzle0, COL.Bell, 1.6, 0.25)
			end)
		elseif kind == "Flask" then
			at(h, function()
				FX.Projectile("Flask", rend.MuzzlePos(view), function() return center(firstId) end, p.TR or 0.4, nil, lv)
			end)
		elseif kind == "Pierce" then
			at(h, function()
				FX.Sphere(rend.MuzzlePos(view), 1.8, COL.Blue, 0.25)
			end)
		elseif kind == "Thread" then
			at(h, function()
				for _, tid in ipairs(p.T or {}) do
					local target = center(tid)
					if target then
						FX.Thread(rend.MuzzlePos(view), target, def.ThreadColor or COL.Red)
					end
				end
				FX.Sound("Magic", 0.8, 0.7, view.Pos)
			end)
		elseif kind == "AOE" then
			at(h, function()
				if id == "NightWatchman" then
					flash(rend.MuzzlePos(view), COL.Light, 1.5, 0.2)
				elseif id == "HeadlessExecutioner" then
					local target = center(firstId)
					if target then
						arcTo(target, 2, 0.7, 4, 10, 160, COL.Ember, 1.1, 0.35)
					end
				end
			end)
		elseif kind == "Projectile" and def.Projectile == "Crow" then
			for si, tid in ipairs(p.T or { firstId }) do
				local travel = (p.TRS and p.TRS[si]) or p.TR or 0.3
				at(h + (si - 1) * (p.SG or 0.12), function()
					crowFly(rend.MuzzlePos(view), function() return center(tid) end, travel, function(pos)
						FX.Burst(pos, COL.Black, 5, 0.3, 5)
					end)
				end)
			end
		else
			return false
		end
		return true
	end

	------------------------------------------------------------------------
	-- «Призрачная корона»: синяя копия юнита за спиной повторяет атаку
	------------------------------------------------------------------------
	local STRIP = { ParticleEmitter = true, BillboardGui = true, PointLight = true, Trail = true, Motor6D = true, Highlight = true }
	FX.Fn.EchoGhost = function(view)
		if not view.Rig or not view.Rig.Model.Parent or (FX.Lite and rng:NextNumber() < 0.5) then
			return
		end
		local model = view.Rig.Model
		local was = model.Archivable
		model.Archivable = true
		local ok, clone = pcall(function() return model:Clone() end)
		model.Archivable = was
		if not ok or not clone then
			return
		end
		local parts = {}
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.CastShadow = false
				if d.Transparency < 1 then
					d.Color = COL.Ghost
					d.Material = Mat.Neon
					d.Transparency = 0.55
					parts[#parts + 1] = d
				end
			elseif STRIP[d.ClassName] then
				d:Destroy()
			end
		end
		local root = view.Rig.Root.CFrame
		local back = root * CF(0, 0.3, 2.4)
		local fwd = root * CF(0, 0.3, -0.6)
		clone:PivotTo(back)
		clone.Parent = FX.Folder
		FX.Run(function(t)
			if t >= 0.7 or not clone.Parent then
				clone:Destroy()
				return true
			end
			clone:PivotTo(back:Lerp(fwd, math.clamp(t / 0.25, 0, 1) * 0.7))
			local tr = 0.55 + math.clamp((t - 0.35) / 0.35, 0, 1) * 0.45
			for _, d in ipairs(parts) do
				d.Transparency = tr
			end
			return false
		end)
	end

	------------------------------------------------------------------------
	-- Король фонарей: трон поднимается из огня
	------------------------------------------------------------------------
	FX.Fn.ThronePlace = function(pos)
		local g = ground(pos)
		local low = V(0, 3, 0)
		local list = {
			FX.Part({ Size = V(4, 0.6, 3.5), CFrame = CF(g - low), Color = COL.Black, Material = Mat.Slate }),
			FX.Part({ Size = V(4, 6, 0.6), CFrame = CF(g + V(0, 0, 1.6) - low), Color = COL.Black, Material = Mat.Slate }),
			FX.Part({ Size = V(4.3, 0.3, 0.7), CFrame = CF(g + V(0, 3, 1.6) - low), Color = COL.Gold }),
		}
		for _, q in ipairs(list) do
			local up = q.CFrame + V(0, 3.3, 0)
			FX.Tween(q, 0.6, { CFrame = up }, Enum.EasingStyle.Back)
			task.delay(1.6, function()
				FX.Fade(q, 0.6, { CFrame = up - V(0, 2, 0) })
			end)
		end
		FX.Ring(g, 6, COL.Ember, 0.8, 0.5, 1, 0.1)
		FX.Burst(g + V(0, 1, 0), COL.Fire, 20, 0.45, 10, 0.8)
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			local q = g + V(math.cos(a) * 4, 0, math.sin(a) * 4)
			local pk = FX.Part({ Size = V(1, 0.8, 1), CFrame = CF(q - V(0, 1, 0)), Color = PUMPKIN, Material = Mat.SmoothPlastic })
			FX.Tween(pk, 0.5, { CFrame = CF(q + V(0, 0.4, 0)) }, Enum.EasingStyle.Back)
			task.delay(1.8, function()
				FX.Fade(pk, 0.5)
			end)
		end
		flash(g + V(0, 3, 0), COL.Orange, 5, 0.8)
		FX.Sound("Secret", 0.6, 1.2, g)
	end
end
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX26D248BF0A072FF336F61373A7CFA749">
						<Properties>
							<string name="Name">Void</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: FX/Void — эффекты способностей Пустоты, Расколотой реальности и Кровавой луны
-- Регистрирует FX.Shockwave, FX.Reap, FX.Judgement, FX.BlackHole, FX.CrystalBurst, FX.FallingShard,
-- FX.RiftPortal, FX.BigRift, FX.RedSplash, FX.Cleave, FX.Hammer, FX.BloodMoonFall, FX.BloodMoonBoom,
-- FX.PierceBeam (+ те же в FX.Fn) и удары Impact: Shockwave Reap Crystal Hammer Shard Rift BigRift Splash
-- Cleave BloodMoonFall BloodMoon Pierce Judgement BlackHole.

return function(FX)
	local V = Vector3.new
	local CF = CFrame.new
	local ANG = CFrame.Angles
	local rad = math.rad
	local rng = FX.Rng
	local C = FX.Colors
	local NEON, SOFT, PINK, WHITE, RED, GOLD, BLUE = C.Neon, C.Soft, C.Pink, C.White, C.Red, C.Gold, C.Blue
	local rgb = Color3.fromRGB
	local CYL = Enum.PartType.Cylinder
	local BALL = Enum.PartType.Ball
	local FLAT = ANG(0, 0, rad(90))
	local Quad, Back = Enum.EasingStyle.Quad, Enum.EasingStyle.Back
	local In = Enum.EasingDirection.In

	local function reg(name, fn)
		FX[name] = fn
		FX.Fn[name] = fn
	end

	-- ударная волна: кольца, трещины, камни, вспышка; на 5 уровне — столб и сферы
	reg("Shockwave", function(pos, radius, lv, color, soft)
		lv = lv or 1
		local col = color or NEON
		local sft = soft or SOFT
		local g = V(pos.X, pos.Y + 0.2, pos.Z)
		FX.Sound("Explosion", 1, 1, pos)
		local cam = workspace.CurrentCamera
		if cam and (cam.CFrame.Position - pos).Magnitude < 70 then
			FX.Shake(lv >= 5 and 0.5 or 0.25, 0.35)
		end
		FX.Ring(g, radius, col, 0.55, 0.5, 1, 0.05)
		FX.Ring(g + V(0, 0.15, 0), radius * 0.75, WHITE, 0.4, 0.3, 0.5, 0.2)
		task.delay(0.08, function()
			FX.Ring(g + V(0, 0.1, 0), radius * 1.05, sft, 0.6, 0.25, radius * 0.4, 0.4)
		end)
		FX.Cracks(g, radius, col, 6 + lv * 2, 1.4)
		if not FX.Lite then
			for _ = 1, 6 + lv do
				local a = rng:NextNumber(0, math.pi * 2)
				local r = rng:NextNumber(1, math.max(1, radius * 0.8))
				local p = g + V(math.cos(a) * r, 0, math.sin(a) * r)
				local rock = FX.Part({ Size = V(0.6, 0.6, 0.6), CFrame = CF(p), Color = rgb(50, 44, 60), Material = Enum.Material.Slate })
				FX.Tween(rock, 0.25, { CFrame = CF(p + V(0, rng:NextNumber(1.5, 3), 0)) * ANG(1, 2, 0) })
				task.delay(0.25, function()
					if rock.Parent then
						FX.Tween(rock, 0.3, { CFrame = CF(p) * ANG(2, 1, 1), Transparency = 1 }, Quad, In)
					end
				end)
				FX.Cleanup(rock, 0.6)
			end
		end
		local flash = FX.Part({ Size = V(0.2, 0.2, 0.2), CFrame = CF(g + V(0, 2, 0)), Transparency = 1 })
		FX.Light(flash, col, radius * 2.5, 5, 0.6)
		FX.Cleanup(flash, 0.7)
		if lv >= 5 then
			FX.Sphere(g, radius * 0.7, col, 0.6)
			FX.Sphere(g, radius * 0.45, WHITE, 0.4)
			local pillar = FX.Part({ Shape = CYL, Size = V(18, 3, 3), CFrame = CF(g + V(0, 9, 0)) * FLAT, Color = col, Transparency = 0.2 })
			FX.Tween(pillar, 0.6, { Size = V(26, 0.2, 0.2), Transparency = 1 })
			FX.Cleanup(pillar, 0.7)
			FX.Burst(g + V(0, 1, 0), sft, 20, 0.6, 16, 0.6)
		end
	end)

	-- удар косы: горизонтальная дуга + тёмная дуга + кольцо области
	reg("Reap", function(unitPos, center, radius, lv, color)
		lv = lv or 1
		local col = color or NEON
		local dir = center - unitPos
		dir = V(dir.X, 0, dir.Z)
		if dir.Magnitude < 0.1 then
			dir = V(0, 0, -1)
		end
		dir = dir.Unit
		local c = V(center.X, center.Y + 1.5, center.Z)
		local cf = CFrame.lookAt(c - dir * 1.5, c + dir)
		FX.Arc(cf, radius * 0.9, rad(-80), rad(80), col, 0.6 + lv * 0.08, 0.4, true)
		FX.Arc(cf * CF(0, -0.4, 0), radius * 0.75, rad(-70), rad(70), rgb(30, 10, 50), 0.5, 0.45, true)
		FX.Ring(V(center.X, center.Y + 0.15, center.Z), radius, rgb(90, 30, 150), 0.4, 0.2, radius * 0.3, 0.45)
		if lv >= 4 then
			FX.Burst(center + V(0, 1, 0), col, 10, 0.4, 8)
		end
	end)

	-- VOID JUDGEMENT: разрезы, луч с неба
	reg("Judgement", function(pos, lv, hitIndex)
		lv = lv or 1
		hitIndex = hitIndex or 1
		FX.Sound("Magic", 1, 0.9 + hitIndex * 0.08, pos)
		local col = hitIndex % 2 == 0 and NEON or PINK
		local p = pos + V(0, 2, 0)
		FX.SlashMark(p, rad(35 + rng:NextNumber(-10, 10)), 9 + lv, 0.7 + lv * 0.08, col, 0.45)
		if lv >= 3 then
			FX.SlashMark(p, rad(-35 + rng:NextNumber(-10, 10)), 8 + lv, 0.6, NEON, 0.4)
		end
		local beam = FX.Part({ Shape = CYL, Size = V(30, 1.4, 1.4), CFrame = CF(pos + V(0, 15, 0)) * FLAT, Color = col, Transparency = 0.3 })
		FX.Tween(beam, 0.35, { Size = V(30, 0.1, 0.1), Transparency = 1 })
		FX.Cleanup(beam, 0.4)
		FX.Burst(p, col, 8, 0.45, 9)
		FX.Ring(V(pos.X, pos.Y + 0.15, pos.Z), 3 + lv * 0.4, col, 0.4, 0.25)
	end)

	-- ЧЁРНАЯ ДЫРА: ядро, диск, вращающиеся рукава, частицы внутрь
	reg("BlackHole", function(pos, radius, duration, lv, delay)
		lv = lv or 1
		duration = duration or 2
		task.delay(delay or 0, function()
			FX.Sound("Portal", 1, 1, pos)
			local center = pos + V(0, 2.2, 0)
			local m = Instance.new("Model")
			m.Name = "BlackHole"
			m.Parent = FX.Folder
			local core = FX.Part({ Shape = BALL, Size = V(0.5, 0.5, 0.5), CFrame = CF(center), Color = rgb(0, 0, 0), Material = Enum.Material.SmoothPlastic, Parent = m })
			local glow = FX.Part({ Shape = BALL, Size = V(0.6, 0.6, 0.6), CFrame = CF(center), Color = NEON, Transparency = 0.55, Parent = m })
			local disk = FX.Part({ Shape = CYL, Size = V(0.15, 1, 1), CFrame = CF(pos + V(0, 0.2, 0)) * FLAT, Color = rgb(60, 20, 100), Transparency = 0.35, Parent = m })
			local edge = FX.Part({ Shape = CYL, Size = V(0.1, 1, 1), CFrame = CF(pos + V(0, 0.25, 0)) * FLAT, Color = NEON, Transparency = 0.5, Parent = m })
			FX.Light(glow, NEON, radius * 2.5, 3)
			local cs = 2.2 + lv * 0.35
			FX.Tween(core, 0.4, { Size = V(cs, cs, cs) }, Back)
			FX.Tween(disk, 0.4, { Size = V(0.15, radius * 2, radius * 2) })
			FX.Tween(edge, 0.4, { Size = V(0.1, radius * 2 + 0.6, radius * 2 + 0.6) })
			local arms = {}
			for i = 1, FX.Lite and 2 or (4 + (lv >= 5 and 2 or 0)) do
				arms[i] = FX.Part({ Size = V(0.35, 0.2, radius * 0.9), Color = (i % 2 == 0) and NEON or SOFT, Transparency = 0.2, Parent = m })
			end
			local em = Instance.new("ParticleEmitter")
			em.Color = ColorSequence.new(NEON)
			em.LightEmission = 1
			em.Rate = 30 + lv * 8
			em.Lifetime = NumberRange.new(0.5, 0.8)
			em.Speed = NumberRange.new(-radius * 1.6, -radius * 1.2)
			em.SpreadAngle = Vector2.new(180, 180)
			em.Size = NumberSequence.new(0.5, 0)
			em.Parent = glow
			local g15 = cs * 1.5
			local low = center + V(0, -1.6, 0)
			FX.Run(function(t)
				if t > duration or not m.Parent then
					return true
				end
				local n = #arms
				for i, a in ipairs(arms) do
					local ang = t * 4 + i / n * math.pi * 2
					local r = radius * 0.55
					local p = center + V(math.cos(ang) * r, -1.6 + math.sin(t * 3 + i) * 0.3, math.sin(ang) * r)
					a.CFrame = CFrame.lookAt(p, low) * ANG(0, rad(70), 0)
				end
				-- пульсация свечения
				local s = g15 * (1 + math.sin(t * 8) * 0.06)
				glow.Size = V(s, s, s)
				return false
			end)
			task.delay(duration, function()
				em.Enabled = false
				for _, d in ipairs(m:GetChildren()) do
					if d:IsA("BasePart") then
						FX.Tween(d, 0.35, { Size = V(0.05, 0.05, 0.05), Transparency = 1 }, Back, In)
					end
				end
				task.delay(0.3, function()
					FX.Sphere(center, radius * 0.6, NEON, 0.35)
				end)
				FX.Cleanup(m, 0.8)
			end)
		end)
	end)

	-- кристаллический взрыв (Crystal Hunter)
	reg("CrystalBurst", function(pos, radius)
		FX.Sphere(pos, radius * 0.6, BLUE, 0.3)
		FX.Ring(V(pos.X, pos.Y + 0.2, pos.Z), radius, rgb(170, 225, 255), 0.35, 0.25)
		FX.Burst(pos + V(0, 1, 0), BLUE, 8, 0.35, 8)
		FX.Sound("Explosion", 0.5, 1.6, pos)
	end)

	-- падающий звёздный осколок
	reg("FallingShard", function(pos, radius, color)
		local col = color or GOLD
		local top = pos + V(rng:NextNumber(-3, 3), 22, rng:NextNumber(-3, 3))
		local shard = FX.Part({ Size = V(0.7, 2.2, 0.7), CFrame = CF(top) * ANG(0, rng:NextNumber(0, 6), rad(15)), Color = col })
		FX.Tween(shard, 0.28, { CFrame = CF(pos + V(0, 1, 0)) * ANG(0, 2, rad(15)) }, Quad, In)
		task.delay(0.28, function()
			shard:Destroy()
			FX.Ring(V(pos.X, pos.Y + 0.2, pos.Z), radius, col, 0.35, 0.3)
			FX.Sphere(pos + V(0, 0.5, 0), radius * 0.4, rgb(255, 240, 200), 0.25)
			FX.Burst(pos + V(0, 1, 0), col, 6, 0.4, 8)
		end)
	end)

	-- маленький портал с разрезом (RIFT STORM)
	reg("RiftPortal", function(pos, lv)
		lv = lv or 1
		local c = pos + V(0, 3.5, 0)
		local cf = CF(c) * ANG(0, rng:NextNumber(0, 6), 0)
		local ring = FX.Part({ Shape = CYL, Size = V(0.2, 0.5, 0.5), CFrame = cf, Color = NEON })
		FX.Tween(ring, 0.15, { Size = V(0.2, 3.2, 3.2) }, Back)
		local core = FX.Part({ Shape = CYL, Size = V(0.25, 0.3, 0.3), CFrame = cf, Color = rgb(15, 0, 30) })
		FX.Tween(core, 0.15, { Size = V(0.25, 2.4, 2.4) }, Back)
		task.delay(0.15, function()
			FX.SlashMark(pos + V(0, 1.5, 0), rad(rng:NextNumber(-50, 50)), 6 + lv * 0.5, 0.5, PINK, 0.3)
			FX.Burst(pos + V(0, 1, 0), NEON, 6, 0.35, 7)
			if ring.Parent then
				FX.Tween(ring, 0.25, { Size = V(0.1, 0.2, 0.2), Transparency = 1 })
				FX.Tween(core, 0.25, { Size = V(0.1, 0.1, 0.1), Transparency = 1 })
			end
		end)
		FX.Cleanup(ring, 0.45)
		FX.Cleanup(core, 0.45)
		FX.Sound("Portal", 0.5, 1.4, pos)
	end)

	-- большой центральный разлом
	reg("BigRift", function(pos, radius)
		local g = V(pos.X, pos.Y + 0.2, pos.Z)
		local disk = FX.Part({ Shape = CYL, Size = V(0.2, 1, 1), CFrame = CF(g) * FLAT, Color = rgb(15, 0, 30) })
		FX.Tween(disk, 0.25, { Size = V(0.2, radius * 2, radius * 2) }, Back)
		FX.Ring(g, radius * 1.1, NEON, 0.6, 0.5, 1, 0.05)
		FX.Ring(g + V(0, 0.1, 0), radius * 0.8, PINK, 0.5, 0.3, 0.5)
		for i = 1, 4 do
			task.delay(i * 0.05, function()
				local off = V(rng:NextNumber(-radius / 2, radius / 2), 2, rng:NextNumber(-radius / 2, radius / 2))
				FX.SlashMark(g + off, rad(rng:NextNumber(-60, 60)), 9, 0.7, NEON, 0.4)
			end)
		end
		task.delay(0.35, function()
			if disk.Parent then
				FX.Tween(disk, 0.35, { Size = V(0.1, 0.5, 0.5), Transparency = 1 })
			end
		end)
		FX.Cleanup(disk, 0.8)
		FX.Shake(0.4, 0.4)
		FX.Sound("Explosion", 1, 0.7, pos)
	end)

	-- RED SPLASH: красная волна, вспышка и осколки из меча
	reg("RedSplash", function(pos, radius, from)
		local g = V(pos.X, pos.Y + 0.2, pos.Z)
		FX.Ring(g, radius, RED, 0.5, 0.5, 1, 0.05)
		FX.Ring(g + V(0, 0.12, 0), radius * 0.7, rgb(255, 150, 150), 0.35, 0.25, 0.5, 0.2)
		local flash = FX.Part({ Shape = CYL, Size = V(0.08, radius * 1.6, radius * 1.6), CFrame = CF(g + V(0, 0.05, 0)) * FLAT, Color = RED, Transparency = 0.3 })
		FX.Tween(flash, 0.3, { Transparency = 1 })
		FX.Cleanup(flash, 0.35)
		FX.Sphere(pos + V(0, 1, 0), 2.5, RED, 0.25)
		if from then
			for _ = 1, FX.Lite and 2 or 6 do
				local to = g + V(rng:NextNumber(-radius, radius) * 0.7, 0.5, rng:NextNumber(-radius, radius) * 0.7)
				local shard = FX.Part({ Size = V(0.25, 0.25, 1.1), CFrame = CFrame.lookAt(from, to), Color = RED })
				FX.Tween(shard, 0.25, { CFrame = CFrame.lookAt(to, to + (to - from)), Transparency = 0.6 })
				FX.Cleanup(shard, 0.27)
			end
		end
		FX.Cracks(g, radius * 0.8, RED, 6, 0.9)
		FX.Sound("HeavyHit", 1, 0.9, pos)
	end)

	-- рассекающий удар топора
	reg("Cleave", function(unitPos, center, radius, color)
		local col = color or RED
		FX.Reap(unitPos, center, radius, 4, col)
		FX.Ring(V(center.X, center.Y + 0.2, center.Z), radius, col, 0.4, 0.3)
		FX.Sound("HeavyHit", 1, 1, center)
	end)

	-- молот Starbreaker
	reg("Hammer", function(pos, radius, lv)
		FX.Shockwave(pos, radius, lv or 1, GOLD, rgb(200, 140, 255))
	end)

	-- кровавая луна падает с неба
	reg("BloodMoonFall", function(pos, radius, delay)
		delay = delay or 1
		local moon = FX.Part({ Shape = BALL, Size = V(5, 5, 5), CFrame = CF(pos + V(0, 45, 0)), Color = RED })
		FX.Light(moon, RED, 40, 4)
		local mark = FX.Part({ Shape = CYL, Size = V(0.1, radius * 2, radius * 2), CFrame = CF(pos + V(0, 0.25, 0)) * FLAT, Color = RED, Transparency = 0.75 })
		FX.Tween(moon, delay, { CFrame = CF(pos + V(0, 2, 0)), Size = V(7, 7, 7) }, Quad, In)
		FX.Tween(mark, delay, { Transparency = 0.4 })
		FX.Cleanup(moon, delay)
		FX.Cleanup(mark, delay)
		FX.Sound("Boss", 0.6, 1.4, pos)
	end)

	reg("BloodMoonBoom", function(pos, radius)
		FX.Shockwave(pos, radius, 5, RED, rgb(255, 140, 140))
		FX.Sphere(pos + V(0, 2, 0), radius * 0.6, rgb(120, 0, 15), 0.6, Enum.Material.Neon, 0.3)
		FX.Shake(0.6, 0.6)
	end)

	-- пробивающий лунный луч
	reg("PierceBeam", function(from, to)
		FX.Beam(from + V(0, 3, 0), to + V(0, 1.5, 0), 2.2, rgb(255, 190, 215), 0.45, true)
		FX.Sound("Laser", 1, 1.2, from)
	end)

	------------------------------------------------------------------------
	-- УДАРЫ (Impact)
	------------------------------------------------------------------------
	local Config = FX.Env.Config

	local function unitOf(p)
		local v = p.U and FX.UnitView(p.U)
		local def = v and Config.Units[v.UnitId]
		return v, def
	end

	local I = FX.RegisterImpact
	I("Shockwave", function(p) FX.Shockwave(p.P, p.R or 6, p.L or 1) end)
	I("Reap", function(p)
		local v, def = unitOf(p)
		FX.Reap((v and v.Pos) or p.P, p.P, p.R or 6, p.L or 1, def and def.ImpactColor)
		FX.Sound("Slash", 1, 0.8, p.P)
	end)
	I("Crystal", function(p) FX.CrystalBurst(p.P, p.R or 4) end)
	I("Hammer", function(p) FX.Hammer(p.P, p.R or 6, p.L or 1) end)
	I("Shard", function(p) FX.FallingShard(p.P, p.R or 4) end)
	I("Rift", function(p) FX.RiftPortal(p.P, p.L or 1) end)
	I("BigRift", function(p) FX.BigRift(p.P, p.R or 8) end)
	I("Splash", function(p)
		local v = unitOf(p)
		FX.RedSplash(p.P, p.R or 6, v and FX.MuzzlePos(v) or nil)
	end)
	I("Cleave", function(p)
		local v = unitOf(p)
		FX.Cleave((v and v.Pos) or p.P, p.P, p.R or 6)
	end)
	I("BloodMoonFall", function(p) FX.BloodMoonFall(p.P, p.R or 10, p.DL) end)
	I("BloodMoon", function(p) FX.BloodMoonBoom(p.P, p.R or 10) end)
	I("Pierce", function(p) FX.PierceBeam(p.P, p.E or p.P) end)
	I("Judgement", function(p) FX.Judgement(p.P, p.L or 1, p.H) end)
	I("BlackHole", function(p) FX.BlackHole(p.P, p.R or 8, p.DUR or 2, p.L or 1, p.DL) end)
end
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="ModuleScript" referent="RBXBD8BDEFF4787BD152284A94B97DDD59B">
					<Properties>
						<string name="Name">Input</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Input (клиент) — клавиши, мышь, касания и подсветка юнита под курсором.
--   1–6 — юнит из слота; Q/Esc — отмена/закрыть; R — повернуть; E — улучшить; X — продать;
--   T — цель; G — окно ЮНИТЫ; ЛКМ — поставить/выбрать; ПКМ — отмена; касание — двигать призрак/выбрать.
--
-- API
--   Input.Init(ctx) ; Input.Update(dt) (подсветка раз в 0.05 с) ; Input.UnitUnder(screenPos, isTouch) -> uid, model

local UserInputService = game:GetService("UserInputService")

local Input = {}

local KC = Enum.KeyCode
local UIT = Enum.UserInputType
local SLOT_KEYS = { [KC.One] = 1, [KC.Two] = 2, [KC.Three] = 3, [KC.Four] = 4, [KC.Five] = 5, [KC.Six] = 6 }

local ctx, UI, Placement, Renderer
local hover
local hoverAcc = 0
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include

-- юнит под точкой экрана: модель с атрибутом Uid (поднимаемся по предкам-моделям)
function Input.UnitUnder(screenPos, isTouch)
	local cam = workspace.CurrentCamera
	local folder = Renderer.UnitFolder
	if not cam or not folder then
		return nil
	end
	local ray = isTouch and cam:ScreenPointToRay(screenPos.X, screenPos.Y) or cam:ViewportPointToRay(screenPos.X, screenPos.Y)
	params.FilterDescendantsInstances = { folder }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 600, params)
	if not hit then
		return nil
	end
	local m = hit.Instance:FindFirstAncestorOfClass("Model")
	while m and m:GetAttribute("Uid") == nil do
		m = m:FindFirstAncestorOfClass("Model")
	end
	if m then
		return m:GetAttribute("Uid"), m
	end
	return nil
end

local function onBegan(input, gp)
	local t = input.UserInputType
	if t == UIT.Keyboard then
		local k = input.KeyCode
		if gp and k ~= KC.Escape then
			return -- печать в чате / текстовом поле
		end
		local slot = SLOT_KEYS[k]
		if slot then
			local id = UI.EquippedAt(slot)
			if id then
				Placement.Start(id)
			end
		elseif k == KC.Q or k == KC.Escape then
			if Placement.Active then
				Placement.Stop()
			else
				UI.CloseUnit()
			end
		elseif k == KC.R then
			if Placement.Active then
				Placement.Rotate()
			end
		elseif k == KC.E then
			UI.UpgradeSelected()
		elseif k == KC.X then
			UI.SellSelected()
		elseif k == KC.T then
			UI.CycleTarget()
		elseif k == KC.G then
			UI.Toggle("Inventory")
		end
	elseif t == UIT.MouseButton1 then
		if gp then
			return -- клик по интерфейсу
		end
		if Placement.Active then
			Placement.Confirm()
		else
			local uid = Input.UnitUnder(UserInputService:GetMouseLocation(), false)
			if uid then
				UI.OpenUnit(uid)
			else
				UI.CloseUnit()
			end
		end
	elseif t == UIT.MouseButton2 then
		if Placement.Active then
			Placement.Stop()
		end
	elseif t == UIT.Touch then
		if gp then
			return
		end
		local pos = Vector2.new(input.Position.X, input.Position.Y)
		if Placement.Active then
			Placement.SetTouch(pos) -- ставит кнопка PLACE
		else
			local uid = Input.UnitUnder(pos, true)
			if uid then
				UI.OpenUnit(uid)
			end
		end
	end
end

function Input.Init(c)
	ctx = c
	UI, Placement, Renderer = c.UI, c.Placement, c.Renderer
	hover = Instance.new("Highlight")
	hover.Name = "VoidTD_Hover"
	hover.FillTransparency = 1
	hover.OutlineColor = Color3.fromRGB(220, 160, 255)
	hover.OutlineTransparency = 0.1
	hover.DepthMode = Enum.HighlightDepthMode.Occluded
	if Input.Conn then
		Input.Conn:Disconnect()
	end
	Input.Conn = UserInputService.InputBegan:Connect(onBegan)
end

function Input.Update(dt)
	hoverAcc += dt
	if hoverAcc < 0.05 then
		return
	end
	hoverAcc = 0
	if Placement.Active or not UserInputService.MouseEnabled then
		hover.Parent = nil
		return
	end
	local _, model = Input.UnitUnder(UserInputService:GetMouseLocation(), false)
	if model then
		hover.Adornee = model
		hover.Parent = model
	else
		hover.Parent = nil
	end
end

return Input
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX55D100FA000B021378180E59E3F274C3">
					<Properties>
						<string name="Name">Net</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Net (клиент) — запросы к серверу и подписка на события.
-- Протокол — ReplicatedStorage.VoidTD.Net (не менять).
--
-- API
--   Net.Init(ctx) -> Request          -- Request(action, data) -> a, b; ошибку сервера показывает тостом
--   Net.Connect(ctx)                  -- Profile, EnemySpawn, Sync, Attack, Impact, Notify
--   Net.Connections                   -- подключения (для отладки/очистки)

local Net = {}
Net.Connections = {}

local ctx

function Net.Init(c)
	ctx = c
	local fn = c.Remotes:WaitForChild("Request")
	local function request(action, data)
		local ok, a, b = pcall(fn.InvokeServer, fn, action, data)
		local UI = ctx.UI
		if not ok then
			if UI and UI.Toast then
				UI.Toast("Нет связи с сервером", "error")
			end
			return false
		end
		if a == false and b ~= nil and UI and UI.Toast then
			UI.Toast(tostring(b), "error")
		end
		return a, b
	end
	Net.Request = request
	return request
end

local function on(name, fn)
	local ev = ctx.Remotes:WaitForChild(name)
	Net.Connections[#Net.Connections + 1] = ev.OnClientEvent:Connect(function(...)
		local ok, err = pcall(fn, ...)
		if not ok then
			warn("[VOID TD] " .. name .. ": " .. tostring(err))
		end
	end)
end

function Net.Connect(c)
	ctx = c or ctx
	local UI, Renderer, FX, Placement = ctx.UI, ctx.Renderer, ctx.FX, ctx.Placement

	on("Profile", function(p)
		if type(p) == "table" then
			UI.SetProfile(p)
		end
	end)
	on("EnemySpawn", Renderer.SpawnEnemy)
	on("Sync", Renderer.OnSync)
	on("Attack", Renderer.OnAttack)
	on("Impact", Renderer.OnImpact)
	on("Notify", function(p)
		if type(p) ~= "table" then
			return
		end
		UI.OnNotify(p)
		local kind = p.Type
		if kind == "CoreHit" then
			local map = Renderer.ActiveMap()
			local core = map and map:FindFirstChild("VoidCore")
			local c0 = core and core:GetAttribute("CoreCenter")
			if typeof(c0) == "Vector3" then
				FX.Sphere(c0, 6, FX.Colors.Pink, 0.4)
				FX.Burst(c0, FX.Colors.Pink, 10, 0.6, 10)
			end
		elseif kind == "Reset" then
			Placement.Stop()
		elseif kind == "WaveClear" or kind == "Victory" then
			Renderer.Cheer()
		end
	end)
end

return Net
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX7CE1D2E1BEA0A0A535EE9041EFCB3062">
					<Properties>
						<string name="Name">Placement</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Placement (клиент) — «призрак» юнита под курсором, круг дальности, проверка места.
-- Сервер всё перепроверяет (Placeable, дорога, деньги, лимиты).
--
-- API
--   Placement.Init(ctx) ; Placement.Start(unitId) ; Placement.Stop() ; Placement.Confirm()
--   Placement.Rotate() ; Placement.SetTouch(screenPos) ; Placement.Active

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Placement = {}
Placement.Active = false

local player = Players.LocalPlayer
local V = Vector3.new
local GOOD = Color3.fromRGB(80, 230, 140)
local BAD = Color3.fromRGB(255, 70, 90)
local NO_PLACE = "Сюда ставить нельзя"

local ctx, Config, Path, UnitModels, FX, UI, Renderer
local unitId, def, ghost, circle, disc, conn
local rotation = 0
local lastPos, valid, reason
local touchPos
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Include

function Placement.Init(c)
	ctx = c
	Config, Path, UnitModels, FX, UI, Renderer = c.Config, c.Path, c.UnitModels, c.FX, c.UI, c.Renderer
end

local function isTouch()
	return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

local function money()
	return player:GetAttribute("Money") or 0
end

local function cost()
	return def and def.Levels[1].Cost or math.huge
end

-- луч из камеры: точка касания, иначе курсор (на тач-экране до первого касания — центр экрана)
local function castRay(map)
	local cam = workspace.CurrentCamera
	if not cam then
		return nil
	end
	local ray
	if touchPos then
		ray = cam:ScreenPointToRay(touchPos.X, touchPos.Y)
	elseif isTouch() then
		local vs = cam.ViewportSize
		ray = cam:ViewportPointToRay(vs.X / 2, vs.Y / 2)
	else
		local m = UserInputService:GetMouseLocation()
		ray = cam:ViewportPointToRay(m.X, m.Y)
	end
	params.FilterDescendantsInstances = { map }
	return workspace:Raycast(ray.Origin, ray.Direction * 800, params)
end

local function check(hit)
	if not hit or not hit.Instance:GetAttribute("Placeable") then
		return false, NO_PLACE
	end
	local pos = hit.Position
	local ok, why = Path.IsPlacementClear(pos)
	if not ok then
		return false, why or NO_PLACE
	end
	local mine, same = 0, 0
	for _, v in pairs(Renderer.UnitViews) do
		if v.Pos and Path.FlatDistance(v.Pos, pos) < Config.Settings.PlacementSpacing then
			return false, "Слишком близко к другому юниту"
		end
		if v.Folder and v.Folder:GetAttribute("OwnerId") == player.UserId then
			mine += 1
			if v.UnitId == unitId then
				same += 1
			end
		end
	end
	if money() < cost() then
		return false, "Недостаточно денег"
	end
	if mine >= Config.Settings.MaxUnitsPerPlayer then
		return false, "Лимит юнитов"
	end
	local rar = Config.Rarities[def.Rarity]
	if rar and rar.PlacementLimit and same >= rar.PlacementLimit then
		return false, "Лимит этого юнита"
	end
	return true, nil
end

local function update()
	if not ghost then
		return
	end
	local map = Renderer.ActiveMap()
	if not map then
		valid, reason = false, NO_PLACE
		return
	end
	local hit = castRay(map)
	if not hit then
		valid, reason = false, NO_PLACE
		return
	end
	lastPos = hit.Position
	valid, reason = check(hit)
	local color = valid and GOOD or BAD
	ghost.Root.CFrame = CFrame.new(lastPos + V(0, ghost.HipHeight or 0, 0)) * CFrame.Angles(0, math.rad(rotation), 0)
	local r = def.Levels[1].Range or 10
	local flat = CFrame.Angles(0, 0, math.rad(90))
	circle.Size = V(0.15, r * 2, r * 2)
	circle.CFrame = CFrame.new(lastPos + V(0, 0.22, 0)) * flat
	circle.Color = color
	disc.CFrame = CFrame.new(lastPos + V(0, 0.25, 0)) * flat
	disc.Color = color
	for _, d in ipairs(ghost.Model:GetChildren()) do
		if d:IsA("Highlight") then
			d.FillColor = color
			d.OutlineColor = color
		end
	end
end

function Placement.Stop()
	Placement.Active = false
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if ghost then
		ghost.Model:Destroy()
		ghost = nil
	end
	if circle then
		circle:Destroy()
		circle = nil
	end
	if disc then
		disc:Destroy()
		disc = nil
	end
	touchPos = nil
	if UI and UI.ShowPlacementHint then
		UI.ShowPlacementHint(false)
	end
end

function Placement.Start(id)
	local d = Config.Units[id]
	if not d then
		return
	end
	Placement.Stop()
	if money() < d.Levels[1].Cost then
		UI.Toast("Недостаточно денег: нужно $" .. Config.FormatNumber(d.Levels[1].Cost), "error")
		return
	end
	local phase = ctx.State:GetAttribute("Phase")
	if phase == "Victory" or phase == "Defeat" or not player:GetAttribute("InMatch") then
		return
	end
	local ok, rig = pcall(UnitModels.Build, id, 1)
	if not ok or not rig then
		warn("[VOID TD] призрак " .. tostring(id) .. ": " .. tostring(rig))
		return
	end
	unitId, def, ghost = id, d, rig
	for _, p in ipairs(rig.Model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanQuery = false
			p.CanTouch = false
			p.CanCollide = false
			p.CastShadow = false
			if p.Transparency < 1 then
				p.Transparency = 0.35 + p.Transparency * 0.5
			end
		elseif p:IsA("ParticleEmitter") or p:IsA("Light") or p:IsA("Trail") then
			p:Destroy()
		end
	end
	local hl = Instance.new("Highlight")
	hl.FillTransparency = 0.75
	hl.OutlineTransparency = 0.2
	hl.DepthMode = Enum.HighlightDepthMode.Occluded
	hl.Parent = rig.Model
	rig.Model.Name = "VoidTD_Ghost"
	rig.Model.Parent = workspace
	circle = FX.Part({ Name = "VoidTD_GhostRange", Shape = Enum.PartType.Cylinder, Transparency = 0.72, Parent = workspace })
	disc = FX.Part({ Name = "VoidTD_GhostDisc", Shape = Enum.PartType.Cylinder, Size = V(0.2, 2.6, 2.6), Transparency = 0.3, Parent = workspace })
	Placement.Active = true
	touchPos = nil
	UI.CloseUnit()
	UI.ShowPlacementHint(true, isTouch())
	conn = RunService.RenderStepped:Connect(update)
	update()
end

function Placement.Rotate()
	rotation = (rotation + 45) % 360
end

function Placement.SetTouch(pos)
	touchPos = pos
	update()
end

function Placement.Confirm()
	if not Placement.Active then
		return
	end
	update()
	if not valid or not lastPos then
		UI.Toast(reason or NO_PLACE, "error")
		return
	end
	local id, price, before = unitId, cost(), money()
	local ok = ctx.Request("Place", { Unit = id, Position = lastPos, Rotation = rotation })
	if not ok then
		return -- причину уже показал Request
	end
	-- Shift — ставить ещё; деньги на атрибуте могут обновиться не сразу
	local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	local left = math.min(money(), before - price)
	if not (shift and left >= price and unitId == id) then
		Placement.Stop()
	end
end

return Placement
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX7616532E40659854C0230E1C49C22949">
					<Properties>
						<string name="Name">Render</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Render — оркестратор отрисовки боя (клиент). Только картинка: урон и позиции считает сервер.
-- Дети: Enemies (враги), Units (юниты игроков), Allies (союзники-призывы на дороге).
--
-- API
--   Renderer.Init(ctx)
--   Renderer.SpawnEnemy(data) ; RemoveEnemy(id, reason) ; ClearEnemies()
--   Renderer.OnSync(p) ; OnAttack(p) ; OnImpact(p)
--   Renderer.AddUnit(folder, isNew) ; RemoveUnit(folder) ; RebuildUnits() ; Cheer()
--   Renderer.ClearAllies() ; Update(dt)
--   Renderer.EnemyViews / UnitViews / AllyViews ; EnemyCenter(id) ; EnemyPosition(id) ; MuzzlePos(view) ; ActiveMap()
--   Renderer.UnitFolder / EnemyFolder / AllyFolder ; хуки OnUnitChanged(uid), OnUnitRemoved(uid)
--   предпросмотр (окно юнита): PreviewStep(state, t), PreviewAttack(state, unitId, level),
--   PreviewAbility(state, name), PreviewFidget(state, unitId)

local Renderer = {}

local Enemies = require(script:WaitForChild("Enemies"))
local Units = require(script:WaitForChild("Units"))
local Allies = require(script:WaitForChild("Allies"))

local ctx, Config, Path, FX, Anims
local V = Vector3.new

Renderer.EnemyViews = Enemies.Views
Renderer.UnitViews = Units.Views
Renderer.AllyViews = Allies.Views

-- активная карта боя (по ключу Path)
function Renderer.ActiveMap()
	local name = (Path and Path.MapKey == "Halloween") and "VoidTDHalloweenMap" or "VoidTDMap"
	return workspace:FindFirstChild(name)
end

function Renderer.MuzzlePos(view)
	local rig = view and view.Rig
	if not rig then
		return nil
	end
	local m = rig.Muzzle
	if m and m.Parent then
		return m.Position
	end
	return rig.Root.Position + V(0, 1, 0)
end

Renderer.EnemyCenter = function(id)
	return Enemies.Center(id)
end
Renderer.EnemyPosition = function(id)
	return Enemies.Position(id)
end

------------------------------------------------------------------------
-- ВРАГИ
------------------------------------------------------------------------
function Renderer.SpawnEnemy(data)
	if type(data) ~= "table" then
		return
	end
	local ok, err = pcall(Enemies.Spawn, data)
	if not ok then
		warn("[VOID TD] SpawnEnemy: " .. tostring(err))
	end
end

function Renderer.RemoveEnemy(id, reason)
	Enemies.Remove(id, reason)
end

function Renderer.ClearEnemies()
	Enemies.Clear()
end

function Renderer.OnSync(p)
	if type(p) ~= "table" then
		return
	end
	if p.E then
		Enemies.Sync(p.E)
	end
	for _, d in ipairs(p.DMG or {}) do
		local pos = Enemies.Center(d[1])
		if pos then
			FX.DamageNumber(pos + V(0, 1.5, 0), d[2], d[3])
		end
	end
	for _, r in ipairs(p.RM or {}) do
		Enemies.Remove(r[1], r[2])
	end
	if p.AL or p.RA then
		Allies.Sync(p.AL, p.RA)
	end
end

------------------------------------------------------------------------
-- ЮНИТЫ
------------------------------------------------------------------------
function Renderer.AddUnit(folder, isNew)
	local ok, err = pcall(Units.Add, folder, isNew)
	if not ok then
		warn("[VOID TD] AddUnit: " .. tostring(err))
	end
end

function Renderer.RemoveUnit(folder)
	Units.Remove(folder)
end

function Renderer.RebuildUnits()
	Units.Rebuild()
end

function Renderer.Cheer()
	Units.Cheer()
end

function Renderer.OnAttack(p)
	if type(p) ~= "table" then
		return
	end
	local ok, err = pcall(Units.OnAttack, p)
	if not ok then
		warn("[VOID TD] Attack: " .. tostring(err))
	end
end

-- удары: все виды зарегистрированы в FX (ядро + Void/Chrono/Halloween)
function Renderer.OnImpact(p)
	if type(p) ~= "table" or typeof(p.P) ~= "Vector3" then
		return
	end
	FX.Impact(p)
end

------------------------------------------------------------------------
-- СОЮЗНИКИ
------------------------------------------------------------------------
function Renderer.ClearAllies()
	Allies.Clear()
end

------------------------------------------------------------------------
-- ПРЕДПРОСМОТР: те же позы, что в бою
------------------------------------------------------------------------
function Renderer.PreviewStep(state, t)
	if state and state.Rig then
		Anims.Apply(state.Rig, Anims.Eval(state, t), t, state.Phase or 0)
	end
end

function Renderer.PreviewAttack(state, unitId, level)
	local def = Config.Units[unitId]
	if not def or not state.Rig then
		return
	end
	local levels = def.Levels
	local st = levels[math.clamp(level or 1, 1, #levels)]
	Anims.Play(state, def.Anim, def.HitDelay or 0.2, st.Hits or 1, def.HitInterval)
end

-- способность: только анимация и ускоренные механизмы, без игровых эффектов
function Renderer.PreviewAbility(state, name)
	if state.Rig and Anims.Has(name) then
		Anims.Play(state, name)
		state.Rig.SpinBoostUntil = os.clock() + 2.2
	end
end

function Renderer.PreviewFidget(state, unitId)
	local def = Config.Units[unitId]
	if def and state.Rig then
		Anims.PlayFidget(state, def.Anim)
	end
end

------------------------------------------------------------------------
-- КАДР
------------------------------------------------------------------------
function Renderer.Update(dt)
	local t = os.clock()
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	Enemies.Update(t, dt, camPos)
	Units.Update(t, dt)
	Allies.Update(t, dt)
end

local function folder(name)
	local f = workspace:FindFirstChild(name)
	if f and f:IsA("Folder") then
		f:ClearAllChildren()
		return f
	end
	f = Instance.new("Folder")
	f.Name = name
	f.Parent = workspace
	return f
end

function Renderer.Init(c)
	ctx = c
	Config, Path, FX, Anims = c.Config, c.Path, c.FX, c.Anims
	Renderer.EnemyFolder = folder("VoidTD_Enemies")
	Renderer.UnitFolder = folder("VoidTD_Units")
	Renderer.AllyFolder = folder("VoidTD_Allies")
	Enemies.Init(Renderer, c)
	Units.Init(Renderer, c)
	Allies.Init(Renderer, c)
	return Renderer
end

return Renderer
]]></ProtectedString>
					</Properties>
					<Item class="ModuleScript" referent="RBXB429DD6B974B2F92A9D510281D826CA0">
						<Properties>
							<string name="Name">Allies</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Render/Allies — союзники-призывы на дороге (проклятые люди, марионетки, иллюзии).
-- Идут от базы к порталу навстречу врагам; HP = запас урона (считает сервер).
--
-- API (вызывается из Render/init)
--   Allies.Init(R, ctx)
--   Allies.Sync(list, removed)   list — плоский массив по 5: id, dist, hp, allyTypeIndex, maxHp; removed — {{id, reason}}
--   Allies.Update(t, dt) ; Allies.Clear()
--   Allies.Views  -- id -> { Id, AllyId, Family, Rig, Dist, ServerDist, HP, MaxHP, LastSync, Phase, Lateral, SpawnT, Fill, HitT }

local Allies = {}

local V = Vector3.new
local ANG = CFrame.Angles
local rad = math.rad
local rgb = Color3.fromRGB

local R, ctx, Config, Path, UnitModels, FX
local views = {}
Allies.Views = views
local rng = Random.new()

local RED = rgb(230, 30, 50)
local ORANGE = rgb(255, 140, 40)
local PURPLE = rgb(180, 90, 255)
local GOLD = rgb(255, 205, 80)

function Allies.Init(renderer, c)
	R, ctx = renderer, c
	Config, Path, UnitModels, FX = c.Config, c.Path, c.UnitModels, c.FX
end

local function familyColor(av, forDeath)
	if av.Family == "Cursed" then
		return RED
	elseif av.Family == "Puppet" then
		return (forDeath and av.AllyId == "GoldenMarionette") and GOLD or ORANGE
	end
	return PURPLE
end

-- полоска HP над головой
local function makeBar(av)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HPBar"
	gui.Size = UDim2.fromOffset(60, 8)
	gui.StudsOffsetWorldSpace = V(0, av.Rig.Height or 5, 0)
	gui.MaxDistance = 90
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = rgb(20, 14, 24)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = familyColor(av, false)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	gui.Parent = av.Rig.Root
	av.Fill = fill
end

local function place(av, dist, yOff)
	local rig = av.Rig
	local pos, dir = Path.OffsetPositionAt(math.max(dist, 0), av.Lateral)
	local up = V(0, rig.HipHeight + yOff, 0)
	-- смотрят назад по дороге (навстречу врагам)
	rig.Root.CFrame = CFrame.lookAt(pos + up, pos - dir + up)
end

local function add(id, dist, hp, typeIndex, maxHp)
	local allyId = Config.AllyOrder[typeIndex]
	if not allyId or not UnitModels.BuildAlly then
		return
	end
	local ok, rig = pcall(UnitModels.BuildAlly, allyId)
	if not ok or not rig then
		warn("[VOID TD] BuildAlly: " .. tostring(rig))
		return
	end
	local def = Config.Allies[allyId] or {}
	local now = os.clock()
	local av = {
		Id = id, AllyId = allyId, Family = def.Family, Rig = rig, Dist = dist, ServerDist = dist,
		HP = hp, MaxHP = maxHp or hp, LastSync = now, Phase = rng:NextNumber(0, 6),
		Lateral = rng:NextNumber(-1.4, 1.4), SpawnT = now,
	}
	rig.Height = rig.Height or (5 * (rig.Scale or 1))
	for _, d in ipairs(rig.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = false
			d.CanTouch = false
			d.CanCollide = false
		end
	end
	place(av, dist, -2)
	makeBar(av)
	rig.Model.Parent = R.AllyFolder or workspace
	views[id] = av
end

local function remove(id, reason)
	local av = views[id]
	if not av then
		return
	end
	views[id] = nil
	local model = av.Rig.Model
	if model.Parent then
		local pos = av.Rig.Root.Position
		local color = familyColor(av, true)
		if reason == "dead" then
			FX.Burst(pos, color, 10, 0.35, 8)
			if av.Family == "Puppet" then
				FX.Debris(pos, rgb(150, 110, 70), 6, 0.4, 7, 0.8, Enum.Material.Wood)
			elseif av.Family == "Illusion" then
				FX.Debris(pos, rgb(220, 210, 255), 6, 0.35, 7, 0.8, Enum.Material.Glass)
			else
				FX.Smoke(pos, rgb(120, 20, 30), 3, 2, 0.8, 3)
			end
		else
			FX.Poof(pos, color, 1)
		end
	end
	model:Destroy()
end

function Allies.Sync(list, removed)
	if type(list) == "table" then
		local now = os.clock()
		local seen = {}
		for i = 1, #list, 5 do
			local id = list[i]
			seen[id] = true
			local av = views[id]
			if av then
				av.ServerDist = list[i + 1]
				av.HP = list[i + 2]
				av.MaxHP = list[i + 4] or av.MaxHP
				av.LastSync = now
			else
				add(id, list[i + 1], list[i + 2], list[i + 3], list[i + 4])
			end
		end
		-- пропавшие из списка без причины (переподключение, сброс)
		for id in pairs(views) do
			if not seen[id] then
				remove(id, "clear")
			end
		end
	end
	if type(removed) == "table" then
		for _, r in ipairs(removed) do
			remove(r[1], r[2])
		end
	end
end

function Allies.Clear()
	for id in pairs(views) do
		remove(id, "clear")
	end
end

function Allies.Update(t, dt)
	if next(views) == nil then
		return
	end
	local speed = Config.Settings.AllySpeed or 6
	local k = math.min(1, dt * 5)
	for _, av in pairs(views) do
		local rig = av.Rig
		-- предсказание: идут к порталу (dist уменьшается), догоняем сервер
		local predicted = av.ServerDist - speed * math.min(t - av.LastSync, 0.35)
		av.Dist = av.Dist - speed * dt
		av.Dist = av.Dist + (predicted - av.Dist) * k
		local rise = math.clamp((t - av.SpawnT) / 0.4, 0, 1)
		local bob = math.abs(math.sin(t * 7 + av.Phase)) * 0.15
		place(av, av.Dist, bob - (1 - rise) * 2)
		-- ходьба: руки и ноги навстречу
		local swing = math.sin(t * 7 + av.Phase) * 32
		local m, b = rig.Motors, rig.Base
		if m.RH and b.RH and m.LH and b.LH then
			m.RH.C0 = b.RH * ANG(rad(swing), 0, 0)
			m.LH.C0 = b.LH * ANG(rad(-swing), 0, 0)
		end
		if m.RS and b.RS and m.LS and b.LS then
			m.RS.C0 = b.RS * ANG(rad(-swing * 0.7), 0, 0)
			m.LS.C0 = b.LS * ANG(rad(swing * 0.7), 0, 0)
		end
		if av.Fill then
			av.Fill.Size = UDim2.fromScale(math.clamp(av.HP / math.max(av.MaxHP or 1, 1), 0, 1), 1)
		end
	end
end

return Allies
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX4CDEB2B84C496D3A64F283CDC0BC4AF1">
						<Properties>
							<string name="Name">Enemies</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Render/Enemies — виды врагов: появление, интерполяция по дороге, походка, вторичное движение,
-- визуальные фазы боссов, полоски HP, смерть. Сервер авторитетен: клиент только догоняет ServerDist.
--
-- API (вызывается из Render/init)
--   Enemies.Init(R, ctx)
--   Enemies.Spawn(data)            data = { id, typeId, maxHp, speed, lateral, dist [, hp] }
--   Enemies.Remove(id, reason)     "clear" — без анимации; "core" — дошёл до ядра; иначе — убит
--   Enemies.Sync(E)                плоский массив по 4: id, dist, hp, flag (0 / 1 замедлен / 2 заморожен)
--   Enemies.Update(t, dt, camPos)
--   Enemies.Clear()
--   Enemies.Center(id), Enemies.Position(id)

local Enemies = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local sin, cos, abs, min, max, clamp = math.sin, math.cos, math.abs, math.min, math.max, math.clamp

local R, ctx, Config, Path, EnemyModels, FX
local views = {}
Enemies.Views = views

local NEON = Color3.fromRGB(180, 80, 255)
local SOFT = Color3.fromRGB(215, 160, 255)
local PINK = Color3.fromRGB(255, 60, 170)
local WHITE = Color3.fromRGB(250, 245, 255)
local DUST = Color3.fromRGB(70, 60, 82)
local LOD_DISTANCE = 200
local SEC_KINDS = { "Sway", "Cape", "Orbit", "Spin", "Bob", "Twitch" }
local DEATH_LIFE = { Dissipate = 0.7, Scatter = 0.85, Collapse = 0.75, Topple = 1.0, Implode = 2.4 }
local FLOAT_ARMS = { "ArmR", "ArmL", "ArmR2", "ArmL2", "RS", "LS" }
local CRAWL_LEGS = { { "FR", 1, 0 }, { "BL", -1, 0 }, { "FL", -1, math.pi }, { "BR", 1, math.pi } }

local function ease(a)
	return a * a * (3 - 2 * a)
end

function Enemies.Init(renderer, c)
	R, ctx = renderer, c
	Config, Path, EnemyModels, FX = c.Config, c.Path, c.EnemyModels, c.FX
end

------------------------------------------------------------------------
-- ПОЗИЦИИ
------------------------------------------------------------------------
function Enemies.Position(id)
	local v = views[id]
	return v and v.Rig.Root.Position or nil
end

function Enemies.Center(id)
	local v = views[id]
	if not v then
		return nil
	end
	local rig = v.Rig
	return rig.Root.Position + V(0, ((rig.Height or 5) - (rig.HipHeight or 0)) * 0.35, 0)
end

local function groundOf(v)
	return v.Rig.Root.Position - V(0, (v.Rig.HipHeight or 0) - 0.3, 0)
end

------------------------------------------------------------------------
-- ПОЯВЛЕНИЕ
------------------------------------------------------------------------
-- вторичные моторы по префиксу имени
local function collectSecondary(rig)
	local list = {}
	local sec = rig.Sec or {}
	for name, motor in pairs(rig.Motors or {}) do
		local base = rig.Base and rig.Base[name]
		if base then
			for _, kind in ipairs(SEC_KINDS) do
				if name:sub(1, #kind) == kind then
					local prm = sec[name] or {}
					list[#list + 1] = { Motor = motor, Base = base, Kind = kind, Amp = prm.Amp or 0.2, Speed = prm.Speed or 1.5,
						Phase = math.random() * 6, Next = 0, Y = 0, P = 0, TY = 0, TP = 0 }
					break
				end
			end
		end
	end
	return list
end

local function makeHealthBar(v, boss)
	local rig = v.Rig
	local gui = Instance.new("BillboardGui")
	gui.Name = "HPBar"
	gui.Size = boss and UDim2.fromOffset(120, 12) or UDim2.fromOffset(60, 7)
	gui.StudsOffsetWorldSpace = V(0, (rig.Height or 5) - (rig.HipHeight or 0) + 1.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 180
	gui.LightInfluence = 0
	gui.Adornee = rig.Root
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(20, 10, 25)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 3)
	corner.Parent = bg
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.new(0, 0, 0)
	stroke.Thickness = 1
	stroke.Parent = bg
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = boss and Color3.fromRGB(235, 50, 130) or Color3.fromRGB(190, 80, 255)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	corner:Clone().Parent = fill
	gui.Parent = rig.Root
	v.Bar = gui
	v.Fill = fill
	v.FillRatio = 1
end

-- вспышка портала при выходе босса
local function portalSurge(final)
	local map = R.ActiveMap()
	local portal = map and map:FindFirstChild("VoidPortal")
	if not portal then
		return
	end
	local disc = portal:FindFirstChild("PortalDisc")
	local core = portal:FindFirstChild("PortalCore")
	local light = core and core:FindFirstChildWhichIsA("PointLight")
	if light then
		local orig = light:GetAttribute("OrigBrightness") or light.Brightness
		light:SetAttribute("OrigBrightness", orig)
		light.Brightness = orig * 3
		FX.Tween(light, 1.8, { Brightness = orig })
	end
	FX.Sound("Portal", 1.2, final and 0.7 or 0.85)
	if not disc then
		return
	end
	local orig = disc:GetAttribute("OrigColor") or disc.Color
	disc:SetAttribute("OrigColor", orig)
	disc.Color = Color3.fromRGB(235, 200, 255)
	FX.Tween(disc, 1.2, { Color = orig })
	local p = disc.Position
	local gy = (Path.Map and Path.Map.GroundY) or p.Y
	FX.Sphere(p, final and 16 or 11, NEON, 0.8, nil, 0.3)
	FX.Ring(V(p.X, gy + 0.3, p.Z), final and 45 or 30, NEON, 1.1, 0.6, 3, 0.05)
	task.delay(0.15, function()
		FX.Ring(V(p.X, gy + 0.4, p.Z), final and 32 or 22, WHITE, 0.9, 0.3, 2, 0.2)
	end)
	FX.Burst(p, SOFT, final and 30 or 18, 0.7, 18, 0.9)
end

local applyPhase, checkPhases

function Enemies.Spawn(data)
	local id, typeId, maxHp, speed, lateral, dist, hp = data[1], data[2], data[3], data[4], data[5], data[6], data[7]
	if id == nil or views[id] then
		return
	end
	local def = Config.Enemies[typeId]
	if not def then
		warn("[VOID TD] неизвестный враг " .. tostring(typeId))
		return
	end
	local ok, rig = pcall(EnemyModels.Build, typeId)
	if not ok or not rig then
		warn("[VOID TD] враг " .. tostring(typeId) .. ": " .. tostring(rig))
		return
	end
	dist = dist or 0
	lateral = lateral or 0
	local now = os.clock()
	local v = {
		Id = id, Type = typeId, Def = def, Rig = rig, MaxHP = maxHp or 1, HP = hp or maxHp or 1, Speed = speed or 0,
		Lateral = lateral, Dist = dist, ServerDist = dist, LastSync = now, Slowed = false, Frozen = false,
		Phase = math.random() * 10, Aggro = 1, NextPhase = 1, VisualPhase = 1, SpawnT = now, Emerge = dist <= 1,
		HitT = -10, RoarT = -10,
	}
	v.W = v.Phase
	v.Sec = collectSecondary(rig)
	local hip = rig.HipHeight or 0
	local pos, dir = Path.OffsetPositionAt(dist, lateral)
	v.CF = CFrame.lookAt(pos + V(0, hip, 0), pos + dir + V(0, hip, 0))
	-- переподключение: уже раненый босс сразу показывает поздние фазы (без эффектов)
	checkPhases(v, true)
	local boss = def.IsBoss == true
	if boss then
		local entity = typeId == "TheEntity"
		v.RoarT = now + (rig.SpawnStyle == "Titan" and 1.1 or 0.6)
		if dist <= 1 then
			portalSurge(entity)
		end
		task.delay(0.6, function()
			FX.Sound("Boss", 1, entity and 0.75 or 1)
			FX.Shake(entity and 0.8 or 0.5, 1.0)
		end)
	end
	if rig.SpawnStyle == "Fade" and not FX.Lite then
		v.FadeParts = {}
		for _, d in ipairs(rig.Model:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 1 then
				v.FadeParts[#v.FadeParts + 1] = { d, d.Transparency }
				d.Transparency = 1
			end
		end
	end
	local rise = v.Emerge and (hip + 1.5) or 0
	rig.Root.CFrame = v.CF - V(0, rise, 0)
	makeHealthBar(v, boss)
	rig.Model.Parent = R.EnemyFolder
	views[id] = v
	if rig.SpawnFX and FX.Fn.EnemySpawn then
		FX.Fn.EnemySpawn(v, dist <= 1)
	end
	if dist <= 1 then
		FX.Burst(pos + V(0, 2, 0), NEON, 6, 0.3, 5)
	end
	if rig.SpawnStyle == "Titan" then
		FX.Cracks(pos + V(0, 0.2, 0), 7, NEON, 10, 1.6)
		task.delay(1.1, function()
			local c = Enemies.Center(id)
			if c then
				FX.Sphere(c, 4, NEON, 0.5)
				FX.Burst(c, SOFT, 14, 0.5, 10, 0.6)
			end
		end)
	end
end

------------------------------------------------------------------------
-- ФАЗЫ БОССОВ (только внешний вид)
------------------------------------------------------------------------
-- оторвать деталь от модели и уронить
local function breakPart(v, part, silent)
	for _, d in ipairs(v.Rig.Model:GetDescendants()) do
		if (d:IsA("JointInstance") or d:IsA("WeldConstraint")) and (d.Part0 == part or d.Part1 == part) then
			d:Destroy()
		end
	end
	if silent or FX.Lite then
		part:Destroy()
		return
	end
	local root = v.Rig.Root.Position
	part.Anchored = true
	part.CanCollide = false
	part.Parent = FX.Folder
	local cf = part.CFrame
	local out = V(cf.Position.X - root.X, 0, cf.Position.Z - root.Z)
	out = out.Magnitude > 0.05 and out.Unit or V(0, 0, 1)
	local dest = V(cf.Position.X, root.Y - (v.Rig.HipHeight or 0) + part.Size.Y * 0.3, cf.Position.Z) + out * (2 + math.random() * 4)
	FX.Tween(part, 0.35, { CFrame = cf + out * 1.5 + V(0, 1.5, 0) })
	task.delay(0.35, function()
		if part.Parent then
			FX.Tween(part, 0.6, { CFrame = CF(dest) * ANG(math.random() * 3, math.random() * 3, math.random() * 3) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end)
	task.delay(1.6, function()
		if part.Parent then
			FX.Tween(part, 0.8, { Transparency = 1 })
		end
	end)
	FX.Cleanup(part, 2.5)
end

applyPhase = function(v, idx, silent)
	local ph = v.Rig.Phases[idx]
	v.VisualPhase = idx + 1
	v.Aggro = ph.Aggro or v.Aggro
	for _, part in ipairs(ph.Reveal or {}) do
		if part.Parent then
			local goal = part:GetAttribute("PT") or 0
			if silent or FX.Lite then
				part.Transparency = goal
			else
				FX.Tween(part, 0.6, { Transparency = goal })
			end
		end
	end
	for _, em in ipairs(ph.Emit or {}) do
		if em.Parent then
			if em.Enabled then
				em.Rate = em.Rate * 1.8
			else
				em.Enabled = true
			end
		end
	end
	for _, l in ipairs(ph.Lights or {}) do
		local light, b = l[1], l[2]
		if light and light.Parent then
			light.Brightness = b or light.Brightness
			light.Range = light.Range * 1.25
		end
	end
	for _, part in ipairs(ph.Break or {}) do
		if part.Parent then
			breakPart(v, part, silent)
		end
	end
	if silent then
		return
	end
	local rig = v.Rig
	local sc = rig.Scale or 1
	local c = Enemies.Center(v.Id) or rig.Root.Position
	v.RoarT = os.clock()
	FX.Sound("Boss", 1, 0.8 + idx * 0.12, c)
	FX.Shake(0.3 + idx * 0.15, 0.6)
	FX.Ring(groundOf(v), 8 * sc, NEON, 0.8, 0.5, 1, 0.05)
	FX.Sphere(c, 2.5 * sc, SOFT, 0.5)
	FX.Burst(c, NEON, 16, 0.4 * sc, 9 * sc, 0.7)
end

checkPhases = function(v, silent)
	local phases = v.Rig.Phases
	if not phases then
		return
	end
	local ratio = v.HP / max(v.MaxHP, 1)
	while phases[v.NextPhase] and ratio <= (phases[v.NextPhase].At or 0) do
		applyPhase(v, v.NextPhase, silent)
		v.NextPhase += 1
	end
end

------------------------------------------------------------------------
-- СИНХРОНИЗАЦИЯ
------------------------------------------------------------------------
function Enemies.Sync(E)
	local now = os.clock()
	for i = 1, #E - 3, 4 do
		local v = views[E[i]]
		if v then
			local hp, flag = E[i + 2], E[i + 3]
			v.ServerDist = E[i + 1] or v.ServerDist
			if hp and hp < v.HP then
				v.HitT = now
			end
			v.HP = hp or v.HP
			v.Slowed = flag == 1
			v.Frozen = flag == 2
			v.LastSync = now
		end
	end
end

------------------------------------------------------------------------
-- ПОХОДКА И ВТОРИЧНОЕ ДВИЖЕНИЕ
------------------------------------------------------------------------
local function heavyStep(v, power, camDist)
	if camDist < 90 then
		FX.Shake(power * (1 - camDist / 90), 0.18)
	end
	if not FX.Lite and camDist < 120 then
		local sc = v.Rig.Scale or 1
		FX.Ring(groundOf(v), 2.2 * sc, DUST, 0.45, 0.2, 0.4 * sc, 0.45)
	end
end

local function stepSecondary(v, t, dt, aggro, sc)
	for _, s in ipairs(v.Sec) do
		local k = s.Kind
		if k == "Sway" or k == "Cape" then
			local sp = s.Speed * (0.8 + 0.2 * aggro)
			s.Motor.C0 = s.Base * ANG(sin(t * sp + s.Phase) * s.Amp + (k == "Cape" and s.Amp * 0.8 or 0), 0, sin(t * sp * 0.7 + s.Phase) * s.Amp * 0.5)
		elseif k == "Orbit" then
			s.Motor.C0 = s.Base * ANG(0, t * s.Speed * aggro + s.Phase, 0)
		elseif k == "Spin" then
			s.Motor.C0 = s.Base * ANG(0, 0, t * s.Speed * aggro + s.Phase)
		elseif k == "Bob" then
			s.Motor.C0 = s.Base * CF(0, sin(t * s.Speed + s.Phase) * s.Amp * sc, 0) * ANG(0, sin(t * s.Speed * 0.5 + s.Phase) * 0.25, 0)
		else -- Twitch: резкие подёргивания
			if t >= s.Next then
				s.Next = t + 0.25 + math.random() * 0.7
				s.TY = (math.random() * 2 - 1) * s.Amp
				s.TP = (math.random() * 2 - 1) * s.Amp * 0.5
			end
			local a = min(1, dt * 22)
			s.Y += (s.TY - s.Y) * a
			s.P += (s.TP - s.P) * a
			s.Motor.C0 = s.Base * ANG(s.P, s.Y, 0)
		end
	end
end

local function animate(v, t, dt, camDist)
	local rig = v.Rig
	local m, b = rig.Motors, rig.Base
	if not m or not b or not m.Root or not b.Root then
		return
	end
	local g = rig.Gait or {}
	local sc = rig.Scale or 1
	local idle = rig.Idle or {}
	local aggro = v.Aggro
	local far = camDist > LOD_DISTANCE
	local style = rig.Style or "Biped"
	local spd = v.Speed * (v.Slowed and 0.5 or 1)
	local freq = spd / max(v.Def.Scale or 1, 0.5) * 1.1 * (g.Speed or 1) * (1 + (aggro - 1) * 0.3)
	v.W += dt * freq
	local W = v.W
	local s = sin(W)
	local stride = (g.Stride or 0.55) * (0.85 + 0.15 * aggro)
	local bob = (g.Bob or 0.12) * sc
	local boss = v.Def.IsBoss == true
	local flinch = 0
	local hitA = t - v.HitT
	if hitA < 0.22 then
		flinch = (1 - hitA / 0.22) * (boss and 0.35 or 1)
	end
	local neckCF
	local function pose(name, x, y, z)
		local motor, base = m[name], b[name]
		if not motor or not base then
			return
		end
		local i = idle[name]
		local cf
		if i then
			cf = base * ANG(rad(i[1] or 0) + x, rad(i[2] or 0) + y, rad(i[3] or 0) + z)
		else
			cf = base * ANG(x, y, z)
		end
		motor.C0 = cf
		if name == "Neck" then
			neckCF = cf
		end
	end
	local idleRoot = idle.Root and rad(idle.Root[1] or 0) or 0
	local rootCF
	if style == "Biped" or style == "Heavy" then
		local heavy = style == "Heavy"
		pose("RH", s * stride, 0, 0)
		pose("LH", -s * stride, 0, 0)
		local arm = stride * (heavy and 0.55 or 0.8) * aggro
		pose("RS", -s * arm, 0, heavy and abs(s) * 0.08 or 0)
		pose("LS", s * arm, 0, heavy and -abs(s) * 0.08 or 0)
		local sway = g.Sway or 0.04
		local lean = rad((g.Lean or 0) + (aggro - 1) * 20)
		local y = heavy and ((1 - abs(s)) * bob - bob * 0.5) or abs(s) * bob
		rootCF = b.Root * CF(0, y, 0) * ANG(idleRoot + lean, s * sway * 0.5, -s * sway)
		pose("Neck", heavy and -abs(s) * 0.05 or 0, 0, s * sway * 0.8)
		if g.Shake and not far then
			local c = cos(W) >= 0
			if v.StepSign ~= nil and v.StepSign ~= c then
				heavyStep(v, g.Shake * (0.8 + 0.2 * aggro), camDist)
			end
			v.StepSign = c
		end
	elseif style == "Gallop" then
		pose("FR", s * stride, 0, 0)
		pose("FL", sin(W + 0.35) * stride, 0, 0)
		pose("BR", sin(W - 1.6) * stride, 0, 0)
		pose("BL", sin(W - 1.25) * stride, 0, 0)
		rootCF = b.Root * CF(0, abs(s) * bob, 0) * ANG(cos(W) * 0.09, 0, 0)
		pose("Neck", -cos(W) * 0.12, 0, 0)
	elseif style == "Crawl" then
		for _, leg in ipairs(CRAWL_LEGS) do
			local p = W + leg[3]
			pose(leg[1], 0, sin(p) * stride * leg[2], max(0, cos(p)) * 0.35 * leg[2])
		end
		rootCF = b.Root * CF(0, abs(sin(2 * W)) * bob, 0) * ANG(0, s * 0.06, s * (g.Sway or 0.05))
	elseif style == "Quad" then
		pose("FR", s * 0.6, 0, 0)
		pose("BL", s * 0.6, 0, 0)
		pose("FL", -s * 0.6, 0, 0)
		pose("BR", -s * 0.6, 0, 0)
		rootCF = b.Root * CF(0, abs(s) * 0.1 * sc, 0) * ANG(s * 0.03, 0, 0)
		pose("Neck", sin(2 * W) * 0.06, 0, 0)
	else -- Float
		local amp = (g.Bob or 0.3) * sc
		rootCF = b.Root * CF(0, sin(t * 2 + v.Phase) * amp, 0) * ANG(0.12 + (aggro - 1) * 0.2, 0, sin(t * 1.3 + v.Phase) * 0.06)
		for _, name in ipairs(FLOAT_ARMS) do
			local side = (name:sub(-1) == "R" or name == "RS" or name == "ArmR2") and 1 or -1
			pose(name, sin(t * 2.2 + v.Phase + side) * 0.3 + 0.3, 0, sin(t * 1.7) * 0.15 * side)
		end
	end
	-- титан встаёт из приседа
	if rig.SpawnStyle == "Titan" then
		local sa = (t - v.SpawnT) / 1.6
		if sa < 1 then
			local k = 1 - ease(clamp(sa, 0, 1))
			rootCF = rootCF * CF(0, -k * 1.2 * sc, 0) * ANG(rad(40) * k, 0, 0)
			pose("RS", rad(-30) * k, 0, rad(20) * k)
			pose("LS", rad(-30) * k, 0, rad(-20) * k)
		end
	end
	-- вздрагивание от удара (шея — от базовой позы, без накопления)
	if m.Neck and b.Neck and (flinch > 0 or v.NeckFlinched) then
		local base = neckCF or b.Neck
		m.Neck.C0 = base * ANG(-flinch * 0.3, 0, 0)
		v.NeckFlinched = flinch > 0
	end
	if flinch > 0 then
		rootCF = rootCF * CF(0, 0, flinch * 0.25 * sc) * ANG(-flinch * 0.25, 0, flinch * 0.08)
	end
	-- рёв (появление босса / смена фазы)
	local roarA = t - v.RoarT
	local roar = (roarA > 0 and roarA < 1.4) and sin(roarA / 1.4 * math.pi) or 0
	if roar > 0 then
		if m.RS and b.RS then
			m.RS.C0 = b.RS * ANG(rad(150 * roar), 0, rad(30 * roar))
			if m.LS and b.LS then
				m.LS.C0 = b.LS * ANG(rad(150 * roar), 0, rad(-30 * roar))
			end
		end
		if m.Neck and b.Neck then
			m.Neck.C0 = b.Neck * ANG(rad(-30 * roar), 0, 0)
		end
		rootCF = rootCF * ANG(rad(-12 * roar), 0, 0)
	end
	m.Root.C0 = rootCF
	if m.Jaw and b.Jaw then
		m.Jaw.C0 = b.Jaw * ANG(max(0, sin(t * 3 + v.Phase)) * 0.4 + roar * 0.6 + flinch * 0.3, 0, 0)
	end
	if not far then
		stepSecondary(v, t, dt, aggro, sc)
	end
end

------------------------------------------------------------------------
-- КАДР
------------------------------------------------------------------------
function Enemies.Update(t, dt, camPos)
	local lerpA = min(1, dt * 9)
	local catchA = min(1, dt * 5)
	for _, v in pairs(views) do
		local rig = v.Rig
		local root = rig.Root
		if root.Parent then
			local f = v.Frozen and 0 or (v.Slowed and 0.5 or 1)
			local haste = (v.HasteUntil and t < v.HasteUntil) and 1.6 or 1
			local speed = v.Speed * f * haste
			local predicted = v.ServerDist + speed * min(t - v.LastSync, 0.35)
			v.Dist += speed * dt
			v.Dist += (predicted - v.Dist) * catchA
			local hip = rig.HipHeight or 0
			local pos, dir = Path.OffsetPositionAt(v.Dist, v.Lateral)
			local up = V(0, hip, 0)
			v.CF = v.CF:Lerp(CFrame.lookAt(pos + up, pos + dir + up), lerpA)
			local rise = 0
			if v.Emerge then
				local a = (t - v.SpawnT) / 0.6
				if a < 1 then
					rise = (1 - ease(clamp(a, 0, 1))) * (hip + 1.5)
				else
					v.Emerge = false
				end
			end
			if v.FadeParts then
				local a = clamp((t - v.SpawnT) / 0.7, 0, 1)
				for _, it in ipairs(v.FadeParts) do
					it[1].Transparency = 1 - (1 - it[2]) * a
				end
				if a >= 1 then
					v.FadeParts = nil
				end
			end
			root.CFrame = rise > 0 and (v.CF - V(0, rise, 0)) or v.CF
			checkPhases(v, false)
			if not v.Frozen then
				animate(v, t, dt, camPos and (root.Position - camPos).Magnitude or 0)
			end
			local ratio = clamp(v.HP / max(v.MaxHP, 1), 0, 1)
			if ratio ~= v.FillRatio then
				v.FillRatio = ratio
				v.Fill.Size = UDim2.fromScale(ratio, 1)
			end
		end
	end
end

------------------------------------------------------------------------
-- СМЕРТЬ
------------------------------------------------------------------------
local function deathAnim(v, reason)
	local rig = v.Rig
	local model = rig.Model
	if v.Bar then
		v.Bar:Destroy()
	end
	local size = v.Def.Scale or 1
	local root = rig.Root
	local pos = root.Position
	if reason == "core" then
		FX.Poof(pos, PINK, size)
		model:Destroy()
		return
	end
	local style = rig.DeathStyle or "Topple"
	local implode = style == "Implode"
	local boss = v.Def.IsBoss == true
	local hip = rig.HipHeight or 0
	local sc = rig.Scale or 1
	if not implode then
		FX.Poof(pos + V(0, 0.5, 0), NEON, size)
	end
	FX.Sound("EnemyDeath", 1, 1 / max(size, 0.6), pos)
	if boss and not implode then
		FX.Shockwave(pos - V(0, hip - 0.2, 0), 10 * size, 5)
	end
	local life = DEATH_LIFE[style] or 1
	if style == "Topple" and boss then
		life = 1.5
	end
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			if d.Transparency < 1 then
				parts[#parts + 1] = { d, d.Transparency }
			end
		elseif d:IsA("ParticleEmitter") or d:IsA("Trail") then
			d.Enabled = false
		end
	end
	local motors = {}
	for name, motor in pairs(rig.Motors or {}) do
		if name ~= "Root" then
			local dir = V(math.random() - 0.5, math.random() * 0.6, math.random() - 0.5)
			motors[#motors + 1] = { motor, motor.C0, name, dir.Magnitude > 0.01 and dir.Unit or V(0, 1, 0) }
		end
	end
	local rm = rig.Motors and rig.Motors.Root
	local start = rm and rm.C0 or CF()
	if style == "Dissipate" then
		FX.Burst(pos, SOFT, 10, 0.4 * size, 4, 0.9)
	elseif implode then
		FX.Sound("Boss", 1.2, 0.6, pos)
		FX.Shake(0.6, 2.4)
	end
	local blown = false
	FX.Run(function(el)
		if not model.Parent then
			return true
		end
		local a = clamp(el / life, 0, 1)
		local fade = a
		local rc
		if style == "Dissipate" then
			rc = start * CF(0, ease(a) * 2.5 * sc, 0) * ANG(0, a * 4, 0)
		elseif style == "Scatter" then
			rc = start * CF(0, a * 1.2 * sc, 0)
			for _, it in ipairs(motors) do
				local d = it[4]
				it[1].C0 = it[2] * CF(d * ease(a) * 3 * sc) * ANG(a * d.X * 4, a * 3, a * d.Z * 4)
			end
		elseif style == "Collapse" then
			rc = start * CF(0, -ease(a) * hip * 0.7, 0) * ANG(rad(-8 * a), 0, rad(20 * ease(a)))
			for _, it in ipairs(motors) do
				local n = it[3]
				if n == "FR" or n == "BR" or n == "FL" or n == "BL" then
					local side = (n == "FR" or n == "BR") and 1 or -1
					it[1].C0 = it[2] * ANG(0, 0, side * ease(a) * 1.1)
				end
			end
			fade = clamp((a - 0.4) / 0.6, 0, 1)
		elseif implode then
			if a < 0.55 then
				local k = a / 0.55
				rc = start * CF((math.random() - 0.5) * 0.4 * k * sc, k * 1.5 * sc, 0) * ANG(rad(-15 * k), 0, 0)
				for _, it in ipairs(motors) do
					if it[3] == "RS" or it[3] == "LS" then
						it[1].C0 = it[2] * ANG(rad(120 * k), 0, rad((it[3] == "RS" and 40 or -40) * k))
					end
				end
				if not FX.Lite and math.random() < 0.25 then
					local c = root.Position
					FX.Burst(c + V((math.random() - 0.5) * 6 * sc, (math.random() - 0.5) * 6 * sc, (math.random() - 0.5) * 6 * sc), NEON, 3, 0.4 * sc, 6, 0.4)
				end
				fade = 0
			else
				if not blown then
					blown = true
					local c = root.Position
					FX.Sphere(c, 9 * sc, WHITE, 0.6)
					FX.Sphere(c, 14 * sc, NEON, 0.9, nil, 0.2)
					FX.Shockwave(c - V(0, hip - 0.2, 0), 14 * size, 5)
					FX.Burst(c, SOFT, 30, 0.8, 22, 1)
					FX.Shake(1.2, 0.8)
				end
				local k = (a - 0.55) / 0.45
				rc = start * CF(0, 1.5 * sc - ease(k) * hip * 0.6, 0) * ANG(rad(-15 + 30 * k), k * 2, 0)
				fade = k
			end
		else -- Topple
			rc = start * CF(0, -a * hip * 0.8, 0) * ANG(rad(-75 * ease(a)), 0, rad(15 * a))
			for _, it in ipairs(motors) do
				local n = it[3]
				if n == "RS" or n == "LS" then
					it[1].C0 = it[2] * ANG(rad(70 * ease(a)), 0, 0)
				elseif n == "RH" or n == "LH" then
					it[1].C0 = it[2] * ANG(rad(40 * ease(a)), 0, 0)
				end
			end
			fade = clamp((a - 0.3) / 0.7, 0, 1)
		end
		if rm then
			rm.C0 = rc
		end
		for _, it in ipairs(parts) do
			it[1].Transparency = it[2] + (1 - it[2]) * fade
		end
		if a >= 1 then
			model:Destroy()
			return true
		end
		return false
	end)
end

function Enemies.Remove(id, reason)
	local v = views[id]
	if not v then
		return
	end
	views[id] = nil
	local model = v.Rig.Model
	if reason == "clear" then
		if model.Parent then
			FX.Poof(v.Rig.Root.Position, NEON, 0.8)
		end
		model:Destroy()
		return
	end
	if not model.Parent then
		return
	end
	if v.Rig.DeathFX and reason ~= "core" and FX.Fn.EnemyDeath then
		FX.Fn.EnemyDeath(v, reason)
	end
	deathAnim(v, reason)
end

function Enemies.Clear()
	for id in pairs(views) do
		Enemies.Remove(id, "clear")
	end
end

return Enemies
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX6063B1D101BCE52661CF5F2E7D46E100">
						<Properties>
							<string name="Name">Units</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Render/Units — виды юнитов: модель по атрибутам папки VoidTD.Units/<uid>, табличка уровня,
-- слежение за врагом, разминки, плащи, буря часовщика, эффекты установки и атак (урон — на сервере).
--
-- API (вызывается из Render/init)
--   Units.Init(R, ctx)
--   Units.Add(folder, isNew) ; Units.Remove(folder) ; Units.Rebuild() ; Units.Cheer()
--   Units.Update(t, dt) ; Units.OnAttack(p)
--   Units.Views  -- uid -> view { Uid, Folder, UnitId, Level, Pos, Yaw, Rig, Anim, Phase, ... }

local Units = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local min, clamp = math.min, math.clamp

local R, ctx, Config, Path, UnitModels, FX, Anims
local views = {}
Units.Views = views

local NEON = Color3.fromRGB(180, 80, 255)
local SOFT = Color3.fromRGB(215, 160, 255)
local PINK = Color3.fromRGB(255, 60, 170)
local RED = Color3.fromRGB(255, 35, 55)
local STORM_GLOW = Color3.fromRGB(255, 170, 60)

local function ease(a)
	return a * a * (3 - 2 * a)
end

local function yawTo(from, to)
	local d = to - from
	return math.atan2(-d.X, -d.Z)
end

function Units.Init(renderer, c)
	R, ctx = renderer, c
	Config, Path, UnitModels, FX, Anims = c.Config, c.Path, c.UnitModels, c.FX, c.Anims
end

local function levelStats(def, lv)
	local levels = def.Levels or {}
	return levels[clamp(lv or 1, 1, math.max(#levels, 1))] or {}
end

local function rarityColor(def)
	local r = def and Config.Rarities[def.Rarity]
	return r and r.Color or NEON
end

------------------------------------------------------------------------
-- МОДЕЛЬ
------------------------------------------------------------------------
local function makeTag(v, rig, def)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Tag"
	gui.Size = UDim2.fromOffset(110, 34)
	gui.StudsOffsetWorldSpace = V(0, 2.7 * (rig.Scale or 1) + 1.2, 0)
	gui.MaxDistance = ctx.Lite and 30 or 70
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = rig.Root
	local lv = clamp(v.Level, 0, 5)
	local stars = Instance.new("TextLabel")
	stars.BackgroundTransparency = 1
	stars.Size = UDim2.fromScale(1, 0.55)
	stars.Font = Enum.Font.FredokaOne
	stars.TextScaled = true
	stars.Text = string.rep("★", lv) .. string.rep("☆", 5 - lv)
	stars.TextColor3 = rarityColor(def)
	stars.TextStrokeTransparency = 0.2
	stars.Parent = gui
	local owner = Instance.new("TextLabel")
	owner.BackgroundTransparency = 1
	owner.Position = UDim2.fromScale(0, 0.55)
	owner.Size = UDim2.fromScale(1, 0.45)
	owner.Font = Enum.Font.GothamBold
	owner.TextScaled = true
	owner.Text = tostring(v.Folder:GetAttribute("OwnerName") or "")
	owner.TextColor3 = Color3.fromRGB(220, 210, 235)
	owner.TextStrokeTransparency = 0.4
	owner.Parent = gui
	gui.Parent = rig.Root
end

local function setStorm(v, on)
	local rig = v.Rig
	if not rig then
		return
	end
	rig.Storm = on
	for _, d in ipairs(rig.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			local st = d:GetAttribute("StormFX")
			if type(st) == "number" then
				if on then
					d.Transparency = st
				else
					FX.Tween(d, 0.8, { Transparency = 1 })
				end
			elseif d:GetAttribute("AxeGlow") then
				local base = d:GetAttribute("BaseColor")
				if base == nil then
					base = d.Color
					d:SetAttribute("BaseColor", base)
				end
				d.Color = on and STORM_GLOW or base
			end
		end
	end
end

local function build(v)
	if v.Rig and v.Rig.Model then
		v.Rig.Model:Destroy()
	end
	v.Rig = nil
	v.Anim = nil
	local ok, rig = pcall(UnitModels.Build, v.UnitId, v.Level)
	if not ok or not rig then
		warn("[VOID TD] юнит " .. tostring(v.UnitId) .. ": " .. tostring(rig))
		return
	end
	rig.Model:SetAttribute("Uid", v.Uid)
	v.Trails = {}
	for _, d in ipairs(rig.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CanQuery = true
			d.CanTouch = false
		elseif d:IsA("Trail") then
			d.Enabled = false
			v.Trails[#v.Trails + 1] = d
		end
	end
	v.TrailOn = false
	rig.Root.CFrame = CF(v.Pos + V(0, rig.HipHeight or 0, 0)) * ANG(0, v.Yaw, 0)
	v.Rig = rig
	makeTag(v, rig, v.Def)
	rig.Model.Parent = R.UnitFolder
end

local function onAttr(v, attr)
	local f = v.Folder
	if attr == "Level" then
		v.Level = f:GetAttribute("Level") or v.Level
		build(v)
		if f:GetAttribute("Storm") then
			setStorm(v, true)
		end
		FX.LevelUp(v.Pos, rarityColor(v.Def))
		Anims.Play(v, "PowerUp")
	elseif attr == "Storm" then
		setStorm(v, f:GetAttribute("Storm") == true)
		return
	end
	if R.OnUnitChanged then
		R.OnUnitChanged(v.Uid)
	end
end

function Units.Add(folder, isNew)
	local uid = tonumber(folder.Name)
	if not uid or views[uid] or not folder.Parent then
		return
	end
	local id = folder:GetAttribute("UnitId")
	local pos = folder:GetAttribute("Position")
	local def = id and Config.Units[id]
	if not def or typeof(pos) ~= "Vector3" then
		return
	end
	local now = os.clock()
	local yaw = rad(folder:GetAttribute("Rotation") or 0)
	local v = {
		Uid = uid, Folder = folder, UnitId = id, Def = def, Level = folder:GetAttribute("Level") or 1, Pos = pos,
		Yaw = yaw, TargetYaw = yaw, Phase = math.random() * 10, NextFidget = now + 4 + math.random() * 8,
		NextTrack = 0, GustT = -10, Trails = {},
	}
	views[uid] = v
	build(v)
	if folder:GetAttribute("Storm") then
		setStorm(v, true)
	end
	local fx = def.PlaceFX
	if isNew then
		if fx == "Throne" then
			v.DropT = now
			if FX.Fn.ThronePlace then
				FX.Fn.ThronePlace(pos)
			end
		elseif fx == "Clock" then
			v.RiseT = now
			if FX.ClockPortal then
				FX.ClockPortal(pos, 1.3)
			end
		else
			v.DropT = now
		end
	else
		FX.Place(pos)
	end
	v.Conn = folder.AttributeChanged:Connect(function(attr)
		if views[uid] == v then
			onAttr(v, attr)
		end
	end)
end

function Units.Remove(folder)
	local uid = tonumber(folder.Name)
	local v = uid and views[uid]
	if not v then
		return
	end
	views[uid] = nil
	if v.Conn then
		v.Conn:Disconnect()
	end
	FX.Poof(v.Pos + V(0, 2, 0), SOFT, 1)
	if v.Rig then
		v.Rig.Model:Destroy()
	end
	if R.OnUnitRemoved then
		R.OnUnitRemoved(uid)
	end
end

-- после смены графики: пересобрать модели (и вернуть бурю)
function Units.Rebuild()
	for _, v in pairs(views) do
		build(v)
		if v.Folder:GetAttribute("Storm") then
			setStorm(v, true)
		end
	end
end

function Units.Cheer()
	for _, v in pairs(views) do
		task.delay(math.random() * 0.3, function()
			if views[v.Uid] == v and v.Rig then
				Anims.Play(v, "Cheer")
			end
		end)
	end
end

------------------------------------------------------------------------
-- КАДР
------------------------------------------------------------------------
local function nearestEnemy(v, range)
	local best, bd
	for _, e in pairs(R.EnemyViews) do
		local d = Path.FlatDistance(v.Pos, e.Rig.Root.Position)
		if d <= range and (not bd or d < bd) then
			best, bd = e, d
		end
	end
	return best
end

function Units.Update(t, dt)
	local turnA = min(1, dt * 8)
	for _, v in pairs(views) do
		local rig = v.Rig
		if rig and rig.Root.Parent then
			if t >= v.NextTrack then
				v.NextTrack = t + 0.3
				local e = nearestEnemy(v, (levelStats(v.Def, v.Level).Range or 10) + 6)
				if e and not v.Anim then
					v.TargetYaw = yawTo(v.Pos, e.Rig.Root.Position)
				end
			end
			if not v.Anim and t >= v.NextFidget then
				Anims.PlayFidget(v, v.Def.Anim)
				v.NextFidget = t + 6 + math.random() * 8
			end
			rig.Gust = math.max(0, 1 - (t - v.GustT) / 0.8)
			local diff = (v.TargetYaw - v.Yaw + math.pi) % (2 * math.pi) - math.pi
			v.Yaw += diff * turnA
			local drop = 0
			if v.DropT then
				local a = clamp((t - v.DropT) / 0.3, 0, 1)
				drop = (1 - a * a) * 7
				if a >= 1 then
					v.DropT = nil
					Anims.Play(v, "Land")
					FX.Place(v.Pos)
				end
			elseif v.RiseT then
				local a = clamp((t - v.RiseT) / 1.3, 0, 1)
				drop = -(1 - ease(a)) * ((rig.HipHeight or 0) + 2.5)
				if a >= 1 then
					v.RiseT = nil
					Anims.Play(v, "TimeHaste")
				end
			end
			rig.Root.CFrame = CF(v.Pos + V(0, (rig.HipHeight or 0) + drop, 0)) * ANG(0, v.Yaw, 0)
			Anims.Step(v, t)
			local on = v.Anim ~= nil
			if on ~= v.TrailOn then
				v.TrailOn = on
				for _, tr in ipairs(v.Trails) do
					tr.Enabled = on
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- АТАКИ (вылет снаряда / взмах; области — по Impact)
------------------------------------------------------------------------
local function alive(v)
	return views[v.Uid] == v and v.Rig ~= nil and v.Rig.Model.Parent ~= nil
end

local function flatLook(origin, target)
	return CFrame.lookAt(origin, V(target.X, origin.Y, target.Z))
end

function Units.OnAttack(p)
	local v = p.U and views[p.U]
	if not v or not v.Rig then
		return
	end
	local def = v.Def
	local lv = p.L or v.Level
	local h = p.D or def.HitDelay or 0.2
	local targets = p.T or {}
	local firstId = targets[1]
	local tpos = firstId and R.EnemyCenter(firstId)
	if tpos then
		v.TargetYaw = yawTo(v.Pos, tpos)
	end
	local now = os.clock()
	if type(p.AB) == "string" then
		Anims.Play(v, p.AB, h)
		v.Rig.SpinBoostUntil = now + (p.AB == "TimeStorm" and 2.4 or 1.6)
		return
	elseif p.AB then
		Anims.Play(v, "BlackHoleCast", h)
		local crystal = v.Rig.Model:FindFirstChild("Crystal", true)
		if crystal and crystal:IsA("BasePart") then
			FX.Sphere(crystal.Position, 3, NEON, 0.5)
		end
		return
	end
	local hits = math.max(#targets, 1)
	if p.EC then
		if FX.Fn.EchoGhost then
			FX.Fn.EchoGhost(v)
		end
	else
		Anims.Play(v, def.Anim, h, hits, p.I)
		v.GustT = now
		v.NextFidget = now + 6 + math.random() * 6
	end
	if FX.Fn.HalloweenAttack and FX.Fn.HalloweenAttack(v, def, p, h, lv) then
		return
	end
	local impactColor = def.ImpactColor or NEON
	local kind = def.AttackType
	local function at(d, fn)
		task.delay(d, function()
			if alive(v) then
				fn()
			end
		end)
	end
	local function muzzle()
		return R.MuzzlePos(v)
	end
	if kind == "Chrono" then
		at(h, function()
			if p.E and FX.GearDisc then
				local from = muzzle()
				local to = V(p.E.X, from.Y - 1.5, p.E.Z)
				FX.GearDisc(from, to, Path.FlatDistance(v.Pos, to) / (p.SP or 70), lv, p.ST)
			end
		end)
	elseif kind == "Projectile" then
		local list = #targets > 0 and targets or { firstId }
		for si, id in ipairs(list) do
			local travel = (p.TRS and p.TRS[si]) or p.TR or 0.2
			at(h + (si - 1) * (p.SG or 0.12), function()
				local from = muzzle()
				local pk = def.Projectile
				FX.Sound("Shoot", pk == "Bolt" and 0.6 or 1, pk == "Bullet" and 0.8 or 1, from)
				FX.Projectile(pk, from, function() return id and R.EnemyCenter(id) end, travel, function(pos)
					local orb = pk == "Orb"
					FX.Burst(pos, orb and NEON or impactColor, orb and 8 or 4, 0.3, 5)
					if orb then
						FX.Sphere(pos, 1.4 + lv * 0.15, NEON, 0.25)
					end
				end, lv)
				if pk == "Bolt" or pk == "Bullet" then
					FX.Sphere(from, 0.6, impactColor, 0.12)
				end
			end)
		end
	elseif kind == "Chain" then
		local times = p.TT or {}
		for i, id in ipairs(targets) do
			local prevT = i == 1 and h or (times[i - 1] or h)
			local prevId = targets[i - 1]
			at(prevT, function()
				local from = (i == 1) and muzzle() or (R.EnemyCenter(prevId) or muzzle())
				FX.Sound("Magic", 0.8, 1.3 + i * 0.1, from)
				FX.Projectile("Moon", from, function() return R.EnemyCenter(id) end, math.max((times[i] or prevT) - prevT, 0.05), function(pos)
					FX.Burst(pos, impactColor, 6, 0.3, 6)
					FX.Ring(pos - V(0, 1, 0), 2.5, impactColor, 0.3, 0.2)
				end, lv)
			end)
		end
	elseif kind == "Thread" then
		at(h, function()
			FX.Sound("Magic", 0.8, 0.7, v.Pos)
			for _, id in ipairs(targets) do
				local c = R.EnemyCenter(id)
				if c then
					FX.Thread(muzzle(), c, SOFT)
				end
			end
		end)
	elseif kind == "Splash" then
		at(h, function() FX.Sphere(muzzle(), 2.2, RED, 0.25) end)
	elseif kind == "Pierce" then
		at(h, function() FX.Sphere(muzzle(), 2, Color3.fromRGB(255, 190, 215), 0.3) end)
	elseif kind == "Laser" then
		at(h, function()
			local target = (firstId and R.EnemyCenter(firstId)) or tpos
			if target then
				FX.Sound("Laser", 1, 1, target)
				local big = lv >= 5
				FX.Beam(muzzle(), target, big and 2.6 or 1.2 + lv * 0.2, big and SOFT or NEON, 0.45, big)
			end
		end)
	elseif kind == "Melee" then
		at(h, function()
			local target = (firstId and R.EnemyCenter(firstId)) or tpos
			if not target then
				return
			end
			local origin = v.Rig.Root.Position + V(0, 1, 0)
			local cf = flatLook(origin, target)
			local reach = math.max(Path.FlatDistance(origin, target) * 0.6, 3)
			local big = v.UnitId == "AbyssOverlord" or p.PW
			local arcColor = def.ImpactColor or (big and NEON or SOFT)
			if p.PW then
				arcColor = PINK
				FX.Sphere(target, 2.2, PINK, 0.25)
			end
			FX.Arc(cf, reach, rad(15), rad(150), arcColor, big and 1 or 0.4 + lv * 0.05, 0.3)
			if def.Anim == "DualDagger" then
				FX.Arc(cf * ANG(0, 0, rad(60)), reach * 0.9, rad(20), rad(140), NEON, 0.35, 0.25)
			end
			FX.Sound(big and "HeavyHit" or "Slash", 1, 1, target)
			FX.Burst(target, NEON, big and 12 or 5, big and 0.6 or 0.3, big and 10 or 5)
			if big then
				FX.Ring(V(target.X, v.Pos.Y + 0.2, target.Z), 4, NEON, 0.35, 0.3)
			end
			if v.UnitId == "VoidKnight" and lv >= 3 then
				FX.Sphere(target, 1.5 + lv * 0.3, Color3.fromRGB(70, 20, 120), 0.35)
				FX.Burst(target, Color3.fromRGB(40, 10, 70), 8, 0.5, 6)
			end
		end)
	elseif kind == "AOE" then
		at(h, function()
			if v.UnitId == "EclipseGuardian" then
				FX.Sphere(muzzle(), 2, NEON, 0.25)
			elseif v.UnitId == "AbyssOverlord" then
				local target = (firstId and R.EnemyCenter(firstId)) or tpos
				if target then
					local origin = v.Rig.Root.Position + V(0, 1, 0)
					FX.Arc(flatLook(origin, target), math.max(Path.FlatDistance(origin, target) * 0.6, 3), rad(15), rad(150), NEON, 1, 0.3)
				end
			end
		end)
	elseif kind == "MultiHit" then
		local interval = p.I or def.HitInterval or 0.16
		for i, id in ipairs(targets) do
			at(h + (i - 1) * interval, function()
				local target = R.EnemyCenter(id) or tpos
				if v.UnitId == "CorruptedSamurai" then
					if not target then
						return
					end
					local origin = v.Rig.Root.Position + V(0, 1, 0)
					local even = i % 2 == 0
					local cf = flatLook(origin, target) * ANG(0, 0, rad(even and 50 or -50))
					local reach = math.max(Path.FlatDistance(origin, target) * 0.6, 3)
					FX.Arc(cf, reach, rad(10), rad(140), lv >= 5 and PINK or NEON, 0.35 + lv * 0.05, 0.25)
					FX.Sound("Slash", 1, 1.15, target)
					if lv >= 3 then
						FX.SlashMark(target, rad(even and 40 or -40), 5 + lv * 0.5, 0.35, NEON, 0.3)
					end
				else
					FX.Sphere(muzzle(), 1.6, def.ImpactKind == "Rift" and NEON or PINK, 0.2)
				end
			end)
		end
	end
end

return Units
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="ModuleScript" referent="RBX8959391D0E44981EF6F09C8608809CED">
					<Properties>
						<string name="Name">UI</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI (клиент) — оркестратор интерфейса: ScreenGui, масштаб, окна, уведомления, затемнение.
-- Дети: Kit (тема и конструкторы), HUD, Hotbar, UnitPanel, Mode, EndScreen, Shop, Cases, Openings,
-- Inventory, Halloween, Viewer. Каждый: Build(UI, ctx) + своё API; здесь — общий фасад UI.*.
--
-- API (SPEC §4)
--   Init(ctx) SetProfile(p) OnNotify(p) Update(dt) Show(name, on) Toggle(name) SelectCase(id) SetInventoryFilter(ev)
--   UpdateQueue() Fade(text) FadeTransition(text, fn) SetMapMode(key) EquippedAt(i) OpenUnit(uid) CloseUnit()
--   RefreshUnitPanel() UpgradeSelected() SellSelected() CycleTarget() SetLiteText(on) ShowPlacementHint(on, touch)
--   Toast(text, kind) Announce(title, sub, color) ToggleEquip(unitId) RefreshInventory() RefreshMode() SpecialText(def, st)
--   поля: Root Gui Modals Refs Kit Theme SelectedUid MapMode InvFilter; модули: HUD Hotbar ... Viewer

local Players = game:GetService("Players")

local UI = {}
UI.Modals = {}
UI.Refs = {}
UI.MapMode = "Void"
UI.InvFilter = nil
UI.SelectedUid = nil

local function child(name)
	return require(script:WaitForChild(name))
end
local Kit = child("Kit")
local HUD = child("HUD")
local Hotbar = child("Hotbar")
local UnitPanel = child("UnitPanel")
local Mode = child("Mode")
local EndScreen = child("EndScreen")
local Shop = child("Shop")
local Cases = child("Cases")
local Openings = child("Openings")
local Inventory = child("Inventory")
local Halloween = child("Halloween")
local Viewer = child("Viewer")

UI.Kit, UI.Theme = Kit, Kit.Theme
UI.HUD, UI.Hotbar, UI.UnitPanel, UI.Mode, UI.EndScreen, UI.Shop = HUD, Hotbar, UnitPanel, Mode, EndScreen, Shop
UI.Cases, UI.Openings, UI.Inventory, UI.Halloween, UI.Viewer = Cases, Openings, Inventory, Halloween, Viewer

local player = Players.LocalPlayer
local ctx, FX
local fading = false

------------------------------------------------------------------------
-- ФАСАД
------------------------------------------------------------------------
function UI.Toast(text, kind)
	HUD.Toast(text, kind)
end
function UI.Announce(title, sub, color)
	HUD.Announce(title, sub, color)
end
function UI.SetLiteText(on)
	HUD.SetLiteText(on)
end
function UI.ShowPlacementHint(on, touch)
	HUD.ShowPlacementHint(on, touch)
end
function UI.SetMapMode(key)
	HUD.SetMapMode(key)
end
function UI.EquippedAt(i)
	return Hotbar.EquippedAt(i)
end
function UI.OpenUnit(uid)
	UnitPanel.Open(uid)
end
function UI.CloseUnit()
	UnitPanel.Close()
end
function UI.RefreshUnitPanel()
	UnitPanel.Refresh()
end
function UI.UpgradeSelected()
	UnitPanel.Upgrade()
end
function UI.SellSelected()
	UnitPanel.Sell()
end
function UI.CycleTarget()
	UnitPanel.CycleTarget()
end
function UI.SpecialText(def, st)
	return UnitPanel.SpecialText(def, st)
end
function UI.SelectCase(id)
	Cases.Select(id)
end
function UI.SetInventoryFilter(ev)
	Inventory.SetFilter(ev)
end
function UI.RefreshInventory()
	Inventory.Refresh()
end
function UI.ToggleEquip(id)
	Inventory.ToggleEquip(id)
end
function UI.RefreshMode()
	Mode.Refresh()
end
function UI.UpdateQueue()
	Halloween.UpdateQueue()
end
function UI.Icon(kind, parent, props)
	return Kit.icon(kind, parent, props)
end
function UI.Viewport(parent, unitId, level, props)
	return Kit.unitViewport(parent, unitId, level, props)
end

------------------------------------------------------------------------
-- ОКНА (взаимоисключающие)
------------------------------------------------------------------------
local OPEN_HOOK = {
	Inventory = function()
		Inventory.Refresh()
	end,
	Mode = function()
		Mode.Refresh()
	end,
	Bestiary = function()
		Halloween.FillBestiary()
	end,
}

function UI.Toggle(name)
	local m = UI.Modals[name]
	if not m then
		return
	end
	local open = not m.Visible
	for _, o in pairs(UI.Modals) do
		o.Visible = false
	end
	m.Visible = open
	if open then
		local sc = m:FindFirstChildOfClass("UIScale")
		if sc then
			sc.Scale = 0.85
			Kit.tween(sc, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
		end
		if OPEN_HOOK[name] then
			OPEN_HOOK[name]()
		end
	end
end

function UI.Show(name, on)
	local m = UI.Modals[name]
	if not m then
		return
	end
	if on then
		if not m.Visible then
			UI.Toggle(name)
		end
	else
		m.Visible = false
	end
end

------------------------------------------------------------------------
-- ЗАТЕМНЕНИЕ (телепорты, вход/выход из боя)
------------------------------------------------------------------------
function UI.FadeTransition(text, fn)
	if fading or not UI.Gui then
		if fn then
			return fn()
		end
		return nil
	end
	fading = true
	local f = Kit.new("Frame", { Parent = UI.Gui, Name = "Fade", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 200 })
	local l = Kit.new("TextLabel", {
		Parent = f, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(700, 60), BackgroundTransparency = 1,
		Font = Enum.Font.FredokaOne, TextScaled = true, Text = text or "", TextColor3 = UI.Theme.Accent, TextTransparency = 1, ZIndex = 201,
	})
	Kit.tween(f, 0.35, { BackgroundTransparency = 0 })
	Kit.tween(l, 0.35, { TextTransparency = 0 })
	FX.Sound("Portal", 0.8, 1)
	task.wait(0.4)
	local r = table.pack(pcall(function()
		if fn then
			return fn()
		end
	end))
	task.wait(0.45)
	Kit.tween(f, 0.55, { BackgroundTransparency = 1 })
	Kit.tween(l, 0.4, { TextTransparency = 1 })
	task.delay(0.6, function()
		f:Destroy()
		fading = false
	end)
	if not r[1] then
		warn("[VOID TD] FadeTransition: " .. tostring(r[2]))
		return nil
	end
	return table.unpack(r, 2, r.n)
end

function UI.Fade(text)
	task.spawn(UI.FadeTransition, text)
end

------------------------------------------------------------------------
-- ПРОФИЛЬ И УВЕДОМЛЕНИЯ
------------------------------------------------------------------------
function UI.SetProfile(p)
	ctx.Profile = p
	Hotbar.Refresh()
	Viewer.Refresh()
	if UI.Modals.Inventory and UI.Modals.Inventory.Visible then
		Inventory.Refresh()
	end
	Halloween.OnProfile(p)
end

function UI.OnNotify(p)
	local T, fmt = UI.Theme, ctx.Config.FormatNumber
	local kind = p.Type
	if kind == "Toast" then
		UI.Toast(p.Text, p.Kind)
	elseif kind == "WaveStart" then
		FX.Sound(p.Boss and "Boss" or "WaveStart", 1, 1)
		if p.Boss then
			FX.Shake(0.4, 0.8)
			UI.Announce("WAVE " .. tostring(p.Wave), "⚠ BOSS: " .. tostring(p.Boss), T.Pink)
		else
			UI.Announce("WAVE " .. tostring(p.Wave), nil, T.Text)
		end
	elseif kind == "WaveClear" then
		UI.Toast(string.format("Волна %d пройдена! +$%s  +💎%d", math.floor(p.Wave or 0), fmt(p.Reward or 0), math.floor(p.Gems or 0)), "good")
	elseif kind == "BossDown" then
		FX.Shake(0.6, 0.6)
	elseif kind == "CoreHit" then
		if player:GetAttribute("InMatch") then
			FX.Shake(0.35, 0.3)
			FX.Sound("CoreHit", 1, 1)
			HUD.CoreHit()
		end
	elseif kind == "Victory" or kind == "Defeat" then
		FX.Sound(kind, 1, 1)
		EndScreen.Show(kind == "Victory", p)
	elseif kind == "Fade" then
		UI.Fade(p.Text or "")
	elseif kind == "Purchase" then
		FX.Sound("Purchase", 1, 1)
		UI.Toast("Покупка: +" .. tostring(p.Gems) .. " 💎", "gold")
	elseif kind == "Reset" then
		EndScreen.Clear()
		UI.CloseUnit()
		if player:GetAttribute("Island") then
			UI.Toast("Бой окончен. Ты на Хэллоуин-острове", "good")
		else
			UI.Toast("Бой окончен. Ты в лобби — встань в круг ИГРАТЬ", "good")
		end
	end
end

------------------------------------------------------------------------
-- КАДР
------------------------------------------------------------------------
function UI.Update(dt)
	if not ctx then
		return
	end
	local inMatch = player:GetAttribute("InMatch") == true
	local t = os.clock()
	HUD.Update(dt, inMatch)
	Hotbar.Update(inMatch)
	UnitPanel.Update(dt, inMatch)
	Mode.Update()
	Cases.Update(t)
	Shop.Update()
	Kit.StepSparks(t)
end

------------------------------------------------------------------------
-- ЗАПУСК
------------------------------------------------------------------------
function UI.Init(c)
	ctx = c
	FX = c.FX
	local pg = player:WaitForChild("PlayerGui")
	local old = pg:FindFirstChild("VoidTD_UI")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "VoidTD_UI"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = gui
	local scale = Instance.new("UIScale")
	scale.Name = "Scale"
	scale.Parent = root
	UI.Gui, UI.Root = gui, root
	Kit.Build(UI, c)
	Kit.SetRoot(root)
	for _, m in ipairs({ HUD, Hotbar, UnitPanel, Cases, Shop, Inventory, Mode, EndScreen, Openings, Halloween, Viewer }) do
		m.Build(UI, c)
	end
	-- масштаб под экран (корень растягивается обратно, чтобы закрывать весь экран)
	local function fit()
		local cam = workspace.CurrentCamera
		local vs = cam and cam.ViewportSize or Vector2.new(1280, 760)
		local s = math.clamp(math.min(vs.X / 1280, vs.Y / 760), 0.55, 1.15)
		scale.Scale = s
		root.Size = UDim2.fromScale(1 / s, 1 / s)
	end
	fit()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
	end
	c.Renderer.OnUnitRemoved = function(uid)
		if UI.SelectedUid == uid then
			UI.CloseUnit()
		end
	end
	gui.Parent = pg
	return UI
end

return UI
]]></ProtectedString>
					</Properties>
					<Item class="ModuleScript" referent="RBX796E4F5BC2C608A7E0292569F7B1C8AE">
						<Properties>
							<string name="Name">Cases</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Cases — окно «КЕЙСЫ»: вкладки кейсов, большое 3D-превью, шансы, юниты кейса, x1 / x10.
--
-- API
--   Cases.Build(UI, ctx) ; Cases.Select(caseId) ; Cases.Update(t) ; Cases.Selected -> caseId

local Players = game:GetService("Players")

local Cases = {}

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local V2 = Vector2.new

local UI, ctx, K, T, Config, refs
local modal, bigModel
local busy = false
Cases.Selected = "VoidCase"

local function hex(c)
	return "#" .. c:ToHex()
end

local function rateText(case)
	local lines = {}
	if case.Rewards then
		for _, r in ipairs(case.Rewards) do
			local name, col
			if r.Rune then
				local rd = Config.Runes[r.Rune]
				name, col = "Руна «" .. (rd and rd.Name or r.Rune) .. "»", Config.RuneRarity.Color
			else
				local def = Config.Units[r.Unit]
				name = (def and def.Name or r.Unit) .. " (" .. (def and def.Rarity or "?") .. ")"
				col = K.rarityColor(r.Unit)
			end
			lines[#lines + 1] = string.format('<font color="%s">%s</font>  %s%%', hex(col), name, tostring(r.Rate))
		end
	else
		for _, rar in ipairs(Config.RarityOrder) do
			local rate = case.Rates and case.Rates[rar]
			if rate and rate > 0 then
				lines[#lines + 1] = string.format('<font color="%s">%s</font>  %s%%', hex(Config.Rarities[rar].Color), string.upper(rar), tostring(rate))
			end
		end
	end
	return table.concat(lines, "\n")
end

local function fillUnits(case)
	local box = refs.CaseUnits
	for _, ch in ipairs(box:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	for i, id in ipairs(case.Units or {}) do
		local def = Config.Units[id]
		if def then
			local col = K.rarityColor(id)
			local cell = K.panel({ Parent = box, LayoutOrder = Config.Rarities[def.Rarity].Order * 100 + i, Size = UDim2.fromOffset(100, 108), BackgroundColor3 = T.BG2, StrokeColor = col, ZIndex = 7 })
			K.unitViewport(cell, id, 1, { Size = UDim2.new(1, 0, 0, 74), ZIndex = 8 })
			K.label({ Parent = cell, Position = UDim2.fromOffset(3, 74), Size = UDim2.new(1, -6, 0, 16), Text = def.Name, Font = Enum.Font.GothamBold, ZIndex = 8 })
			K.label({ Parent = cell, Position = UDim2.fromOffset(3, 90), Size = UDim2.new(1, -6, 0, 14), Text = def.Rarity, TextColor3 = col, ZIndex = 8 })
			K.eventTag(cell, id, 8)
		end
	end
	for i, r in ipairs(case.Rewards or {}) do
		local rd = r.Rune and Config.Runes[r.Rune]
		if rd then
			local col = Config.RuneRarity.Color
			local cell = K.panel({ Parent = box, LayoutOrder = 1000 + i, Size = UDim2.fromOffset(100, 108), BackgroundColor3 = T.BG2, StrokeColor = col, ZIndex = 7 })
			K.runeViewport(cell, r.Rune, { Size = UDim2.new(1, 0, 0, 74), ZIndex = 8 })
			K.label({ Parent = cell, Position = UDim2.fromOffset(3, 74), Size = UDim2.new(1, -6, 0, 16), Text = rd.Name, Font = Enum.Font.GothamBold, ZIndex = 8 })
			K.label({ Parent = cell, Position = UDim2.fromOffset(3, 90), Size = UDim2.new(1, -6, 0, 14), Text = "РУНА • HALLOWEEN", TextColor3 = col, ZIndex = 8 })
		end
	end
end

function Cases.Select(caseId)
	local case = Config.Cases[caseId]
	if not case then
		return
	end
	Cases.Selected = caseId
	refs.CaseName.Text = case.Name
	refs.CaseName.TextColor3 = case.Color
	refs.CaseDesc.Text = case.Description or ""
	refs.CaseRates.TextSize = case.Rewards and 13 or 18
	refs.CaseRates.Text = rateText(case)
	refs.CasePity.Visible = not case.Single
	local glyph = case.Currency == "HalloweenCoins" and "🎃" or "💎"
	refs.Buy1.Text = (case.Single and "ОТКРЫТЬ  " or "x1  ") .. glyph .. tostring(case.Cost1)
	refs.Buy10.Visible = not case.Single and case.Cost10 ~= nil
	if case.Cost10 then
		refs.Buy10.Text = "x10  " .. glyph .. tostring(case.Cost10)
	end
	-- большое превью
	local big = refs.CaseBig
	for _, ch in ipairs(big:GetChildren()) do
		if ch:IsA("ViewportFrame") then
			ch:Destroy()
		end
	end
	local r = K.caseViewport(big, caseId)
	bigModel = r.Model
	for id, tab in pairs(refs.CaseTabs) do
		tab.Border.Color = id == caseId and Config.Cases[id].Color or T.AccentDark
	end
	fillUnits(case)
end

local function open(count)
	if busy or UI.Openings.Busy() then
		return
	end
	busy = true
	local caseId = Cases.Selected
	local ok, res = ctx.Request("Summon", { Case = caseId, Count = count })
	busy = false
	if ok and type(res) == "table" then
		if caseId == "Halloween" then
			UI.Openings.PlayHalloween(res)
		else
			UI.Openings.PlayCase(caseId, res)
		end
	end
end

function Cases.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	modal = K.modal("Summon", "КЕЙСЫ", UDim2.fromOffset(980, 590), "Gem")
	local tabs = K.new("Frame", { Parent = modal, Position = UDim2.fromOffset(18, 70), Size = UDim2.fromOffset(200, 480), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = tabs, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.CaseTabs = {}
	for i, id in ipairs(Config.CaseOrder) do
		local case = Config.Cases[id]
		local b = K.button({ Parent = tabs, LayoutOrder = i, Size = UDim2.fromOffset(200, 140), Text = "", BackgroundColor3 = T.BG2, StrokeColor = case.Color, ZIndex = 7 }, function()
			Cases.Select(id)
			ctx.FX.Sound("Click", 1, 1)
		end)
		K.caseViewport(b, id, { Size = UDim2.new(1, 0, 0, 100), ZIndex = 8 })
		K.label({ Parent = b, Position = UDim2.fromOffset(5, 104), Size = UDim2.new(1, -10, 0, 26), Text = case.Name, TextColor3 = case.Color, ZIndex = 8 })
		refs.CaseTabs[id] = b
	end
	local big = K.new("Frame", { Parent = modal, Position = UDim2.fromOffset(236, 70), Size = UDim2.fromOffset(300, 300), BackgroundColor3 = T.BG2, BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 6 })
	K.corner(10).Parent = big
	refs.CaseBig = big
	local left = Enum.TextXAlignment.Left
	local top = Enum.TextYAlignment.Top
	refs.CaseName = K.label({ Parent = modal, Position = UDim2.fromOffset(548, 70), Size = UDim2.fromOffset(420, 40), Text = "", TextXAlignment = left, ZIndex = 6 })
	refs.CaseDesc = K.label({ Parent = modal, Position = UDim2.fromOffset(548, 112), Size = UDim2.fromOffset(420, 40), Text = "", TextScaled = false, TextSize = 15, TextWrapped = true, Font = Enum.Font.Gotham, TextColor3 = T.Dim, TextXAlignment = left, TextYAlignment = top, ZIndex = 6 })
	refs.CaseRates = K.label({ Parent = modal, Position = UDim2.fromOffset(548, 156), Size = UDim2.fromOffset(420, 150), Text = "", RichText = true, TextScaled = false, TextSize = 18, TextXAlignment = left, TextYAlignment = top, ZIndex = 6 })
	refs.CasePity = K.label({ Parent = modal, Position = UDim2.fromOffset(548, 306), Size = UDim2.fromOffset(420, 20), Text = "В x10 гарантирован минимум один Rare+", TextScaled = false, TextSize = 14, Font = Enum.Font.GothamBold, TextColor3 = T.Dim, TextXAlignment = left, ZIndex = 6 })
	local units = K.new("ScrollingFrame", {
		Parent = modal, Position = UDim2.fromOffset(236, 380), Size = UDim2.fromOffset(732, 150), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6,
		ScrollingDirection = Enum.ScrollingDirection.X, AutomaticCanvasSize = Enum.AutomaticSize.X, CanvasSize = UDim2.new(), ScrollBarThickness = 6,
	})
	K.new("UIListLayout", { Parent = units, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.CaseUnits = units
	refs.SummonGems = K.label({ Parent = modal, Position = UDim2.new(0, 236, 1, -52), Size = UDim2.fromOffset(240, 36), Text = "", TextColor3 = rgb(120, 200, 255), TextXAlignment = left, ZIndex = 6 })
	refs.Buy1 = K.button({ Parent = modal, AnchorPoint = V2(1, 1), Position = UDim2.new(1, -238, 1, -12), Size = UDim2.fromOffset(200, 50), Text = "x1", BackgroundColor3 = T.AccentDark, ZIndex = 6 }, function()
		open(1)
	end)
	refs.Buy10 = K.button({ Parent = modal, AnchorPoint = V2(1, 1), Position = UDim2.new(1, -18, 1, -12), Size = UDim2.fromOffset(210, 50), Text = "x10", BackgroundColor3 = rgb(150, 60, 200), StrokeColor = T.Gold, ZIndex = 6 }, function()
		open(10)
	end)
	Cases.Select(Cases.Selected)
end

function Cases.Update(t)
	if not modal.Visible then
		return
	end
	local prof = ctx.Profile or {}
	if Cases.Selected == "Halloween" then
		refs.SummonGems.Text = "🎃 " .. Config.FormatNumber(player:GetAttribute("HalloweenCoins") or prof.HalloweenCoins or 0)
		refs.SummonGems.TextColor3 = rgb(255, 160, 60)
	else
		refs.SummonGems.Text = "💎 " .. Config.FormatNumber(player:GetAttribute("Gems") or prof.Gems or 0)
		refs.SummonGems.TextColor3 = rgb(120, 200, 255)
	end
	if bigModel and bigModel.Parent then
		bigModel:PivotTo(CFrame.Angles(0, t * 0.6, 0))
	end
end

return Cases
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXC8E2AD19EC18FFC6CE8F06EA2DF3F0F7">
						<Properties>
							<string name="Name">EndScreen</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.EndScreen — экран победы/поражения с таймером до новой игры.
--
-- API
--   EndScreen.Build(UI, ctx) ; EndScreen.Show(victory, payload) ; EndScreen.Clear()

local EndScreen = {}

local rgb = Color3.fromRGB
local V2 = Vector2.new

local UI, ctx, K, T, refs
local overlays = {}

function EndScreen.Build(ui, c)
	UI, ctx = ui, c
	K, T, refs = ui.Kit, ui.Theme, ui.Refs
end

function EndScreen.Clear()
	for _, o in ipairs(overlays) do
		o:Destroy()
	end
	table.clear(overlays)
	refs.EndOverlay = nil
end

function EndScreen.Show(victory, p)
	EndScreen.Clear()
	p = p or {}
	local ov = K.new("Frame", {
		Parent = UI.Root, Name = "EndOverlay", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, ZIndex = 30,
		BackgroundColor3 = victory and rgb(30, 10, 50) or rgb(40, 0, 10), BackgroundTransparency = 1,
	})
	K.tween(ov, 0.6, { BackgroundTransparency = 0.3 })
	local title = K.label({
		Parent = ov, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.38), Size = UDim2.fromOffset(800, 120), ZIndex = 31,
		Text = victory and "VICTORY" or "DEFEAT", TextColor3 = victory and T.Gold or T.Bad, StrokeThickness = 4,
	})
	local sc = K.new("UIScale", { Parent = title, Scale = 0.2 })
	K.tween(sc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	local sub
	if victory then
		sub = "Пустота отступила! Награда: 💎" .. tostring(p.Gems or 0)
		if p.Coins then
			sub = sub .. "  +🎃" .. tostring(p.Coins) .. " Halloween Coins"
		end
	else
		sub = "Ядро разрушено на волне " .. tostring(p.Wave or 0)
		if p.Mode == "Halloween" then
			sub = sub .. "  •  Halloween Coins не выдаются"
		end
	end
	K.label({ Parent = ov, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(800, 40), ZIndex = 31, Text = sub })
	local timer = K.label({ Parent = ov, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.57), Size = UDim2.fromOffset(600, 30), ZIndex = 31, Text = "", TextColor3 = T.Dim })
	overlays[#overlays + 1] = ov
	refs.EndOverlay = ov
	task.spawn(function()
		for n = math.floor(p.Reset or 15), 0, -1 do
			if not ov.Parent then
				return
			end
			timer.Text = "Новая игра через " .. n .. " c"
			task.wait(1)
		end
	end)
end

return EndScreen
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXA5D2D423F76CF247B482EF6AB68AE8FF">
						<Properties>
							<string name="Name">Halloween</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Halloween — окно рун («РУНЫ»), панель очереди 4 квадратов (HALLOWEEN TD), бестиарий острова.
--
-- API
--   Halloween.Build(UI, ctx)
--   Halloween.OpenRunePicker(unitId) ; Halloween.OnProfile(p) ; Halloween.UpdateQueue() ; Halloween.FillBestiary()
--   Halloween.RuneCard(grid, r, i)   -- карточка руны в результатах (из Openings)

local Players = game:GetService("Players")

local Halloween = {}

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local V2 = Vector2.new
local BLACK = Color3.new(0, 0, 0)
local ORANGE = rgb(255, 130, 30)
local GOLD = rgb(255, 205, 80)
local BOSS_OF = { GraveWarden = "Easy", FogReaper = "Medium", CursedMonarch = "Hard" }

local UI, ctx, K, T, Config, refs
local runeModal, pickerUnit
local queue, diffButtons = nil, {}
local bestiary, bestiaryBuilt = nil, false

function Halloween.RuneCard(grid, r, i)
	return UI.Openings.RuneCard(grid, r, i)
end

------------------------------------------------------------------------
-- РУНЫ
------------------------------------------------------------------------
local function refreshPicker()
	if not runeModal or not pickerUnit then
		return
	end
	local p = ctx.Profile or {}
	local runes, slots = p.Runes or {}, p.RuneSlots or {}
	local def = Config.Units[pickerUnit]
	refs.RuneFor.Text = "Юнит: " .. (def and def.Name or tostring(pickerUnit)) .. "  •  1 руна на юнита. Руна работает, только когда надета."
	refs.RuneRemove.Visible = slots[pickerUnit] ~= nil
	local row = refs.RuneRow
	for _, ch in ipairs(row:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	for i, id in ipairs(Config.RuneOrder) do
		local rd = Config.Runes[id]
		local have = runes[id] or 0
		local used = 0
		for _, rid in pairs(slots) do
			if rid == id then
				used += 1
			end
		end
		local on = slots[pickerUnit] == id
		local card = K.panel({ Parent = row, LayoutOrder = i, Size = UDim2.fromOffset(210, 266), BackgroundColor3 = T.BG2, StrokeColor = on and GOLD or (have > 0 and rd.Color or rgb(60, 50, 60)), ZIndex = 7 })
		K.runeViewport(card, id, { Size = UDim2.new(1, 0, 0, 96), ZIndex = 8 })
		K.label({ Parent = card, Position = UDim2.fromOffset(6, 96), Size = UDim2.new(1, -12, 0, 22), Text = rd.Name, TextColor3 = rd.Color, ZIndex = 8 })
		K.label({ Parent = card, Position = UDim2.fromOffset(6, 118), Size = UDim2.new(1, -12, 0, 16), Text = string.format("есть: %d  •  надето: %d", have, used), TextColor3 = T.Dim, Font = Enum.Font.GothamBold, ZIndex = 8 })
		K.label({
			Parent = card, Position = UDim2.fromOffset(6, 136), Size = UDim2.new(1, -12, 0, 76), Text = rd.Description or "", ZIndex = 8,
			TextScaled = false, TextSize = 12, TextWrapped = true, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		})
		local free = have - used + (on and 1 or 0)
		local text, bg = "ЗАНЯТА", rgb(60, 50, 60)
		if on then
			text, bg = "НАДЕТА", rgb(90, 70, 20)
		elseif have == 0 then
			text, bg = "НЕТ РУНЫ", T.BG3
		elseif free > 0 then
			text, bg = "НАДЕТЬ", rgb(60, 110, 60)
		end
		K.button({ Parent = card, AnchorPoint = V2(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -16, 0, 38), Text = text, BackgroundColor3 = bg, ZIndex = 8 }, function()
			if on or have == 0 or free <= 0 then
				return -- свободных рун нет (сервер всё равно проверяет)
			end
			ctx.Request("EquipRune", { Unit = pickerUnit, Rune = id })
		end)
	end
end

function Halloween.OpenRunePicker(unitId)
	pickerUnit = unitId
	UI.Show("Runes", true)
	refreshPicker()
end

function Halloween.OnProfile()
	if runeModal and runeModal.Visible then
		refreshPicker()
	end
end

local function buildRunes()
	runeModal = K.modal("Runes", "РУНЫ", UDim2.fromOffset(720, 420), "Rune")
	refs.RuneFor = K.label({ Parent = runeModal, Position = UDim2.fromOffset(18, 58), Size = UDim2.new(1, -36, 0, 24), Text = "", TextColor3 = T.Dim, Font = Enum.Font.GothamBold, ZIndex = 6 })
	local row = K.new("Frame", { Parent = runeModal, Position = UDim2.fromOffset(18, 88), Size = UDim2.new(1, -36, 0, 270), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = row, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	refs.RuneRow = row
	refs.RuneRemove = K.button({
		Parent = runeModal, AnchorPoint = V2(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.fromOffset(260, 44), ZIndex = 6, Visible = false,
		Text = "СНЯТЬ РУНУ", BackgroundColor3 = rgb(110, 40, 50),
	}, function()
		if pickerUnit then
			ctx.Request("EquipRune", { Unit = pickerUnit })
		end
	end)
end

------------------------------------------------------------------------
-- ОЧЕРЕДЬ (4 квадрата)
------------------------------------------------------------------------
local function buildQueue()
	queue = K.panel({ Parent = UI.Root, Name = "HalloweenQueue", AnchorPoint = V2(1, 0.5), Position = UDim2.new(1, -110, 0.5, 0), Size = UDim2.fromOffset(330, 330), StrokeColor = ORANGE, ZIndex = 4, Visible = false })
	K.label({ Parent = queue, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 32), Text = "🎃 HALLOWEEN TD", TextColor3 = ORANGE, ZIndex = 5 })
	refs.QMembers = K.label({
		Parent = queue, Position = UDim2.fromOffset(10, 44), Size = UDim2.new(1, -20, 0, 92), Text = "", ZIndex = 5,
		TextScaled = false, TextSize = 17, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	})
	refs.QHost = K.label({ Parent = queue, Position = UDim2.fromOffset(10, 140), Size = UDim2.new(1, -20, 0, 18), Text = "", TextColor3 = T.Dim, ZIndex = 5 })
	local row = K.new("Frame", { Parent = queue, Position = UDim2.fromOffset(10, 164), Size = UDim2.new(1, -20, 0, 44), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = row, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	for i, key in ipairs(Config.Halloween.Difficulties) do
		local d = Config.Difficulties[key]
		diffButtons[key] = K.button({
			Parent = row, LayoutOrder = i, Size = UDim2.fromOffset(98, 44), ZIndex = 5, BackgroundColor3 = T.BG2, StrokeColor = d.Color, TextColor3 = d.Color,
			Text = d.Name .. "\n" .. tostring(Config.Halloween.Coins[key] or 0) .. "🎃",
		}, function()
			if queue:GetAttribute("IsHost") then
				ctx.Request("QueueDifficulty", { Difficulty = key })
			end
		end)
	end
	refs.QTimer = K.label({ Parent = queue, Position = UDim2.fromOffset(10, 214), Size = UDim2.new(1, -20, 0, 30), Text = "", TextColor3 = GOLD, ZIndex = 5 })
	refs.QStart = K.button({ Parent = queue, Position = UDim2.new(0, 10, 1, -54), Size = UDim2.new(0.5, -14, 0, 44), ZIndex = 5, Text = "СТАРТ", BackgroundColor3 = rgb(140, 70, 20), StrokeColor = ORANGE }, function()
		ctx.Request("QueueStart")
	end)
	K.button({ Parent = queue, Position = UDim2.new(0.5, 4, 1, -54), Size = UDim2.new(0.5, -14, 0, 44), ZIndex = 5, Text = "ВЫЙТИ", BackgroundColor3 = rgb(110, 30, 40), StrokeColor = T.Bad }, function()
		ctx.Request("QueueLeave")
	end)
	refs.Queue = queue
end

function Halloween.UpdateQueue()
	if not queue then
		return
	end
	local S = ctx.State
	local raw = S:GetAttribute("HQ_Members") or ""
	local members = {}
	for name in string.gmatch(raw, "[^\n]+") do
		members[#members + 1] = name
	end
	local me = table.find(members, player.DisplayName) ~= nil
	queue.Visible = me and not player:GetAttribute("InMatch")
	if not queue.Visible then
		return
	end
	local lines = {}
	for i = 1, Config.HalloweenIsland.Queue.MaxPlayers do
		lines[i] = (i == 1 and "👑 " or "• ") .. (members[i] or "свободно")
	end
	refs.QMembers.Text = table.concat(lines, "\n")
	local isHost = S:GetAttribute("HQ_Host") == player.UserId
	queue:SetAttribute("IsHost", isHost)
	refs.QHost.Text = isHost and "Ты хост: выбери сложность" or "Сложность выбирает хост"
	refs.QStart.Visible = isHost
	local sel = S:GetAttribute("HQ_Diff") or "Easy"
	for key, b in pairs(diffButtons) do
		local d = Config.Difficulties[key]
		b.BackgroundColor3 = key == sel and d.Color:Lerp(BLACK, 0.4) or T.BG2
		b.Active = isHost
		b.AutoButtonColor = false
	end
	local at = S:GetAttribute("HQ_At") or 0
	if S:GetAttribute("HQ_Busy") then
		refs.QTimer.Text = "Арена занята — ждём конца матча"
	elseif at > 0 then
		refs.QTimer.Text = "Телепорт через " .. math.max(0, math.ceil(at - workspace:GetServerTimeNow())) .. " c"
	else
		refs.QTimer.Text = ""
	end
end

------------------------------------------------------------------------
-- БЕСТИАРИЙ
------------------------------------------------------------------------
function Halloween.FillBestiary()
	if bestiaryBuilt or not bestiary then
		return
	end
	bestiaryBuilt = true
	local grid = refs.BestiaryGrid
	local n = 0
	for _, id in ipairs(Config.EnemyOrder) do
		local e = Config.Enemies[id]
		if e and e.Event == "Halloween" then
			n += 1
			local diff = BOSS_OF[id] and Config.Difficulties[BOSS_OF[id]]
			local col = diff and diff.Color or (e.MiniBoss and rgb(200, 90, 255) or ORANGE)
			local tag = diff and ("ФИНАЛЬНЫЙ БОСС • " .. diff.Name) or (e.MiniBoss and "МИНИ-БОСС" or "ВРАГ")
			local card = K.panel({ Parent = grid, LayoutOrder = n, BackgroundColor3 = T.BG2, StrokeColor = col, ZIndex = 7 })
			K.enemyViewport(card, id, { Size = UDim2.new(1, 0, 0, 110), ZIndex = 8 })
			K.label({ Parent = card, Position = UDim2.fromOffset(5, 110), Size = UDim2.new(1, -10, 0, 22), Text = e.Name or id, TextColor3 = col, ZIndex = 8 })
			K.label({
				Parent = card, Position = UDim2.fromOffset(5, 134), Size = UDim2.new(1, -10, 0, 16), ZIndex = 8, Font = Enum.Font.GothamBold, TextColor3 = T.Dim,
				Text = string.format("%s  •  HP %d  •  скор. %g", tag, math.floor((e.Health or 0) + 0.5), e.Speed or 0),
			})
			K.label({
				Parent = card, Position = UDim2.fromOffset(5, 152), Size = UDim2.new(1, -10, 0, 78), Text = e.Description or "", ZIndex = 8,
				TextScaled = false, TextSize = 12, TextWrapped = true, Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			})
		end
	end
end

local function buildBestiary()
	bestiary = K.modal("Bestiary", "БЕСТИАРИЙ • HAUNTED HOLLOW", UDim2.fromOffset(940, 580), "Pumpkin")
	local grid = K.new("ScrollingFrame", {
		Parent = bestiary, Position = UDim2.fromOffset(18, 66), Size = UDim2.new(1, -36, 1, -80), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 6,
	})
	K.new("UIGridLayout", { Parent = grid, CellSize = UDim2.fromOffset(212, 236), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.BestiaryGrid = grid
end

function Halloween.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	buildRunes()
	buildQueue()
	buildBestiary()
end

return Halloween
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXC4CA92030B699E0A8081C4C34EED2B71">
						<Properties>
							<string name="Name">Hotbar</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Hotbar — слоты экипировки внизу экрана (клик или 1–6 — начать размещение).
--
-- API
--   Hotbar.Build(UI, ctx) ; Hotbar.Refresh() ; Hotbar.Update(inMatch) ; Hotbar.EquippedAt(i) -> unitId|nil

local Players = game:GetService("Players")

local Hotbar = {}

local player = Players.LocalPlayer
local V2 = Vector2.new

local UI, ctx, K, T, Config, refs
local slots = {}

function Hotbar.EquippedAt(i)
	local p = ctx and ctx.Profile
	return p and p.Equipped and p.Equipped[tostring(i)] or nil
end

function Hotbar.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	local n = Config.Settings.EquipSlots
	local bar = K.new("Frame", {
		Parent = ui.Root, Name = "Hotbar", AnchorPoint = V2(0.5, 1), Size = UDim2.fromOffset(n * 104, 128),
		Position = UDim2.new(0.5, 0, 1, -12), BackgroundTransparency = 1, Visible = false,
	})
	K.new("UIListLayout", { Parent = bar, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	refs.Hotbar = bar
	for i = 1, n do
		local b = K.button({ Parent = bar, Name = "Slot" .. i, LayoutOrder = i, Size = UDim2.fromOffset(96, 124), BackgroundColor3 = T.BG2, Text = "" }, function()
			local id = Hotbar.EquippedAt(i)
			if id then
				ctx.Placement.Start(id)
			else
				UI.Toast("Пустой слот: экипируй юнитов в круге ЮНИТЫ в лобби", "error")
			end
		end)
		slots[i] = { Button = b }
	end
end

function Hotbar.Refresh()
	for i, s in ipairs(slots) do
		local b = s.Button
		for _, ch in ipairs(b:GetChildren()) do
			if ch:IsA("ViewportFrame") or ch:IsA("TextLabel") or ch:IsA("Frame") then
				ch:Destroy()
			end
		end
		s.Cost, s.Price = nil, nil
		K.label({ Parent = b, Size = UDim2.fromOffset(20, 20), Position = UDim2.fromOffset(5, 3), Text = tostring(i), TextColor3 = T.Dim, ZIndex = 3 })
		local id = Hotbar.EquippedAt(i)
		local def = id and Config.Units[id]
		if def then
			local col = K.rarityColor(id)
			b.Border.Color = col
			local strip = K.new("Frame", { Parent = b, Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0, 4), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 2 })
			K.corner(2).Parent = strip
			K.unitViewport(b, id, 1, { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 82) })
			K.label({ Parent = b, Position = UDim2.fromOffset(3, 86), Size = UDim2.new(1, -6, 0, 16), Text = def.Name, Font = Enum.Font.GothamBold })
			s.Price = def.Levels[1].Cost
			s.Cost = K.label({ Parent = b, Position = UDim2.fromOffset(3, 102), Size = UDim2.new(1, -6, 0, 18), Text = "$" .. Config.FormatNumber(s.Price), TextColor3 = T.Good })
		else
			b.Border.Color = T.AccentDark
			K.label({ Parent = b, Position = UDim2.fromOffset(5, 40), Size = UDim2.new(1, -10, 0, 40), Text = "+", TextColor3 = T.Dim })
		end
	end
end

function Hotbar.Update(inMatch)
	refs.Hotbar.Visible = inMatch
	if not inMatch then
		return
	end
	local money = player:GetAttribute("Money") or 0
	for _, s in ipairs(slots) do
		if s.Cost then
			s.Cost.TextColor3 = money >= s.Price and T.Good or T.Bad
		end
	end
end

return Hotbar
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXB3DF9BAA9A568A41425D48626084D824">
						<Properties>
							<string name="Name">HUD</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.HUD — валюта, волна и ядро, полоса босса, кнопка волны, иконки справа, «В ЛОББИ»,
-- подсказка размещения и тач-кнопки, тосты и объявления.
--
-- API
--   HUD.Build(UI, ctx) ; HUD.Update(dt, inMatch)
--   HUD.Toast(text, kind) ; HUD.Announce(title, sub, color) ; HUD.SetLiteText(on)
--   HUD.ShowPlacementHint(on, touch) ; HUD.SetMapMode(key) ; HUD.CoreHit()

local Players = game:GetService("Players")

local HUD = {}

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local V2 = Vector2.new
local ORANGE = rgb(255, 130, 30)

local UI, ctx, K, T, Config, refs

local TOAST_COLOR = { error = "Bad", good = "Good", boss = "Pink", gold = "Gold" }

function HUD.Toast(text, kind)
	if not refs or not refs.Toasts then
		return
	end
	local color = T[TOAST_COLOR[kind] or "Accent"]
	-- не больше 6 тостов: старый уходит
	local list = refs.Toasts:GetChildren()
	local n = 0
	for _, c in ipairs(list) do
		if c:IsA("Frame") then
			n += 1
		end
	end
	if n >= 6 then
		for _, c in ipairs(list) do
			if c:IsA("Frame") then
				c:Destroy()
				break
			end
		end
	end
	local p = K.panel({ Parent = refs.Toasts, Size = UDim2.fromOffset(380, 38), StrokeColor = color, BackgroundTransparency = 0.05 })
	local l = K.label({ Parent = p, Position = UDim2.fromOffset(8, 5), Size = UDim2.new(1, -16, 1, -10), Text = tostring(text or ""), TextColor3 = color })
	local sc = K.new("UIScale", { Parent = p, Scale = 0.6 })
	K.tween(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		if p.Parent then
			K.tween(p, 0.3, { BackgroundTransparency = 1 })
			K.tween(l, 0.3, { TextTransparency = 1 })
			task.delay(0.32, function()
				p:Destroy()
			end)
		end
	end)
end

function HUD.Announce(title, sub, color)
	local h = refs.Announce
	h:ClearAllChildren()
	local sc = K.new("UIScale", { Parent = h, Scale = 0.3 })
	K.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	local t1 = K.label({ Parent = h, Size = UDim2.new(1, 0, 0.62, 0), Text = title or "", TextColor3 = color or T.Text, StrokeThickness = 3 })
	local t2
	if sub then
		t2 = K.label({ Parent = h, Position = UDim2.fromScale(0, 0.66), Size = UDim2.new(1, 0, 0.32, 0), Text = sub, TextColor3 = T.Dim })
	end
	h.Visible = true
	task.delay(2.2, function()
		if t1.Parent then
			K.tween(t1, 0.4, { TextTransparency = 1 })
			if t2 then
				K.tween(t2, 0.4, { TextTransparency = 1 })
			end
		end
	end)
end

function HUD.SetLiteText(on)
	if refs.LiteCaption then
		refs.LiteCaption.Text = on and "ЛЁГКАЯ" or "ПОЛНАЯ"
		refs.LiteCaption.TextColor3 = on and T.Good or T.Text
	end
end

function HUD.ShowPlacementHint(on, touch)
	refs.PlaceHint.Visible = on and not touch or false
	refs.TouchBar.Visible = on and touch or false
end

local function coreColor()
	return UI.MapMode == "Halloween" and ORANGE or T.Accent
end

function HUD.SetMapMode(key)
	UI.MapMode = key
	refs.CoreFill.BackgroundColor3 = coreColor()
end

function HUD.CoreHit()
	refs.CoreFill.BackgroundColor3 = T.Bad
	K.tween(refs.CoreFill, 0.4, { BackgroundColor3 = coreColor() })
end

------------------------------------------------------------------------
-- ПОСТРОЕНИЕ
------------------------------------------------------------------------
local function buildCurrency(root)
	local cur = K.panel({ Parent = root, Name = "Currency", Size = UDim2.fromOffset(230, 92), Position = UDim2.fromOffset(16, 16) })
	refs.Currency = cur
	local function row(y, color, icon, iy, isz, ix)
		local l = K.label({ Parent = cur, Position = UDim2.fromOffset(52, y), Size = UDim2.new(1, -60, 0, 32), Text = "0", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color })
		local ic = K.icon(icon, cur, { Size = UDim2.fromOffset(isz, isz), Position = UDim2.fromOffset(ix, iy) })
		return l, ic
	end
	refs.Money, refs.MoneyIcon = row(6, rgb(255, 220, 120), "Coin", 7, 34, 10)
	refs.Money.Size = UDim2.new(1, -60, 0, 36)
	refs.Gems, refs.GemsIcon = row(50, rgb(150, 200, 255), "Gem", 49, 34, 10)
	refs.Coins, refs.CoinsIcon = row(92, rgb(255, 160, 60), "Pumpkin", 91, 32, 11)
	refs.Coins.Size = UDim2.new(1, -60, 0, 30)
end

local function buildTop(root)
	local top = K.panel({ Parent = root, Name = "Top", AnchorPoint = V2(0.5, 0), Size = UDim2.fromOffset(420, 104), Position = UDim2.new(0.5, 0, 0, 12), Visible = false })
	refs.Top = top
	refs.Wave = K.label({ Parent = top, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(1, -20, 0, 40), Text = "WAVE 0 / 30" })
	refs.Status = K.label({ Parent = top, Position = UDim2.fromOffset(10, 44), Size = UDim2.new(1, -20, 0, 22), Text = "", TextColor3 = T.Dim, Font = Enum.Font.GothamBold })
	local bar = K.new("Frame", { Parent = top, Position = UDim2.fromOffset(12, 72), Size = UDim2.new(1, -24, 0, 24), BackgroundColor3 = rgb(25, 12, 32), BorderSizePixel = 0 })
	K.corner(6).Parent = bar
	local fill = K.new("Frame", { Parent = bar, Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Accent, BorderSizePixel = 0 })
	K.corner(6).Parent = fill
	K.new("UIGradient", { Parent = fill, Color = ColorSequence.new(rgb(120, 50, 220), rgb(230, 120, 255)) })
	refs.CoreFill = fill
	refs.CoreText = K.label({ Parent = bar, Size = UDim2.fromScale(1, 1), Text = "VOID CORE 100 / 100", ZIndex = 2 })

	local boss = K.panel({ Parent = root, Name = "BossBar", AnchorPoint = V2(0.5, 0), Size = UDim2.fromOffset(560, 46), Position = UDim2.new(0.5, 0, 0, 124), StrokeColor = T.Pink, Visible = false })
	refs.Boss = boss
	local bb = K.new("Frame", { Parent = boss, Position = UDim2.fromOffset(8, 20), Size = UDim2.new(1, -16, 0, 20), BackgroundColor3 = rgb(30, 8, 20), BorderSizePixel = 0 })
	K.corner(5).Parent = bb
	refs.BossFill = K.new("Frame", { Parent = bb, Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Pink, BorderSizePixel = 0 })
	K.corner(5).Parent = refs.BossFill
	refs.BossName = K.label({ Parent = boss, Position = UDim2.fromOffset(8, 2), Size = UDim2.new(1, -16, 0, 18), Text = "BOSS", TextColor3 = T.Pink })
	refs.BossHP = K.label({ Parent = bb, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 2 })
end

local function buildButtons(root)
	refs.StartWave = K.button({
		Parent = root, Name = "StartWave", AnchorPoint = V2(1, 1), Size = UDim2.fromOffset(220, 60), Position = UDim2.new(1, -18, 1, -150),
		Text = "▶ START WAVE", BackgroundColor3 = rgb(70, 150, 90), StrokeColor = T.Good, Visible = false,
	}, function()
		ctx.Request("StartWave")
	end)

	local dock = K.new("Frame", { Parent = root, Name = "IconDock", AnchorPoint = V2(1, 0.5), Position = UDim2.new(1, -14, 0.5, -40), Size = UDim2.fromOffset(84, 290), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = dock, Padding = UDim.new(0, 12), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	refs.ShopButton = K.iconButton(dock, 1, "Gem", "МАГАЗИН", rgb(44, 52, 92), rgb(18, 18, 36), rgb(110, 150, 230), function()
		UI.Toggle("Shop")
		ctx.FX.Sound("Click", 1, 1)
	end)
	refs.InvButton = K.iconButton(dock, 2, "Helmet", "ЮНИТЫ", rgb(66, 44, 100), rgb(22, 14, 36), rgb(150, 110, 210), function()
		UI.Toggle("Inventory")
	end)
	refs.LiteButton, refs.LiteCaption = K.iconButton(dock, 3, "Gear", "ГРАФИКА", rgb(56, 54, 72), rgb(22, 20, 30), rgb(120, 116, 140), function()
		ctx.SetLite(not ctx.Lite, true)
	end, 62)
	HUD.SetLiteText(ctx.Lite)

	local leave = K.button({
		Parent = root, Name = "LeaveButton", Size = UDim2.fromOffset(150, 44), Position = UDim2.fromOffset(16, 118),
		Text = "    В ЛОББИ", BackgroundColor3 = rgb(80, 30, 46), StrokeColor = rgb(170, 70, 90), Visible = false,
	}, function()
		ctx.Placement.Stop()
		UI.CloseUnit()
		task.spawn(UI.FadeTransition, "ВОЗВРАЩЕНИЕ В ЛОББИ", function()
			return ctx.Request("LeaveMatch")
		end)
	end)
	K.icon("Back", leave, { Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(12, 9), ZIndex = 2 })
	refs.Leave = leave

	local hint = K.panel({ Parent = root, Name = "PlaceHint", AnchorPoint = V2(0.5, 1), Size = UDim2.fromOffset(520, 34), Position = UDim2.new(0.5, 0, 1, -150), Visible = false })
	K.label({ Parent = hint, Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 1, -8), Font = Enum.Font.GothamBold,
		Text = "ЛКМ — поставить  •  R — повернуть  •  Q / ПКМ — отмена  •  Shift — несколько" })
	refs.PlaceHint = hint

	local bar = K.new("Frame", { Parent = root, Name = "TouchBar", AnchorPoint = V2(0.5, 1), Size = UDim2.fromOffset(380, 56), Position = UDim2.new(0.5, 0, 1, -190), BackgroundTransparency = 1, Visible = false })
	K.new("UIListLayout", { Parent = bar, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	local function tb(order, text, color, fn)
		K.button({ Parent = bar, LayoutOrder = order, Size = UDim2.fromOffset(115, 52), Text = text, BackgroundColor3 = color }, fn)
	end
	tb(1, "PLACE", rgb(60, 140, 80), function()
		ctx.Placement.Confirm()
	end)
	tb(2, "ROTATE", T.BG3, function()
		ctx.Placement.Rotate()
	end)
	tb(3, "CANCEL", rgb(140, 40, 60), function()
		ctx.Placement.Stop()
	end)
	refs.TouchBar = bar

	local toasts = K.new("Frame", { Parent = root, Name = "Toasts", AnchorPoint = V2(0.5, 0), Size = UDim2.fromOffset(400, 300), Position = UDim2.new(0.5, 0, 0, 180), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = toasts, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	refs.Toasts = toasts
	refs.Announce = K.new("Frame", { Parent = root, Name = "Announce", AnchorPoint = V2(0.5, 0.5), Size = UDim2.fromOffset(700, 130), Position = UDim2.fromScale(0.5, 0.36), BackgroundTransparency = 1, Visible = false })
end

function HUD.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	buildCurrency(ui.Root)
	buildTop(ui.Root)
	buildButtons(ui.Root)
end

------------------------------------------------------------------------
-- КАДР
------------------------------------------------------------------------
local PHASE_TEXT = { Prep = "Расставь юнитов и начни волну", Victory = "ПОБЕДА!", Defeat = "Ядро разрушено" }

function HUD.Update(dt, inMatch)
	local fmt = Config.FormatNumber
	local prof = ctx.Profile or {}
	-- валюта
	local gy = inMatch and 50 or 8
	refs.Currency.Size = UDim2.fromOffset(230, gy + 84)
	refs.Gems.Position = UDim2.fromOffset(52, gy)
	refs.GemsIcon.Position = UDim2.fromOffset(10, gy - 1)
	refs.Coins.Position = UDim2.fromOffset(52, gy + 44)
	refs.CoinsIcon.Position = UDim2.fromOffset(11, gy + 43)
	refs.Money.Visible = inMatch
	refs.MoneyIcon.Visible = inMatch
	refs.Money.Text = fmt(player:GetAttribute("Money") or 0)
	refs.Gems.Text = fmt(player:GetAttribute("Gems") or prof.Gems or 0)
	refs.Coins.Text = fmt(player:GetAttribute("HalloweenCoins") or prof.HalloweenCoins or 0)

	refs.Top.Visible = inMatch
	refs.Leave.Visible = inMatch
	local State = ctx.State
	local phase = State:GetAttribute("Phase")
	refs.StartWave.Visible = inMatch and (phase == "Prep" or phase == "Intermission") or false
	if not inMatch then
		refs.Boss.Visible = false
		return
	end
	-- волна и статус
	local diffKey = State:GetAttribute("Difficulty")
	local d = diffKey and Config.Difficulties[diffKey]
	refs.Wave.Text = "WAVE " .. tostring(State:GetAttribute("Wave") or 0) .. " / " .. tostring(State:GetAttribute("MaxWave") or 30) .. (d and ("  •  " .. d.Name) or "")
	refs.Wave.TextColor3 = d and d.Color or T.Text
	if phase == "Intermission" then
		local left = math.max(0, math.ceil((State:GetAttribute("NextWaveAt") or 0) - workspace:GetServerTimeNow()))
		refs.Status.Text = "Следующая волна через " .. left .. " c"
		refs.StartWave.Text = "▶ START WAVE (" .. left .. ")"
	elseif phase == "Wave" then
		local n = 0
		for _ in pairs(ctx.Renderer.EnemyViews) do
			n += 1
		end
		refs.Status.Text = "Врагов на поле: " .. n
	elseif PHASE_TEXT[phase] then
		refs.Status.Text = PHASE_TEXT[phase]
	end
	if phase == "Prep" then
		refs.StartWave.Text = "▶ START WAVE"
	end
	-- ядро
	local hp, maxHp = State:GetAttribute("CoreHP") or 100, State:GetAttribute("CoreMaxHP") or 100
	refs.CoreFill.Size = UDim2.fromScale(math.clamp(hp / math.max(maxHp, 1), 0, 1), 1)
	refs.CoreText.Text = (UI.MapMode == "Halloween" and "СВЯТИЛИЩЕ  " or "VOID CORE  ") .. tostring(math.floor(hp + 0.5)) .. " / " .. tostring(math.floor(maxHp + 0.5))
	-- босс
	local bossId = State:GetAttribute("BossId") or 0
	local bv = bossId ~= 0 and ctx.Renderer.EnemyViews[bossId]
	if bv then
		refs.Boss.Visible = true
		refs.BossName.Text = "☠ " .. string.upper(State:GetAttribute("BossName") or "BOSS")
		refs.BossFill.Size = UDim2.fromScale(math.clamp((bv.HP or 0) / math.max(bv.MaxHP or 1, 1), 0, 1), 1)
		refs.BossHP.Text = fmt(bv.HP or 0) .. " / " .. fmt(bv.MaxHP or 0)
	else
		refs.Boss.Visible = false
	end
end

return HUD
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXAE6992D0C7820FC6FBCAB4730B4AC9F5">
						<Properties>
							<string name="Name">Inventory</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Inventory — окно «ЮНИТЫ»: экипировка (6 слотов), коллекция, описание и таблица уровней,
-- руна юнита, EQUIP / UNEQUIP. Клик по открытому юниту — 3D-просмотр.
--
-- API
--   Inventory.Build(UI, ctx) ; Inventory.Refresh() ; Inventory.ToggleEquip(unitId) ; Inventory.SetFilter(eventKey|nil)

local Inventory = {}

local rgb = Color3.fromRGB
local V2 = Vector2.new

local UI, ctx, K, T, Config, refs
local modal, selected

local function prof()
	return ctx.Profile or {}
end

local function owned(id)
	local inv = prof().Inventory
	return inv and (inv[id] or 0) > 0
end

local function slotOf(id)
	local eq = prof().Equipped or {}
	for i = 1, Config.Settings.EquipSlots do
		if eq[tostring(i)] == id then
			return i
		end
	end
	return nil
end

function Inventory.ToggleEquip(id)
	if not owned(id) then
		return
	end
	local slot = slotOf(id)
	if slot then
		ctx.Request("Equip", { Unit = nil, Slot = slot })
		return
	end
	local eq = prof().Equipped or {}
	for i = 1, Config.Settings.EquipSlots do
		if not eq[tostring(i)] then
			ctx.Request("Equip", { Unit = id, Slot = i })
			return
		end
	end
	UI.Toast("Все слоты заняты — сними юнита сверху", "error")
end

function Inventory.SetFilter(ev)
	UI.InvFilter = ev
	if modal and modal.Visible then
		Inventory.Refresh()
	end
end

local function clear(frame)
	for _, ch in ipairs(frame:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
end

local function fmtStats(def)
	local lines = { "LV   DMG     RNG   CD     COST" }
	local fmt = Config.FormatNumber
	for i, st in ipairs(def.Levels) do
		lines[#lines + 1] = string.format("%-4d %-7s %-5s %-6s $%s", i, fmt(st.Damage), tostring(st.Range), string.format("%.2f", st.Cooldown), fmt(st.Cost))
	end
	return table.concat(lines, "\n")
end

local function select(id)
	selected = id
	local def = Config.Units[id]
	if not def then
		return
	end
	local have = owned(id)
	refs.InvName.Text = have and def.Name or "???"
	refs.InvName.TextColor3 = K.rarityColor(id)
	local ev = def.Event and Config.Events[def.Event]
	refs.InvRarity.Text = string.upper(def.Rarity) .. (ev and ("  •  " .. ev.Tag) or "") .. (def.Ability and ("  •  " .. def.Ability) or "")
	refs.InvRarity.TextColor3 = K.rarityColor(id)
	refs.InvDesc.Text = def.Description or ""
	refs.InvStats.Text = fmtStats(def)
	refs.InvEquip.Visible = have
	refs.InvRune.Visible = have
	if have then
		local eq = slotOf(id) ~= nil
		refs.InvEquip.Text = eq and "UNEQUIP" or "EQUIP"
		refs.InvEquip.BackgroundColor3 = eq and rgb(130, 50, 60) or rgb(60, 130, 80)
		local runeId = (prof().RuneSlots or {})[id]
		local rd = runeId and Config.Runes[runeId]
		refs.InvRune.Text = rd and ("РУНА: " .. rd.Name .. "  (сменить)") or "РУНА: нет  (надеть)"
	end
end

function Inventory.Refresh()
	if not modal then
		return
	end
	local p = prof()
	local eq = p.Equipped or {}
	-- экипировка
	clear(refs.EquipRow)
	for i = 1, Config.Settings.EquipSlots do
		local id = eq[tostring(i)]
		local b = K.button({ Parent = refs.EquipRow, LayoutOrder = i, Size = UDim2.fromOffset(92, 90), Text = "", BackgroundColor3 = T.BG2, StrokeColor = id and K.rarityColor(id) or T.AccentDark, ZIndex = 7 }, function()
			if id then
				ctx.Request("Equip", { Unit = nil, Slot = i })
			end
		end)
		if id then
			K.unitViewport(b, id, 1, { ZIndex = 8 })
		else
			K.label({ Parent = b, Size = UDim2.fromScale(1, 1), Text = tostring(i), TextColor3 = T.Dim, ZIndex = 8 })
		end
	end
	-- коллекция
	clear(refs.InvGrid)
	local inv = p.Inventory or {}
	local slots = p.RuneSlots or {}
	for i, id in ipairs(Config.UnitOrder) do
		local def = Config.Units[id]
		if def and (not UI.InvFilter or def.Event == UI.InvFilter) then
			local count = inv[id] or 0
			local have = count > 0
			local col = K.rarityColor(id)
			local card = K.button({ Parent = refs.InvGrid, LayoutOrder = i, Text = "", BackgroundColor3 = T.BG2, StrokeColor = have and col or rgb(60, 50, 70), ZIndex = 7 }, function()
				select(id)
				if owned(id) then
					UI.Viewer.Open(id, 1)
				else
					UI.Toast("Сначала открой этого юнита в кейсе — тогда откроется 3D-просмотр", "error")
				end
			end)
			K.new("UIGradient", { Parent = card, Rotation = 90, Color = ColorSequence.new(col:Lerp(T.BG, have and 0.6 or 0.9), T.BG) })
			K.unitViewport(card, id, 1, { Size = UDim2.new(1, 0, 0, 96), ZIndex = 8, Silhouette = not have })
			K.label({ Parent = card, Position = UDim2.fromOffset(4, 98), Size = UDim2.new(1, -8, 0, 18), Text = have and def.Name or "???", Font = Enum.Font.GothamBold, ZIndex = 8 })
			K.label({ Parent = card, Position = UDim2.fromOffset(4, 118), Size = UDim2.new(1, -8, 0, 16), Text = def.Rarity, TextColor3 = col, ZIndex = 8 })
			if have then
				K.label({ Parent = card, Position = UDim2.new(1, -44, 0, 4), Size = UDim2.fromOffset(40, 20), Text = "x" .. count, TextColor3 = T.Gold, ZIndex = 9 })
			end
			if slots[id] then
				K.icon("Rune", card, { Size = UDim2.fromOffset(20, 20), Position = UDim2.new(1, -24, 0, 26), ZIndex = 10 })
			end
			K.eventTag(card, id, 8, UDim2.fromOffset(4, 82))
		end
	end
	if selected then
		select(selected)
	end
end

function Inventory.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	modal = K.modal("Inventory", "ЮНИТЫ", UDim2.fromOffset(860, 560), "Helmet")
	K.label({ Parent = modal, Position = UDim2.fromOffset(18, 56), Size = UDim2.fromOffset(300, 22), Text = "ЭКИПИРОВКА (клик — снять)", TextColor3 = T.Dim, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6 })
	local row = K.new("Frame", { Parent = modal, Position = UDim2.fromOffset(18, 80), Size = UDim2.new(1, -36, 0, 92), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = row, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.EquipRow = row
	local grid = K.new("ScrollingFrame", {
		Parent = modal, Position = UDim2.fromOffset(18, 182), Size = UDim2.new(0, 500, 1, -196), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ScrollBarThickness = 6,
	})
	K.new("UIGridLayout", { Parent = grid, CellSize = UDim2.fromOffset(112, 140), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	K.pad(4).Parent = grid
	refs.InvGrid = grid
	local det = K.new("Frame", { Parent = modal, Position = UDim2.fromOffset(536, 182), Size = UDim2.new(1, -556, 1, -196), BackgroundColor3 = T.BG2, BorderSizePixel = 0, ZIndex = 6 })
	K.corner(10).Parent = det
	local left, top = Enum.TextXAlignment.Left, Enum.TextYAlignment.Top
	refs.InvName = K.label({ Parent = det, Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 30), Text = "Выбери юнита", TextXAlignment = left, ZIndex = 7 })
	refs.InvRarity = K.label({ Parent = det, Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -20, 0, 18), Text = "", TextXAlignment = left, ZIndex = 7 })
	refs.InvDesc = K.label({ Parent = det, Position = UDim2.fromOffset(10, 60), Size = UDim2.new(1, -20, 0, 48), Text = "", TextScaled = false, TextSize = 14, TextWrapped = true, Font = Enum.Font.Gotham, TextColor3 = T.Dim, TextXAlignment = left, TextYAlignment = top, ZIndex = 7 })
	refs.InvStats = K.label({ Parent = det, Position = UDim2.fromOffset(10, 110), Size = UDim2.new(1, -20, 0, 120), Text = "", TextScaled = false, TextSize = 14, Font = Enum.Font.Code, TextXAlignment = left, TextYAlignment = top, ZIndex = 7 })
	refs.InvRune = K.button({
		Parent = det, AnchorPoint = V2(0, 1), Position = UDim2.new(0, 10, 1, -60), Size = UDim2.new(1, -20, 0, 34), ZIndex = 7, Visible = false,
		Text = "РУНА: нет", TextColor3 = rgb(255, 170, 70), BackgroundColor3 = rgb(50, 26, 20), StrokeColor = rgb(255, 130, 30),
	}, function()
		if selected then
			UI.Halloween.OpenRunePicker(selected)
		end
	end)
	refs.InvEquip = K.button({ Parent = det, AnchorPoint = V2(0, 1), Position = UDim2.new(0, 10, 1, -10), Size = UDim2.new(1, -20, 0, 44), Text = "EQUIP", BackgroundColor3 = rgb(60, 130, 80), Visible = false, ZIndex = 7 }, function()
		if selected then
			Inventory.ToggleEquip(selected)
		end
	end)
end

return Inventory
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXBF8658C63611D6B53A19895BF059F1A5">
						<Properties>
							<string name="Name">Kit</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Kit (клиент) — тема, конструкторы, нарисованные иконки, 3D-превью, теги события
-- Весь интерфейс создаётся кодом: без картинок и эмодзи в иконках (иконки — из Frame).
--
-- ПОДКЛЮЧЕНИЕ
--   local Kit = require(script.Kit); Kit.Build(UI, ctx)   -- первым из детей UI
--   Build: Kit.UI = UI; UI.Kit = Kit; UI.Theme = Kit.Theme; UI.Modals = UI.Modals or {} (Kit.Modals — та же
--   таблица); модели берутся из ctx (UnitModels, EnemyModels, CaseModels), иначе из ReplicatedStorage.VoidTD.Models.
--   Окна (modal) кладутся в UI.Root (или Kit.Root, если задан); Kit.SetRoot(frame) — сменить вручную.
--
-- ТЕМА
--   Kit.Theme = { BG BG2 BG3 Accent AccentDark Text Dim Good Bad Gold Pink, Orange (255,130,30) HGold (255,205,80) }
--
-- КОНСТРУКТОРЫ (props — свойства экземпляра; Parent ставится ПОСЛЕДНИМ; служебные ключи
--   Radius / StrokeColor / StrokeThickness не пишутся в экземпляр)
--   Kit.new(class, props?, children?) -> Instance
--   Kit.corner(r=8) -> UICorner (offset)
--   Kit.stroke(color=Accent, th=2, transparency=0) -> UIStroke Name="Border" (Border mode; код меняет obj.Border.Color)
--   Kit.textStroke(th=1.5) -> UIStroke (10,0,20) Contextual
--   Kit.pad(px) -> UIPadding со всех сторон
--   Kit.tween(obj, t, goal, style=Quad, dir=Out) -> Tween (уже запущен)
--   Kit.panel(props) -> Frame  BG, прозрачность 0.12, угол Radius|10, рамка Border StrokeColor|AccentDark (2)
--   Kit.label(props) -> TextLabel  без фона, FredokaOne, цвет Text, TextScaled (если не false), обводка StrokeThickness
--   Kit.button(props, onClick?) -> TextButton  BG3, FredokaOne, угол Radius|8, рамка Border StrokeColor|Accent,
--        UIScale с анимацией наведения (1.06 / 1 / 0.94 / 1.04); onClick — на Activated
--   Kit.shape(parent, x, y, w, h, color, rot?, round?, z?, props?) -> Frame  фигура в долях контейнера (центр x,y)
--   Kit.shade(frame, top, bottom, rot=90) -> UIGradient
--
-- ИКОНКИ
--   Kit.icon(kind, parent, props?) -> Frame "Icon"..kind (квадрат, UIAspectRatioConstraint)
--        props: Size (по умолчанию scale 1,1), Position, AnchorPoint, ZIndex (фигуры рисуются с ZIndex+1..)
--        kind: Gem Coin Helmet Gear Back Pumpkin Rune; Kit.Icons[kind] = function(container, z) — свои иконки
--   Kit.iconButton(parent, order, kind, caption, top, bottom, edge, onClick?, size=76) -> button, captionLabel
--        TextButton Name = kind.."Button", градиент top->bottom, рамка edge, блик, иконка 0.72, подпись снизу
--
-- ОКНА
--   Kit.modal(name, title, size, iconKind?, parent?) -> Frame
--        панель по центру (ZIndex 5, скрыта, UIScale для анимации открытия), иконка 38x38, заголовок
--        (прямой ребёнок окна — по нему тесты ищут окна), кнопка "✕" прячет окно; регистрируется в UI.Modals[name]
--
-- 3D-ПРЕВЬЮ (ViewportFrame; частицы, свет, шлейфы, огонь/дым убираются — во ViewportFrame они не рисуются)
--   Kit.unitViewport(parent, unitId, level=1, props?) -> vf, rig|nil   (props.Silhouette — чёрный силуэт)
--   Kit.enemyViewport(parent, enemyId, props?) -> vf, rig|nil
--   Kit.runeViewport(parent, runeId, props?) -> vf, r|nil   (вращается в Kit.StepSpins; vf:GetAttribute("Spin"))
--   Kit.caseViewport(parent, caseId, props?) -> r   (r = CaseModels.Build(caseId) + r.Viewport; при ошибке —
--        заглушка { Model = пустая Model, Base = {}, Shards = {}, Cracks = {}, Failed = true, Viewport })
--   props: Size (scale 1,1), Position, AnchorPoint, ZIndex. Kit.viewport = Kit.unitViewport (как в легаси).
--
-- ПРОЧЕЕ
--   Kit.rarityColor(unitId) -> Color3 (цвет редкости; неизвестный юнит — Theme.Dim)
--   Kit.eventTag(parent, unitId, z=1, textPos?, textSize?)  -- только для юнитов события (def.Event):
--        тыква 22x22 в углу, подпись Events[ev].Tag (если textPos), 4 искры. Рамка остаётся цветом редкости.
--   Kit.eventSparks(parent, z, n=4)
--   Kit.StepSparks(t=os.clock())  -- каждый кадр из UI.Update: искры поднимаются и гаснут; также крутит руны
--   Kit.StepSpins(t=os.clock())   -- только вращение 3D-рун (видимых)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Kit = {}
Kit.Modals = {}

local V2 = Vector2.new
local V3 = Vector3.new
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)

local Theme = {
	BG = rgb(16, 10, 26),
	BG2 = rgb(32, 20, 50),
	BG3 = rgb(48, 30, 72),
	Accent = rgb(170, 80, 255),
	AccentDark = rgb(90, 40, 150),
	Text = rgb(242, 234, 255),
	Dim = rgb(170, 155, 195),
	Good = rgb(90, 220, 140),
	Bad = rgb(255, 80, 110),
	Gold = rgb(255, 205, 70),
	Pink = rgb(255, 70, 170),
	-- цвета события Хэллоуин
	Orange = rgb(255, 130, 30),
	HGold = rgb(255, 205, 80),
}
Kit.Theme = Theme

------------------------------------------------------------------------
-- ПОДКЛЮЧЕНИЕ
------------------------------------------------------------------------
local ctx

function Kit.Build(UI, c)
	ctx = c or ctx
	if UI then
		Kit.UI = UI
		UI.Kit = Kit
		UI.Theme = Theme
		local modals = UI.Modals or {}
		for name, m in pairs(Kit.Modals) do
			if modals[name] == nil then
				modals[name] = m
			end
		end
		UI.Modals = modals
		Kit.Modals = modals
	end
	return Kit
end

function Kit.SetRoot(frame)
	Kit.Root = frame
end

-- модели: из ctx, иначе напрямую из ReplicatedStorage
local function models(key, child)
	local m = ctx and ctx[key]
	if m then
		return m
	end
	local folder = Shared:FindFirstChild("Models")
	local mod = folder and folder:FindFirstChild(child)
	if mod then
		local ok, res = pcall(require, mod)
		if ok then
			return res
		end
	end
	return nil
end

------------------------------------------------------------------------
-- КОНСТРУКТОРЫ
------------------------------------------------------------------------
local CUSTOM = { Parent = true, Radius = true, StrokeColor = true, StrokeThickness = true }

local function new(class, props, children)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if not CUSTOM[k] then
				o[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = o
		end
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end
Kit.new = new

-- копия props с значениями по умолчанию (исходную таблицу не трогаем)
local function with(props, defaults)
	local o = {}
	for k, v in pairs(defaults) do
		o[k] = v
	end
	if props then
		for k, v in pairs(props) do
			o[k] = v
		end
	end
	return o
end

function Kit.corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

function Kit.stroke(color, th, transparency)
	return new("UIStroke", {
		Name = "Border",
		Color = color or Theme.Accent,
		Thickness = th or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.textStroke(th)
	return new("UIStroke", { Color = rgb(10, 0, 20), Thickness = th or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function Kit.pad(px)
	local u = UDim.new(0, px or 0)
	return new("UIPadding", { PaddingLeft = u, PaddingRight = u, PaddingTop = u, PaddingBottom = u })
end

local function tween(o, t, goal, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
Kit.tween = tween

function Kit.panel(props)
	props = props or {}
	local p = with(props, { BackgroundColor3 = Theme.BG, BackgroundTransparency = 0.12 })
	p.BorderSizePixel = 0
	local parent = p.Parent
	p.Parent = nil
	local f = new("Frame", p)
	Kit.corner(props.Radius or 10).Parent = f
	Kit.stroke(props.StrokeColor or Theme.AccentDark, 2).Parent = f
	f.Parent = parent
	return f
end

function Kit.label(props)
	props = props or {}
	local p = with(props, { Font = Enum.Font.FredokaOne, TextColor3 = Theme.Text, TextScaled = true })
	p.BackgroundTransparency = 1
	local parent = p.Parent
	p.Parent = nil
	local l = new("TextLabel", p)
	Kit.textStroke(props.StrokeThickness).Parent = l
	l.Parent = parent
	return l
end

-- анимация наведения/нажатия через UIScale
local function hoverScale(b, over, down)
	local sc = new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		tween(sc, 0.12, { Scale = over })
	end)
	b.MouseLeave:Connect(function()
		tween(sc, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(sc, 0.06, { Scale = down })
	end)
	b.MouseButton1Up:Connect(function()
		tween(sc, 0.1, { Scale = 1.04 })
	end)
	return sc
end

function Kit.button(props, onClick)
	props = props or {}
	local p = with(props, { BackgroundColor3 = Theme.BG3, Font = Enum.Font.FredokaOne, TextColor3 = Theme.Text, TextScaled = true })
	p.BorderSizePixel = 0
	p.AutoButtonColor = false
	local parent = p.Parent
	p.Parent = nil
	local b = new("TextButton", p)
	Kit.corner(props.Radius or 8).Parent = b
	Kit.stroke(props.StrokeColor or Theme.Accent, 2).Parent = b
	Kit.textStroke().Parent = b
	hoverScale(b, 1.06, 0.94)
	if onClick then
		b.Activated:Connect(onClick)
	end
	b.Parent = parent
	return b
end

------------------------------------------------------------------------
-- ИКОНКИ ИЗ ФИГУР
------------------------------------------------------------------------
-- фигура в долях контейнера: центр (x, y), размер (w, h), поворот, скругление (доля)
local function shape(parent, x, y, w, h, color, rot, round, z, props)
	local f = new("Frame", {
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rot or 0,
		ZIndex = z or 1,
	})
	if round then
		new("UICorner", { Parent = f, CornerRadius = UDim.new(round, 0) })
	end
	if props then
		for k, v in pairs(props) do
			f[k] = v
		end
	end
	f.Parent = parent
	return f
end
Kit.shape = shape

local function shade(f, top, bottom, rot)
	return new("UIGradient", { Parent = f, Rotation = rot or 90, Color = ColorSequence.new(top, bottom) })
end
Kit.shade = shade

local function edge(f, color, th)
	new("UIStroke", { Parent = f, Color = color, Thickness = th })
end

local Icons = {}
Kit.Icons = Icons

-- кристалл: огранённый ромб с бликом
function Icons.Gem(c, z)
	local o = shape(c, 0.5, 0.52, 0.6, 0.6, WHITE, 45, 0.12, z)
	shade(o, rgb(150, 210, 255), rgb(80, 70, 220), 45)
	edge(o, rgb(20, 14, 50), 2)
	shape(c, 0.5, 0.4, 0.28, 0.28, rgb(215, 240, 255), 45, 0.1, z + 1, { BackgroundTransparency = 0.15 })
	shape(c, 0.38, 0.38, 0.08, 0.16, WHITE, 45, 0.5, z + 2, { BackgroundTransparency = 0.1 })
end

-- монета со знаком $
function Icons.Coin(c, z)
	local o = shape(c, 0.5, 0.5, 0.74, 0.74, WHITE, 0, 0.5, z)
	shade(o, rgb(255, 225, 110), rgb(190, 120, 30))
	edge(o, rgb(70, 40, 10), 2)
	local i = shape(c, 0.5, 0.5, 0.5, 0.5, rgb(215, 150, 45), 0, 0.5, z + 1)
	new("TextLabel", {
		Parent = i,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "$",
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = rgb(90, 50, 10),
		ZIndex = z + 2,
	})
end

-- шлем рыцаря Пустоты: рога, купол, гребень, Т-визор
function Icons.Helmet(c, z)
	local acc = rgb(196, 130, 255)
	for _, sx in ipairs({ -1, 1 }) do
		shape(c, 0.5 + 0.26 * sx, 0.26, 0.09, 0.3, rgb(215, 205, 190), 28 * sx, 0.3, z)
	end
	local h = shape(c, 0.5, 0.55, 0.54, 0.62, WHITE, 0, 0.22, z + 1)
	shade(h, rgb(110, 106, 130), rgb(40, 36, 54))
	edge(h, rgb(16, 12, 24), 2)
	shape(c, 0.5, 0.2, 0.1, 0.18, rgb(90, 86, 110), 0, 0.3, z)
	shape(c, 0.5, 0.48, 0.38, 0.07, acc, 0, 0.5, z + 2)
	shape(c, 0.5, 0.6, 0.07, 0.24, acc, 0, 0.5, z + 2)
end

-- шестерёнка настроек: 8 зубцов, диск, отверстие
function Icons.Gear(c, z)
	local col = rgb(190, 186, 210)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		shape(c, 0.5 + math.cos(a) * 0.3, 0.5 + math.sin(a) * 0.3, 0.16, 0.16, col, math.deg(a), 0.15, z)
	end
	shape(c, 0.5, 0.5, 0.6, 0.6, col, 0, 0.5, z + 1)
	shape(c, 0.5, 0.5, 0.26, 0.26, rgb(34, 30, 48), 0, 0.5, z + 2)
end

-- стрелка «назад»
function Icons.Back(c, z)
	local col = rgb(255, 235, 240)
	shape(c, 0.56, 0.5, 0.5, 0.12, col, 0, 0.5, z)
	shape(c, 0.34, 0.37, 0.32, 0.12, col, -42, 0.5, z)
	shape(c, 0.34, 0.63, 0.32, 0.12, col, 42, 0.5, z)
end

-- тыква: три дольки, хвостик, вырезанное лицо
function Icons.Pumpkin(c, z)
	for i, x in ipairs({ 0.3, 0.7, 0.5 }) do
		local mid = i == 3
		local o = shape(c, x, 0.58, mid and 0.42 or 0.38, 0.6, WHITE, 0, 0.45, z + (mid and 1 or 0))
		shade(o, rgb(255, 165, 60), rgb(190, 80, 20))
		edge(o, rgb(70, 25, 5), 1.5)
	end
	shape(c, 0.52, 0.22, 0.1, 0.18, rgb(80, 110, 40), 14, 0.3, z + 2)
	local eye = rgb(255, 230, 120)
	for _, x in ipairs({ 0.38, 0.62 }) do
		shape(c, x, 0.52, 0.12, 0.12, eye, 45, 0.1, z + 3)
	end
	shape(c, 0.5, 0.7, 0.34, 0.08, eye, 0, 0.4, z + 3)
end

-- руна: камень-ромб с символом
function Icons.Rune(c, z)
	local o = shape(c, 0.5, 0.5, 0.62, 0.62, WHITE, 45, 0.15, z)
	shade(o, rgb(255, 160, 60), rgb(120, 30, 40), 45)
	edge(o, rgb(40, 10, 10), 2)
	local glyph = rgb(255, 240, 200)
	shape(c, 0.5, 0.5, 0.08, 0.42, glyph, 0, 0.5, z + 1)
	shape(c, 0.5, 0.4, 0.3, 0.07, glyph, 30, 0.5, z + 1)
	shape(c, 0.5, 0.6, 0.3, 0.07, glyph, -30, 0.5, z + 1)
end

-- квадратный контейнер с иконкой
function Kit.icon(kind, parent, props)
	props = props or {}
	local z = props.ZIndex or 1
	local c = new("Frame", {
		Name = "Icon" .. tostring(kind),
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or V2(0, 0),
		ZIndex = z,
	})
	new("UIAspectRatioConstraint", { Parent = c })
	local draw = Icons[kind]
	if draw then
		draw(c, z + 1)
	else
		warn("[UI.Kit] нет иконки " .. tostring(kind))
	end
	c.Parent = parent
	return c
end

-- квадратная кнопка-иконка с подписью (панель справа)
function Kit.iconButton(parent, order, kind, caption, top, bottom, edgeColor, onClick, size)
	size = size or 76
	local b = new("TextButton", {
		Name = kind .. "Button",
		LayoutOrder = order or 0,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
	})
	Kit.corner(16).Parent = b
	Kit.stroke(edgeColor, 2).Parent = b
	new("UIGradient", { Parent = b, Rotation = 90, Color = ColorSequence.new(top, bottom) })
	-- мягкий блик сверху
	local shine = new("Frame", {
		Parent = b,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 0.4, 0),
	})
	Kit.corner(12).Parent = shine
	Kit.icon(kind, b, { Size = UDim2.fromScale(0.72, 0.72), Position = UDim2.fromScale(0.5, 0.48), AnchorPoint = V2(0.5, 0.5), ZIndex = 2 })
	local cap = Kit.label({
		Parent = b,
		AnchorPoint = V2(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 3),
		Size = UDim2.new(1, 16, 0, math.max(14, size * 0.2)),
		Text = caption or "",
		Font = Enum.Font.GothamBold,
	})
	hoverScale(b, 1.08, 0.93)
	if onClick then
		b.Activated:Connect(onClick)
	end
	b.Parent = parent
	return b, cap
end

------------------------------------------------------------------------
-- МОДАЛЬНЫЕ ОКНА
------------------------------------------------------------------------
local function rootFrame()
	local ui = Kit.UI
	return (ui and ui.Root) or Kit.Root
end

function Kit.modal(name, title, size, iconKind, parent)
	local m = Kit.panel({
		Name = "Modal_" .. tostring(name),
		AnchorPoint = V2(0.5, 0.5),
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		Visible = false,
		BackgroundTransparency = 0.04,
		ZIndex = 5,
	})
	new("UIScale", { Parent = m })
	local x = 18
	if iconKind then
		Kit.icon(iconKind, m, { Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(16, 13), ZIndex = 6 })
		x = 62
	end
	-- заголовок — прямой ребёнок окна (тесты ищут окно по нему)
	Kit.label({
		Parent = m,
		Name = "Title",
		Size = UDim2.new(1, -80 - x, 0, 44),
		Position = UDim2.fromOffset(x, 10),
		Text = title or "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Accent,
	})
	Kit.button({
		Parent = m,
		Name = "Close",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -52, 0, 12),
		Text = "✕",
		BackgroundColor3 = rgb(120, 30, 50),
	}, function()
		m.Visible = false
	end)
	Kit.Modals[name] = m
	m.Parent = parent or rootFrame()
	return m
end

------------------------------------------------------------------------
-- 3D-ПРЕВЬЮ
------------------------------------------------------------------------
-- во ViewportFrame не рисуются частицы, свет, шлейфы — убираем, чтобы не тратить память
local function strip(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
			d:Destroy()
		end
	end
end
Kit.StripModel = strip

local function viewportFrame(parent, props, ambient, lightColor, lightDir)
	props = props or {}
	return new("ViewportFrame", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or V2(0, 0),
		Ambient = ambient,
		LightColor = lightColor,
		LightDirection = lightDir,
		ZIndex = props.ZIndex or 1,
	})
end

local function camera(vf, fov, cf)
	local cam = Instance.new("Camera")
	cam.FieldOfView = fov
	cam.CFrame = cf
	cam.Parent = vf
	vf.CurrentCamera = cam
	return cam
end

-- юнит: камера сбоку-спереди, дальше — чтобы оружие помещалось целиком
function Kit.unitViewport(parent, unitId, level, props)
	props = props or {}
	local vf = viewportFrame(parent, props, rgb(150, 130, 185), rgb(255, 245, 255), V3(-0.6, -1, -0.8))
	if props.Silhouette then
		vf.ImageColor3 = rgb(0, 0, 0)
		vf.ImageTransparency = 0.2
	end
	local UnitModels = models("UnitModels", "Units")
	if not UnitModels or not UnitModels.Build then
		return vf
	end
	local ok, rig = pcall(UnitModels.Build, unitId, level or 1)
	if not ok or type(rig) ~= "table" or not rig.Model then
		if not ok then
			warn("[UI.Kit] превью " .. tostring(unitId) .. ": " .. tostring(rig))
		end
		return vf
	end
	strip(rig.Model)
	rig.Model.Parent = vf
	local s = rig.Scale or 1
	local center = V3(0, -0.1 * s, 0)
	camera(vf, 34, CFrame.lookAt(center + V3(5.6, 2.6, -14.5) * s, center))
	return vf, rig
end
Kit.viewport = Kit.unitViewport

-- враг (бестиарий): камера по высоте модели
function Kit.enemyViewport(parent, enemyId, props)
	local vf = viewportFrame(parent, props, rgb(150, 130, 160), rgb(255, 240, 230), V3(-0.5, -1, -0.8))
	local EnemyModels = models("EnemyModels", "Enemies")
	if not EnemyModels or not EnemyModels.Build then
		return vf
	end
	local ok, rig = pcall(EnemyModels.Build, enemyId)
	if not ok or type(rig) ~= "table" or not rig.Model then
		if not ok then
			warn("[UI.Kit] превью врага " .. tostring(enemyId) .. ": " .. tostring(rig))
		end
		return vf
	end
	strip(rig.Model)
	rig.Model.Parent = vf
	local h = rig.Height or 5
	local c = V3(0, h * 0.5 - (rig.HipHeight or 0), 0)
	camera(vf, 34, CFrame.lookAt(c + V3(h * 0.45, h * 0.25, -h * 1.7), c))
	return vf, rig
end

-- руны медленно вращаются (Kit.StepSpins)
local spins = {}

function Kit.runeViewport(parent, runeId, props)
	local vf = viewportFrame(parent, props, rgb(170, 140, 130), rgb(255, 240, 220), V3(-0.5, -1, -0.7))
	local UnitModels = models("UnitModels", "Units")
	if not UnitModels or not UnitModels.BuildRune then
		return vf
	end
	local ok, r = pcall(UnitModels.BuildRune, runeId)
	if not ok or type(r) ~= "table" or not r.Model then
		if not ok then
			warn("[UI.Kit] руна " .. tostring(runeId) .. ": " .. tostring(r))
		end
		return vf
	end
	strip(r.Model)
	r.Model.Parent = vf
	camera(vf, 30, CFrame.lookAt(V3(2.2, 1.4, -6.5), V3(0, 0, 0)))
	vf:SetAttribute("Spin", true)
	spins[#spins + 1] = { Model = r.Model, VF = vf, Vis = true, Next = 0 }
	return vf, r
end

-- кейс: модель собирает CaseModels (части анимируются напрямую через CFrame)
function Kit.caseViewport(parent, caseId, props)
	local vf = viewportFrame(parent, props, rgb(160, 140, 190), rgb(255, 245, 255), V3(-0.5, -1, -0.7))
	local CaseModels = models("CaseModels", "Cases")
	local ok, r = false, nil
	if CaseModels and CaseModels.Build then
		ok, r = pcall(CaseModels.Build, caseId)
	end
	if not ok or type(r) ~= "table" or not r.Model then
		if CaseModels then
			warn("[UI.Kit] кейс " .. tostring(caseId) .. ": " .. tostring(r))
		end
		r = { Model = Instance.new("Model"), Base = {}, Shards = {}, Cracks = {}, Failed = true }
	end
	r.Base = r.Base or {}
	r.Shards = r.Shards or {}
	r.Cracks = r.Cracks or {}
	r.Model.Parent = vf
	camera(vf, 40, CFrame.lookAt(V3(0, 4.5, -13), V3(0, 2.6, 0)))
	r.Viewport = vf
	return r
end

------------------------------------------------------------------------
-- РЕДКОСТЬ И ТЕГ СОБЫТИЯ
------------------------------------------------------------------------
function Kit.rarityColor(unitId)
	local def = Config.Units and Config.Units[unitId]
	local r = def and Config.Rarities and Config.Rarities[def.Rarity]
	return (r and r.Color) or Theme.Dim
end

-- лёгкие оранжевые искры на карточках юнитов события (двигаются в Kit.StepSparks)
local sparks = {}
local SPARK = rgb(255, 160, 60)

function Kit.eventSparks(parent, z, n)
	for _ = 1, n or 4 do
		local f = new("Frame", {
			Name = "Spark",
			BackgroundColor3 = SPARK,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(3, 3),
			Rotation = 45,
			ZIndex = z or 1,
			BackgroundTransparency = 0.2,
		})
		local sp = { F = f, X = math.random(), P = math.random() * 3, S = 0.25 + math.random() * 0.25, Vis = true, Next = 0 }
		f.Position = UDim2.fromScale(sp.X, 1)
		f.Parent = parent
		sparks[#sparks + 1] = sp
	end
end

-- значок-тыква, подпись события и искры; рамка карточки остаётся цветом редкости
function Kit.eventTag(parent, unitId, z, textPos, textSize)
	local def = Config.Units and Config.Units[unitId]
	local ev = def and def.Event and Config.Events and Config.Events[def.Event]
	if not ev then
		return nil
	end
	z = z or 1
	local ic = Kit.icon("Pumpkin", parent, { Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(4, 4), ZIndex = z + 2 })
	local tag
	if textPos then
		tag = Kit.label({
			Parent = parent,
			Name = "EventTag",
			Size = textSize or UDim2.new(1, -8, 0, 13),
			Position = textPos,
			Text = ev.Tag,
			TextColor3 = ev.Color,
			Font = Enum.Font.GothamBold,
			ZIndex = z + 1,
		})
	end
	Kit.eventSparks(parent, z + 1, 4)
	return ic, tag
end

------------------------------------------------------------------------
-- ПОКАДРОВОЕ ОБНОВЛЕНИЕ
------------------------------------------------------------------------
-- виден ли элемент на экране (все GuiObject-предки Visible, есть ScreenGui/LayerCollector)
local function onScreen(obj)
	local o = obj
	while o do
		if o:IsA("LayerCollector") then
			return o.Enabled ~= false
		end
		if o:IsA("GuiObject") and not o.Visible then
			return false
		end
		o = o.Parent
	end
	return false
end

-- проверка видимости раз в 0.25 с, чтобы не обходить предков каждый кадр
local function visibleCached(it, t)
	if t >= it.Next then
		it.Next = t + 0.25
		it.Vis = onScreen(it.F or it.VF)
	end
	return it.Vis
end

function Kit.StepSpins(t)
	t = t or os.clock()
	local cf
	for i = #spins, 1, -1 do
		local it = spins[i]
		if not it.VF.Parent or not it.Model.Parent then
			spins[i] = spins[#spins]
			spins[#spins] = nil
		elseif visibleCached(it, t) then
			cf = cf or (CFrame.new(0, math.sin(t * 1.6) * 0.08, 0) * CFrame.Angles(0, t * 0.9, 0))
			it.Model:PivotTo(cf)
		end
	end
end

function Kit.StepSparks(t)
	t = t or os.clock()
	for i = #sparks, 1, -1 do
		local sp = sparks[i]
		local f = sp.F
		if not f.Parent then
			sparks[i] = sparks[#sparks]
			sparks[#sparks] = nil
		elseif visibleCached(sp, t) then
			-- поднимаются снизу вверх, покачиваясь, и гаснут
			local a = (t * sp.S + sp.P) % 1
			f.Position = UDim2.fromScale(sp.X + math.sin(t * 2 + sp.P) * 0.04, 1 - a)
			f.BackgroundTransparency = 0.2 + a * 0.8
		end
	end
	Kit.StepSpins(t)
end

function Kit.Step(t)
	Kit.StepSparks(t)
end

-- локальный игрок (для модулей UI)
Kit.Player = Players.LocalPlayer

return Kit
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX864E91D8B98DC7BDEFC2B4D946BEEA49">
						<Properties>
							<string name="Name">Mode</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Mode — окно «ВЫБОР СЛОЖНОСТИ» (круг ИГРАТЬ): карточки сложностей или «ПРИСОЕДИНИТЬСЯ» к идущему бою.
--
-- API
--   Mode.Build(UI, ctx) ; Mode.Refresh() ; Mode.Update() ; Mode.Join(diffKey|nil)

local Mode = {}

local rgb = Color3.fromRGB
local BLACK = Color3.new(0, 0, 0)

local UI, ctx, K, T, Config, refs
local modal, cards, running, runningText

function Mode.Join(key)
	modal.Visible = false
	task.spawn(function()
		local ok = UI.FadeTransition("ПОРТАЛ ОТКРЫВАЕТСЯ...", function()
			return ctx.Request("JoinMatch", { Difficulty = key })
		end)
		if not ok then
			UI.Show("Mode", true)
		end
	end)
end

function Mode.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	modal = K.modal("Mode", "ВЫБОР СЛОЖНОСТИ", UDim2.fromOffset(880, 430))
	cards = K.new("Frame", { Parent = modal, Position = UDim2.fromOffset(18, 70), Size = UDim2.new(1, -36, 0, 340), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = cards, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	for i, key in ipairs(Config.DifficultyOrder) do
		local d = Config.Difficulties[key]
		local card = K.panel({ Parent = cards, LayoutOrder = i, Size = UDim2.fromOffset(200, 336), BackgroundColor3 = T.BG2, StrokeColor = d.Color, ZIndex = 6 })
		K.new("UIGradient", { Parent = card, Rotation = 90, Color = ColorSequence.new(d.Color:Lerp(T.BG, 0.6), T.BG) })
		K.label({ Parent = card, Position = UDim2.fromOffset(8, 10), Size = UDim2.new(1, -16, 0, 40), Text = d.Name, TextColor3 = d.Color, ZIndex = 7 })
		K.label({
			Parent = card, Position = UDim2.fromOffset(10, 56), Size = UDim2.new(1, -20, 0, 116), ZIndex = 7,
			Font = Enum.Font.Code, TextScaled = false, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
			Text = string.format("HP врагов   x%.2g\nСкорость    x%.2g\nДеньги      x%.2g\nГемы        x%.2g\nЯдро        %d HP",
				d.HP, d.Speed, d.Money, d.Gems, math.floor(d.CoreHP + 0.5)),
		})
		K.label({
			Parent = card, Position = UDim2.fromOffset(10, 176), Size = UDim2.new(1, -20, 0, 70), ZIndex = 7, Text = d.Description or "",
			Font = Enum.Font.Gotham, TextScaled = false, TextSize = 14, TextWrapped = true, TextColor3 = T.Dim,
			TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
		})
		K.button({
			Parent = card, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(1, -24, 0, 50), ZIndex = 7,
			Text = "ИГРАТЬ", BackgroundColor3 = d.Color:Lerp(BLACK, 0.45), StrokeColor = d.Color,
		}, function()
			Mode.Join(key)
		end)
	end
	running = K.new("Frame", { Parent = modal, Position = UDim2.fromOffset(18, 80), Size = UDim2.new(1, -36, 0, 300), BackgroundTransparency = 1, Visible = false })
	runningText = K.label({ Parent = running, Size = UDim2.new(1, 0, 0, 120), Text = "", ZIndex = 7 })
	K.button({
		Parent = running, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 160), Size = UDim2.fromOffset(320, 64), ZIndex = 7,
		Text = "ПРИСОЕДИНИТЬСЯ", BackgroundColor3 = T.AccentDark,
	}, function()
		Mode.Join(nil)
	end)
	refs.ModeCards, refs.ModeRunning = cards, running
end

function Mode.Refresh()
	local State = ctx.State
	local phase = State:GetAttribute("Phase") or "Idle"
	local idle = phase == "Idle"
	cards.Visible = idle
	running.Visible = not idle
	if not idle then
		local d = Config.Difficulties[State:GetAttribute("Difficulty") or "Medium"] or Config.Difficulties.Medium
		runningText.Text = "Уже идёт бой: " .. d.Name .. ", волна " .. tostring(State:GetAttribute("Wave") or 0) .. "\nПрисоединяйся к команде!"
		runningText.TextColor3 = d.Color
	end
end

function Mode.Update()
	if modal.Visible then
		Mode.Refresh()
	end
end

return Mode
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX38DD77CAECD0F7EA6AC339F3F00A662D">
						<Properties>
							<string name="Name">Openings</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Openings — анимации открытия кейсов (тряска → взрыв → карточки) и проклятого сундука Хэллоуина
-- (цепи → крышка → награда поднимается), кинематограф SECRET.
--
-- API
--   Openings.Build(UI, ctx)
--   Openings.PlayCase(caseId, results)     results = { {Id, New} | {Rune, New}, ... }
--   Openings.PlayHalloween(results)         показывает results[1]
--   Openings.ShowCards(overlay, results) ; Openings.RuneCard(grid, r, i) ; Openings.Busy() -> bool

local RunService = game:GetService("RunService")

local Openings = {}

local rgb = Color3.fromRGB
local V2 = Vector2.new
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local BLACK = Color3.new(0, 0, 0)
local WHITE = Color3.new(1, 1, 1)
local ORANGE = rgb(255, 130, 30)
local GOLD = rgb(255, 205, 80)

local UI, ctx, K, T, Config, FX
local active = 0 -- открытых оверлеев (защита от двойного открытия)

function Openings.Busy()
	return active > 0
end

local function overlay(color, transp)
	active += 1
	local ov = K.new("Frame", { Parent = UI.Root, Name = "CaseOverlay", Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BackgroundTransparency = transp, BorderSizePixel = 0, ZIndex = 20 })
	ov.Destroying:Connect(function()
		active = math.max(0, active - 1)
	end)
	return ov
end

local function flash(parent, color, transp, life)
	local f = K.new("Frame", { Parent = parent, Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BackgroundTransparency = transp, BorderSizePixel = 0, ZIndex = 30 })
	K.tween(f, life, { BackgroundTransparency = 1 })
	task.delay(life + 0.05, function()
		f:Destroy()
	end)
end

local function okButton(ov, props)
	local p = { Parent = ov, AnchorPoint = V2(0.5, 1), Position = UDim2.fromScale(0.5, 0.95), Size = UDim2.fromOffset(200, 54), Text = "OK", ZIndex = 25 }
	for k, v in pairs(props or {}) do
		p[k] = v
	end
	return K.button(p, function()
		ov:Destroy()
	end)
end

-- кинематограф SECRET поверх оверлея; done() — по окончании
local function secretFlash(ov, color, flickerColor, flickers, hold, sub)
	FX.Sound("Secret", 1, color == ORANGE and 0.9 or 1)
	FX.Shake(0.8, color == ORANGE and 1.4 or 1.2)
	local blk = K.new("Frame", { Parent = ov, Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 40 })
	local lab = K.label({ Parent = blk, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(900, 160), Text = "SECRET!!", TextColor3 = color, StrokeThickness = 4, ZIndex = 41 })
	if sub then
		K.label({ Parent = blk, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.6), Size = UDim2.fromOffset(700, 50), Text = sub, TextColor3 = rgb(255, 60, 60), ZIndex = 41 })
	end
	for i = 1, flickers do
		task.wait(0.12)
		if not blk.Parent then
			return
		end
		blk.BackgroundColor3 = i % 2 == 0 and flickerColor or BLACK
		lab.Rotation = math.random(-5, 5)
	end
	task.wait(math.max(0, hold - flickers * 0.12))
	if not blk.Parent then
		return
	end
	K.tween(blk, hold > 1.5 and 0.5 or 0.4, { BackgroundTransparency = 1 })
	for _, d in ipairs(blk:GetChildren()) do
		if d:IsA("TextLabel") then
			K.tween(d, 0.4, { TextTransparency = 1 })
		end
	end
	task.wait(hold > 1.5 and 0.55 or 0.45)
	blk:Destroy()
end

------------------------------------------------------------------------
-- КАРТОЧКИ НАГРАД
------------------------------------------------------------------------
local function cardBase(grid, i, col)
	local card = K.panel({ Parent = grid, LayoutOrder = i, BackgroundColor3 = T.BG2, StrokeColor = col, ZIndex = 23 })
	K.new("UIGradient", { Parent = card, Rotation = 90, Color = ColorSequence.new(col:Lerp(T.BG, 0.55), T.BG) })
	local sc = K.new("UIScale", { Parent = card, Scale = 0 })
	K.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	return card
end

function Openings.RuneCard(grid, r, i)
	local rd = Config.Runes[r.Rune]
	local col = Config.RuneRarity.Color
	local card = cardBase(grid, i, col)
	K.runeViewport(card, r.Rune, { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 120), ZIndex = 24 })
	K.label({ Parent = card, Position = UDim2.fromOffset(4, 130), Size = UDim2.new(1, -8, 0, 22), Text = rd and rd.Name or tostring(r.Rune), ZIndex = 24 })
	K.label({ Parent = card, Position = UDim2.fromOffset(4, 154), Size = UDim2.new(1, -8, 0, 18), Text = "РУНА • " .. Config.RuneRarity.Name, TextColor3 = col, ZIndex = 24 })
	return card
end

function Openings.ShowCards(ov, results)
	local n = #results
	local rows = n > 5 and 2 or 1
	local grid = K.new("Frame", { Parent = ov, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(5 * 150, rows * 200), BackgroundTransparency = 1, ZIndex = 22 })
	K.new("UIGridLayout", { Parent = grid, CellSize = UDim2.fromOffset(140, 190), CellPadding = UDim2.fromOffset(10, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	task.spawn(function()
		for i, r in ipairs(results) do
			task.wait(0.15)
			if not ov.Parent then
				return
			end
			if r.Rune then
				Openings.RuneCard(grid, r, i)
			else
				local def = Config.Units[r.Id]
				if def then
					local col = K.rarityColor(r.Id)
					local card = cardBase(grid, i, col)
					K.unitViewport(card, r.Id, 1, { Position = UDim2.fromOffset(0, 8), Size = UDim2.new(1, 0, 0, 120), ZIndex = 24 })
					K.label({ Parent = card, Position = UDim2.fromOffset(4, 130), Size = UDim2.new(1, -8, 0, 22), Text = def.Name, ZIndex = 24 })
					K.label({ Parent = card, Position = UDim2.fromOffset(4, 154), Size = UDim2.new(1, -8, 0, 18), Text = string.upper(def.Rarity), TextColor3 = col, ZIndex = 24 })
					K.eventTag(card, r.Id, 24, UDim2.fromOffset(4, 172), UDim2.new(1, -8, 0, 14))
					if r.New then
						K.label({ Parent = card, Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(56, 22), Text = "NEW!", TextColor3 = T.Gold, Rotation = -12, ZIndex = 25 })
					end
					FX.Sound("Reveal", 1, 0.8 + Config.Rarities[def.Rarity].Order * 0.12)
				end
			end
		end
		task.wait(0.4)
		if ov.Parent then
			okButton(ov)
		end
	end)
end

------------------------------------------------------------------------
-- ОБЫЧНЫЙ КЕЙС
------------------------------------------------------------------------
local SHAKE, BURST = 1.4, 0.9

function Openings.PlayCase(caseId, results)
	local case = Config.Cases[caseId]
	if not case then
		return
	end
	local best = 1
	for _, r in ipairs(results) do
		local def = r.Id and Config.Units[r.Id]
		if def then
			best = math.max(best, Config.Rarities[def.Rarity].Order)
		end
	end
	local bestName = Config.RarityOrder[best]
	local bestColor = Config.Rarities[bestName].Color
	local ov = overlay(rgb(5, 0, 10), 0.15)
	local stage = K.new("Frame", { Parent = ov, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(520, 520), BackgroundTransparency = 1, ZIndex = 21 })
	local r = K.caseViewport(stage, caseId, { ZIndex = 21 })
	local title = K.label({ Parent = ov, AnchorPoint = V2(0.5, 0), Position = UDim2.fromScale(0.5, 0.06), Size = UDim2.fromOffset(700, 56), Text = case.Name, TextColor3 = case.Color, StrokeThickness = 3, ZIndex = 22 })
	-- направления разлёта
	local dirs = {}
	for p, base in pairs(r.Base) do
		local d = base.Position - V3(0, 2, 0)
		d = d.Magnitude > 0.01 and d.Unit or V3(0, 1, 0)
		dirs[p] = d + V3(math.random() - 0.5, math.random() * 0.6, math.random() - 0.5)
	end
	local blood = caseId == "BloodMoon"
	local t0 = os.clock()
	local nextShake, burst = 0, false
	local conn
	local function finish()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if not ov.Parent then
			return
		end
		stage:Destroy()
		title.Text = best >= 4 and (string.upper(bestName) .. "!") or case.Name
		title.TextColor3 = bestColor
		if bestName == "Secret" then
			task.spawn(function()
				secretFlash(ov, rgb(255, 30, 50), rgb(120, 0, 10), 8, 1.4)
				if ov.Parent then
					Openings.ShowCards(ov, results)
				end
			end)
		else
			Openings.ShowCards(ov, results)
		end
	end
	conn = RunService.RenderStepped:Connect(function()
		if not ov.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock() - t0
		if t < SHAKE then
			local k = t / SHAKE
			local shake = CF((math.random() - 0.5) * k * 0.5, 0, (math.random() - 0.5) * k * 0.5) * ANG(0, t * (1 + k * 6), (math.random() - 0.5) * k * 0.15)
			for p, base in pairs(r.Base) do
				p.CFrame = shake * base
			end
			if caseId == "VoidCase" and r.Lid and r.Base[r.Lid] then
				r.Lid.CFrame = shake * r.Base[r.Lid] * CF(0, k * 1.2, 0.6 * k) * ANG(-0.9 * k, 0, 0)
			elseif caseId == "ShatteredReality" then
				for _, c in ipairs(r.Cracks) do
					c.Size = V3(0.14 + 0.3 * k, 0.14 + 0.3 * k, c.Size.Z)
				end
				if r.Core and r.Base[r.Core] then
					r.Core.CFrame = shake * r.Base[r.Core] * CF(0, 1.5 * k, 0) * ANG(0, t * 8, 0)
				end
			elseif blood and r.Shards[1] and r.Base[r.Shards[1]] then
				r.Shards[1].CFrame = shake * r.Base[r.Shards[1]] * CF(0, -2.8 * k, 0)
				ov.BackgroundColor3 = rgb(5 + 60 * k, 0, 10)
			end
			for i, s in ipairs(r.Shards) do
				if not (blood and i == 1) then
					s.CFrame = ANG(0, t * (2 + 10 * k), 0) * s.CFrame
				end
			end
			if t >= nextShake then
				nextShake = t + (0.45 - 0.3 * k)
				FX.Sound("CaseShake", 1, 0.8 + 0.8 * k)
			end
		elseif t < SHAKE + BURST then
			if not burst then
				burst = true
				FX.Sound("CaseOpen", 1, 1)
				flash(ov, bestColor, 0.1, 0.8)
			end
			local k = (t - SHAKE) / BURST
			for p, base in pairs(r.Base) do
				local d = dirs[p]
				p.CFrame = CF(d * k * 14) * base * ANG(4 * k * d.X, 5 * k, 4 * k * d.Z)
				p.Transparency = math.min(1, 1.3 * k)
			end
		else
			finish()
		end
	end)
end

------------------------------------------------------------------------
-- ПРОКЛЯТЫЙ СУНДУК ХЭЛЛОУИНА
------------------------------------------------------------------------
local H_SHAKE, H_BREAK, H_OPEN, H_RISE = 1.6, 0.5, 0.7, 0.9

function Openings.PlayHalloween(results)
	local r0 = results and results[1]
	if not r0 then
		return
	end
	local isRune = r0.Rune ~= nil
	local def = r0.Id and Config.Units[r0.Id]
	if not isRune and not def then
		return
	end
	local rarity = isRune and "Rune" or def.Rarity
	local color = isRune and Config.RuneRarity.Color or K.rarityColor(r0.Id)
	local order = (not isRune and Config.Rarities[rarity] and Config.Rarities[rarity].Order) or 3
	local secret = rarity == "Secret"

	local ov = overlay(rgb(8, 2, 4), 0.1)
	local vf = K.new("ViewportFrame", {
		Parent = ov, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.fromOffset(620, 620), BackgroundTransparency = 1,
		Ambient = rgb(120, 80, 70), LightColor = rgb(255, 210, 160), LightDirection = V3(-0.4, -1, -0.8), ZIndex = 21,
	})
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.Parent = vf
	vf.CurrentCamera = cam
	local okC, r = pcall(ctx.CaseModels.Build, "Halloween")
	if not okC or type(r) ~= "table" or not r.Model then
		r = { Model = Instance.new("Model"), Base = {} }
	end
	K.StripModel(r.Model)
	r.Model.Parent = vf
	local base = r.Base or {}
	local lidParts = r.LidParts or { r.Lid }
	local isLid = {}
	for _, p in ipairs(lidParts) do
		isLid[p] = true
	end
	local chains = r.Chains or {}
	local isChain, chainDir = {}, {}
	for _, p in ipairs(chains) do
		isChain[p] = true
		chainDir[p] = V3(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5).Unit
	end
	local hinge = r.Hinge or CF(0, 2.7, 1.4)
	local eyes, eyeBase = r.Eyes or {}, {}
	for i, e in ipairs(eyes) do
		eyeBase[i] = e.Color
	end
	local title = K.label({ Parent = ov, AnchorPoint = V2(0.5, 0), Position = UDim2.fromScale(0.5, 0.05), Size = UDim2.fromOffset(700, 56), Text = "HALLOWEEN CASE", TextColor3 = ORANGE, StrokeThickness = 3, ZIndex = 22 })
	local glow = K.new("Frame", { Parent = ov, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = ORANGE, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20 })
	K.corner(300).Parent = glow
	FX.Sound("CaseShake", 1, 0.6)

	local reward, rewardHip = nil, 0
	local riseH = isRune and 3.8 or 2.2
	local t0 = os.clock()
	local nextShake, broke, rose = 0, false, false
	local conn

	local function buildReward()
		if isRune then
			local ok, rr = pcall(ctx.UnitModels.BuildRune, r0.Rune)
			if ok and rr and rr.Model then
				rr.Model:ScaleTo(1.2)
				reward = rr.Model
			end
		else
			local ok, rig = pcall(ctx.UnitModels.Build, r0.Id, 1)
			if ok and rig and rig.Model then
				K.StripModel(rig.Model)
				reward = rig.Model
				rewardHip = rig.HipHeight or 0
			end
		end
		if reward then
			reward.Parent = vf
		end
	end

	local function finish()
		if not ov.Parent then
			return
		end
		local rd = isRune and Config.Runes[r0.Rune]
		title.Text = isRune and ("РУНА «" .. (rd and rd.Name or r0.Rune) .. "»") or def.Name
		title.TextColor3 = color
		local ev = Config.Events.Halloween
		K.label({
			Parent = ov, AnchorPoint = V2(0.5, 0), Position = UDim2.new(0.5, 0, 0.05, 60), Size = UDim2.fromOffset(600, 34), ZIndex = 22,
			Text = isRune and ("РУНА • " .. Config.RuneRarity.Name) or (string.upper(rarity) .. "  •  " .. (ev and ev.Tag or "")),
			TextColor3 = isRune and color or ORANGE,
		})
		if r0.New then
			K.label({ Parent = ov, AnchorPoint = V2(0.5, 0), Position = UDim2.new(0.5, 220, 0.05, 0), Size = UDim2.fromOffset(160, 34), Text = "NEW!", TextColor3 = GOLD, Rotation = -12, ZIndex = 23 })
		end
		okButton(ov, { BackgroundColor3 = rgb(110, 50, 20), StrokeColor = ORANGE })
		-- награда продолжает вращаться
		local s0 = os.clock()
		local spin
		spin = RunService.RenderStepped:Connect(function()
			if not ov.Parent or not reward then
				spin:Disconnect()
				return
			end
			local dt = os.clock() - s0
			reward:PivotTo(CF(0, 1.5 + riseH + rewardHip + math.sin(dt * 2) * 0.15, -0.6) * ANG(0, math.pi + dt * 0.8, 0))
		end)
	end

	conn = RunService.RenderStepped:Connect(function()
		if not ov.Parent then
			conn:Disconnect()
			return
		end
		local t = os.clock() - t0
		local kc = math.clamp(t / 2.1, 0, 1)
		local dist = 15 - 4.5 * kc
		cam.CFrame = CFrame.lookAt(V3(0, 4.5 - 0.6 * kc, -dist), V3(0, 2.4, 0))
		if t < H_SHAKE then
			local a = t / H_SHAKE
			local shake = CF((math.random() - 0.5) * a * 0.35, 0, (math.random() - 0.5) * a * 0.35) * ANG(0, 0, (math.random() - 0.5) * a * 0.12)
			for p, b in pairs(base) do
				p.CFrame = shake * b
			end
			for i, e in ipairs(eyes) do
				e.Color = eyeBase[i]:Lerp(rgb(255, 240, 180), a)
			end
			local sz = 60 + 300 * a
			glow.Size = UDim2.fromOffset(sz, sz)
			glow.BackgroundTransparency = 1 - 0.25 * a
			if t >= nextShake then
				nextShake = t + (0.42 - 0.28 * a)
				FX.Sound("CaseShake", 1, 0.6 + 0.6 * a)
			end
		elseif t < H_SHAKE + H_BREAK then
			local a = (t - H_SHAKE) / H_BREAK
			if not broke then
				broke = true
				FX.Sound("CaseOpen", 0.7, 1)
				flash(ov, ORANGE, 0.3, 0.5)
			end
			for p, b in pairs(base) do
				if isChain[p] then
					local d = chainDir[p]
					p.CFrame = CF(d * a * 9 + V3(0, -3 * a * a, 0)) * b * ANG(5 * a * d.X, 4 * a, 5 * a * d.Z)
					p.Transparency = math.min(1, 1.2 * a)
				else
					p.CFrame = b -- крышка тоже на место (без скачка при открытии)
				end
			end
		elseif t < H_SHAKE + H_BREAK + H_OPEN then
			local a = (t - H_SHAKE - H_BREAK) / H_OPEN
			local ang = math.rad(110) * (1 - (1 - a) ^ 3)
			local rot = hinge * ANG(ang, 0, 0) * hinge:Inverse()
			for _, p in ipairs(lidParts) do
				if base[p] then
					p.CFrame = rot * base[p]
				end
			end
			glow.BackgroundColor3 = color
			local sz = 360 + 200 * a
			glow.Size = UDim2.fromOffset(sz, sz)
		elseif t < H_SHAKE + H_BREAK + H_OPEN + H_RISE then
			local a = (t - H_SHAKE - H_BREAK - H_OPEN) / H_RISE
			if not rose then
				rose = true
				FX.Sound("Reveal", 1, isRune and 1.2 or (0.7 + order * 0.12))
				buildReward()
			end
			if reward then
				reward:PivotTo(CF(0, 1.5 + a * riseH + rewardHip * a, -0.6) * ANG(0, math.pi + a * 2 * math.pi, 0))
			end
		else
			conn:Disconnect()
			if secret then
				task.spawn(function()
					secretFlash(ov, ORANGE, rgb(140, 40, 0), 10, 1.6, def and def.Name)
					finish()
				end)
			else
				finish()
			end
		end
	end)
end

function Openings.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, FX = ui.Kit, ui.Theme, c.Config, c.FX
end

return Openings
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX7BFBC5FD1C5E171A63C1EE3996906815">
						<Properties>
							<string name="Name">Shop</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Shop — «МАГАЗИН КРИСТАЛЛОВ»: наборы кристаллов за Robux и ежедневный подарок.
--
-- API
--   Shop.Build(UI, ctx) ; Shop.Update()   -- таймер подарка, пока окно открыто

local Shop = {}

local rgb = Color3.fromRGB
local V2 = Vector2.new

local UI, ctx, K, T, Config, refs
local modal, dailyButton

function Shop.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	modal = K.modal("Shop", "МАГАЗИН КРИСТАЛЛОВ", UDim2.fromOffset(920, 470), "Gem")
	local row = K.new("Frame", { Parent = modal, Position = UDim2.fromOffset(18, 70), Size = UDim2.new(1, -36, 0, 270), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = row, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder })
	for i, item in ipairs(Config.Shop) do
		local card = K.panel({ Parent = row, LayoutOrder = i, Size = UDim2.fromOffset(165, 266), BackgroundColor3 = T.BG2, StrokeColor = rgb(90, 180, 255), ZIndex = 6 })
		K.new("UIGradient", { Parent = card, Rotation = 90, Color = ColorSequence.new(rgb(40, 70, 120), T.BG) })
		K.label({ Parent = card, Position = UDim2.fromOffset(5, 12), Size = UDim2.new(1, -10, 0, 70), Text = string.rep("💎", math.min(i, 3)), ZIndex = 7 })
		K.label({ Parent = card, Position = UDim2.fromOffset(5, 86), Size = UDim2.new(1, -10, 0, 40), Text = Config.FormatNumber(item.Gems), TextColor3 = rgb(130, 210, 255), ZIndex = 7 })
		K.label({ Parent = card, Position = UDim2.fromOffset(5, 128), Size = UDim2.new(1, -10, 0, 34), Text = item.Title or "", TextScaled = false, TextSize = 14, TextWrapped = true, Font = Enum.Font.GothamBold, ZIndex = 7 })
		if item.Bonus then
			K.label({ Parent = card, Position = UDim2.new(1, -74, 0, 6), Size = UDim2.fromOffset(70, 24), Text = item.Bonus, TextColor3 = T.Gold, Rotation = 10, ZIndex = 8 })
		end
		K.button({
			Parent = card, AnchorPoint = V2(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(1, -20, 0, 48), ZIndex = 7,
			Text = "R$ " .. tostring(item.Robux), BackgroundColor3 = rgb(50, 140, 80), StrokeColor = T.Good,
		}, function()
			local ok, res = ctx.Request("BuyGems", { Key = item.Key })
			if ok and res ~= "prompt" then
				ctx.FX.Sound("Purchase", 1, 1)
				UI.Toast("+" .. Config.FormatNumber(item.Gems) .. " 💎 (тестовая покупка в Studio)", "good")
			end
		end)
	end
	local daily = K.panel({ Parent = modal, Position = UDim2.new(0, 18, 1, -90), Size = UDim2.new(1, -36, 0, 74), BackgroundColor3 = T.BG2, StrokeColor = T.Gold, ZIndex = 6 })
	K.label({
		Parent = daily, Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -300, 1, -24), ZIndex = 7, TextXAlignment = Enum.TextXAlignment.Left,
		Text = "🎁 Бесплатный подарок: " .. tostring(Config.Settings.DailyGems) .. " 💎", TextColor3 = T.Gold,
	})
	dailyButton = K.button({
		Parent = daily, Name = "DailyButton", AnchorPoint = V2(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(260, 52), ZIndex = 7,
		Text = "ЗАБРАТЬ", BackgroundColor3 = rgb(150, 110, 30), StrokeColor = T.Gold,
	}, function()
		local ok, res = ctx.Request("ClaimDaily")
		if ok then
			ctx.FX.Sound("Purchase", 1, 1.2)
			UI.Toast("+" .. tostring(res) .. " 💎 Подарок получен!", "gold")
		end
	end)
	refs.DailyButton = dailyButton
end

function Shop.Update()
	if not modal.Visible then
		return
	end
	local p = ctx.Profile
	local left = math.floor((p and p.DailyReadyAt or 0) - os.time())
	if left > 0 then
		dailyButton.Text = string.format("через %d:%02d:%02d", left // 3600, (left % 3600) // 60, left % 60)
	else
		dailyButton.Text = "ЗАБРАТЬ"
	end
end

return Shop
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX71B0A0146B1C1168F732BF4F7EBFB086">
						<Properties>
							<string name="Name">UnitPanel</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.UnitPanel — панель выбранного юнита на карте: характеристики, цель, улучшение, продажа,
-- круг дальности.
--
-- API
--   UnitPanel.Build(UI, ctx) ; Open(uid) ; Close() ; Refresh() ; Update(dt, inMatch)
--   UnitPanel.Upgrade() ; Sell() ; CycleTarget() ; UnitPanel.SpecialText(def, st) -> string

local Players = game:GetService("Players")

local UnitPanel = {}

local player = Players.LocalPlayer
local rgb = Color3.fromRGB
local V2 = Vector2.new
local V3 = Vector3.new

local UI, ctx, K, T, Config, refs
local panel, rangePart
local acc = 0
local viewKey

-- целое для %d (Luau падает на дробных)
local function int(n)
	return math.floor((n or 0) + 0.5)
end

function UnitPanel.SpecialText(def, st)
	if st.BlackHole then
		return string.format("Black Hole r%d, %d/тик", int(st.BlackHole.Radius), int(st.BlackHole.TickDamage))
	elseif st.AOERadius then
		return string.format("AOE радиус %.1f", st.AOERadius)
	elseif st.Hits and st.Hits > 1 then
		local s = "x" .. st.Hits .. " удара"
		if st.CritChance then
			s = s .. string.format(", крит %d%%", int(st.CritChance * 100))
		end
		return s
	elseif st.CritChance then
		return string.format("Крит %d%% x%.1f", int(st.CritChance * 100), st.CritMult or 2)
	end
	return tostring(def.AttackType or "")
end

local function view()
	return UI.SelectedUid and ctx.Renderer.UnitViews[UI.SelectedUid]
end

local function arrow(a, b)
	if b ~= nil and b ~= a then
		return a .. "  →  " .. b
	end
	return a
end

function UnitPanel.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config, refs = ui.Kit, ui.Theme, c.Config, ui.Refs
	panel = K.panel({ Parent = ui.Root, Name = "UnitPanel", AnchorPoint = V2(1, 0.5), Size = UDim2.fromOffset(310, 470), Position = UDim2.new(1, -112, 0.45, 0), Visible = false })
	refs.UnitPanel = panel
	refs.UPName = K.label({ Parent = panel, Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -60, 0, 32), Text = "", TextXAlignment = Enum.TextXAlignment.Left })
	K.button({ Parent = panel, Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, -42, 0, 10), Text = "✕", BackgroundColor3 = rgb(120, 30, 50) }, function()
		UnitPanel.Close()
	end)
	refs.UPRarity = K.label({ Parent = panel, Position = UDim2.fromOffset(12, 42), Size = UDim2.new(1, -24, 0, 20), Text = "", TextXAlignment = Enum.TextXAlignment.Left })
	refs.UPStars = K.label({ Parent = panel, Position = UDim2.fromOffset(12, 62), Size = UDim2.new(1, -24, 0, 24), Text = "", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = T.Gold })
	local vf = K.new("Frame", { Parent = panel, Position = UDim2.fromOffset(12, 90), Size = UDim2.new(1, -24, 0, 110), BackgroundColor3 = T.BG2, BackgroundTransparency = 0.3, BorderSizePixel = 0 })
	K.corner(8).Parent = vf
	refs.UPView = vf
	local stats = K.new("Frame", { Parent = panel, Position = UDim2.fromOffset(12, 206), Size = UDim2.new(1, -24, 0, 160), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = stats, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.UPStats = {}
	for i, name in ipairs({ "Урон", "Дальность", "Перезарядка", "Особое", "Нанесено", "Владелец" }) do
		local row = K.new("Frame", { Parent = stats, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1 })
		K.label({ Parent = row, Size = UDim2.fromScale(0.45, 1), Text = name, TextColor3 = T.Dim, TextXAlignment = Enum.TextXAlignment.Left })
		refs.UPStats[name] = K.label({ Parent = row, Position = UDim2.fromScale(0.45, 0), Size = UDim2.fromScale(0.55, 1), Text = "", Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right })
	end
	refs.UPTarget = K.button({ Parent = panel, Position = UDim2.fromOffset(12, 362), Size = UDim2.new(1, -24, 0, 36), Text = "TARGET: First" }, function()
		UnitPanel.CycleTarget()
	end)
	refs.UPUpgrade = K.button({ Parent = panel, Position = UDim2.fromOffset(12, 406), Size = UDim2.new(0.6, -16, 0, 50), Text = "UPGRADE", BackgroundColor3 = rgb(60, 130, 80), StrokeColor = T.Good }, function()
		UnitPanel.Upgrade()
	end)
	refs.UPSell = K.button({ Parent = panel, Position = UDim2.new(0.6, 4, 0, 406), Size = UDim2.new(0.4, -12, 0, 50), Text = "SELL", BackgroundColor3 = rgb(130, 40, 60), StrokeColor = T.Bad }, function()
		UnitPanel.Sell()
	end)
end

local function hideRange()
	if rangePart then
		rangePart.Parent = nil
	end
end

function UnitPanel.Refresh()
	local v = view()
	if not v or not v.Folder then
		return
	end
	local def = Config.Units[v.UnitId]
	if not def then
		return
	end
	local f = v.Folder
	local lv = f:GetAttribute("Level") or 1
	local st = def.Levels[lv] or def.Levels[1]
	local nx = def.Levels[lv + 1]
	local col = K.rarityColor(v.UnitId)
	local fmt = Config.FormatNumber
	panel.Border.Color = col
	refs.UPName.Text = def.Name
	refs.UPRarity.Text = string.upper(def.Rarity) .. (def.Ability and ("  •  " .. def.Ability) or "")
	refs.UPRarity.TextColor3 = col
	refs.UPStars.Text = "Lv " .. lv .. "  " .. string.rep("★", lv) .. string.rep("☆", math.max(0, 5 - lv))
	-- 3D только при смене уровня/юнита
	local key = tostring(UI.SelectedUid) .. ":" .. lv
	if viewKey ~= key then
		viewKey = key
		refs.UPView:ClearAllChildren()
		K.corner(8).Parent = refs.UPView
		K.unitViewport(refs.UPView, v.UnitId, lv)
	end
	local S = refs.UPStats
	S["Урон"].Text = arrow(fmt(st.Damage), nx and fmt(nx.Damage))
	S["Дальность"].Text = arrow(tostring(st.Range), nx and tostring(nx.Range))
	S["Перезарядка"].Text = arrow(string.format("%.2fs", st.Cooldown), nx and string.format("%.2fs", nx.Cooldown))
	S["Особое"].Text = UnitPanel.SpecialText(def, st)
	S["Нанесено"].Text = fmt(f:GetAttribute("Damage") or 0)
	S["Владелец"].Text = tostring(f:GetAttribute("OwnerName") or "?")
	local mine = f:GetAttribute("OwnerId") == player.UserId
	refs.UPTarget.Visible = mine
	refs.UPUpgrade.Visible = mine
	refs.UPSell.Visible = mine
	refs.UPTarget.Text = "🎯 TARGET: " .. tostring(f:GetAttribute("TargetMode") or "First")
	if nx then
		refs.UPUpgrade.Text = "UPGRADE $" .. fmt(nx.Cost)
		refs.UPUpgrade.BackgroundColor3 = (player:GetAttribute("Money") or 0) >= nx.Cost and rgb(60, 130, 80) or rgb(60, 60, 70)
	else
		refs.UPUpgrade.Text = "MAX LEVEL"
		refs.UPUpgrade.BackgroundColor3 = rgb(120, 90, 30)
	end
	refs.UPSell.Text = "SELL $" .. fmt(math.floor((f:GetAttribute("Spent") or 0) * Config.Settings.SellRefund))
	-- круг дальности
	if not rangePart then
		rangePart = ctx.FX.Part({ Name = "VoidTD_Range", Shape = Enum.PartType.Cylinder, Color = T.Accent, Transparency = 0.75, Parent = nil })
	end
	local r = st.Range or 10
	rangePart.Size = V3(0.2, r * 2, r * 2)
	rangePart.CFrame = CFrame.new(v.Pos + V3(0, 0.25, 0)) * CFrame.Angles(0, 0, math.rad(90))
	rangePart.Parent = workspace
end

function UnitPanel.Open(uid)
	UI.SelectedUid = uid
	panel.Visible = true
	viewKey = nil
	acc = 0
	UnitPanel.Refresh()
end

function UnitPanel.Close()
	UI.SelectedUid = nil
	panel.Visible = false
	viewKey = nil
	hideRange()
end

function UnitPanel.Upgrade()
	local uid = UI.SelectedUid
	if not uid then
		return
	end
	local ok, res = ctx.Request("Upgrade", { Uid = uid })
	if ok then
		UI.Toast("Улучшено до уровня " .. tostring(res) .. "!", "good")
		UnitPanel.Refresh()
	end
end

function UnitPanel.Sell()
	local uid = UI.SelectedUid
	if not uid then
		return
	end
	local ok, res = ctx.Request("Sell", { Uid = uid })
	if ok then
		UI.Toast("Продано за $" .. Config.FormatNumber(res or 0), "gold")
		ctx.FX.Sound("Sell", 1, 1)
		UnitPanel.Close()
	end
end

function UnitPanel.CycleTarget()
	local v = view()
	if not v or not refs.UPTarget.Visible then
		return
	end
	local modes = Config.TargetModes
	local cur = v.Folder:GetAttribute("TargetMode") or "First"
	local i = table.find(modes, cur) or 0
	local nextMode = modes[i % #modes + 1]
	local ok = ctx.Request("SetTarget", { Uid = UI.SelectedUid, Mode = nextMode })
	if ok then
		refs.UPTarget.Text = "🎯 TARGET: " .. nextMode
	end
end

function UnitPanel.Update(dt, inMatch)
	if not UI.SelectedUid then
		return
	end
	if not inMatch or not view() then
		UnitPanel.Close()
		return
	end
	acc += dt
	if acc >= 0.25 then
		acc = 0
		UnitPanel.Refresh()
	end
end

return UnitPanel
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXE1C52577F10981539DBD0D8DA6ECCC04">
						<Properties>
							<string name="Name">Viewer</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Viewer — большое окно 3D-просмотра юнита (копия модели в ViewportFrame + WorldModel):
-- вкладки уровней (ничего не покупают), анимации и способности, вращение/зум, эффекты редкости,
-- галерея призыва / «проклятых людей», кинематограф SECRET.
--
-- API
--   Viewer.Build(UI, ctx) ; Viewer.Open(unitId, level) ; Viewer.SetLevel(lv) ; Viewer.PlayAnim(kind)
--   Viewer.Refresh() ; Viewer.IsOpen() ; Viewer.Close()

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Viewer = {}

local rgb = Color3.fromRGB
local V2 = Vector2.new
local V3 = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)

local GLOW = {
	Common = rgb(150, 140, 170), Rare = rgb(90, 150, 255), Epic = rgb(70, 140, 255),
	Legendary = rgb(255, 200, 70), Mythic = rgb(190, 80, 255), Secret = rgb(255, 40, 60),
}
local PARTICLES = { Mythic = 14, Secret = 10, Legendary = 9, Epic = 6 }
local LEVEL_TABS = { "LVL 1", "LVL 2", "LVL 3", "LVL 4", "MAX" }
local GOLD = rgb(230, 178, 74)
local ORANGE = rgb(255, 140, 40)
local POWER_FX = {
	LanternBeam = rgb(255, 230, 150), DirtBurst = rgb(140, 110, 80), LeafStorm = rgb(230, 140, 40), CurseMark = rgb(120, 255, 110),
	MidnightToll = rgb(190, 160, 255), PlagueCloud = rgb(140, 230, 80), GhostSword = rgb(110, 190, 255), MirrorShatter = rgb(180, 90, 255),
	ThreadSnap = rgb(230, 30, 50), Execution = rgb(255, 110, 30), GhostPumpkin = rgb(255, 140, 40), Summon = rgb(200, 90, 255),
}
local ZOOM_MIN, ZOOM_MAX = 0.45, 1.8

local UI, ctx, K, T, Config, UnitModels, Renderer, FX
local win, dim, refs
local state
local conns = {}
local particles, sparks = {}, {}

local function glowOf(def)
	return GLOW[def.Rarity] or T.Accent
end

------------------------------------------------------------------------
-- СЦЕНА
------------------------------------------------------------------------
local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	p.Parent = refs.World
	return p
end

local function strip(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Trail") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.CanQuery = false
		end
	end
end

local function clearScene()
	if state and state.Rig then
		state.Rig.Model:Destroy()
		state.Rig = nil
	end
	refs.World:ClearAllChildren()
end

local function bounds(model)
	local lo, hi
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			local r = math.max(d.Size.X, d.Size.Y, d.Size.Z) / 2
			local p = d.Position
			local a, b = p - V3(r, r, r), p + V3(r, r, r)
			lo = lo and V3(math.min(lo.X, a.X), math.min(lo.Y, a.Y), math.min(lo.Z, a.Z)) or a
			hi = hi and V3(math.max(hi.X, b.X), math.max(hi.Y, b.Y), math.max(hi.Z, b.Z)) or b
		end
	end
	return lo or V3(-2, -3, -2), hi or V3(2, 3, 2)
end

local function platform(groundY, r, glow)
	local flat = ANG(0, 0, rad(90))
	part({ Name = "Platform", Shape = Enum.PartType.Cylinder, Size = V3(0.6, 2 * r, 2 * r), CFrame = CF(0, groundY - 0.3, 0) * flat, Color = rgb(24, 20, 32), Material = Enum.Material.Slate })
	part({ Name = "PlatformTop", Shape = Enum.PartType.Cylinder, Size = V3(0.62, 1.7 * r, 1.7 * r), CFrame = CF(0, groundY - 0.29, 0) * flat, Color = rgb(40, 34, 54), Material = Enum.Material.Slate })
	part({ Name = "PlatformRing", Shape = Enum.PartType.Cylinder, Size = V3(0.64, 2.06 * r, 2.06 * r), CFrame = CF(0, groundY - 0.36, 0) * flat, Color = glow:Lerp(BLACK, 0.35), Material = Enum.Material.SmoothPlastic })
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		part({
			Name = "Rune", Size = V3(0.12, 0.62, 0.18 * r), Color = glow:Lerp(BLACK, 0.45), Material = Enum.Material.Neon,
			CFrame = CF(math.cos(a) * 0.93 * r, groundY - 0.3, math.sin(a) * 0.93 * r) * ANG(0, -a, 0),
		})
	end
end

local function updateCamera()
	local dir = V3(math.sin(state.Yaw) * math.cos(state.Pitch), math.sin(state.Pitch), -math.cos(state.Yaw) * math.cos(state.Pitch))
	refs.Cam.CFrame = CFrame.lookAt(state.Center + dir * state.Dist, state.Center)
end

local function buildModel(keepCamera)
	clearScene()
	local ok, rig = pcall(UnitModels.Build, state.Id, state.Level)
	if not ok or not rig then
		warn("[VOID TD] Предпросмотр: " .. tostring(rig))
		return
	end
	strip(rig.Model)
	rig.Root.CFrame = CF(0, rig.HipHeight or 0, 0)
	rig.Model.Parent = refs.World
	state.Rig = rig
	state.Anim = nil
	state.Phase = 0
	local def = Config.Units[state.Id]
	local glow = glowOf(def)
	local lo, hi = bounds(rig.Model)
	local size = hi - lo
	platform(0, math.max(size.X, size.Z, 4) * 0.62, glow)
	state.Center = V3(0, (lo.Y + hi.Y) / 2, 0)
	state.BaseDist = math.max(size.Y, size.X * 0.9) * 1.95 + 2
	if not keepCamera then
		state.Yaw, state.Pitch, state.Zoom = rad(200), rad(12), 1
	end
	state.Dist = state.BaseDist * state.Zoom
	refs.VF.LightColor = Color3.new(1, 0.97, 1):Lerp(glow, 0.2)
	updateCamera()
end

------------------------------------------------------------------------
-- ЭФФЕКТЫ РЕДКОСТИ
------------------------------------------------------------------------
local function clearList(list)
	for _, f in ipairs(list) do
		f:Destroy()
	end
	table.clear(list)
end

local function setGlow(glow)
	for i, g in ipairs(refs.Glows) do
		g.BackgroundColor3 = glow
		g.BackgroundTransparency = 0.84 + i * 0.04
	end
	refs.SceneStroke.Color = glow
end

local function spawnParticles(glow, n)
	clearList(particles)
	for i = 1, n do
		local s = (i * 0.6180339) % 1
		local sz = 6 + (i % 3) * 2
		local f = K.new("Frame", { Parent = refs.Scene, Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = glow, BackgroundTransparency = 0.2, BorderSizePixel = 0, Rotation = 45, ZIndex = 24 })
		f:SetAttribute("Seed", s)
		particles[i] = f
	end
end

local function secretIntro()
	local ov = refs.Intro
	ov.Visible = true
	ov.BackgroundTransparency = 0
	refs.IntroText.Text = "✦ SECRET ✦"
	refs.IntroText.TextTransparency = 1
	refs.IntroRing.Size = UDim2.fromScale(0.05, 0.05)
	refs.IntroRing.BackgroundTransparency = 0.1
	state.Zoom = 2.2 -- камера стартует дальше, затем мягко подъезжает (колесо вернёт в диапазон)
	K.tween(refs.IntroText, 0.35, { TextTransparency = 0 })
	K.tween(refs.IntroRing, 0.7, { Size = UDim2.fromScale(1.6, 1.6), BackgroundTransparency = 1 })
	FX.Sound("Secret", 0.8, 1)
	local my = state
	task.delay(0.55, function()
		if ov.Parent and state == my then
			K.tween(ov, 0.6, { BackgroundTransparency = 1 })
			K.tween(refs.IntroText, 0.6, { TextTransparency = 1 })
		end
	end)
	task.delay(1.25, function()
		if ov.Parent and state == my then
			ov.Visible = false
		end
	end)
end

local function applyRarityFx(first)
	local def = Config.Units[state.Id]
	local glow = glowOf(def)
	setGlow(glow)
	spawnParticles(glow, PARTICLES[def.Rarity] or 0)
	clearList(sparks)
	local hw = def.Event == "Halloween"
	refs.Pumpkin.Visible = hw
	if hw then
		for i = 1, 8 do
			local f = K.new("Frame", { Parent = refs.Scene, Size = UDim2.fromOffset(4, 4), BackgroundColor3 = rgb(255, 150, 50), BackgroundTransparency = 0.3, BorderSizePixel = 0, Rotation = 45, ZIndex = 24 })
			f:SetAttribute("Seed", (i * 0.37 + 0.11) % 1)
			sparks[i] = f
		end
	end
	if first and def.Rarity == "Secret" then
		secretIntro()
	end
end

------------------------------------------------------------------------
-- ИНФО
------------------------------------------------------------------------
local function refreshInfo()
	local def = Config.Units[state.Id]
	local lv = state.Level
	local st = def.Levels[lv] or def.Levels[#def.Levels]
	local prof = ctx.Profile or {}
	local fmt = Config.FormatNumber
	local rcol = Config.Rarities[def.Rarity].Color
	refs.RarityBar.BackgroundColor3 = rcol
	refs.Name.Text = def.Name
	local rt = string.upper(def.Rarity)
	local ev = def.Event and Config.Events[def.Event]
	if ev then
		rt = rt .. '  <font color="#' .. ev.Color:ToHex() .. '">' .. ev.Tag .. "</font>"
	end
	local runeId = prof.RuneSlots and prof.RuneSlots[state.Id]
	local rd = runeId and Config.Runes[runeId]
	if rd then
		rt = rt .. '  <font color="#' .. Config.RuneRarity.Color:ToHex() .. '">• РУНА ' .. rd.Name .. "</font>"
	end
	refs.Rarity.Text = rt
	refs.Rarity.TextColor3 = rcol
	refs.Desc.Text = def.Description or ""
	for i, tab in ipairs(refs.Tabs) do
		local on = i == lv
		tab.BackgroundColor3 = on and T.Accent or T.BG3
		tab.TextColor3 = on and WHITE or T.Dim
	end
	local S = refs.Stats
	S[1].Text = fmt(st.Damage) .. ((st.Hits or 1) > 1 and ("  x" .. st.Hits) or "")
	S[2].Text = tostring(st.Range)
	S[3].Text = string.format("%.2f/с  (%.2f с)", 1 / st.Cooldown, st.Cooldown)
	S[4].Text = "$" .. fmt(def.Levels[1].Cost)
	if lv > 1 then
		local total = 0
		for i = 1, lv do
			total += def.Levels[i].Cost
		end
		S[5].Text = string.format("$%s  (всего $%s)", fmt(st.Cost), fmt(total))
	else
		S[5].Text = "—"
	end
	refs.Abilities.Text = (def.Ability and (def.Ability .. "\n") or "") .. (UI.SpecialText and UI.SpecialText(def, st) or tostring(def.AttackType))
	local inv = prof.Inventory or {}
	local eq = prof.Equipped or {}
	local equipped = false
	for i = 1, Config.Settings.EquipSlots do
		if eq[tostring(i)] == state.Id then
			equipped = true
		end
	end
	local b = refs.Equip
	if (inv[state.Id] or 0) <= 0 then
		b.Text, b.BackgroundColor3, b.Active = "НЕТ В КОЛЛЕКЦИИ", rgb(50, 44, 60), false
	elseif equipped then
		b.Text, b.BackgroundColor3, b.Active = "СНЯТЬ", rgb(130, 50, 60), true
	else
		b.Text, b.BackgroundColor3, b.Active = "ЭКИПИРОВАТЬ", rgb(70, 40, 140), true
	end
end

------------------------------------------------------------------------
-- ГАЛЕРЕЯ ПРИЗЫВА
------------------------------------------------------------------------
local function galleryList(kind)
	local out = {}
	if kind == "Rune" then
		local rs = Config.Runes.CursedThreads and Config.Runes.CursedThreads.Summon
		for i, lv in ipairs(rs and rs.Levels or {}) do
			out[#out + 1] = { Ally = lv.Ally, HP = lv.HP, Text = string.format("LVL %d • x%d • %d HP • каждые 60 с", i, lv.Count, lv.HP) }
		end
	else
		local s = Config.Units[state.Id].Summon
		for i, lv in ipairs(s and s.Levels or {}) do
			out[#out + 1] = { Ally = lv.Ally, HP = lv.HP, Text = string.format("%s • x%d • %d HP • %d с", i == 5 and "MAX" or ("LVL " .. i), lv.Count, lv.HP, lv.Interval) }
		end
		local g = s and s.Golden
		if g then
			out[#out + 1] = { Ally = g.Ally, HP = g.HP, Text = string.format("MAX • каждый %d-й призыв • %d HP", g.Every, g.HP) }
		end
	end
	return out
end

local function galleryLabel()
	return Config.Units[state.Id].Summon and "ПОСМОТРЕТЬ ПРИЗЫВ" or "ПРОКЛЯТЫЕ ЛЮДИ"
end

local function clearGallery()
	if state and state.Gallery then
		for _, r in ipairs(state.Gallery) do
			r.Model:Destroy()
		end
		state.Gallery = nil
	end
	refs.GalleryInfo.Visible = false
end

local function showGallery(kind)
	if not UnitModels.BuildAlly or not kind then
		return
	end
	if state.Gallery then
		clearGallery()
		buildModel(true)
		refs.GalleryButton.Text = galleryLabel()
		return
	end
	clearScene()
	state.Anim = nil
	local list = galleryList(kind)
	local n = #list
	local rigs, lines = {}, {}
	for i, it in ipairs(list) do
		local ok, rig = pcall(UnitModels.BuildAlly, it.Ally)
		if ok and rig then
			strip(rig.Model)
			local x = (i - (n + 1) / 2) * 3.4
			rig.Root.CFrame = CF(x, rig.HipHeight or 0, math.abs(x) * 0.25) * ANG(0, math.pi, 0)
			rig.Model.Parent = refs.World
			rigs[#rigs + 1] = rig
		end
		local ad = Config.Allies[it.Ally]
		lines[#lines + 1] = string.format("%d. %s — %s", i, ad and ad.Name or tostring(it.Ally), it.Text)
	end
	state.Gallery = rigs
	platform(0, n * 1.9 + 2, glowOf(Config.Units[state.Id]))
	state.Center = V3(0, 2.4, 0)
	state.BaseDist = n * 3.6 + 8
	state.Zoom, state.Dist, state.Yaw, state.Pitch = 1, state.BaseDist, rad(180), rad(10)
	updateCamera()
	local head = kind == "Rune" and "ПРОКЛЯТЫЕ НИТИ — проклятые люди:\n" or "ПРИЗЫВ — союзники идут по дороге навстречу врагам, HP = запас урона:\n"
	refs.GalleryInfo.Text = head .. table.concat(lines, "\n")
	refs.GalleryInfo.Visible = true
	refs.GalleryButton.Text = "← К ЮНИТУ"
end

local function exitGallery()
	if state.Gallery then
		clearGallery()
		buildModel(true)
		refs.GalleryButton.Text = galleryLabel()
	end
end

------------------------------------------------------------------------
-- ЭФФЕКТЫ СПОСОБНОСТЕЙ (только картинка)
------------------------------------------------------------------------
local function previewRing(y, r0, r1, color, time, delay)
	local rig = state and state.Rig
	task.delay(delay or 0, function()
		if not state or state.Rig ~= rig or not refs.World.Parent then
			return
		end
		local p = part({ Shape = Enum.PartType.Cylinder, Size = V3(0.15, 2 * r0, 2 * r0), CFrame = CF(0, y, 0) * ANG(0, 0, rad(90)), Color = color, Material = Enum.Material.Neon, Transparency = 0.2 })
		K.tween(p, time, { Size = V3(0.1, 2 * r1, 2 * r1), Transparency = 1 })
		task.delay(time + 0.1, function()
			p:Destroy()
		end)
	end)
end

local function previewStorm(on)
	local rig = state and state.Rig
	if not rig then
		return
	end
	rig.Storm = on
	for _, d in ipairs(rig.Model:GetDescendants()) do
		if d:IsA("BasePart") then
			local v = d:GetAttribute("StormFX")
			if type(v) == "number" then
				d.Transparency = on and v or 1
			end
		end
	end
end

local function previewFx(kind)
	local s = state.Rig and state.Rig.Scale or 1
	local col = POWER_FX[kind]
	if col then
		previewRing(0.08, 1, 7 * s, col, 0.8, 0.5)
		previewRing(0.12, 0.5, 4.5 * s, col:Lerp(WHITE, 0.3), 0.6, 0.6)
	elseif kind == "TimeBreak" then
		previewRing(0.05, 1, 6 * s, GOLD, 0.9, 0.5)
		previewRing(0.1, 0.5, 4 * s, ORANGE, 0.6, 0.55)
	elseif kind == "TimeHaste" then
		previewRing(0.1, 1, 9 * s, GOLD, 1.0, 0.4)
		previewRing(0.15, 1, 7 * s, ORANGE, 0.8, 0.5)
	elseif kind == "TimeStorm" then
		previewStorm(true)
		previewRing(0.1, 1, 8 * s, GOLD, 0.9, 1.3)
		previewRing(0.15, 0.5, 5 * s, ORANGE, 0.6, 1.35)
		local rig = state.Rig
		task.delay(4, function()
			if state and state.Rig == rig then
				previewStorm(false)
			end
		end)
	end
end

------------------------------------------------------------------------
-- ВВОД И КАДР
------------------------------------------------------------------------
local function disconnect()
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
end

local function bindInput()
	local vf = refs.VF
	local dragging, last = false, nil
	local function zoom(f)
		state.Zoom = math.clamp(state.Zoom * f, ZOOM_MIN, ZOOM_MAX)
		state.Idle = 0
	end
	conns[#conns + 1] = vf.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			-- второй палец (щипок) не перехватывает вращение
			if dragging and t == Enum.UserInputType.Touch then
				return
			end
			dragging, last = input, input.Position
			state.Idle = 0
		end
	end)
	conns[#conns + 1] = vf.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			zoom(input.Position.Z > 0 and 0.88 or 1.14)
		end
	end)
	conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		local t = input.UserInputType
		local ok = t == Enum.UserInputType.MouseMovement or (t == Enum.UserInputType.Touch and (input == dragging or dragging.UserInputType ~= Enum.UserInputType.Touch))
		if ok then
			local d = input.Position - last
			last = input.Position
			state.Yaw -= d.X * 0.012
			state.Pitch = math.clamp(state.Pitch + d.Y * 0.008, rad(-15), rad(60))
			state.Idle = 0
		end
	end)
	conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	local lastScale = 1
	conns[#conns + 1] = UserInputService.TouchPinch:Connect(function(_, scale, _, st)
		if st == Enum.UserInputState.Begin then
			lastScale = 1
		elseif st == Enum.UserInputState.Change and scale > 0 then
			-- scale накопительный с начала жеста — берём приращение
			local f = scale / lastScale
			lastScale = scale
			zoom(1 / f)
		end
	end)
end

local function step(dt)
	if not state or not (state.Rig or state.Gallery) then
		return
	end
	local t = os.clock()
	state.Idle += dt
	if state.Idle > 2.5 then
		state.Yaw += dt * 0.45
	end
	state.Dist += (state.BaseDist * state.Zoom - state.Dist) * math.min(1, dt * 8)
	updateCamera()
	if state.Rig then
		Renderer.PreviewStep(state, t)
	end
	for i, f in ipairs(particles) do
		local s = f:GetAttribute("Seed")
		local a = (t * (0.08 + s * 0.06) + s) % 1
		f.Position = UDim2.new(0.12 + s * 0.76 + math.sin(t * 1.3 + i) * 0.02, 0, 0.95 - a * 0.9, 0)
		f.BackgroundTransparency = 0.15 + a * 0.85
	end
	for i, f in ipairs(sparks) do
		local s = f:GetAttribute("Seed")
		local a = (t * (0.12 + s * 0.1) + s) % 1
		f.Position = UDim2.new(0.08 + s * 0.84 + math.sin(t * 2 + i) * 0.03, 0, 1 - a, 0)
		f.BackgroundTransparency = 0.25 + a * 0.75
	end
	if refs.Pumpkin.Visible then
		local b = math.sin(t * 3)
		refs.Pumpkin.Position = UDim2.new(1, -54, 1, -64 - math.abs(b) * 10)
		refs.Pumpkin.Rotation = b * 8
	end
	if state.Gallery then
		for i, rig in ipairs(state.Gallery) do
			local sw = math.sin(t * 6 + i) * 28
			local m, b = rig.Motors, rig.Base
			if m and b then
				for _, j in ipairs({ { "RH", 1 }, { "LH", -1 }, { "RS", -0.7 }, { "LS", 0.7 } }) do
					local mo, bc = m[j[1]], b[j[1]]
					if mo and bc then
						mo.C0 = bc * ANG(rad(sw * j[2]), 0, 0)
					end
				end
			end
		end
	end
end

------------------------------------------------------------------------
-- ОКНО
------------------------------------------------------------------------
local function buildWindow()
	refs = {}
	local root = UI.Root
	dim = K.new("TextButton", { Parent = root, Name = "ViewerDim", Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 0.45, Text = "", AutoButtonColor = false, Visible = false, ZIndex = 19, BorderSizePixel = 0 })
	dim.Activated:Connect(function()
		Viewer.Close()
	end)
	win = K.new("Frame", { Parent = root, Name = "UnitViewer", AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1020, 620), BackgroundColor3 = rgb(10, 6, 18), BackgroundTransparency = 0.02, Visible = false, ZIndex = 20, BorderSizePixel = 0 })
	K.corner(14).Parent = win
	K.new("UIStroke", { Parent = win, Color = T.Accent, Thickness = 2 })
	K.new("UIGradient", { Parent = win, Rotation = 90, Color = ColorSequence.new(rgb(40, 22, 64), rgb(8, 4, 14)) })
	refs.Scale = K.new("UIScale", { Parent = win })
	-- сцена
	local scene = K.new("Frame", { Parent = win, Position = UDim2.fromOffset(16, 16), Size = UDim2.new(0, 560, 1, -32), BackgroundColor3 = rgb(14, 9, 24), ClipsDescendants = true, ZIndex = 21, BorderSizePixel = 0 })
	K.corner(12).Parent = scene
	refs.SceneStroke = K.new("UIStroke", { Parent = scene, Color = T.AccentDark, Thickness = 2 })
	K.new("UIGradient", { Parent = scene, Rotation = 90, Color = ColorSequence.new(rgb(34, 20, 56), rgb(6, 4, 12)) })
	refs.Scene = scene
	refs.Glows = {}
	for i = 1, 3 do
		local sz = 0.95 - i * 0.2
		local g = K.new("Frame", { Parent = scene, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(sz, sz * 0.9), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = 21 })
		K.new("UICorner", { Parent = g, CornerRadius = UDim.new(0.5, 0) })
		refs.Glows[i] = g
	end
	local vf = K.new("ViewportFrame", { Parent = scene, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = rgb(120, 105, 150), LightColor = rgb(255, 245, 255), LightDirection = V3(-0.5, -1, -0.7), ZIndex = 22, Active = true })
	refs.VF = vf
	refs.World = K.new("WorldModel", { Parent = vf })
	local cam = Instance.new("Camera")
	cam.FieldOfView = 32
	cam.Parent = vf
	vf.CurrentCamera = cam
	refs.Cam = cam
	K.label({ Parent = scene, AnchorPoint = V2(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -20, 0, 18), Text = "Тяни мышью или пальцем — вращать  •  колесо / щипок — приблизить", TextColor3 = T.Dim, Font = Enum.Font.Gotham, ZIndex = 24 })
	local anim = K.new("Frame", { Parent = scene, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(330, 34), BackgroundTransparency = 1, ZIndex = 24 })
	K.new("UIListLayout", { Parent = anim, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	for i, it in ipairs({ { "IDLE", "Idle" }, { "АТАКА", "Attack" }, { "ПОЗА", "Fidget" } }) do
		K.button({ Parent = anim, LayoutOrder = i, Size = UDim2.fromOffset(104, 32), Text = it[1], BackgroundColor3 = T.BG3, ZIndex = 25 }, function()
			Viewer.PlayAnim(it[2])
		end)
	end
	local ab = K.new("Frame", { Parent = scene, Position = UDim2.fromOffset(10, 48), Size = UDim2.fromOffset(420, 32), BackgroundTransparency = 1, ZIndex = 24 })
	K.new("UIListLayout", { Parent = ab, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.AbilityRow = ab
	K.button({ Parent = scene, AnchorPoint = V2(1, 0), Position = UDim2.new(1, -10, 0, 10), Size = UDim2.fromOffset(40, 32), Text = "⟲", BackgroundColor3 = T.BG3, ZIndex = 25 }, function()
		if state then
			state.Yaw, state.Pitch, state.Zoom, state.Dist, state.Idle = rad(200), rad(12), 1, state.BaseDist, 0
		end
	end)
	refs.GalleryButton = K.button({ Parent = scene, AnchorPoint = V2(1, 0), Position = UDim2.new(1, -56, 0, 10), Size = UDim2.fromOffset(190, 32), Text = "", BackgroundColor3 = rgb(110, 40, 30), StrokeColor = rgb(255, 130, 40), Visible = false, ZIndex = 25 }, function()
		if state then
			showGallery(state.GalleryKind)
		end
	end)
	refs.GalleryInfo = K.label({
		Parent = scene, AnchorPoint = V2(0, 1), Position = UDim2.new(0, 10, 1, -30), Size = UDim2.new(1, -20, 0, 120), Text = "", Visible = false, ZIndex = 25,
		TextScaled = false, TextSize = 13, TextWrapped = true, Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom,
	})
	local pk = K.new("Frame", { Parent = scene, Position = UDim2.new(1, -54, 1, -64), Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 1, Visible = false, ZIndex = 25 })
	K.icon("Pumpkin", pk, { Size = UDim2.fromScale(1, 1), ZIndex = 25 })
	refs.Pumpkin = pk
	local intro = K.new("Frame", { Parent = scene, Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, Visible = false, ZIndex = 30, BorderSizePixel = 0 })
	refs.IntroRing = K.new("Frame", { Parent = intro, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.05, 0.05), BackgroundColor3 = GLOW.Secret, ZIndex = 31, BorderSizePixel = 0 })
	K.new("UICorner", { Parent = refs.IntroRing, CornerRadius = UDim.new(0.5, 0) })
	K.new("UIAspectRatioConstraint", { Parent = refs.IntroRing })
	refs.IntroText = K.label({ Parent = intro, AnchorPoint = V2(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 60), Text = "", TextColor3 = GLOW.Secret, ZIndex = 32 })
	refs.Intro = intro
	-- информация
	K.button({ Parent = win, AnchorPoint = V2(1, 0), Position = UDim2.new(1, -14, 0, 14), Size = UDim2.fromOffset(40, 40), Text = "✕", BackgroundColor3 = rgb(120, 30, 50), ZIndex = 26 }, function()
		Viewer.Close()
	end)
	local info = K.new("Frame", { Parent = win, Position = UDim2.fromOffset(592, 16), Size = UDim2.new(1, -608, 1, -32), BackgroundTransparency = 1, ZIndex = 21 })
	local left, top = Enum.TextXAlignment.Left, Enum.TextYAlignment.Top
	refs.RarityBar = K.new("Frame", { Parent = info, Size = UDim2.fromOffset(6, 64), BorderSizePixel = 0, ZIndex = 22 })
	refs.Name = K.label({ Parent = info, Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -70, 0, 40), Text = "", TextXAlignment = left, ZIndex = 22 })
	refs.Rarity = K.label({ Parent = info, Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -70, 0, 24), Text = "", RichText = true, TextXAlignment = left, ZIndex = 22 })
	refs.Desc = K.label({ Parent = info, Position = UDim2.fromOffset(0, 72), Size = UDim2.new(1, 0, 0, 40), Text = "", TextScaled = false, TextSize = 14, TextWrapped = true, Font = Enum.Font.Gotham, TextColor3 = T.Dim, TextXAlignment = left, TextYAlignment = top, ZIndex = 22 })
	local tabs = K.new("Frame", { Parent = info, Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = tabs, FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.Tabs = {}
	for i, name in ipairs(LEVEL_TABS) do
		refs.Tabs[i] = K.button({ Parent = tabs, LayoutOrder = i, Size = UDim2.new(0.2, -5, 1, 0), Text = name, BackgroundColor3 = T.BG3, ZIndex = 23 }, function()
			Viewer.SetLevel(i)
		end)
	end
	K.label({ Parent = info, Position = UDim2.fromOffset(0, 156), Size = UDim2.new(1, 0, 0, 16), Text = "Предпросмотр: уровень ничего не покупает и не улучшает", TextColor3 = T.Dim, Font = Enum.Font.Gotham, TextXAlignment = left, ZIndex = 22 })
	local stats = K.new("Frame", { Parent = info, Position = UDim2.fromOffset(0, 178), Size = UDim2.new(1, 0, 0, 180), BackgroundTransparency = 1 })
	K.new("UIListLayout", { Parent = stats, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder })
	refs.Stats = {}
	for i, name in ipairs({ "Урон", "Радиус", "Скорость атаки", "Установка", "Улучшение" }) do
		local row = K.new("Frame", { Parent = stats, LayoutOrder = i, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = T.BG2, BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 23 })
		K.corner(6).Parent = row
		K.label({ Parent = row, Position = UDim2.fromOffset(10, 4), Size = UDim2.new(0.5, -8, 1, -8), Text = name, TextColor3 = T.Dim, Font = Enum.Font.GothamBold, TextXAlignment = left, ZIndex = 24 })
		refs.Stats[i] = K.label({ Parent = row, Position = UDim2.new(0.5, 0, 0, 4), Size = UDim2.new(0.5, -10, 1, -8), Text = "", Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 24 })
	end
	local abox = K.new("Frame", { Parent = info, Position = UDim2.fromOffset(0, 364), Size = UDim2.new(1, 0, 0, 108), BackgroundColor3 = T.BG2, BackgroundTransparency = 0.2, BorderSizePixel = 0, ZIndex = 22 })
	K.corner(8).Parent = abox
	K.label({ Parent = abox, Position = UDim2.fromOffset(10, 6), Size = UDim2.new(1, -20, 0, 20), Text = "СПОСОБНОСТИ", TextColor3 = T.Accent, TextXAlignment = left, ZIndex = 23 })
	refs.Abilities = K.label({ Parent = abox, Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -20, 1, -36), Text = "", TextScaled = false, TextSize = 15, TextWrapped = true, Font = Enum.Font.GothamBold, TextXAlignment = left, TextYAlignment = top, ZIndex = 23 })
	refs.Equip = K.button({ Parent = info, AnchorPoint = V2(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 54), Text = "", ZIndex = 23 }, function()
		if state and refs.Equip.Active and UI.ToggleEquip then
			UI.ToggleEquip(state.Id)
		end
	end)
end

-- окно помещается на экран (телефоны)
local function fitScale()
	local vs = UI.Root.AbsoluteSize
	if vs.X <= 0 or vs.Y <= 0 then
		return 1
	end
	return math.min(1, (vs.X - 16) / 1020, (vs.Y - 16) / 620)
end

function Viewer.Open(unitId, level)
	local def = Config.Units[unitId]
	local inv = ctx.Profile and ctx.Profile.Inventory
	if not def or not inv or (inv[unitId] or 0) <= 0 then
		return
	end
	if not win then
		buildWindow()
	end
	clearGallery()
	state = state or {}
	state.Id = unitId
	state.Level = math.clamp(level or 1, 1, 5)
	state.Idle = 0
	state.Rig = nil
	win.Visible = true
	dim.Visible = true
	local fit = fitScale()
	refs.Scale.Scale = 0.88 * fit
	K.tween(refs.Scale, 0.22, { Scale = fit }, Enum.EasingStyle.Back)
	buildModel(false)
	refreshInfo()
	applyRarityFx(true)
	local prof = ctx.Profile
	state.GalleryKind = def.Summon and "Summon" or ((prof.RuneSlots and prof.RuneSlots[unitId] == "CursedThreads") and "Rune" or nil)
	refs.GalleryButton.Visible = state.GalleryKind ~= nil
	refs.GalleryButton.Text = galleryLabel()
	for _, ch in ipairs(refs.AbilityRow:GetChildren()) do
		if ch:IsA("GuiButton") then
			ch:Destroy()
		end
	end
	for i, it in ipairs(def.PreviewAbilities or {}) do
		local kind = it[1]
		K.button({ Parent = refs.AbilityRow, LayoutOrder = i, Size = UDim2.fromOffset(132, 30), Text = it[2], BackgroundColor3 = rgb(90, 56, 20), StrokeColor = rgb(230, 170, 70), ZIndex = 25 }, function()
			Viewer.PlayAnim(kind)
		end)
	end
	disconnect()
	bindInput()
	conns[#conns + 1] = RunService.RenderStepped:Connect(step)
	FX.Sound("Click", 1, 1.1)
end

function Viewer.SetLevel(lv)
	if not state or not win then
		return
	end
	lv = math.clamp(lv or 1, 1, 5)
	state.Level = lv
	clearGallery()
	refs.GalleryButton.Text = galleryLabel()
	buildModel(true)
	refreshInfo()
	FX.Sound("Upgrade", 0.6, 0.9 + lv * 0.05)
end

function Viewer.PlayAnim(kind)
	if not state then
		return
	end
	exitGallery()
	if not state.Rig then
		return
	end
	state.Idle = 0
	if kind == "Idle" then
		state.Anim = nil
	elseif kind == "Attack" then
		Renderer.PreviewAttack(state, state.Id, state.Level)
	elseif kind == "Fidget" then
		Renderer.PreviewFidget(state, state.Id)
	else
		Renderer.PreviewAbility(state, kind)
		previewFx(kind)
	end
end

function Viewer.Refresh()
	if win and win.Visible and state then
		refreshInfo()
	end
end

function Viewer.IsOpen()
	return win ~= nil and win.Visible
end

function Viewer.Close()
	if not win then
		return
	end
	win.Visible = false
	dim.Visible = false
	disconnect()
	clearGallery()
	clearScene()
	clearList(sparks)
	clearList(particles)
	refs.Intro.Visible = false
	state = nil
end

function Viewer.Build(ui, c)
	UI, ctx = ui, c
	K, T, Config = ui.Kit, ui.Theme, c.Config
	UnitModels, Renderer, FX = c.UnitModels, c.Renderer, c.FX
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and Viewer.IsOpen() then
			Viewer.Close()
		end
	end)
end

return Viewer
]]></ProtectedString>
