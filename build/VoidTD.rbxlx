		{ 0.3, { RS = { 80, 0, 35 }, LS = { 80, 0, -35 }, Root = { -5, 0, 0 } } },
		{ 0.45, { RS = { 96, 0, -8 }, LS = { 96, 0, 8 }, Root = { 8, 0, 0, -0.05 } } },
		{ 0.75, { RS = { 90, 0, -5 }, LS = { 90, 0, 5 } } },
		{ 1.0, {} },
	}
end

-- Разрыв нитей: руки широко вверх и резкий рывок вниз (~0.5 с)
