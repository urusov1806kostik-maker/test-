			<Item class="ModuleScript" referent="RBX32E739BF70238E1540BC550858CBB2DC">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Net
-- Имена сетевых объектов и протокол. Сервер создаёт папку VoidTD.Remotes (Net.Setup),
-- клиент и сервер получают её через Net.Remotes().
--
-- Протокол (не менять — клиент и сервер читают одинаково):
--   EnemySpawn  { id, typeId, maxHp, speed, lateral, dist [, hp] }
--   Sync        { T, E = {id, dist, hp, flag, ...}, DMG = {{id, amount, flag}}, RM = {{id, reason}},
--                 AL = {id, dist, hp, allyIndex (Config.AllyOrder), maxHp, ...} | nil, RA = {{id, reason}} | nil }
--   Attack      { U, T = {enemyIds}, L, D, AB, EC, PW, TR, TRS, SG, TT, I, E, SP, ST }
--   Impact      { K, P, R, L, U, N, DUR, DL, I, A, S, G, E, F, H }
--   Notify      { Type = Toast|WaveStart|WaveClear|BossDown|CoreHit|Victory|Defeat|Fade|Purchase|Reset, ... }
--   Profile     { Gems, Inventory, Equipped ("1".."6"), Stats, Settings, DailyReadyAt, HalloweenCoins, Runes, RuneSlots }
--   Request     RemoteFunction (action, data) -> ok, resultOrError

local Net = {}

Net.FolderName = "Remotes"

-- RemoteEvent'ы (порядок создания как в legacy)
Net.Events = { "EnemySpawn", "Sync", "Attack", "Impact", "Notify", "Profile" }

-- RemoteFunction для запросов клиента
Net.Function = "Request"

-- действия запроса Request(action, data)
Net.Actions = {
	"GetProfile", "GetEnemies", "Place", "Upgrade", "Sell", "SetTarget", "JoinMatch", "LeaveMatch", "GetMatchInfo",
	"SetLite", "ClaimDaily", "BuyGems", "StartWave", "Summon", "Equip", "EquipRune", "Teleport",
	"QueueDifficulty", "QueueStart", "QueueLeave",
}

Net.ActionSet = {}
for _, name in ipairs(Net.Actions) do
	Net.ActionSet[name] = true
end

-- флаг врага в Sync.E
Net.EnemyFlag = { Normal = 0, Slowed = 1, Frozen = 2 }
-- флаг урона в Sync.DMG
Net.DamageFlag = { Normal = 0, Crit = 1, Dodge = 2 }

-- причины удаления врага (Sync.RM) и союзника (Sync.RA)
Net.RemoveReasons = { "kill", "core", "clear" }
Net.AllyRemoveReasons = { "dead", "portal", "sold", "replaced", "clear" }

local function shared()
	return game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
end

function Net.IsAction(name)
	return type(name) == "string" and Net.ActionSet[name] == true
end

-- Сервер: создать (или переиспользовать) папку Remotes со всеми событиями и функцией.
-- Существующие объекты не пересоздаются, чтобы клиент не схватил устаревшую копию.
function Net.Setup()
	local root = shared()
	local folder = root:FindFirstChild(Net.FolderName)
	if folder and not folder:IsA("Folder") then
		folder:Destroy()
		folder = nil
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = Net.FolderName
		folder.Parent = root
	end
	local function ensure(name, class)
		local obj = folder:FindFirstChild(name)
		if obj and not obj:IsA(class) then
			obj:Destroy()
			obj = nil
		end
		if not obj then
			obj = Instance.new(class)
			obj.Name = name
			obj.Parent = folder
		end
		return obj
	end
	for _, name in ipairs(Net.Events) do
		ensure(name, "RemoteEvent")
	end
	ensure(Net.Function, "RemoteFunction")
	return folder
end

-- Клиент/сервер: папка Remotes. Дожидается всех событий и функции,
-- поэтому дальше можно обращаться напрямую: Remotes.Sync, Remotes.Request.
function Net.Remotes()
	local folder = shared():WaitForChild(Net.FolderName)
	for _, name in ipairs(Net.Events) do
		folder:WaitForChild(name)
	end
	folder:WaitForChild(Net.Function)
	return folder
end

-- Один объект по имени ("Sync", "Request", ...)
function Net.Get(name)
	return Net.Remotes():WaitForChild(name)
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX7A61E9F0D5EC819792B32B7E82ADE227">
				<Properties>
					<string name="Name">Path</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Path
-- Общая математика дороги. Сервер и клиент считают позиции врагов одинаково.
--
-- Активная дорога (одна на процесс) переключается через Path.SetMap(key); функции модуля
-- (PositionAt, DistanceToPath, IsPlacementClear, ...) всегда работают с активной картой.
-- Path.Get(key) отдаёт дорогу любой карты с теми же функциями — без переключения активной
-- (удобно строителям мира и проверкам).
--
-- Точки дороги в Config — (X, Z) от Center карты (у Void Center = 0,60,0, так что это мировые
-- координаты). Высота точек — GroundY.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Path = {}

local EDGE_MARGIN = 3       -- отступ от края острова при установке
local END_CLEARANCE = 14    -- нельзя ставить ближе к порталу / ядру
local FALLBACK_DIR = Vector3.new(0, 0, -1)

local roads = {}            -- таблица карты -> дорога (кэш)
local active                -- активная дорога

local sqrt = math.sqrt

local function flatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return sqrt(dx * dx + dz * dz)
end

------------------------------------------------------------------------
-- Математика одной дороги
------------------------------------------------------------------------

-- Позиция и направление на расстоянии d от начала дороги
local function positionAt(road, d)
	local points, cum, dirs = road.Points, road.Cumulative, road.Dirs
	local n = #points
	if d <= 0 then
		return points[1], dirs[2]
	end
	if d >= road.Length then
		return points[n], dirs[n]
	end
	for i = 2, n do
		if d <= cum[i] then
			-- отрезок нулевой длины сюда не попадает: d <= cum[i-1] сработало бы раньше
			local alpha = (d - cum[i - 1]) / (cum[i] - cum[i - 1])
			return points[i - 1] + road.Segs[i] * alpha, dirs[i]
		end
	end
	-- d = NaN: как в legacy — конец дороги
	return points[n], dirs[n]
end

-- Позиция с боковым смещением (чтобы враги не шли одной ниткой). right = (-dir.Z, 0, dir.X)
local function offsetPositionAt(road, d, lateral)
	local pos, dir = positionAt(road, d)
	if lateral and lateral ~= 0 then
		pos = pos + Vector3.new(-dir.Z, 0, dir.X) * lateral
	end
	return pos, dir
end

-- Горизонтальное расстояние от точки до ближайшего участка дороги
local function distanceToPath(road, pos)
	local best = math.huge
	local px, pz = pos.X, pos.Z
	local ax, az, abx, abz, lenSq = road.AX, road.AZ, road.ABX, road.ABZ, road.LenSq
	for i = 2, #road.Points do
		local t = 0
		local l = lenSq[i]
		if l > 0 then
			t = math.clamp(((px - ax[i]) * abx[i] + (pz - az[i]) * abz[i]) / l, 0, 1)
		end
		local dx = px - (ax[i] + abx[i] * t)
		local dz = pz - (az[i] + abz[i] * t)
		local d = sqrt(dx * dx + dz * dz)
		if d < best then
			best = d
		end
	end
	return best
end

-- Доля пройденного пути (без зажима: 0..1 внутри дороги)
local function fraction(road, d)
	if road.Length <= 0 then return 0 end
	return d / road.Length
end

-- Проверка позиции для установки (клиент — для превью, сервер — для проверки).
-- Не проверяет высоту, расстояние до других юнитов, деньги и лимиты.
local function isPlacementClear(road, pos)
	local map = road.Map
	local s = Config.Settings
	if distanceToPath(road, pos) < map.PathWidth / 2 + s.PathClearance then
		return false, "Нельзя ставить на дорогу"
	end
	local size = map.IslandSize -- Vector2: Y — размер по мировой оси Z
	local c = road.Center
	if math.abs(pos.X - c.X) > size.X / 2 - EDGE_MARGIN or math.abs(pos.Z - c.Z) > size.Y / 2 - EDGE_MARGIN then
		return false, "Слишком близко к краю"
	end
	local points = road.Points
	if flatDistance(pos, points[1]) < END_CLEARANCE then
		return false, "Слишком близко к порталу"
	end
	if flatDistance(pos, points[#points]) < END_CLEARANCE then
		return false, "Слишком близко к ядру"
	end
	return true
end

------------------------------------------------------------------------
-- Сборка дороги из конфига карты
------------------------------------------------------------------------
local function build(key, map)
	assert(type(map) == "table" and type(map.Path) == "table", "[Path] у карты нет Path: " .. tostring(key))
	assert(#map.Path >= 2, "[Path] в дороге меньше 2 точек: " .. tostring(key))
	local c = map.Center or Vector3.new()
	local y = map.GroundY or c.Y

	local road = {
		MapKey = key,
		Map = map,
		Center = c,
		Points = {},
		Cumulative = { 0 },
		Segs = {},
		Dirs = {},
		AX = {}, AZ = {}, ABX = {}, ABZ = {}, LenSq = {},
	}
	local points = road.Points
	for i, p in ipairs(map.Path) do
		points[i] = Vector3.new(c.X + p[1], y, c.Z + p[2])
	end

	local n = #points
	for i = 2, n do
		local a, b = points[i - 1], points[i]
		local seg = b - a
		local len = seg.Magnitude
		road.Segs[i] = seg
		road.Cumulative[i] = road.Cumulative[i - 1] + len
		road.Dirs[i] = len > 0 and seg.Unit or nil
		road.AX[i], road.AZ[i] = a.X, a.Z
		road.ABX[i], road.ABZ[i] = b.X - a.X, b.Z - a.Z
		road.LenSq[i] = road.ABX[i] * road.ABX[i] + road.ABZ[i] * road.ABZ[i]
	end
	-- у отрезков нулевой длины направление берём от соседей (без NaN)
	local last = nil
	for i = 2, n do
		if road.Dirs[i] then last = road.Dirs[i] elseif last then road.Dirs[i] = last end
	end
	local nextDir = nil
	for i = n, 2, -1 do
		if road.Dirs[i] then nextDir = road.Dirs[i] else road.Dirs[i] = nextDir or FALLBACK_DIR end
	end
	road.Length = road.Cumulative[n]

	-- функции дороги (вызов через точку, как у модуля)
	road.PositionAt = function(d) return positionAt(road, d) end
	road.OffsetPositionAt = function(d, lateral) return offsetPositionAt(road, d, lateral) end
	road.DistanceToPath = function(pos) return distanceToPath(road, pos) end
	road.Fraction = function(d) return fraction(road, d) end
	road.IsPlacementClear = function(pos) return isPlacementClear(road, pos) end
	road.FlatDistance = flatDistance
	return road
end

local function resolve(key)
	local maps = Config.Maps
	local map = (maps and key ~= nil and maps[key]) or Config.Map
	return map.Key or "Void", map
end

------------------------------------------------------------------------
-- API модуля
------------------------------------------------------------------------

-- Дорога карты key (неизвестный ключ — Void). Активную карту не меняет.
function Path.Get(key)
	local k, map = resolve(key)
	local road = roads[map]
	if not road then
		road = build(k, map)
		roads[map] = road
	end
	return road
end

-- Сделать карту активной (Void / Halloween). Сервер и клиент вызывают при смене карты.
function Path.SetMap(key)
	active = Path.Get(key)
	Path.Road = active
	Path.Points = active.Points
	Path.Length = active.Length
	Path.MapKey = active.MapKey
	Path.Map = active.Map
	return active
end

function Path.Fraction(d)
	return fraction(active, d)
end

function Path.PositionAt(d)
	return positionAt(active, d)
end

function Path.OffsetPositionAt(d, lateral)
	return offsetPositionAt(active, d, lateral)
end

function Path.DistanceToPath(pos)
	return distanceToPath(active, pos)
end

function Path.FlatDistance(a, b)
	return flatDistance(a, b)
end

function Path.IsPlacementClear(pos)
	return isPlacementClear(active, pos)
end

Path.SetMap("Void")

return Path
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX336E2317306E95824ABF1B85472DC665">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Util
-- Мелкие общие помощники (без состояния). Сервер и клиент.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Util = {}

-- Та же функция, что и Config.FormatNumber: 1234 -> "1,234", 15000 -> "15.0K", 1500000 -> "1.5M"
Util.FormatNumber = Config.FormatNumber

------------------------------------------------------------------------
-- Таблицы
------------------------------------------------------------------------

-- Глубокая копия простых таблиц. Таблицы с метатаблицей и значения Roblox
-- (Vector3, Color3, ...) копируются ссылкой. Циклы и общие подтаблицы сохраняются.
function Util.DeepCopy(t, seen)
	if type(t) ~= "table" or getmetatable(t) ~= nil then
		return t
	end
	seen = seen or {}
	if seen[t] then
		return seen[t]
	end
	local copy = {}
	seen[t] = copy
	for k, v in pairs(t) do
		copy[Util.DeepCopy(k, seen)] = Util.DeepCopy(v, seen)
	end
	return copy
end

function Util.ShallowCopy(t)
	local copy = {}
	for k, v in pairs(t) do
		copy[k] = v
	end
	return copy
end

-- Число ключей в словаре
function Util.Count(t)
	local n = 0
	for _ in pairs(t) do
		n = n + 1
	end
	return n
end

-- Индекс значения в массиве (или nil)
function Util.IndexOf(list, value)
	for i, v in ipairs(list) do
		if v == value then
			return i
		end
	end
	return nil
end

------------------------------------------------------------------------
-- Случайность
------------------------------------------------------------------------

local function rand01(rng)
	if rng == nil then
		return math.random()
	elseif type(rng) == "function" then
		return rng()
	end
	return rng:NextNumber()
end

local function weightOf(entry, weightKey)
	local w
	if type(weightKey) == "function" then
		w = weightKey(entry)
	elseif weightKey ~= nil then
		w = entry[weightKey]
	else
		w = entry
	end
	w = tonumber(w) or 0
	if w ~= w or w < 0 then w = 0 end
	return w
end

-- Взвешенный выбор: roll = roll01 * сумма весов, первый элемент с roll < накопленной суммы.
-- weightKey — имя поля ("Rate"), функция entry -> вес или nil (элементы — сами числа).
-- roll01 — число 0..1 (по умолчанию math.random()). Возвращает entry, index (nil для пустого списка).
function Util.WeightedPick(list, weightKey, roll01)
	local total = 0
	local lastIndex = nil
	for i, entry in ipairs(list) do
		local w = weightOf(entry, weightKey)
		total = total + w
		if w > 0 then lastIndex = i end
	end
	if not lastIndex then
		return nil, nil
	end
	local roll = (roll01 or math.random()) * total
	local acc = 0
	for i, entry in ipairs(list) do
		acc = acc + weightOf(entry, weightKey)
		if roll < acc then
			return entry, i
		end
	end
	-- roll01 >= 1 или погрешность суммы — последний элемент с весом
	return list[lastIndex], lastIndex
end

-- Перемешать массив на месте (Фишер — Йетс). rng — Random, функция 0..1 или nil.
function Util.Shuffle(list, rng)
	for i = #list, 2, -1 do
		local j = math.min(i, math.floor(rand01(rng) * i) + 1)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

-- Случайный элемент массива (nil для пустого)
function Util.Pick(list, rng)
	local n = #list
	if n == 0 then return nil end
	return list[math.min(n, math.floor(rand01(rng) * n) + 1)]
end

------------------------------------------------------------------------
-- Числа и проверки (для валидации аргументов клиента)
------------------------------------------------------------------------

-- Конечное число (не NaN и не ±inf)
function Util.IsFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Vector3 с конечными координатами
function Util.IsFiniteVector3(v)
	return typeof(v) == "Vector3" and Util.IsFinite(v.X) and Util.IsFinite(v.Y) and Util.IsFinite(v.Z)
end

-- Целое число в диапазоне [lo, hi]
function Util.IsIntInRange(n, lo, hi)
	return Util.IsFinite(n) and n % 1 == 0 and n >= lo and n <= hi
end

function Util.Round(n, step)
	step = step or 1
	return math.floor(n / step + 0.5) * step
end

function Util.Lerp(a, b, t)
	return a + (b - a) * t
end

-- Горизонтальное расстояние (XZ)
function Util.FlatDistance(a, b)
	local dx, dz = a.X - b.X, a.Z - b.Z
	return math.sqrt(dx * dx + dz * dz)
end

-- Цвет -> "#rrggbb" (для RichText <font color>)
function Util.ColorHex(c)
	return string.format("#%02x%02x%02x",
		math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),
		math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),
		math.clamp(math.floor(c.B * 255 + 0.5), 0, 255))
end

return Util
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX70F93E12E8103C04149FB4F6115592D8">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="Script" referent="RBX4D18368081B24ADBE370EA5B7A2CE669">
			<Properties>
				<string name="Name">VoidTDServer</string>
				<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: сервер (бутстрап)
-- Создаёт папки Remotes/State/Units, строит мир, запускает модули и связывает события игроков.
-- Вся логика — в модулях: Data, Economy, Sim, Match, Queue, Router, World.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local World = require(script:WaitForChild("World"))
local Data = require(script:WaitForChild("Data"))
local Economy = require(script:WaitForChild("Economy"))
local Sim = require(script:WaitForChild("Sim"))
local Match = require(script:WaitForChild("Match"))
local Queue = require(script:WaitForChild("Queue"))
local Router = require(script:WaitForChild("Router"))

-- папка: существующую переиспользуем (клиент мог уже схватить её через WaitForChild)
local function folder(name)
	local f = Shared:FindFirstChild(name)
	if f and not f:IsA("Folder") then
		f:Destroy()
		f = nil
	end
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = Shared
	end
	return f
end

local remotes = Net.Setup()
local state = folder("State")
local unitsFolder = folder("Units")
for _, ch in ipairs(unitsFolder:GetChildren()) do
	ch:Destroy()
end

-- мир: Хэллоуин может не построиться — тогда Хэллоуин-матчи блокируются (Match.CanStartHalloween)
local okW, maps = pcall(World.Build)
if not okW then
	warn("[VOID TD] Мир не построен: " .. tostring(maps))
	maps = {}
end

Economy.Init({ Data = Data })
Sim.Init({
	Remotes = remotes,
	State = state,
	UnitsFolder = unitsFolder,
	Maps = { Void = maps.Void, Halloween = maps.Halloween },
	Data = Data,
	Economy = Economy,
})
Match.Init({ Remotes = remotes, State = state, Sim = Sim, Data = Data, Economy = Economy, Maps = maps })
Queue.Init(Match, state)
Router.Init({ Remotes = remotes, Data = Data, Match = Match, Sim = Sim, Queue = Queue, Economy = Economy })
Match.OnProfileChanged = Router.PushProfile

local function onPlayerAdded(player)
	Match.PlayerAdded(player)
	local profile = Data.Load(player)
	if not profile or not player.Parent then
		return
	end
	player:SetAttribute("VoidReady", true)
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	Match.PlayerRemoving(player)
	Queue.Leave(player, true)
	Router.PlayerRemoving(player)
	Data.Release(player)
end)

game:BindToClose(function()
	for _, p in ipairs(Players:GetPlayers()) do
		Data.Save(p, true)
	end
	Data.Flush(25)
end)

print("[VOID TD] Сервер запущен. Карта: " .. Config.Map.Name)
]]></ProtectedString>
			</Properties>
			<Item class="ModuleScript" referent="RBXF3F93B863B3F668B62935E37A2F9A748">
				<Properties>
					<string name="Name">Data</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Data
-- Профиль игрока: кристаллы, Halloween Coins, инвентарь юнитов, экипировка, руны, статистика.
-- DataStore с безопасным фолбэком: если загрузка не удалась, профиль работает в памяти и НЕ сохраняется
-- (иначе дефолт затёр бы настоящее сохранение). Сохранение — UpdateAsync, без потерь при троттлинге
-- (отложенная запись вместо пропуска), одна запись на игрока одновременно.
--
-- API: Load Get Save Release Snapshot AddGems AddCurrency Summon ClaimDaily GrantPurchase SaveNow
--      Equip IsEquipped GetRune EquipRune Flush(timeout)

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local S = Config.Settings
local SAVE_THROTTLE = 8 -- с между обычными сохранениями
local LOAD_TRIES = 3
local MAX_RECEIPTS = 200 -- старые чеки обрезаются (лимит 4 МБ на ключ)

local Data = {}
Data.Profiles = {}

local meta = {} -- player -> { Last, Inflight, Dirty, Timer, NoSave, Studio = {id=true}, Profile }
local inflight = 0

local store
do
	local ok = pcall(function()
		store = DataStoreService:GetDataStore(S.DataStoreName)
	end)
	if not ok then
		store = nil
	end
end

local function key(player)
	return "u_" .. player.UserId
end

local deepCopy = Util.DeepCopy

local function isNum(n)
	return Util.IsFinite(n)
end

------------------------------------------------------------------------
-- ПРОФИЛЬ ПО УМОЛЧАНИЮ И ОЧИСТКА
------------------------------------------------------------------------
local function defaultProfile()
	local p = {
		Gems = S.StartGems,
		Inventory = {},
		Equipped = {},
		Stats = { Wins = 0, BestWave = 0, Summons = 0 },
		Settings = {},
		LastDaily = 0,
		Receipts = {},
		HalloweenCoins = 0,
		Runes = {},     -- RuneId -> количество
		RuneSlots = {}, -- UnitId -> RuneId (1 руна на тип юнита)
	}
	for i, id in ipairs(S.StarterUnits) do
		p.Inventory[id] = 1
		p.Equipped[i] = id
	end
	return p
end

local function count(n)
	n = tonumber(n)
	if not isNum(n) then
		return 0
	end
	return math.max(0, math.floor(n))
end

local function sortedKeys(t)
	local keys = {}
	for k in pairs(t) do
		if type(k) == "string" then
			keys[#keys + 1] = k
		end
	end
	table.sort(keys)
	return keys
end

local function sanitize(p)
	local d = defaultProfile()
	if type(p) ~= "table" then
		return d
	end
	local out = {}
	local gems = tonumber(p.Gems)
	out.Gems = isNum(gems) and math.max(0, math.floor(gems)) or d.Gems
	-- инвентарь: только известные юниты с числом > 0
	out.Inventory = {}
	if type(p.Inventory) == "table" then
		for id, n in pairs(p.Inventory) do
			if type(id) == "string" and Config.Units[id] and count(n) > 0 then
				out.Inventory[id] = count(n)
			end
		end
	end
	if next(out.Inventory) == nil then
		-- пустой инвентарь — стартовые юниты заново
		out.Inventory = d.Inventory
		p.Equipped = d.Equipped
	end
	local st = type(p.Stats) == "table" and p.Stats or {}
	out.Stats = { Wins = count(st.Wins), BestWave = count(st.BestWave), Summons = count(st.Summons) }
	out.Settings = {}
	if type(p.Settings) == "table" then
		for k, v in pairs(p.Settings) do
			if type(k) == "string" and (type(v) == "boolean" or isNum(v) or type(v) == "string") then
				out.Settings[k] = v
			end
		end
	end
	local ld = tonumber(p.LastDaily)
	out.LastDaily = isNum(ld) and ld or 0
	out.Receipts = {}
	if type(p.Receipts) == "table" then
		for k, v in pairs(p.Receipts) do
			if type(k) == "string" and v then
				out.Receipts[k] = true
			end
		end
	end
	out.HalloweenCoins = count(p.HalloweenCoins)
	-- руны: только известные; слоты — только у своих юнитов и не больше, чем рун есть (порядок детерминирован)
	out.Runes = {}
	if type(p.Runes) == "table" then
		for id, n in pairs(p.Runes) do
			if type(id) == "string" and Config.Runes[id] and count(n) > 0 then
				out.Runes[id] = count(n)
			end
		end
	end
	out.RuneSlots = {}
	if type(p.RuneSlots) == "table" then
		local used = {}
		for _, unitId in ipairs(sortedKeys(p.RuneSlots)) do
			local runeId = p.RuneSlots[unitId]
			if out.Inventory[unitId] and type(runeId) == "string" and out.Runes[runeId] and (used[runeId] or 0) < out.Runes[runeId] then
				out.RuneSlots[unitId] = runeId
				used[runeId] = (used[runeId] or 0) + 1
			end
		end
	end
	-- экипировка: читаем и числовые, и строковые (JSON) ключи; дубли выкидываем
	out.Equipped = {}
	local eq = type(p.Equipped) == "table" and p.Equipped or {}
	local seen = {}
	for i = 1, S.EquipSlots do
		local id = eq[i] or eq[tostring(i)]
		if type(id) == "string" and out.Inventory[id] and not seen[id] then
			out.Equipped[i] = id
			seen[id] = true
		end
	end
	return out
end

------------------------------------------------------------------------
-- ЗАГРУЗКА / СОХРАНЕНИЕ
------------------------------------------------------------------------
function Data.Load(player)
	local raw, failed = nil, false
	if store then
		failed = true
		for attempt = 1, LOAD_TRIES do
			local ok, result = pcall(function()
				return store:GetAsync(key(player))
			end)
			if ok then
				raw, failed = result, false
				break
			end
			if attempt < LOAD_TRIES then
				task.wait(1)
			end
		end
		if failed then
			warn("[VOID TD] DataStore недоступен (в Studio включи API Services). Используются данные по умолчанию.")
		end
	end
	-- игрок ушёл, пока грузился профиль — ничего не создаём
	if not player.Parent then
		return nil
	end
	local profile = sanitize(type(raw) == "table" and deepCopy(raw) or nil)
	local m = { Last = 0, NoSave = failed, Studio = {}, Profile = profile }
	-- Studio: тестовые юниты в инвентаре (в сохранение не попадают)
	if RunService:IsStudio() then
		for _, id in ipairs(S.StudioGrantUnits or {}) do
			if Config.Units[id] and (profile.Inventory[id] or 0) == 0 then
				profile.Inventory[id] = 1
				m.Studio[id] = true
			end
		end
	end
	meta[player] = m
	Data.Profiles[player] = profile
	player:SetAttribute("Gems", profile.Gems)
	player:SetAttribute("HalloweenCoins", profile.HalloweenCoins)
	return profile
end

function Data.Get(player)
	return Data.Profiles[player]
end

-- копия для DataStore: ключи экипировки строками, без студийных выдач, чеков не больше MAX_RECEIPTS
local function serialize(profile, m)
	local data = deepCopy(profile)
	for id in pairs(m.Studio) do
		local n = (data.Inventory[id] or 0) - 1
		if n <= 0 then
			data.Inventory[id] = nil
			data.RuneSlots[id] = nil
			for i = 1, S.EquipSlots do
				if data.Equipped[i] == id then
					data.Equipped[i] = nil
				end
			end
		else
			data.Inventory[id] = n
		end
	end
	local eq = {}
	for i, id in pairs(data.Equipped) do
		eq[tostring(i)] = id
	end
	data.Equipped = eq
	local ids = sortedKeys(data.Receipts)
	if #ids > MAX_RECEIPTS then
		for i = 1, #ids - MAX_RECEIPTS do
			data.Receipts[ids[i]] = nil
		end
	end
	return data
end

local function writeNow(player, m)
	local data = serialize(m.Profile, m)
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if not ok and not RunService:IsStudio() then
		warn("[VOID TD] Ошибка сохранения: " .. tostring(err))
	end
	return ok
end

local function write(player, m)
	m.Inflight = true
	m.Last = os.clock()
	inflight += 1
	task.spawn(function()
		writeNow(player, m)
		inflight -= 1
		m.Inflight = false
		if m.Dirty then
			m.Dirty = false
			write(player, m)
		end
	end)
end

-- force = true — сразу (с очередью, если запись уже идёт); иначе не чаще раза в 8 с, лишнее откладывается
function Data.Save(player, force)
	local m = meta[player]
	if not m or not store or m.NoSave then
		return
	end
	if m.Inflight then
		m.Dirty = true
		return
	end
	local since = os.clock() - m.Last
	if not force and since < SAVE_THROTTLE then
		if not m.Timer then
			m.Timer = true
			task.delay(SAVE_THROTTLE - since, function()
				m.Timer = false
				if meta[player] == m then
					Data.Save(player, true)
				end
			end)
		end
		return
	end
	write(player, m)
end

-- синхронная запись (покупки): true — данные в DataStore (или DataStore не используется)
function Data.SaveNow(player)
	local m = meta[player]
	if not m then
		return false
	end
	if not store then
		return true
	end
	if m.NoSave then
		return false
	end
	m.Last = os.clock()
	return writeNow(player, m)
end

function Data.Release(player)
	Data.Save(player, true)
	Data.Profiles[player] = nil
	meta[player] = nil
end

-- дождаться всех записей (BindToClose)
function Data.Flush(timeout)
	local t0 = os.clock()
	while inflight > 0 and os.clock() - t0 < (timeout or 25) do
		task.wait(0.1)
	end
end

------------------------------------------------------------------------
-- ВАЛЮТЫ
------------------------------------------------------------------------
function Data.AddGems(player, amount)
	local p = Data.Profiles[player]
	if not p or not isNum(amount) then
		return
	end
	p.Gems = math.max(0, math.floor(p.Gems + amount))
	player:SetAttribute("Gems", p.Gems)
end

function Data.AddCurrency(player, currency, amount)
	local p = Data.Profiles[player]
	if not p or not isNum(amount) then
		return
	end
	if currency == "Gems" then
		Data.AddGems(player, amount)
		return
	end
	p[currency] = math.max(0, (p[currency] or 0) + math.floor(amount))
	player:SetAttribute(currency, p[currency])
end

-- Публичная версия профиля для клиента
function Data.Snapshot(player)
	local p = Data.Profiles[player]
	if not p then
		return nil
	end
	-- ключи экипировки строками: разреженные массивы плохо переживают RemoteEvent
	local eq = {}
	for i, id in pairs(p.Equipped) do
		eq[tostring(i)] = id
	end
	return {
		Gems = p.Gems,
		Inventory = deepCopy(p.Inventory),
		Equipped = eq,
		Stats = deepCopy(p.Stats),
		Settings = deepCopy(p.Settings),
		DailyReadyAt = (tonumber(p.LastDaily) or 0) + S.DailyCooldown,
		HalloweenCoins = p.HalloweenCoins or 0,
		Runes = deepCopy(p.Runes),
		RuneSlots = deepCopy(p.RuneSlots),
	}
end

------------------------------------------------------------------------
-- ЭКИПИРОВКА
------------------------------------------------------------------------
local function owns(p, unitId)
	return type(unitId) == "string" and Config.Units[unitId] ~= nil and (p.Inventory[unitId] or 0) > 0
end

local function autoEquip(p, id)
	for slot = 1, S.EquipSlots do
		if not p.Equipped[slot] then
			p.Equipped[slot] = id
			return
		end
	end
end

function Data.Equip(player, unitId, slot)
	local p = Data.Profiles[player]
	if not p then
		return false, "Профиль не загружен"
	end
	slot = tonumber(slot)
	if not Util.IsIntInRange(slot, 1, S.EquipSlots) then
		return false, "Неверный слот"
	end
	if unitId == nil then
		p.Equipped[slot] = nil
		Data.Save(player)
		return true
	end
	if not owns(p, unitId) then
		return false, "Юнита нет в инвентаре"
	end
	for i = 1, S.EquipSlots do
		if p.Equipped[i] == unitId then
			p.Equipped[i] = nil
		end
	end
	p.Equipped[slot] = unitId
	Data.Save(player)
	return true
end

function Data.IsEquipped(player, unitId)
	local p = Data.Profiles[player]
	if not p then
		return false
	end
	for i = 1, S.EquipSlots do
		if p.Equipped[i] == unitId then
			return true
		end
	end
	return false
end

------------------------------------------------------------------------
-- РУНЫ: 1 руна на юнита, снимается и переносится на другого, работает только надетой
------------------------------------------------------------------------
function Data.GetRune(player, unitId)
	local p = Data.Profiles[player]
	return p and p.RuneSlots[unitId] or nil
end

local function runesUsed(p, runeId, exceptUnit)
	local n = 0
	for unitId, r in pairs(p.RuneSlots) do
		if r == runeId and unitId ~= exceptUnit then
			n += 1
		end
	end
	return n
end

-- runeId = nil — снять руну с юнита
function Data.EquipRune(player, unitId, runeId)
	local p = Data.Profiles[player]
	if not p then
		return false, "Профиль не загружен"
	end
	if not owns(p, unitId) then
		return false, "Юнита нет в инвентаре"
	end
	if runeId == nil then
		p.RuneSlots[unitId] = nil
		Data.Save(player)
		return true
	end
	if type(runeId) ~= "string" or not Config.Runes[runeId] then
		return false, "Неизвестная руна"
	end
	if runesUsed(p, runeId, unitId) >= (p.Runes[runeId] or 0) then
		return false, "Все такие руны уже надеты — сними руну с другого юнита"
	end
	p.RuneSlots[unitId] = runeId
	Data.Save(player)
	return true
end

------------------------------------------------------------------------
-- КЕЙСЫ (SUMMON)
------------------------------------------------------------------------
local rng = Random.new()

local function unitsByRarity(case)
	local map = {}
	for _, id in ipairs(case.Units or {}) do
		local def = Config.Units[id]
		if def then
			map[def.Rarity] = map[def.Rarity] or {}
			table.insert(map[def.Rarity], id)
		end
	end
	return map
end

-- редкость есть в розыгрыше, если в ней есть юниты без отдельного шанса (UnitRates)
local function rollable(pool, name, unitRates)
	for _, id in ipairs(pool[name] or {}) do
		if not (unitRates and unitRates[id]) then
			return true
		end
	end
	return false
end

local function rollRarity(case, pool, unitRates)
	local total = 0
	for _, name in ipairs(Config.RarityOrder) do
		if rollable(pool, name, unitRates) then
			total += case.Rates[name] or 0
		end
	end
	local roll = rng:NextNumber() * total
	local acc, last = 0, nil
	for _, name in ipairs(Config.RarityOrder) do
		if rollable(pool, name, unitRates) then
			acc += case.Rates[name] or 0
			last = name
			if roll <= acc then
				return name
			end
		end
	end
	return last or "Common"
end

local function rollFixed(case)
	if not case.UnitRates then
		return nil
	end
	local roll, acc = rng:NextNumber() * 100, 0
	for _, id in ipairs(sortedKeys(case.UnitRates)) do
		acc += case.UnitRates[id]
		if roll < acc then
			return id
		end
	end
	return nil
end

-- кейс с полным списком наград (юниты и руны): один бросок на открытие
local function rollReward(p, case)
	local pick = Util.WeightedPick(case.Rewards, "Rate", rng:NextNumber())
	if pick.Rune then
		local isNew = (p.Runes[pick.Rune] or 0) == 0
		p.Runes[pick.Rune] = (p.Runes[pick.Rune] or 0) + 1
		return { Rune = pick.Rune, New = isNew }
	end
	local id = pick.Unit
	local isNew = (p.Inventory[id] or 0) == 0
	p.Inventory[id] = (p.Inventory[id] or 0) + 1
	if isNew then
		autoEquip(p, id)
	end
	return { Id = id, New = isNew }
end

-- проверка кейса до списания: награды существуют
local function caseValid(case)
	if case.Rewards then
		if #case.Rewards == 0 then
			return false
		end
		for _, r in ipairs(case.Rewards) do
			if not ((r.Rune and Config.Runes[r.Rune]) or (r.Unit and Config.Units[r.Unit])) then
				return false
			end
		end
		return true
	end
	local pool = unitsByRarity(case)
	for _, name in ipairs(Config.RarityOrder) do
		if (case.Rates[name] or 0) > 0 and rollable(pool, name, case.UnitRates) then
			return true
		end
	end
	return false
end

function Data.Summon(player, caseId, n)
	local p = Data.Profiles[player]
	if not p then
		return false, "Профиль не загружен"
	end
	local case = type(caseId) == "string" and Config.Cases[caseId]
	if not case then
		return false, "Неизвестный кейс"
	end
	if case.Enabled == false then
		return false, "Кейс пока недоступен"
	end
	local amount = (n == 10) and 10 or 1
	if case.Single and amount ~= 1 then
		return false, "Этот кейс открывается по одному"
	end
	local cost = (amount == 10) and case.Cost10 or case.Cost1
	if not cost or not caseValid(case) then
		return false, "Неверный запрос"
	end
	local currency = case.Currency or "Gems"
	if (p[currency] or 0) < cost then
		return false, currency == "Gems" and "Недостаточно кристаллов" or "Недостаточно Halloween Coins"
	end
	p[currency] = p[currency] - cost
	player:SetAttribute(currency, p[currency])

	if case.Rewards then
		local result = rollReward(p, case)
		p.Stats.Summons += 1
		Data.Save(player, true)
		return true, { result }
	end

	local pool = unitsByRarity(case)
	local results = {}
	local bestOrder = 0
	for i = 1, amount do
		-- отдельный шанс конкретных юнитов (UnitRates, в процентах), иначе — по редкостям
		local fixed = rollFixed(case)
		local rarity = fixed and Config.Units[fixed].Rarity or rollRarity(case, pool, case.UnitRates)
		-- гарантия: в x10 минимум один Rare+
		if amount == 10 and i == 10 and bestOrder < 2 and not fixed and rollable(pool, "Rare", case.UnitRates) then
			rarity = "Rare"
		end
		bestOrder = math.max(bestOrder, Config.Rarities[rarity].Order)
		local id = fixed
		if not id then
			local list = {}
			for _, u in ipairs(pool[rarity] or {}) do
				if not (case.UnitRates and case.UnitRates[u]) then
					list[#list + 1] = u
				end
			end
			id = list[rng:NextInteger(1, #list)]
		end
		local isNew = (p.Inventory[id] or 0) == 0
		p.Inventory[id] = (p.Inventory[id] or 0) + 1
		results[i] = { Id = id, New = isNew }
		if isNew then
			autoEquip(p, id)
		end
	end
	p.Stats.Summons += amount
	Data.Save(player)
	return true, results
end

------------------------------------------------------------------------
-- МАГАЗИН
------------------------------------------------------------------------
function Data.ClaimDaily(player)
	local p = Data.Profiles[player]
	if not p then
		return false, "Профиль не загружен"
	end
	local now = os.time()
	local left = (p.LastDaily + S.DailyCooldown) - now
	if left > 0 then
		return false, string.format("Подарок будет через %d ч %d мин", left // 3600, (left % 3600) // 60)
	end
	p.LastDaily = now
	Data.AddGems(player, S.DailyGems)
	Data.Save(player, true)
	return true, S.DailyGems
end

-- Выдача кристаллов за покупку. receiptId защищает от повторной выдачи.
-- Возвращает ok, already (чек уже был выдан). С receiptId запись синхронная: ok = данные сохранены.
function Data.GrantPurchase(player, gems, receiptId)
	local p = Data.Profiles[player]
	if not p then
		return false
	end
	if receiptId then
		receiptId = tostring(receiptId)
		if p.Receipts[receiptId] then
			return Data.SaveNow(player), true
		end
		p.Receipts[receiptId] = true
		Data.AddGems(player, gems)
		return Data.SaveNow(player), false
	end
	Data.AddGems(player, gems)
	Data.Save(player, true)
	return true, false
end

return Data
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXCC208C9551C9FB71A5D6D17BDB669E20">
				<Properties>
					<string name="Name">Economy</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Economy
-- Деньги матча (атрибут игрока Money + leaderstats.Money) и раздача наград всем участникам матча.
-- Награды не делятся: каждый игрок в матче получает полную сумму.

local Players = game:GetService("Players")

local Economy = {}

local Data

function Economy.Init(ctx)
	Data = ctx.Data
end

function Economy.Get(player)
	return player:GetAttribute("Money") or 0
end

function Economy.Set(player, amount)
	amount = tonumber(amount) or 0
	if amount ~= amount then
		amount = 0
	end
	amount = math.max(0, math.floor(amount))
	player:SetAttribute("Money", amount)
	local ls = player:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild("Money")
	if v then
		v.Value = amount
	end
	return amount
end

function Economy.Add(player, amount)
	return Economy.Set(player, Economy.Get(player) + amount)
end

-- можно ли списать
function Economy.Has(player, amount)
	return Economy.Get(player) >= amount
end

function Economy.InMatch(player)
	return player:GetAttribute("InMatch") == true
end

function Economy.MatchPlayers()
	local list = {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if Economy.InMatch(pl) then
			list[#list + 1] = pl
		end
	end
	return list
end

function Economy.AddAll(amount)
	for _, pl in ipairs(Economy.MatchPlayers()) do
		Economy.Add(pl, amount)
	end
end

-- кристаллы всем в матче с множителем сложности; возвращает итоговое (округлённое) число
function Economy.AddGemsAll(base, gemsMult)
	local amount = math.floor(base * (gemsMult or 1) + 0.5)
	for _, pl in ipairs(Economy.MatchPlayers()) do
		Data.AddGems(pl, amount)
	end
	return amount
end

return Economy
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX837CAE8D5E0A286C8AC005E18923FEF4">
				<Properties>
					<string name="Name">Match</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Match
-- Единственный матч сервера: фазы Idle → Prep → Wave ⇄ Intermission → Victory/Defeat → Idle,
-- волны, ядро, награды, телепорты лобби/остров/арена, Хэллоуин-матч из очереди (Queue).
-- Бой (враги, юниты, урон) — в Sim; здесь только поток матча.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local S = Config.Settings
local FADE_DELAY = 0.45 -- телепорт после затемнения экрана

local Match = {}
Match.OnProfileChanged = nil -- function(player), ставит бутстрап (Router.PushProfile)

local Remotes, State, Sim, Data, Economy, Maps
local rng = Random.new()

-- состояние матча
local phase = "Idle"
local diffKey = "Medium"
local D = Config.Difficulties.Medium
local wave = 0
local coreHP = S.CoreMaxHP
local matchId = 0
local waveSpawning = false
local nextWaveAt = 0
local mode = "Void"
local maxWave = S.MaxWave
local roster = {} -- UserId -> true (участники Хэллоуин-матча)
local coinsPaid = {} -- matchId -> true

local RUNNING = { Prep = true, Wave = true, Intermission = true }

local function now()
	return workspace:GetServerTimeNow()
end

local function setState(k, v)
	State:SetAttribute(k, v)
end

local function notifyAll(payload)
	Remotes.Notify:FireAllClients(payload)
end

local function setPhase(p)
	phase = p
	setState("Phase", p)
	Sim.Configure({ Running = RUNNING[p] == true })
end

function Match.Toast(player, text, kind)
	Remotes.Notify:FireClient(player, { Type = "Toast", Text = text, Kind = kind or "error" })
end

local function inMatch(player)
	return player:GetAttribute("InMatch") == true
end

local function pushProfile(player)
	if Match.OnProfileChanged then
		Match.OnProfileChanged(player)
	end
end

------------------------------------------------------------------------
-- ТЕЛЕПОРТЫ
------------------------------------------------------------------------
function Match.Teleport(player, pos)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	char:PivotTo(CFrame.new(pos + Vector3.new(rng:NextNumber(-3, 3), 3.5, rng:NextNumber(-3, 3))))
end

local function toBattle(player)
	local m = Config.Maps[mode] or Config.Map
	Match.Teleport(player, m.BattleSpawn or Config.BattleSpawn)
end

function Match.ToLobby(player, island)
	player:SetAttribute("Island", island == true)
	Match.Teleport(player, island and Config.HalloweenIsland.Spawn or Config.Lobby.Spawn)
end

------------------------------------------------------------------------
-- ИГРОКИ
------------------------------------------------------------------------
local function onCharacter(player, char)
	char:WaitForChild("HumanoidRootPart", 5)
	task.wait(0.2)
	if char.Parent == nil or player.Character ~= char then
		return
	end
	if inMatch(player) then
		toBattle(player)
	else
		Match.ToLobby(player, player:GetAttribute("Island") == true)
	end
end

function Match.PlayerAdded(player)
	if not player:FindFirstChild("leaderstats") then
		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local money = Instance.new("IntValue")
		money.Name = "Money"
		money.Parent = ls
		ls.Parent = player
	end
	player:SetAttribute("InMatch", false)
	Economy.Set(player, 0)
	player.CharacterAdded:Connect(function(char)
		onCharacter(player, char)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

------------------------------------------------------------------------
-- СБРОС / НАЧАЛО
------------------------------------------------------------------------
local function clearMatch()
	matchId += 1
	Sim.Clear()
	wave = 0
	waveSpawning = false
	nextWaveAt = 0
	Sim.Configure({ Wave = 0 })
	setState("Wave", 0)
	setState("NextWaveAt", 0)
	setState("MatchId", matchId)
end

local function setMapMode(m)
	mode = m
	maxWave = (Config.Maps[m] and Config.Maps[m].MaxWave) or S.MaxWave
	Sim.Configure({ Mode = m })
	setState("Map", m)
	setState("MaxWave", maxWave)
end

local function resetMatch()
	local wasHalloween = mode == "Halloween"
	clearMatch()
	setPhase("Idle")
	setState("Difficulty", "")
	local myMatch = matchId
	for _, pl in ipairs(Players:GetPlayers()) do
		if inMatch(pl) then
			pl:SetAttribute("InMatch", false)
			Economy.Set(pl, 0)
			pl:SetAttribute("Island", wasHalloween)
			Remotes.Notify:FireClient(pl, { Type = "Fade", Text = wasHalloween and "HALLOWEEN" or "ЛОББИ" })
			task.delay(FADE_DELAY, function()
				-- игрок мог успеть зайти в новый матч — тогда не выдёргиваем
				if pl.Parent and not inMatch(pl) and matchId == myMatch then
					Match.ToLobby(pl, wasHalloween)
				end
			end)
		end
	end
	roster = {}
	setMapMode("Void")
	notifyAll({ Type = "Reset" })
end
Match._reset = resetMatch

local function startNewMatch(key, m)
	clearMatch()
	setMapMode(m or "Void")
	diffKey = key
	D = Config.Difficulties[key]
	coreHP = D.CoreHP
	Sim.Configure({ D = D })
	setState("Difficulty", key)
	setState("CoreMaxHP", coreHP)
	setState("CoreHP", coreHP)
	setPhase("Prep")
end

local function resetIfEmpty()
	if #Economy.MatchPlayers() == 0 and phase ~= "Idle" then
		resetMatch()
	end
end

------------------------------------------------------------------------
-- ВОЛНЫ
------------------------------------------------------------------------
local function waveGroups(w)
	local source = mode == "Halloween" and Config.Maps.Halloween.Waves or Config.Waves
	local groups = {}
	for i, g in ipairs(source[w] or {}) do
		if g[1] == "BOSS" then
			groups[i] = { Config.Halloween.Bosses[diffKey] or "GraveWarden", g[2], g[3] }
		else
			groups[i] = g
		end
	end
	return groups
end

local function startWave()
	if phase ~= "Prep" and phase ~= "Intermission" then
		return false
	end
	wave += 1
	Sim.Configure({ Wave = wave })
	setPhase("Wave")
	setState("Wave", wave)
	setState("NextWaveAt", 0)
	nextWaveAt = 0
	local groups = waveGroups(wave)
	-- имя босса для анонса: самый «толстый» босс волны (legacy брал последнего)
	local bossName, bossHP
	for _, g in ipairs(groups) do
		local def = Config.Enemies[g[1]]
		if def and def.IsBoss and (not bossHP or def.Health > bossHP) then
			bossName, bossHP = def.Name, def.Health
		end
	end
	notifyAll({ Type = "WaveStart", Wave = wave, Boss = bossName })
	waveSpawning = true
	local myMatch, myWave = matchId, wave
	task.spawn(function()
		for gi, g in ipairs(groups) do
			local id, count, interval = g[1], g[2], g[3]
			for i = 1, count do
				if matchId ~= myMatch or phase ~= "Wave" then
					return
				end
				Sim.SpawnEnemy(id)
				if i < count then
					task.wait(interval)
				end
			end
			if gi < #groups then
				task.wait(S.GroupDelay)
			end
		end
		if matchId == myMatch and wave == myWave then
			waveSpawning = false
		end
	end)
	return true
end

local function endMatch(victory)
	setPhase(victory and "Victory" or "Defeat")
	waveSpawning = false
	local myMatch = matchId
	local players = Economy.MatchPlayers()
	if victory then
		local g = Economy.AddGemsAll(S.VictoryGems, D.Gems)
		local coins = 0
		if mode == "Halloween" and not coinsPaid[myMatch] then
			coinsPaid[myMatch] = true
			coins = Config.Halloween.Coins[diffKey] or 0
		end
		for _, pl in ipairs(players) do
			local prof = Data.Get(pl)
			if prof then
				prof.Stats.Wins = (prof.Stats.Wins or 0) + 1
				prof.Stats.BestWave = math.max(prof.Stats.BestWave or 0, wave)
				if coins > 0 and roster[pl.UserId] then
					Data.AddCurrency(pl, "HalloweenCoins", coins)
				end
				Data.Save(pl, true)
				pushProfile(pl)
			end
		end
		notifyAll({
			Type = "Victory", Wave = wave, Gems = g, Coins = coins > 0 and coins or nil,
			Reset = S.ResetDelay, Difficulty = diffKey, Mode = mode,
		})
	else
		for _, pl in ipairs(players) do
			local prof = Data.Get(pl)
			if prof then
				prof.Stats.BestWave = math.max(prof.Stats.BestWave or 0, wave - 1)
				Data.Save(pl, true)
			end
		end
		notifyAll({ Type = "Defeat", Wave = wave, Reset = S.ResetDelay, Difficulty = diffKey, Mode = mode })
		Sim.ClearEnemies()
	end
	task.delay(S.ResetDelay, function()
		if matchId == myMatch then
			resetMatch()
		end
	end)
end

local function waveCleared()
	local reward = math.floor((S.WaveRewardBase + S.WaveRewardPerWave * wave) * D.Money + 0.5)
	Economy.AddAll(reward)
	local gems = Economy.AddGemsAll(S.WaveGemsBase + S.WaveGemsPerWave * wave, D.Gems)
	if wave >= maxWave then
		endMatch(true)
		return
	end
	nextWaveAt = now() + (D.Intermission or S.Intermission)
	setPhase("Intermission")
	setState("NextWaveAt", nextWaveAt)
	notifyAll({ Type = "WaveClear", Wave = wave, Reward = reward, Gems = gems })
end

local function damageCore(amount)
	if phase == "Victory" or phase == "Defeat" or phase == "Idle" then
		return
	end
	coreHP = math.max(0, coreHP - amount)
	setState("CoreHP", coreHP)
	notifyAll({ Type = "CoreHit", Amount = amount })
	if coreHP <= 0 then
		endMatch(false)
	end
end

local function onKill(e, reward)
	Economy.AddAll(reward)
	local bossGems = e.Def.BossGems
	if bossGems then
		local g = Economy.AddGemsAll(bossGems, D.Gems)
		notifyAll({ Type = "Toast", Text = e.Def.Name .. " повержен! +" .. g .. " гемов", Kind = "boss" })
		notifyAll({ Type = "BossDown" })
	end
end

local function step(dt)
	local t = now()
	Sim.Step(t, dt, RUNNING[phase] == true)
	if phase == "Wave" and not waveSpawning and not Sim.HasEnemies() then
		waveCleared()
	elseif phase == "Intermission" and t >= nextWaveAt then
		startWave()
	end
end
Match._step = step

------------------------------------------------------------------------
-- ЗАПРОСЫ
------------------------------------------------------------------------
function Match.JoinMatch(player, key)
	if inMatch(player) then
		return false, "Ты уже в матче"
	end
	if phase == "Victory" or phase == "Defeat" then
		return false, "Матч завершается, подожди пару секунд"
	end
	if phase ~= "Idle" and mode == "Halloween" then
		return false, "Сейчас идёт Хэллоуин-матч. Подожди, пока он закончится"
	end
	if phase == "Idle" then
		if type(key) ~= "string" or not Config.Difficulties[key] then
			return false, "Выбери сложность"
		end
		startNewMatch(key)
	end
	player:SetAttribute("InMatch", true)
	Economy.Set(player, (S.StartMoney + math.max(0, wave - 1) * 150) * D.Money)
	toBattle(player)
	notifyAll({ Type = "Toast", Text = player.DisplayName .. " вступил в бой (" .. D.Name .. ")", Kind = "good" })
	return true, diffKey
end

function Match.LeaveMatch(player)
	if not inMatch(player) then
		return false, "Ты не в матче"
	end
	Sim.RemovePlayerUnits(player)
	player:SetAttribute("InMatch", false)
	Economy.Set(player, 0)
	Match.ToLobby(player, mode == "Halloween")
	resetIfEmpty()
	return true
end

function Match.PlayerRemoving(player)
	Sim.RemovePlayerUnits(player)
	player:SetAttribute("InMatch", false)
	task.defer(resetIfEmpty)
end

function Match.RequestStartWave(player)
	if not inMatch(player) then
		return false, "Сначала зайди в матч через портал ИГРАТЬ"
	end
	if phase == "Prep" or phase == "Intermission" then
		startWave()
		return true
	end
	return false, "Волна уже идёт"
end

-- ставить юнитов можно только участнику идущего матча
function Match.CanPlace(player)
	if not inMatch(player) then
		return false, "Сначала зайди в матч через портал ИГРАТЬ"
	end
	if not RUNNING[phase] then
		return false, "Матч не идёт"
	end
	return true
end

function Match.GetMatchInfo()
	return { Phase = phase, Difficulty = diffKey, Wave = wave, Players = #Economy.MatchPlayers(), Mode = mode }
end

function Match.GetMode()
	return mode, phase
end

-- арена одна: Хэллоуин только когда никто не играет (и карта построена)
function Match.CanStartHalloween()
	return phase == "Idle" and Maps.Halloween ~= nil
end

function Match.StartHalloween(list, key)
	if phase ~= "Idle" then
		return false, "Арена занята — идёт другой матч"
	end
	if not Maps.Halloween then
		return false, "Хэллоуин-арена недоступна"
	end
	if type(key) ~= "string" or not table.find(Config.Halloween.Difficulties, key) then
		return false, "Неверная сложность"
	end
	startNewMatch(key, "Halloween")
	roster = {}
	local myMatch = matchId
	for _, pl in ipairs(list) do
		if pl.Parent and not inMatch(pl) then
			roster[pl.UserId] = true
			pl:SetAttribute("InMatch", true)
			Economy.Set(pl, S.StartMoney * D.Money)
			Remotes.Notify:FireClient(pl, { Type = "Fade", Text = "HAUNTED HOLLOW" })
			task.delay(FADE_DELAY, function()
				if pl.Parent and inMatch(pl) and matchId == myMatch then
					toBattle(pl)
				end
			end)
		end
	end
	if #Economy.MatchPlayers() == 0 then
		resetMatch()
		return false, "Никого нет в очереди"
	end
	notifyAll({ Type = "Toast", Text = "🎃 Хэллоуин-матч начался (" .. D.Name .. ")", Kind = "good" })
	return true
end

function Match.Debug()
	local d = Sim.Debug()
	d.Mode = function()
		return mode, roster
	end
	d.Phase = function()
		return phase
	end
	d.Reset = resetMatch
	return d
end

function Match.Init(ctx)
	Remotes, State, Sim, Data, Economy = ctx.Remotes, ctx.State, ctx.Sim, ctx.Data, ctx.Economy
	Maps = ctx.Maps or {}
	Sim.Hooks.OnKill = onKill
	Sim.Hooks.OnCore = function(_, dmg)
		damageCore(dmg)
	end
	setState("MaxWave", S.MaxWave)
	setState("CoreMaxHP", S.CoreMaxHP)
	setState("CoreHP", S.CoreMaxHP)
	setState("BossId", 0)
	setState("BossName", "")
	resetMatch()
	RunService.Heartbeat:Connect(step)
end

return Match
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX4251576929C1D8B6BAE32465099F2767">
				<Properties>
					<string name="Name">Queue</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Queue
-- Очередь Хэллоуин-матча на 4 светящихся квадратах острова (хост = первый, выбирает сложность),
-- отсчёт 15 с (СТАРТ хоста — 3 с), порталы лобби ↔ остров.
-- State: HQ_Members (DisplayName через \n), HQ_Ids (UserId через ","), HQ_Count, HQ_Host, HQ_Diff, HQ_At, HQ_Busy.

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Q = Config.HalloweenIsland.Queue
local CENTER = Config.HalloweenIsland.Center + Q.Offset
local HALF = Q.Pad / 2 + 0.4
local TICK = 0.25

local Queue = {}

local Match, State
local queue = {} -- игроки по порядку входа; queue[1] — хост
local difficulty = "Easy"
local countdownAt = 0 -- серверное время телепорта (0 — нет отсчёта)
local leftUntil = {} -- player -> true: вышел кнопкой, вернётся только сойдя с квадратов

local function now()
	return workspace:GetServerTimeNow()
end

local function onPad(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local p = root.Position
	if math.abs(p.Y - CENTER.Y) > 9 then
		return false
	end
	for _, off in ipairs(Q.Pads) do
		local c = CENTER + off
		if math.abs(p.X - c.X) <= HALF and math.abs(p.Z - c.Z) <= HALF then
			return true
		end
	end
	return false
end

local function publish()
	local names, ids = {}, {}
	for i, pl in ipairs(queue) do
		names[i] = pl.DisplayName
		ids[i] = tostring(pl.UserId)
	end
	State:SetAttribute("HQ_Members", table.concat(names, "\n"))
	State:SetAttribute("HQ_Ids", table.concat(ids, ","))
	State:SetAttribute("HQ_Count", #queue)
	State:SetAttribute("HQ_Host", queue[1] and queue[1].UserId or 0)
	State:SetAttribute("HQ_Diff", difficulty)
	State:SetAttribute("HQ_At", countdownAt)
	State:SetAttribute("HQ_Busy", not Match.CanStartHalloween())
end

local function remove(player)
	local i = table.find(queue, player)
	if i then
		table.remove(queue, i)
		if i == 1 then
			difficulty = "Easy" -- новый хост выбирает заново
		end
	end
	return i ~= nil
end

local function tick()
	local t = now()
	for i = #queue, 1, -1 do
		local pl = queue[i]
		if not pl.Parent or pl:GetAttribute("InMatch") or not onPad(pl) then
			remove(pl)
		end
	end
	for _, pl in ipairs(Players:GetPlayers()) do
		if not table.find(queue, pl) and not pl:GetAttribute("InMatch") then
			local standing = onPad(pl)
			if leftUntil[pl] and not standing then
				leftUntil[pl] = nil
			end
			if standing and not leftUntil[pl] and #queue < Q.MaxPlayers then
				queue[#queue + 1] = pl
				Match.Toast(pl, "Ты в очереди Хэллоуин-матча (" .. #queue .. "/" .. Q.MaxPlayers .. ")", "good")
			end
		end
	end
	if #queue == 0 or not Match.CanStartHalloween() then
		countdownAt = 0
	elseif countdownAt == 0 then
		countdownAt = t + Q.Countdown
	elseif t >= countdownAt then
		local list, diff = table.clone(queue), difficulty
		queue, countdownAt, difficulty = {}, 0, "Easy"
		local ok, err = Match.StartHalloween(list, diff)
		if not ok then
			for _, pl in ipairs(list) do
				Match.Toast(pl, err or "Не удалось начать матч", "error")
			end
		end
	end
	publish()
end
Queue._tick = tick

function Queue._queue()
	return queue, difficulty, countdownAt
end

function Queue.SetDifficulty(player, diff)
	if queue[1] ~= player then
		return false, "Сложность выбирает хост (первый в очереди)"
	end
	if type(diff) ~= "string" or not table.find(Config.Halloween.Difficulties, diff) then
		return false, "Неверная сложность"
	end
	difficulty = diff
	publish()
	return true
end

function Queue.StartNow(player)
	if queue[1] ~= player then
		return false, "Начать может только хост"
	end
	if countdownAt == 0 then
		return false, "Арена занята — подожди окончания матча"
	end
	countdownAt = math.min(countdownAt, now() + Q.StartNow)
	publish()
	return true
end

-- silent = игрок уходит с сервера: только убрать из очереди
function Queue.Leave(player, silent)
	if silent then
		remove(player)
		leftUntil[player] = nil
		if State then
			publish()
		end
		return true
	end
	if not remove(player) then
		return false, "Ты не в очереди"
	end
	leftUntil[player] = true
	Match.Teleport(player, CENTER + Vector3.new(0, 0, 16))
	publish()
	return true
end

-- портал лобби ↔ остров (сервер проверяет, что игрок рядом с порталом)
function Queue.Teleport(player, where)
	if player:GetAttribute("InMatch") then
		return false, "Сначала выйди из матча"
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false, "Персонаж не загружен"
	end
	local zone, center
	if where == "Halloween" then
		zone, center = Config.Lobby.Zones.HalloweenPortal, Config.Lobby.Center
	elseif where == "Lobby" then
		zone, center = Config.HalloweenIsland.Zones.ReturnPortal, Config.HalloweenIsland.Center
	else
		return false, "Неверный портал"
	end
	local p, c = root.Position, center + zone.Offset
	local d = Vector2.new(p.X - c.X, p.Z - c.Z).Magnitude
	if d > zone.Radius + 8 then
		return false, "Подойди к порталу"
	end
	Match.ToLobby(player, where == "Halloween")
	return true
end

function Queue.Init(match, state)
	Match, State = match, state
	publish()
	task.spawn(function()
		while true do
			task.wait(TICK)
			local ok, err = pcall(tick)
			if not ok then
				warn("[VOID TD] Queue: " .. tostring(err))
			end
		end
	end)
end

return Queue
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0B6513452A4028D4E659B491456E30A0">
				<Properties>
					<string name="Name">Router</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Router
-- Обработчики Request(action, data) для всех Net.Actions: проверка аргументов, лимит 25 запросов/с,
-- pcall + текст ошибки (клиент показывает его тостом), покупки (ProcessReceipt), рассылка профиля.

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))
local Net = require(Shared:WaitForChild("Net"))

local Router = {}

local RATE = 25 -- запросов за окно 1 с
local PUSH_EVERY = 5

local Remotes, Data, Match, Sim, Queue
local budget = {} -- player -> { Start, Count }
local last = {} -- player -> { Gems, Coins } последнего отправленного профиля

local function allow(player)
	local now = os.clock()
	local b = budget[player]
	if not b or now - b.Start > 1 then
		budget[player] = { Start = now, Count = 1 }
		return true
	end
	b.Count += 1
	return b.Count <= RATE
end

function Router.PushProfile(player)
	local snap = Data.Snapshot(player)
	if snap then
		last[player] = { Gems = snap.Gems, Coins = snap.HalloweenCoins }
		Remotes.Profile:FireClient(player, snap)
	end
end

local function tbl(data)
	return type(data) == "table" and data or nil
end

-- uid: число или строка-число (клиент шлёт {Uid} или сам uid)
local function uidOf(data)
	local v = tbl(data) and data.Uid or data
	v = tonumber(v)
	if not v or v ~= v or v % 1 ~= 0 then
		return nil
	end
	return v
end

local function str(v, maxLen)
	return type(v) == "string" and #v <= (maxLen or 64) and v or nil
end

local function bad()
	return false, "Неверный запрос"
end

-- ok -> профиль клиенту
local function withPush(player, ok, res)
	if ok then
		Router.PushProfile(player)
	end
	return ok, res
end

local function shopItem(key)
	local found
	for _, it in ipairs(Config.Shop) do
		if it.Key == key then
			found = it -- как в legacy: берётся последний с этим ключом
		end
	end
	return found
end

local handlers = {}

function handlers.GetProfile(player)
	return true, Data.Snapshot(player)
end

function handlers.GetEnemies()
	return true, Sim.EnemySnapshot()
end

function handlers.Place(player, data)
	data = tbl(data)
	if not data or not str(data.Unit) or typeof(data.Position) ~= "Vector3" then
		return bad()
	end
	local ok, why = Match.CanPlace(player)
	if not ok then
		return false, why
	end
	return Sim.PlaceUnit(player, data.Unit, data.Position, data.Rotation)
end

function handlers.Upgrade(player, data)
	local uid = uidOf(data)
	if not uid then
		return bad()
	end
	return Sim.UpgradeUnit(player, uid)
end

function handlers.Sell(player, data)
	local uid = uidOf(data)
	if not uid then
		return bad()
	end
	return Sim.SellUnit(player, uid)
end

function handlers.SetTarget(player, data)
	data = tbl(data)
	local uid = data and uidOf(data)
	if not uid or not str(data.Mode) then
		return bad()
	end
	return Sim.SetTargetMode(player, uid, data.Mode)
end

function handlers.JoinMatch(player, data)
	return Match.JoinMatch(player, tbl(data) and str(data.Difficulty) or nil)
end

function handlers.LeaveMatch(player)
	return Match.LeaveMatch(player)
end

function handlers.GetMatchInfo()
	return true, Match.GetMatchInfo()
end

function handlers.SetLite(player, data)
	local prof = Data.Get(player)
	prof.Settings = prof.Settings or {}
	prof.Settings.Lite = (tbl(data) and data.On == true) or nil
	Data.Save(player)
	return true
end

function handlers.ClaimDaily(player)
	return withPush(player, Data.ClaimDaily(player))
end

function handlers.BuyGems(player, data)
	local item = tbl(data) and str(data.Key) and shopItem(data.Key)
	if not item then
		return false, "Неизвестный товар"
	end
	if (item.ProductId or 0) > 0 then
		MarketplaceService:PromptProductPurchase(player, item.ProductId)
		return true, "prompt"
	end
	if Config.Settings.ShopTestMode and RunService:IsStudio() then
		Data.GrantPurchase(player, item.Gems, nil)
		Router.PushProfile(player)
		return true, item.Gems
	end
	return false, "Товар не настроен: укажи ProductId в Config.Shop"
end

function handlers.StartWave(player)
	return Match.RequestStartWave(player)
end

function handlers.Summon(player, data)
	data = tbl(data)
	local count = (data and data.Count == 10) and 10 or 1
	local caseId = data and str(data.Case) or "VoidCase"
	return withPush(player, Data.Summon(player, caseId, count))
end

function handlers.Equip(player, data)
	data = tbl(data)
	if not data then
		return bad()
	end
	if data.Unit ~= nil and not str(data.Unit) then
		return bad()
	end
	return withPush(player, Data.Equip(player, data.Unit, data.Slot))
end

function handlers.EquipRune(player, data)
	data = tbl(data)
	if not data or not str(data.Unit) then
		return bad()
	end
	if data.Rune ~= nil and not str(data.Rune) then
		return bad() -- legacy молча снимал руну; теперь только явный nil снимает
	end
	return withPush(player, Data.EquipRune(player, data.Unit, data.Rune))
end

function handlers.Teleport(player, data)
	return Queue.Teleport(player, tbl(data) and str(data.To) or nil)
end

function handlers.QueueDifficulty(player, data)
	return Queue.SetDifficulty(player, tbl(data) and str(data.Difficulty) or nil)
end

function handlers.QueueStart(player)
	return Queue.StartNow(player)
end

function handlers.QueueLeave(player)
	return Queue.Leave(player)
end

Router.Handlers = handlers

local function dispatch(player, action, data)
	if not allow(player) then
		return false, "Слишком много запросов"
	end
	if not Data.Get(player) then
		return false, "Профиль ещё загружается"
	end
	local h = Net.IsAction(action) and handlers[action]
	if not h then
		return false, "Неизвестное действие"
	end
	local ok, a, b = pcall(h, player, data)
	if not ok then
		warn("[VOID TD] Ошибка обработки " .. tostring(action) .. ": " .. tostring(a))
		return false, "Ошибка сервера"
	end
	return a, b
end
Router.Dispatch = dispatch

-- покупка за Robux: выдаём только после сохранения в DataStore
local function processReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player or not Data.Get(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	for _, it in ipairs(Config.Shop) do
		if it.ProductId == info.ProductId then
			local saved, already = Data.GrantPurchase(player, it.Gems, info.PurchaseId)
			if not saved then
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
			if not already then
				Router.PushProfile(player)
				Remotes.Notify:FireClient(player, { Type = "Purchase", Gems = it.Gems })
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

function Router.PlayerRemoving(player)
	budget[player] = nil
	last[player] = nil
end

function Router.Init(ctx)
	Remotes, Data, Match, Sim, Queue = ctx.Remotes, ctx.Data, ctx.Match, ctx.Sim, ctx.Queue
	Remotes.Request.OnServerInvoke = dispatch
	MarketplaceService.ProcessReceipt = processReceipt
	-- кристаллы/монеты меняются наградами без явной рассылки — догоняем раз в 5 с
	task.spawn(function()
		while true do
			task.wait(PUSH_EVERY)
			for _, p in ipairs(Players:GetPlayers()) do
				local prof = Data.Get(p)
				local l = last[p]
				if prof and (not l or l.Gems ~= prof.Gems or l.Coins ~= prof.HalloweenCoins) then
					Router.PushProfile(p)
					Data.Save(p)
				end
			end
		end
	end)
end

return Router
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX3A0CFBE516CA358EB4DDA3B13CDCBA17">
				<Properties>
					<string name="Name">Sim</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Sim
-- Ядро боя на сервере: враги, юниты, союзники, зоны, урон. Матч (Match) управляет фазами и вызывает Sim.Step.
-- Дочерние модули (Enemies Units Attacks Abilities Allies Runes) — `return function(Sim) ... end`,
-- добавляют свои функции в таблицу Sim и пользуются общим состоянием (Sim.enemies, Sim.units, ...).
--
-- API
--   Sim.Init({ Remotes, State, UnitsFolder, Maps = {Void, Halloween}, Data, Economy })
--   Sim.Configure({ D = difficulty, Mode = "Void"|"Halloween", Wave = n, Running = bool })
--   Sim.Clear()  Sim.ClearEnemies()  Sim.Step(t, dt, simulate?)
--   Sim.SpawnEnemy(typeId, startDist?, lateral?) -> e ; Sim.HasEnemies() ; Sim.EnemySnapshot()
--   Sim.PlaceUnit / UpgradeUnit / SellUnit / SetTargetMode / RemovePlayerUnits
--   Sim.Hooks.OnKill(e, reward), Sim.Hooks.OnCore(e, damage)   (ставит Match)
--   Sim.Debug() -> { Units, Enemies, Allies(), Spawn, Now }
-- Таблицы enemies/units/allies/zones никогда не пересоздаются (очистка на месте) — ссылки из Debug не устаревают.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))
local Path = require(Shared:WaitForChild("Path"))

local Sim = {}
Sim.Config = Config
Sim.Path = Path
Sim.S = Config.Settings
Sim.Hooks = {}
Sim.rng = Random.new()

-- состояние
Sim.enemies = {}   -- Id -> враг (только живые)
Sim.units = {}     -- Uid -> юнит
Sim.allies = {}    -- Id -> союзник
Sim.zones = {}     -- зоны урона (яд, чёрная дыра)
Sim.pending = {}   -- отложенные спавны { type, count, startDist, fxPos, fxKind }
Sim.dmgBuf = {}    -- { id, amount, flag }
Sim.rmBuf = {}     -- { id, reason }
Sim.allyRm = {}    -- { allyId, reason }
Sim.ids = { Enemy = 0, Unit = 0, Ally = 0 }
Sim.gen = 0        -- поколение матча: отложенные удары прошлого матча не срабатывают
Sim.D = Config.Difficulties.Medium
Sim.Mode = "Void"
Sim.Wave = 0
Sim.Running = false -- бой идёт (Prep / Wave / Intermission)
Sim.echo = false   -- true, пока синхронно выполняется повтор атаки «Призрачной короны»

local lastSync, lastFlush = 0, 0
local IDLE_SYNC = 1 -- вне боя пустой Sync не чаще раза в секунду

function Sim.now()
	return workspace:GetServerTimeNow()
end

function Sim.Impact(payload)
	Sim.Remotes.Impact:FireAllClients(payload)
end

function Sim.Attack(payload)
	Sim.Remotes.Attack:FireAllClients(payload)
end

-- юнит жив и матч тот же
function Sim.Valid(u, gen)
	return u.Alive and Sim.gen == gen
end

-- отложенный вызов с проверкой юнита и поколения
function Sim.Later(u, delay, fn)
	local gen = Sim.gen
	task.delay(delay, function()
		if Sim.Valid(u, gen) then
			fn()
		end
	end)
end

for _, name in ipairs({ "Enemies", "Allies", "Attacks", "Abilities", "Runes", "Units" }) do
	require(script:WaitForChild(name))(Sim)
end

function Sim.Init(ctx)
	Sim.Remotes = ctx.Remotes
	Sim.State = ctx.State
	Sim.UnitsFolder = ctx.UnitsFolder
	Sim.Maps = ctx.Maps or {}
	Sim.Data = ctx.Data
	Sim.Economy = ctx.Economy
end

function Sim.Configure(o)
	if o.D then
		Sim.D = o.D
	end
	if o.Mode and o.Mode ~= Sim.Mode then
		Sim.Mode = o.Mode
	end
	if o.Mode then
		Path.SetMap(o.Mode)
	end
	if o.Wave then
		Sim.Wave = o.Wave
	end
	if o.Running ~= nil then
		Sim.Running = o.Running
		if not o.Running then
			table.clear(Sim.pending)
		end
	end
end

-- всё убрать: враги ("clear"), юниты (их союзники — "sold"), сироты-союзники ("clear"), зоны
function Sim.Clear()
	Sim.gen += 1
	Sim.ClearEnemies()
	for _, u in pairs(Sim.units) do
		Sim.RemoveUnit(u)
	end
	table.clear(Sim.units)
	for _, a in pairs(Sim.allies) do
		Sim.RemoveAlly(a, "clear")
	end
	table.clear(Sim.allies)
	Sim.Wave = 0
end

local function sync(t)
	local al
	if next(Sim.allies) or #Sim.allyRm > 0 then
		al = Sim.AllySyncList()
	end
	Sim.Remotes.Sync:FireAllClients({
		T = t,
		E = Sim.EnemySyncList(t),
		DMG = Sim.dmgBuf,
		RM = Sim.rmBuf,
		AL = al,
		RA = #Sim.allyRm > 0 and Sim.allyRm or nil,
	})
	Sim.dmgBuf = {}
	Sim.rmBuf = {}
	Sim.allyRm = {}
end

-- simulate = false: бой стоит (Idle / Victory / Defeat), только рассылка
function Sim.Step(t, dt, simulate)
	if simulate == nil then
		simulate = Sim.Running
	end
	if simulate then
		Sim.UpdateEnemies(t, dt)
		Sim.UpdateAllies(t, dt)
		Sim.UpdateZones(t)
		Sim.UpdateDots(t)
		Sim.UpdateUnits(t)
	end
	local busy = simulate or next(Sim.enemies) or #Sim.dmgBuf > 0 or #Sim.rmBuf > 0 or #Sim.allyRm > 0
	if t - lastSync >= (busy and Sim.S.SyncRate or IDLE_SYNC) then
		lastSync = t
		sync(t)
	end
	if t - lastFlush >= 1 then
		lastFlush = t
		for _, u in pairs(Sim.units) do
			u.Folder:SetAttribute("Damage", math.floor(u.DamageDealt))
		end
	end
end

function Sim.Debug()
	return {
		Units = Sim.units,
		Enemies = Sim.enemies,
		Allies = function()
			return Sim.allies
		end,
		Zones = Sim.zones,
		Spawn = Sim.SpawnEnemy,
		Now = Sim.now,
	}
end

return Sim
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX88F5CC1786160495755941F07E51E4C0">
					<Properties>
						<string name="Name">Abilities</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Sim.Abilities
-- Способности юнитов: Чёрная дыра, Кровавая луна, зоны урона (яд / чума), Power (Хэллоуин: способность
-- вместо каждой N-й атаки), способности времени Проклятого часовщика (Поломка, Ускорение, Буря).

return function(Sim)
	local Path, S = Sim.Path, Sim.S
	local enemies, units, zones = Sim.enemies, Sim.units, Sim.zones
	local flat = Path.FlatDistance

	local STORM_FX_RADIUS = 6 -- радиус визуального вихря вокруг часовщика (не боевой)

	------------------------------------------------------------------------
	-- ЗОНЫ
	------------------------------------------------------------------------
	-- ядовитая/огненная зона: урон раз в 0.5 с всем внутри
	function Sim.PoisonZone(u, pos, radius, duration, dps, kind, delay)
		if not dps or dps <= 0 then
			return
		end
		local t = Sim.now() + (delay or 0)
		zones[#zones + 1] = {
			Pos = pos, Radius = radius, Until = t + duration, NextTick = t, Tick = 0.5,
			TickDamage = dps * 0.5, Slow = 0, Unit = u,
		}
		Sim.Impact({ K = kind, P = pos, R = radius, DUR = duration, DL = delay, U = u.Uid, L = u.Level })
	end

	function Sim.UpdateZones(t)
		for i = #zones, 1, -1 do
			local z = zones[i]
			if t >= z.Until or not z.Unit.Alive then
				table.remove(zones, i)
			elseif t >= z.NextTick then
				z.NextTick += z.Tick
				for _, e in pairs(enemies) do
					if e.Alive and flat(e.Pos, z.Pos) <= z.Radius then
						if z.Slow and z.Slow > 0 then
							-- как обычное замедление: сильнейшее и самое долгое (не обрезает чужое)
							local slow = z.Slow * (e.IsBoss and S.BossSlowResist or 1)
							e.SlowAmount = math.max(e.SlowUntil > t and e.SlowAmount or 0, slow)
							e.SlowUntil = math.max(e.SlowUntil, t + z.Tick + 0.15)
						end
						Sim.DamageEnemy(e, z.TickDamage, false, z.Unit, true)
					end
				end
			end
		end
	end

	------------------------------------------------------------------------
	-- ЧЁРНАЯ ДЫРА / КРОВАВАЯ ЛУНА
	------------------------------------------------------------------------
	function Sim.CastBlackHole(u, stats, list)
		local bh = stats.BlackHole
		local target = list[1]
		local pos = Path.PositionAt(math.min(target.Dist + 4, Path.Length - 1))
		local t = Sim.now()
		zones[#zones + 1] = {
			Pos = pos, Radius = bh.Radius, Until = t + 0.6 + bh.Duration, NextTick = t + 0.6,
			Tick = bh.Tick, TickDamage = bh.TickDamage, Slow = bh.Slow, Unit = u,
		}
		Sim.Attack({ U = u.Uid, T = { target.Id }, L = u.Level, D = 0.6, AB = true })
		Sim.Impact({ K = "BlackHole", P = pos, R = bh.Radius, L = u.Level, U = u.Uid, DUR = bh.Duration, DL = 0.6 })
	end

	function Sim.CastBloodMoon(u, stats, list)
		local bm = stats.BloodMoon
		local target = list[1]
		local pos = Path.PositionAt(math.min(target.Dist + 3, Path.Length - 1))
		Sim.Attack({ U = u.Uid, T = { target.Id }, L = u.Level, D = 0.6, AB = true })
		Sim.Impact({ K = "BloodMoonFall", P = pos, R = bm.Radius, L = u.Level, U = u.Uid, DL = 1.0 })
		Sim.Later(u, 1.0, function()
			local big = { Damage = stats.Damage * (bm.Mult or 3) }
			Sim.AoeHit(u, pos, bm.Radius, big, "BloodMoon", { Bleed = bm.Bleed, BleedTime = bm.BleedTime })
		end)
	end

	------------------------------------------------------------------------
	-- POWER: способность вместо каждой N-й обычной атаки (руны не срабатывают)
	------------------------------------------------------------------------
	function Sim.CastPower(u, stats, list)
		local P = u.Def.Power
		local target = list[1]
		local delay = P.Delay or 0.45
		local saved = target.Pos
		-- длинная анимация способности не обрывается следующей атакой
		u.NextAttack = math.max(u.NextAttack, Sim.now() + delay + 0.25)
		Sim.Attack({ U = u.Uid, T = { target.Id }, L = u.Level, D = delay, AB = P.Anim })
		Sim.Later(u, delay, function()
			local center = target.Alive and target.Pos or saved
			if P.Mode == "Single" then
				local e = target.Alive and target or Sim.Candidates(u, stats.Range + 2)[1]
				if not e then
					return
				end
				Sim.Impact({ K = P.Kind, P = e.Pos, I = e.Id, U = u.Uid, L = u.Level, DUR = P.MarkTime })
				-- метка до урона: этот удар уже усилен
				if P.Mark then
					e.Mark = P.Mark
					e.MarkUntil = Sim.now() + (P.MarkTime or 3)
				end
				local dmg = Sim.RollDamage(stats)
				Sim.DamageEnemy(e, dmg * (P.Mult or 1), true, u)
			elseif P.Mode == "Zone" then
				local radius = (stats.Explode or 5) * (P.RadiusMult or 1.5)
				Sim.AoeHit(u, center, radius, stats, P.Kind .. "Burst", { Mult = 0.5 })
				Sim.PoisonZone(u, center, radius, P.Duration or 5, (stats.PoisonDps or stats.Damage * 0.3) * (P.Mult or 1), P.Kind)
			else
				local radius = stats.PowerRadius or P.Radius or ((stats.AOERadius or 5) + (P.RadiusAdd or 0))
				if P.Mode == "Self" then
					center = u.Pos
					radius = stats.PowerRadius or P.Radius or ((stats.AOERadius or stats.Range) + (P.RadiusAdd or 1))
				end
				Sim.AoeHit(u, center, radius, stats, P.Kind, {
					Mult = P.Mult, Slow = P.Slow, SlowTime = P.SlowTime,
					Bleed = P.Burn and stats.Damage * P.Burn or nil, BleedTime = P.BurnTime, DotKind = "Burn",
				})
			end
		end)
	end

	------------------------------------------------------------------------
	-- СПОСОБНОСТИ ВРЕМЕНИ (Проклятый часовщик)
	------------------------------------------------------------------------
	-- Остановка не суммируется: замороженного не морозим повторно, после заморозки — иммунитет.
	-- После остановки до MaxRewind обычных врагов отматываются назад по дороге (боссы — нет).
	function Sim.CastTimeBreak(u, stats)
		local tb = u.Def.TimeBreak
		local list = Sim.Candidates(u, stats.Range + 2)
		if #list == 0 then
			return
		end
		local t = Sim.now()
		local center = list[1].Pos
		local normal, bosses = {}, {}
		for _, e in pairs(enemies) do
			if e.Alive and t >= (e.FreezeImmuneUntil or 0) and (e.FrozenUntil or 0) <= t then
				local d = flat(e.Pos, center)
				if d <= tb.Radius + (e.IsBoss and 1.5 or 0) then
					e._dc = d
					table.insert(e.IsBoss and bosses or normal, e)
				end
			end
		end
		table.sort(normal, function(a, b)
			return a._dc < b._dc
		end)
		local frozen = {}
		for i = 1, math.min(tb.MaxFreeze, #normal) do
			Sim.Freeze(normal[i], tb.Freeze, t)
			frozen[i] = normal[i]
		end
		for _, b in ipairs(bosses) do
			Sim.Freeze(b, tb.BossFreeze, t)
		end
		Sim.Attack({ U = u.Uid, T = { list[1].Id }, L = u.Level, D = 0.5, AB = "TimeBreak" })
		Sim.Impact({ K = "TimeBreak", P = center, R = tb.Radius, DUR = tb.Freeze, U = u.Uid, L = u.Level })
		Sim.Later(u, tb.Freeze, function()
			for i = 1, math.min(tb.MaxRewind, #frozen) do
				local e = frozen[i]
				if e.Alive then
					e.Dist = math.max(0, e.Dist - tb.Rewind)
					e.Pos = Sim.EnemyPos(e)
				end
			end
		end)
	end

	-- ускорение своих юнитов рядом (не самого часовщика): кулдаун / (1 + Haste), урон прежний
	function Sim.CastTimeHaste(u, stats)
		local th = u.Def.TimeHaste
		local t = Sim.now()
		local ids = {}
		for _, o in pairs(units) do
			if o ~= u and o.Alive and o.Owner == u.Owner and flat(o.Pos, u.Pos) <= th.Radius then
				-- одинаковые ускорения не суммируются: действует самое сильное
				if (o.HasteUntil or 0) > t then
					o.Haste = math.max(o.Haste or 0, stats.Haste)
				else
					o.Haste = stats.Haste
				end
				o.HasteUntil = math.max(o.HasteUntil or 0, t + stats.HasteTime)
				ids[#ids + 1] = o.Uid
			end
		end
		Sim.Attack({ U = u.Uid, T = {}, L = u.Level, D = 0.4, AB = "TimeHaste" })
		Sim.Impact({ K = "TimeHaste", P = u.Pos, R = th.Radius, A = ids, DUR = stats.HasteTime, U = u.Uid, L = u.Level })
	end

	function Sim.StartTimeStorm(u, t)
		local ts = u.Def.TimeStorm
		u.StormUntil = t + ts.Duration
		u.NextStorm = u.StormUntil + ts.Cooldown
		u.Folder:SetAttribute("Storm", true)
		Sim.Attack({ U = u.Uid, T = {}, L = u.Level, D = 1.2, AB = "TimeStorm" })
		Sim.Impact({ K = "TimeStorm", P = u.Pos, R = STORM_FX_RADIUS, DL = 1.3, U = u.Uid, L = u.Level })
	end

	function Sim.UpdateChrono(u, stats, t)
		local def = u.Def
		if def.TimeStorm then
			if u.StormUntil and t >= u.StormUntil then
				u.StormUntil = nil
				u.Folder:SetAttribute("Storm", false)
			end
			if not u.StormUntil and t >= u.NextStorm then
				Sim.StartTimeStorm(u, t)
				u.NextAttack = math.max(u.NextAttack, t + 1.4)
			end
		end
		if def.TimeHaste and t >= u.NextHaste then
			Sim.CastTimeHaste(u, stats)
			u.NextHaste = t + def.TimeHaste.Interval
			u.NextAttack = math.max(u.NextAttack, t + 0.6)
		end
	end
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX6008B2D4C2CFBDC60A61B716A59355B2">
					<Properties>
						<string name="Name">Allies</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Sim.Allies
-- Союзники (призывы Кукловода / Иллюзиониста и руны «Проклятые нити»): идут по дороге от базы к порталу.
-- HP союзника — запас урона: при столкновении враг теряет min(HP/стоимость, HP врага), союзник — это × стоимость
-- (стоимость = FireAura врага, иначе 1). Отдельного события спавна нет: клиент узнаёт из Impact (A) и Sync (AL).

return function(Sim)
	local Config, Path, S = Sim.Config, Sim.Path, Sim.S
	local allies, enemies = Sim.allies, Sim.enemies
	local rng = Sim.rng

	local allyIndex = {}
	for i, id in ipairs(Config.AllyOrder or {}) do
		allyIndex[id] = i
	end

	local function startBack()
		return S.AllyStartBack or 4
	end

	-- точка появления союзников (у базы)
	function Sim.AllyGate()
		return (Path.PositionAt(Path.Length - startBack()))
	end

	function Sim.SpawnAlly(u, allyId, hp, source, index)
		Sim.ids.Ally += 1
		local a = {
			Id = Sim.ids.Ally,
			AllyId = allyId,
			HP = hp,
			MaxHP = hp,
			Dist = math.max(1, Path.Length - startBack() - (index or 0) * 2.2),
			Lateral = rng:NextNumber(-1.6, 1.6),
			Speed = S.AllySpeed or 6,
			Owner = u,
			Source = source,
			Born = Sim.now(),
			Alive = true,
		}
		a.Pos = Path.OffsetPositionAt(a.Dist, a.Lateral)
		allies[a.Id] = a
		return a
	end

	function Sim.RemoveAlly(a, reason)
		if not a.Alive then
			return
		end
		a.Alive = false
		allies[a.Id] = nil
		Sim.allyRm[#Sim.allyRm + 1] = { a.Id, reason }
	end

	-- живые союзники юнита из источника, от старых к новым
	function Sim.AlliesOf(u, source)
		local list = {}
		for _, a in pairs(allies) do
			if a.Owner == u and (source == nil or a.Source == source) then
				list[#list + 1] = a
			end
		end
		table.sort(list, function(x, y)
			return x.Id < y.Id
		end)
		return list
	end

	-- Призыв Кукловода / Иллюзиониста: не больше Max живых, лишние не появляются
	function Sim.CastSummon(u, t)
		local sm = u.Def.Summon
		local lv = sm.Levels[math.min(u.Level, #sm.Levels)]
		u.NextSummon = t + lv.Interval
		local count = math.min(lv.Count, sm.Max - #Sim.AlliesOf(u, "Summon"))
		if count <= 0 then
			return
		end
		u.SummonCount = (u.SummonCount or 0) + 1
		local golden = sm.Golden ~= nil and u.Level >= #u.Def.Levels and u.SummonCount % sm.Golden.Every == 0
		local ids = {}
		for i = 1, count do
			local a
			if golden and i == 1 then
				a = Sim.SpawnAlly(u, sm.Golden.Ally, sm.Golden.HP, "Summon", i - 1)
			else
				a = Sim.SpawnAlly(u, lv.Ally, lv.HP, "Summon", i - 1)
			end
			ids[i] = a.Id
		end
		Sim.Attack({ U = u.Uid, T = {}, L = u.Level, D = 0.6, AB = "Summon" })
		Sim.Impact({ K = "SummonPortal", S = sm.Portal, P = Sim.AllyGate(), U = u.Uid, L = u.Level, A = ids, G = golden or nil })
	end

	-- ближайшие по дороге враги — первыми (при большом dt столкновения в правильном порядке)
	local hits = {}
	local function byGap(x, y)
		return x._gap < y._gap
	end

	function Sim.UpdateAllies(t, dt)
		for _, a in pairs(allies) do
			if a.Alive then
				a.Dist -= a.Speed * dt
				if a.Dist <= 0 then
					Sim.RemoveAlly(a, "portal")
				else
					a.Pos = Path.OffsetPositionAt(a.Dist, a.Lateral)
					-- столкновение: враг дошёл до союзника (окно с запасом для большого dt)
					table.clear(hits)
					for _, e in pairs(enemies) do
						if e.Alive and e.Dist >= a.Dist - 1.4 - (e.IsBoss and 1.2 or 0) and e.Dist <= a.Dist + 3 then
							e._gap = math.abs(e.Dist - a.Dist)
							hits[#hits + 1] = e
						end
					end
					if #hits > 1 then
						table.sort(hits, byGap)
					end
					for _, e in ipairs(hits) do
						if e.Alive then
							local cost = e.Def.FireAura or 1
							local dealt = Sim.RawDamage(e, math.min(a.HP / cost, e.Health), a.Owner)
							a.HP -= dealt * cost
							Sim.Impact({ K = "AllyHit", P = a.Pos, I = a.Id, E = e.Id, F = cost > 1 or nil })
							if a.HP <= 0.5 or dealt <= 0 then
								Sim.RemoveAlly(a, "dead")
								break
							end
						end
					end
					table.clear(hits)
				end
			end
		end
	end

	function Sim.AllySyncList()
		local al = {}
		for _, a in pairs(allies) do
			al[#al + 1] = a.Id
			al[#al + 1] = math.floor(a.Dist * 100) / 100
			al[#al + 1] = math.floor(a.HP + 0.5)
			al[#al + 1] = allyIndex[a.AllyId] or 1
			al[#al + 1] = a.MaxHP
		end
		return al
	end
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXF202B2D4962D3ACD4EF4489C054595E3">
					<Properties>
						<string name="Name">Attacks</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Sim.Attacks
-- Обычные атаки юнитов по AttackType: Melee/Laser, Projectile, Chain, Thread, AOE, MultiHit, Splash,
-- Chrono, Pulse, Flask, Pierce. Урон считается на сервере с задержкой удара; клиент получает Attack/Impact.
-- Sim.echo = true во время синхронной части повтора «Призрачной короны» (EC в Attack, без счётчиков).

return function(Sim)
	local Path = Sim.Path
	local enemies = Sim.enemies
	local rng = Sim.rng
	local flat = Path.FlatDistance

	local function fireAttack(u, targetIds, extra)
		local payload = { U = u.Uid, T = targetIds, L = u.Level, EC = Sim.echo or nil }
		if extra then
			for k, v in pairs(extra) do
				payload[k] = v
			end
		end
		Sim.Attack(payload)
	end

	-- AOE: каждый враг получает урон ровно один раз за удар.
	-- opts: Exclude, Mult, Bleed/BleedTime/DotKind, Slow/SlowTime, Extra (доп. поля события)
	-- Кровотечение и замедление не накладываются, если удар был уклонён.
	function Sim.AoeHit(u, center, radius, stats, kind, opts)
		opts = opts or {}
		local hitSet = {}
		for _, e in pairs(enemies) do
			if e.Alive and e ~= opts.Exclude and flat(e.Pos, center) <= radius + (e.IsBoss and 1.5 or 0.5) then
				hitSet[#hitSet + 1] = e
			end
		end
		local payload = { K = kind, P = center, R = radius, L = u.Level, U = u.Uid, N = #hitSet }
		if opts.Extra then
			for k, v in pairs(opts.Extra) do
				payload[k] = v
			end
		end
		Sim.Impact(payload)
		for _, e in ipairs(hitSet) do
			local dmg, crit = Sim.RollDamage(stats)
			local _, dodged = Sim.DamageEnemy(e, dmg * (opts.Mult or 1), crit, u)
			if not dodged then
				if opts.Bleed then
					Sim.ApplyDot(e, opts.Bleed, opts.BleedTime or 3, u, opts.DotKind or "Bleed")
				end
				if opts.Slow then
					Sim.ApplySlow(e, opts.Slow, opts.SlowTime or 1.5)
				end
			end
		end
		return hitSet
	end

	-- направление от юнита к цели в XZ (запасное — -Z)
	local function flatDir(from, to)
		local dir = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
		if dir.Magnitude < 0.1 then
			return Vector3.new(0, 0, -1)
		end
		return dir.Unit
	end

	-- задержка попадания обычной атаки (для рун): HitDelay + полёт снаряда
	local SPEED_DEFAULT = { Projectile = 80, Chain = 60, Flask = 45, Chrono = 70 }
	function Sim.ImpactDelay(u, target)
		local def = u.Def
		local d = def.HitDelay or 0.2
		local speed = def.ProjectileSpeed or SPEED_DEFAULT[def.AttackType]
		if speed then
			d += flat(u.Pos, target.Pos) / speed
		end
		return d
	end

	local A = {} -- AttackType -> function(u, stats, list, ctx)

	A.Melee = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		local mult, power = 1, false
		if def.EveryNth and not Sim.echo then
			u.HitCount = (u.HitCount or 0) + 1
			if u.HitCount % def.EveryNth.N == 0 then
				mult, power = def.EveryNth.Mult, true
			end
		end
		fireAttack(u, { target.Id }, { D = c.hitDelay, PW = power })
		c.later(c.hitDelay, function()
			c.strike(target, mult, power)
		end)
	end
	A.Laser = A.Melee

	A.Projectile = function(u, stats, list, c)
		local def = u.Def
		local shots = stats.Shots or 1
		local ids, travels, plan = {}, {}, {}
		for s = 1, shots do
			local e = list[((s - 1) % #list) + 1]
			plan[s] = e
			ids[s] = e.Id
			travels[s] = flat(u.Pos, e.Pos) / (def.ProjectileSpeed or 80)
		end
		fireAttack(u, ids, { D = c.hitDelay, TR = travels[1], TRS = travels, SG = 0.12 })
		for s = 1, shots do
			local e = plan[s]
			c.later(c.hitDelay + (s - 1) * 0.12 + travels[s], function()
				if not e.Alive then
					return
				end
				local center = e.Pos
				c.strike(e)
				if stats.Explode then
					Sim.AoeHit(u, center, stats.Explode, stats, def.ExplodeKind or "Crystal", { Exclude = e, Mult = def.ExplodeMult or 0.5 })
				end
			end)
		end
	end

	-- лунный серп отскакивает к ближайшим врагам
	A.Chain = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		local seq, times = { target }, {}
		local used = { [target] = true }
		local speed = def.ProjectileSpeed or 60
		times[1] = c.hitDelay + flat(u.Pos, target.Pos) / speed
		for i = 2, stats.Bounces or 3 do
			local prev = seq[i - 1]
			local best, bestD
			for _, e in pairs(enemies) do
				if e.Alive and not used[e] then
					local d = flat(e.Pos, prev.Pos)
					if d <= (def.BounceRange or 12) and (not bestD or d < bestD) then
						best, bestD = e, d
					end
				end
			end
			if not best then
				break
			end
			used[best] = true
			seq[i] = best
			times[i] = times[i - 1] + bestD / speed
		end
		local ids = {}
		for i, e in ipairs(seq) do
			ids[i] = e.Id
		end
		fireAttack(u, ids, { D = c.hitDelay, TT = times })
		for i, e in ipairs(seq) do
			c.later(times[i], function()
				c.strike(e, (def.BounceMult or 0.8) ^ (i - 1))
			end)
		end
	end

	A.Thread = function(u, stats, list, c)
		local ids, targets = {}, {}
		for i = 1, math.min(stats.Targets or 1, #list) do
			targets[i] = list[i]
			ids[i] = list[i].Id
		end
		fireAttack(u, ids, { D = c.hitDelay })
		c.later(c.hitDelay, function()
			for _, e in ipairs(targets) do
				if e.Alive and not c.strike(e) then
					Sim.ApplySlow(e, stats.Slow, stats.SlowTime or 1.5)
					Sim.ApplyDot(e, stats.Dot, stats.DotTime or 3, u, "Thread")
				end
			end
		end)
	end

	A.AOE = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		local saved = target.Pos
		fireAttack(u, { target.Id }, { D = c.hitDelay })
		c.later(c.hitDelay, function()
			local center = target.Alive and target.Pos or saved
			Sim.AoeHit(u, center, stats.AOERadius or 6, stats, def.ImpactKind or "Reap", { Bleed = stats.Bleed, BleedTime = stats.BleedTime })
			-- падающие звёздные осколки
			for k = 1, stats.Shards or 0 do
				c.later(0.35 + k * 0.15, function()
					local pool = Sim.Candidates(u, stats.Range + 4)
					if #pool > 0 then
						local e = pool[rng:NextInteger(1, #pool)]
						Sim.AoeHit(u, e.Pos, stats.ShardRadius or 4, stats, "Shard", { Mult = stats.ShardMult or 0.6 })
					end
				end)
			end
		end)
	end

	A.MultiHit = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		local hits = stats.Hits or 1
		local interval = def.HitInterval or 0.15
		local spread = def.Spread or (u.Id == "VoidEmperor")
		local kind = def.ImpactKind or "Judgement"
		local ids, plan = {}, {}
		for h = 1, hits do
			local e = spread and list[((h - 1) % #list) + 1] or target
			plan[h] = e
			ids[h] = e.Id
		end
		fireAttack(u, ids, { D = c.hitDelay, I = interval })
		for h = 1, hits do
			c.later(c.hitDelay + (h - 1) * interval, function()
				local e = plan[h]
				if not e.Alive then
					e = Sim.Candidates(u, stats.Range)[1]
				end
				if e then
					if spread then
						Sim.Impact({ K = kind, P = e.Pos, L = u.Level, U = u.Uid, H = h })
					end
					c.strike(e)
				end
			end)
		end
		if stats.BigRift then
			c.later(c.hitDelay + hits * interval + 0.2, function()
				local pool = Sim.Candidates(u, stats.Range)
				if #pool > 0 then
					Sim.AoeHit(u, pool[1].Pos, stats.BigRift, stats, "BigRift", { Mult = stats.BigRiftMult or 1.5 })
				end
			end)
		end
	end

	-- RED SPLASH: цель 100%, остальные в радиусе 50% (цель второй раз не задевается)
	A.Splash = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		fireAttack(u, { target.Id }, { D = c.hitDelay })
		local saved = target.Pos
		c.later(c.hitDelay, function()
			local center = target.Alive and target.Pos or saved
			if target.Alive then
				c.strike(target)
			end
			Sim.AoeHit(u, center, stats.AOERadius or 8, stats, "Splash", { Exclude = target, Mult = def.SplashMult or 0.5 })
		end)
	end

	-- РАЗРЕЗ СЕКУНД: зубчатый диск летит по прямой и режет до DiscTargets врагов (только впереди юнита)
	A.Chrono = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		local t0 = Sim.now()
		local storm = u.StormUntil ~= nil and t0 < u.StormUntil
		local dir = flatDir(u.Pos, target.Pos)
		local endPos = u.Pos + dir * (stats.Range + 3)
		local speed = def.ProjectileSpeed or 70
		local half = (def.DiscWidth or 3) / 2
		local line = {}
		for _, e in pairs(enemies) do
			if e.Alive and e ~= target and Sim.DistToSegment(e.Pos, u.Pos, endPos) <= half + (e.IsBoss and 1.2 or 0) then
				e._along = (e.Pos.X - u.Pos.X) * dir.X + (e.Pos.Z - u.Pos.Z) * dir.Z
				if e._along >= 0 then
					line[#line + 1] = e
				end
			end
		end
		table.sort(line, function(a, b)
			return a._along < b._along
		end)
		local hits = { target }
		local hitSet = { [target] = true }
		for _, e in ipairs(line) do
			if #hits >= (def.DiscTargets or 5) then
				break
			end
			hits[#hits + 1] = e
			hitSet[e] = true
		end
		fireAttack(u, { target.Id }, { D = c.hitDelay, E = endPos, SP = speed, ST = storm or nil })
		for _, e in ipairs(hits) do
			local along = math.max(0, (e.Pos.X - u.Pos.X) * dir.X + (e.Pos.Z - u.Pos.Z) * dir.Z)
			c.later(c.hitDelay + along / speed, function()
				if e.Alive then
					Sim.Impact({ K = "ChronoHit", P = e.Pos, L = u.Level, U = u.Uid })
					c.strike(e)
				end
			end)
		end
		-- ВРЕМЕННАЯ БУРЯ: до Extra других врагов рядом с целью — по Mult (не считаются обычными атаками)
		if storm then
			local ts = def.TimeStorm
			local saved = target.Pos
			c.later(c.hitDelay + flat(u.Pos, target.Pos) / speed + 0.02, function()
				local center = target.Alive and target.Pos or saved
				local extra = Sim.NearestTo(center, ts.Radius, hitSet, ts.Extra)
				Sim.Impact({ K = "ChronoBurst", P = center, R = ts.Radius, L = u.Level, U = u.Uid })
				for _, e in ipairs(extra) do
					c.strike(e, ts.Mult)
				end
			end)
		end
		-- ПОЛОМКА ВРЕМЕНИ: после EveryNth обычных атак, но не чаще раза в MinInterval
		local tb = def.TimeBreak
		if tb and not Sim.echo then
			u.ChronoCount = (u.ChronoCount or 0) + 1
			if u.ChronoCount >= tb.EveryNth and t0 - (u.LastBreak or -1e9) >= tb.MinInterval then
				u.ChronoCount = 0
				u.LastBreak = t0
				u.NextAttack = math.max(u.NextAttack or 0, t0 + 1.6)
				c.later(c.hitDelay + 0.45, function()
					Sim.CastTimeBreak(u, stats)
				end)
			end
		end
	end

	-- звуковая волна вокруг самого юнита
	A.Pulse = function(u, stats, list, c)
		fireAttack(u, { list[1].Id }, { D = c.hitDelay })
		c.later(c.hitDelay, function()
			Sim.AoeHit(u, u.Pos, stats.AOERadius or stats.Range, stats, u.Def.ImpactKind or "BellWave")
		end)
	end

	-- колба: взрыв по области и ядовитая лужа
	A.Flask = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		local travel = flat(u.Pos, target.Pos) / (def.ProjectileSpeed or 45)
		local saved = target.Pos
		fireAttack(u, { target.Id }, { D = c.hitDelay, TR = travel })
		c.later(c.hitDelay + travel, function()
			local center = target.Alive and target.Pos or saved
			local r = stats.Explode or 5
			Sim.AoeHit(u, center, r, stats, "FlaskSplash")
			Sim.PoisonZone(u, center, r * 0.8, def.PoisonTime or 3, stats.PoisonDps or 0, "Poison")
		end)
	end

	-- луч насквозь: все враги на линии от юнита через цель
	A.Pierce = function(u, stats, list, c)
		local def, target = u.Def, list[1]
		local dir = flatDir(u.Pos, target.Pos)
		local endPos = u.Pos + dir * (stats.Range + 4)
		fireAttack(u, { target.Id }, { D = c.hitDelay, E = endPos })
		c.later(c.hitDelay, function()
			Sim.Impact({ K = def.ImpactKindPierce or "Pierce", P = u.Pos, E = endPos, L = u.Level, U = u.Uid })
			local half = (def.PierceWidth or 3) / 2
			local hitSet = {}
			for _, e in pairs(enemies) do
				if e.Alive and Sim.DistToSegment(e.Pos, u.Pos, endPos) <= half + (e.IsBoss and 1.2 or 0) then
					hitSet[#hitSet + 1] = e
				end
			end
			for _, e in ipairs(hitSet) do
				c.strike(e)
			end
		end)
	end

	-- обычная атака по списку целей (list[1] — лучшая цель)
	function Sim.DoAttack(u, stats, list)
		if not list or not list[1] then
			return
		end
		local fn = A[u.Def.AttackType]
		if not fn then
			return
		end
		local c = { hitDelay = u.Def.HitDelay or 0.2 }
		function c.later(delay, f)
			Sim.Later(u, delay, f)
		end
		-- урон + кровотечение; -> уклонился?
		function c.strike(e, mult, forceCrit)
			if not e or not e.Alive then
				return true
			end
			local dmg, crit = Sim.RollDamage(stats)
			local _, dodged = Sim.DamageEnemy(e, dmg * (mult or 1), crit or forceCrit, u)
			if not dodged and stats.Bleed then
				Sim.ApplyDot(e, stats.Bleed, stats.BleedTime or 3, u, "Bleed")
			end
			return dodged
		end
		fn(u, stats, list, c)
	end
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX83A31A66673EFD0236007D7656CEFF3A">
					<Properties>
						<string name="Name">Enemies</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Sim.Enemies
-- Враги: спавн, движение и особое поведение (фаза, щит, рывок, туман, призыв), урон и его модификаторы
-- (броня, участки брони, фаза/щит/метка), пороги HP (слом брони, ярость), DoT, замедление, заморозка,
-- выбор целей и данные для Sync.

return function(Sim)
	local Config, Path, S = Sim.Config, Sim.Path, Sim.S
	local enemies = Sim.enemies
	local rng = Sim.rng
	local flat = Path.FlatDistance

	local function enemyPos(e)
		return (Path.OffsetPositionAt(e.Dist, e.Lateral))
	end
	Sim.EnemyPos = enemyPos

	local function setState(k, v)
		if Sim.State then
			Sim.State:SetAttribute(k, v)
		end
	end

	-- полоса босса: самый «толстый» живой босс
	function Sim.RefreshBoss()
		local best
		for _, e in pairs(enemies) do
			if e.IsBoss and (not best or e.MaxHealth > best.MaxHealth) then
				best = e
			end
		end
		if best then
			setState("BossId", best.Id)
			setState("BossName", best.Def.Name)
			setState("BossMaxHP", best.MaxHealth)
		else
			setState("BossId", 0)
			setState("BossName", "")
			setState("BossMaxHP", 0)
		end
	end

	function Sim.SpawnEnemy(typeId, startDist, lateral)
		local def = Config.Enemies[typeId]
		if not def then
			return nil
		end
		Sim.ids.Enemy += 1
		local t0 = Sim.now()
		local hp = math.floor(def.Health * Config.WaveHPMult(math.max(Sim.Wave, 1)) * Sim.D.HP)
		local e = {
			Id = Sim.ids.Enemy,
			Type = typeId,
			Def = def,
			MaxHealth = hp,
			Health = hp,
			Speed = def.Speed * Sim.D.Speed,
			Dist = startDist or 0,
			Lateral = lateral or (def.IsBoss and 0 or rng:NextNumber(-2.2, 2.2)),
			Armor = def.Armor or 0,
			Dodge = def.Dodge or 0,
			IsBoss = def.IsBoss == true,
			SlowUntil = 0,
			SlowAmount = 0,
			Dots = {},
			NextDot = 0,
			Alive = true,
			Wave = Sim.Wave,
		}
		e.BaseArmor = e.Armor
		if def.Summon then
			e.NextSummon = t0 + def.Summon.Interval
		end
		if def.Phase then
			e.NextPhase = t0 + def.Phase.Every * rng:NextNumber(0.5, 1)
		end
		if def.Fog then
			e.NextFog = t0 + def.Fog.Every * rng:NextNumber(0.4, 0.8)
		end
		if def.Shield then
			e.NextShield = t0 + def.Shield.Every * 0.6
		end
		if def.Haste then
			e.NextHaste = t0 + def.Haste.Every * 0.7
		end
		e.Pos = enemyPos(e)
		enemies[e.Id] = e
		Sim.Remotes.EnemySpawn:FireAllClients({ e.Id, typeId, hp, e.Speed, e.Lateral, e.Dist })
		if e.IsBoss then
			Sim.RefreshBoss()
		end
		return e
	end

	function Sim.RemoveEnemy(e, reason)
		if not e.Alive then
			return
		end
		e.Alive = false
		enemies[e.Id] = nil
		Sim.rmBuf[#Sim.rmBuf + 1] = { e.Id, reason }
		if e.IsBoss then
			Sim.RefreshBoss()
		end
	end

	function Sim.ClearEnemies()
		for _, e in pairs(enemies) do
			e.Alive = false
			Sim.rmBuf[#Sim.rmBuf + 1] = { e.Id, "clear" }
		end
		table.clear(enemies)
		table.clear(Sim.zones)
		table.clear(Sim.pending)
		Sim.RefreshBoss()
	end

	-- враги есть, пока кто-то жив или ждёт спавна (минионы с OnDeath/Enrage)
	function Sim.HasEnemies()
		return next(enemies) ~= nil or #Sim.pending > 0
	end

	function Sim.EnemySnapshot()
		local list = {}
		for _, e in pairs(enemies) do
			list[#list + 1] = { e.Id, e.Type, e.MaxHealth, e.Speed, e.Lateral, e.Dist, e.Health }
		end
		return list
	end

	function Sim.EnemySyncList(t)
		local list = {}
		for _, e in pairs(enemies) do
			list[#list + 1] = e.Id
			list[#list + 1] = math.floor(e.Dist * 100) / 100
			list[#list + 1] = math.max(0, e.Health)
			list[#list + 1] = ((e.FrozenUntil or 0) > t) and 2 or ((e.SlowUntil > t) and 1 or 0)
		end
		return list
	end

	function Sim.EnemyState(e, state, dur)
		Sim.Impact({ K = "EnemyState", I = e.Id, S = state, DUR = dur, P = e.Pos })
	end

	local function queueSpawn(typeId, n, startDist, fxPos, fxKind)
		Sim.pending[#Sim.pending + 1] = { typeId, n, startDist, fxPos, fxKind }
	end

	------------------------------------------------------------------------
	-- УРОН
	------------------------------------------------------------------------
	-- множитель получаемого урона: фаза призрака, защита, метка проклятия
	local function takenMult(e, t)
		local m = 1
		if (e.PhasedUntil or 0) > t then
			m *= e.Def.Phase.Taken
		end
		if (e.ShieldUntil or 0) > t then
			m *= e.Def.Shield.Taken
		end
		if (e.MarkUntil or 0) > t then
			m *= 1 + (e.Mark or 0)
		end
		return m
	end

	-- броня с учётом участков дороги (Проклятый монарх)
	local function armorOf(e)
		local a = e.Armor
		local zones = e.Def.ArmorZones
		if zones then
			local f = Path.Fraction(e.Dist)
			for _, z in ipairs(zones) do
				if f >= z[1] and f <= z[2] then
					a += z[3]
				end
			end
		end
		return math.min(a, 0.9)
	end

	-- пороги HP: шкала брони, слом брони, ярость (+ подкрепление)
	local function checkThresholds(e)
		local def = e.Def
		local ratio = e.Health / e.MaxHealth
		if def.ArmorScale then
			e.Armor = e.BaseArmor * math.max(ratio, 0)
		end
		if def.ArmorBreak and not e.ArmorBroken and ratio <= def.ArmorBreak.At then
			e.ArmorBroken = true
			e.Armor = def.ArmorBreak.Armor
			Sim.EnemyState(e, "ArmorBreak")
		end
		if def.Enrage and not e.Enraged and ratio <= def.Enrage.At then
			e.Enraged = true
			e.EnrageSpeed = def.Enrage.Speed or 0
			Sim.EnemyState(e, "Enrage")
			if def.Enrage.Spawn then
				queueSpawn(def.Enrage.Spawn[1], def.Enrage.Spawn[2], math.max(e.Dist - 4, 0), e.Pos, "Fire")
			end
		end
	end

	local function killEnemy(e)
		local reward = math.floor(e.Def.Reward * (1 + S.KillRewardScalePerWave * (math.max(e.Wave, 1) - 1)) * Sim.D.Money + 0.5)
		if e.Def.OnDeath then
			queueSpawn(e.Def.OnDeath.Enemy, e.Def.OnDeath.Count, e.Dist + 1.5, e.Pos, "Straw")
		end
		Sim.RemoveEnemy(e, "kill")
		if Sim.Hooks.OnKill then
			Sim.Hooks.OnKill(e, reward)
		end
	end

	local function pushDamage(id, amount, flag)
		Sim.dmgBuf[#Sim.dmgBuf + 1] = { id, amount, flag }
	end

	-- урон с бронёй и модификаторами. flag в Sync: 0 обычный, 1 крит, 2 уклонение.
	-- -> нанесено (без перебора), уклонился?
	function Sim.DamageEnemy(e, amount, crit, unit, noDodge)
		if not e or not e.Alive then
			return 0, false
		end
		if not noDodge and e.Dodge > 0 and rng:NextNumber() < e.Dodge then
			pushDamage(e.Id, 0, 2)
			return 0, true
		end
		local dmg = math.max(1, math.floor(amount * (1 - armorOf(e)) * takenMult(e, Sim.now()) + 0.5))
		e.Health -= dmg
		pushDamage(e.Id, dmg, crit and 1 or 0)
		local dealt = math.min(dmg, dmg + e.Health)
		if unit then
			unit.DamageDealt += dealt
		end
		if e.Health <= 0 then
			killEnemy(e)
		else
			checkThresholds(e)
		end
		return dealt, false
	end

	-- чистый урон без брони и уклонения (столкновение с союзником). HP врага остаётся целым.
	function Sim.RawDamage(e, amount, unit)
		if not e.Alive or amount <= 0 then
			return 0
		end
		local dmg = math.min(amount, e.Health)
		if e.Health - dmg < 0.5 then
			dmg = e.Health
		else
			dmg = math.floor(dmg + 0.5)
		end
		if dmg <= 0 then
			return 0
		end
		e.Health -= dmg
		pushDamage(e.Id, dmg, 0)
		if unit and unit.Alive then
			unit.DamageDealt += dmg
		end
		if e.Health <= 0 then
			e.Health = 0
			killEnemy(e)
		else
			checkThresholds(e)
		end
		return dmg
	end

	function Sim.RollDamage(stats)
		local dmg = stats.Damage
		if stats.CritChance and rng:NextNumber() < stats.CritChance then
			return dmg * (stats.CritMult or 2), true
		end
		return dmg, false
	end

	------------------------------------------------------------------------
	-- ЭФФЕКТЫ: DoT, замедление, заморозка
	------------------------------------------------------------------------
	-- один источник обновляет свой эффект, разные юниты/виды стакаются
	function Sim.ApplyDot(e, dps, duration, u, kind)
		if not e or not e.Alive or not dps or dps <= 0 then
			return
		end
		local key = tostring(u and u.Uid or 0) .. ":" .. kind
		e.Dots[key] = { Dps = dps, Until = Sim.now() + duration, Unit = u }
	end

	-- не суммируется: сильнейшее и самое долгое; боссы — вполсилы
	function Sim.ApplySlow(e, amount, duration)
		if not e or not e.Alive or not amount then
			return
		end
		local t = Sim.now()
		amount *= e.IsBoss and S.BossSlowResist or 1
		if e.SlowUntil < t then
			e.SlowAmount = 0
		end
		e.SlowAmount = math.max(e.SlowAmount, amount)
		e.SlowUntil = math.max(e.SlowUntil, t + duration)
	end

	function Sim.Freeze(e, duration, t)
		e.FrozenUntil = t + duration
		e.FreezeImmuneUntil = t + duration + (S.FreezeImmunity or 3)
	end

	-- тик DoT раз в 0.5 с; урон делится между источниками по вкладу; DoT проданного юнита исчезает
	local shares = {}
	function Sim.UpdateDots(t)
		for _, e in pairs(enemies) do
			if next(e.Dots) and t >= e.NextDot then
				e.NextDot = t + 0.5
				local total = 0
				table.clear(shares)
				for key, d in pairs(e.Dots) do
					if t >= d.Until or (d.Unit and not d.Unit.Alive) then
						e.Dots[key] = nil
					else
						local part = d.Dps * 0.5
						total += part
						if d.Unit then
							shares[d.Unit] = (shares[d.Unit] or 0) + part
						end
					end
				end
				if total > 0 then
					local dealt = Sim.DamageEnemy(e, total, false, nil, true)
					for u, part in pairs(shares) do
						u.DamageDealt += dealt * part / total
					end
				end
			end
		end
	end

	------------------------------------------------------------------------
	-- ДВИЖЕНИЕ И ПОВЕДЕНИЕ
	------------------------------------------------------------------------
	local reached = {}
	function Sim.UpdateEnemies(t, dt)
		table.clear(reached)
		for _, e in pairs(enemies) do
			local def = e.Def
			local mult = 1
			if (e.FrozenUntil or 0) > t then
				mult = 0
			elseif e.SlowUntil > t then
				mult = 1 - e.SlowAmount
			else
				e.SlowAmount = 0
			end
			-- ускорения: туман, рывок босса, ярость (замедление и заморозка действуют поверх)
			local boost = e.EnrageSpeed or 0
			if (e.FogUntil or 0) > t then
				boost += e.FogAmount or 0
			end
			if (e.HasteUntil or 0) > t then
				boost += def.Haste.Speed
			end
			mult *= 1 + boost
			if e.NextPhase and t >= e.NextPhase then
				e.NextPhase = t + def.Phase.Every
				e.PhasedUntil = t + def.Phase.Duration
				Sim.EnemyState(e, "Phase", def.Phase.Duration)
			end
			if e.NextShield and t >= e.NextShield then
				e.NextShield = t + def.Shield.Every
				e.ShieldUntil = t + def.Shield.Duration
				Sim.EnemyState(e, "Shield", def.Shield.Duration)
			end
			if e.NextHaste and t >= e.NextHaste then
				e.NextHaste = t + def.Haste.Every
				e.HasteUntil = t + def.Haste.Duration
				Sim.EnemyState(e, "Haste", def.Haste.Duration)
			end
			if e.NextFog and t >= e.NextFog then
				-- туман: враги рядом (и сам колдун) ускоряются; одинаковый туман не суммируется
				local fog = def.Fog
				e.NextFog = t + fog.Every
				for _, o in pairs(enemies) do
					if flat(o.Pos, e.Pos) <= fog.Radius then
						o.FogAmount = math.max((o.FogUntil or 0) > t and o.FogAmount or 0, fog.Speed)
						o.FogUntil = math.max(o.FogUntil or 0, t + fog.Duration)
					end
				end
				Sim.Impact({ K = "Fog", P = e.Pos, R = fog.Radius, I = e.Id, DUR = fog.Duration })
			end
			e.Dist += e.Speed * mult * dt
			e.Pos = enemyPos(e)
			if e.NextSummon and t >= e.NextSummon then
				e.NextSummon = t + def.Summon.Interval
				queueSpawn(def.Summon.Enemy, def.Summon.Count, math.max(e.Dist - 3, 0), e.Pos)
			end
			if e.Dist >= Path.Length then
				reached[#reached + 1] = e
			end
		end
		for _, e in ipairs(reached) do
			if e.Alive then
				Sim.RemoveEnemy(e, "core")
				if Sim.Hooks.OnCore then
					Sim.Hooks.OnCore(e, e.Def.CoreDamage)
				end
			end
		end
		table.clear(reached)
		Sim.FlushSpawns()
	end

	-- отложенные спавны (не вставляем врагов, пока кто-то обходит enemies); после поражения — не спавним
	function Sim.FlushSpawns()
		if #Sim.pending == 0 or not Sim.Running then
			return
		end
		local list = Sim.pending
		Sim.pending = {}
		for _, s in ipairs(list) do
			Sim.Impact({ K = s[5] or "Summon", P = s[4], R = 6 })
			for k = 1, s[2] do
				Sim.SpawnEnemy(s[1], math.max(0, s[3] - k * 1.5))
			end
		end
	end

	------------------------------------------------------------------------
	-- ЦЕЛИ
	------------------------------------------------------------------------
	local sorters = {
		First = function(a, b)
			return a.Dist > b.Dist
		end,
		Last = function(a, b)
			return a.Dist < b.Dist
		end,
		Strongest = function(a, b)
			if a.Health == b.Health then
				return a.Dist > b.Dist
			end
			return a.Health > b.Health
		end,
		Weakest = function(a, b)
			if a.Health == b.Health then
				return a.Dist > b.Dist
			end
			return a.Health < b.Health
		end,
	}
	local function byD(a, b)
		return a._d < b._d
	end

	-- живые враги в радиусе юнита, отсортированные по режиму прицеливания
	function Sim.Candidates(u, range)
		local list = {}
		for _, e in pairs(enemies) do
			if e.Alive then
				local d = flat(e.Pos, u.Pos)
				if d <= range then
					e._d = d
					list[#list + 1] = e
				end
			end
		end
		if #list > 1 then
			table.sort(list, sorters[u.TargetMode] or byD)
		end
		return list
	end

	local function byDr(a, b)
		return a._dr < b._dr
	end
	-- ближайшие к точке (без exclude), не больше maxCount
	function Sim.NearestTo(center, radius, exclude, maxCount)
		local list = {}
		for _, e in pairs(enemies) do
			if e.Alive and not exclude[e] then
				local d = flat(e.Pos, center)
				if d <= radius + (e.IsBoss and 1 or 0.3) then
					e._dr = d
					list[#list + 1] = e
				end
			end
		end
		table.sort(list, byDr)
		for i = #list, math.max(maxCount, 0) + 1, -1 do
			list[i] = nil
		end
		return list
	end

	-- расстояние от точки до отрезка (XZ)
	function Sim.DistToSegment(p, a, b)
		local abx, abz = b.X - a.X, b.Z - a.Z
		local lenSq = abx * abx + abz * abz
		local t = 0
		if lenSq > 0 then
			t = math.clamp(((p.X - a.X) * abx + (p.Z - a.Z) * abz) / lenSq, 0, 1)
		end
		local cx, cz = a.X + abx * t, a.Z + abz * t
		local dx, dz = p.X - cx, p.Z - cz
		return math.sqrt(dx * dx + dz * dz)
	end
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXEE27280DAD139482FE7B301BAA2A094E">
					<Properties>
						<string name="Name">Runes</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Sim.Runes
-- Хэллоуин-руны (читаются из профиля при установке юнита). Срабатывают только от обычных атак:
-- не от Power и не от повтора «Призрачной короны».
--   LanternHeart  — каждая 3-я атака: огненный взрыв по дополнительным врагам рядом с целью
--   CursedThreads — каждая 5-я атака: замедление до 3 врагов; каждые 60 с — призыв проклятых
--   PhantomCrown  — 30%: призрачная копия повторяет атаку через 0.3 с

return function(Sim)
	local Config, Path = Sim.Config, Sim.Path
	local rng = Sim.rng

	local R = {}

	R.LanternHeart = function(u, stats, target, rune)
		u.RuneCount = (u.RuneCount or 0) + 1
		if u.RuneCount % rune.EveryNth ~= 0 then
			return
		end
		local saved = target.Pos
		Sim.Later(u, Sim.ImpactDelay(u, target), function()
			local center = target.Alive and target.Pos or saved
			local extra = Sim.NearestTo(center, rune.Radius, { [target] = true }, rune.MaxTargets)
			Sim.Impact({ K = "LanternHeart", P = center, R = rune.Radius, U = u.Uid, L = u.Level, N = #extra })
			for _, e in ipairs(extra) do
				Sim.DamageEnemy(e, stats.Damage * rune.Mult, false, u, true)
			end
		end)
	end

	R.CursedThreads = function(u, stats, target, rune)
		u.RuneCount = (u.RuneCount or 0) + 1
		if u.RuneCount % rune.EveryNth ~= 0 then
			return
		end
		Sim.Later(u, Sim.ImpactDelay(u, target), function()
			local first = target.Alive and target or nil
			local center = target.Pos -- у погибшей цели — точка гибели
			local list = first and { first } or {}
			for _, e in ipairs(Sim.NearestTo(center, 8, { [target] = true }, rune.MaxTargets - #list)) do
				list[#list + 1] = e
			end
			local ids = {}
			for i, e in ipairs(list) do
				Sim.ApplySlow(e, rune.Slow, rune.SlowTime)
				ids[i] = e.Id
			end
			Sim.Impact({ K = "CursedThreads", P = center, A = ids, U = u.Uid, L = u.Level, DUR = rune.SlowTime })
		end)
	end

	-- повтор атаки со 100% урона, не задерживая следующую атаку
	R.PhantomCrown = function(u, stats, target, rune)
		if rng:NextNumber() >= rune.Chance then
			return
		end
		Sim.Later(u, rune.Delay, function()
			if not Sim.Running then
				return
			end
			local pool = Sim.Candidates(u, stats.Range)
			if target.Alive and Path.FlatDistance(target.Pos, u.Pos) <= stats.Range then
				local i = table.find(pool, target)
				if i then
					table.remove(pool, i)
				end
				table.insert(pool, 1, target)
			end
			if #pool == 0 then
				return -- целей нет — повтор отменяется
			end
			Sim.Impact({ K = "PhantomEcho", P = u.Pos, U = u.Uid, L = u.Level })
			Sim.echo = true
			local ok, err = pcall(Sim.DoAttack, u, stats, pool)
			Sim.echo = false
			if not ok then
				warn("[VOID TD] echo: " .. tostring(err))
			end
		end)
	end

	function Sim.RuneAfterAttack(u, stats, list)
		local runeId = u.Rune
		local rune = runeId and Config.Runes[runeId]
		local fn = R[runeId]
		if not rune or not fn or Sim.echo or not list[1] then
			return
		end
		fn(u, stats, list[1], rune)
	end

	-- «Проклятые нити»: ровно каждые Interval с, не больше Max живых, лишний — самый старый — исчезает
	function Sim.RuneSummon(u, t)
		local sm = Config.Runes.CursedThreads.Summon
		u.NextRuneSummon += sm.Interval
		local lv = sm.Levels[math.min(u.Level, #sm.Levels)]
		local ids = {}
		for i = 1, lv.Count do
			ids[i] = Sim.SpawnAlly(u, lv.Ally, lv.HP, "Rune", i - 1).Id
		end
		local list = Sim.AlliesOf(u, "Rune")
		for i = 1, #list - sm.Max do
			Sim.RemoveAlly(list[i], "replaced")
		end
		Sim.Impact({ K = "CursedCircle", P = Sim.AllyGate(), U = u.Uid, L = u.Level, A = ids })
	end
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX5A2C6CAE6CED06F642FDDBC23C7D8C4C">
					<Properties>
						<string name="Name">Units</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Sim.Units
-- Юниты на карте: установка (все проверки сервера), улучшение, продажа, режим цели, такт юнита
-- (способности, призывы, атака по кулдауну). Каждый юнит — Folder в ReplicatedStorage.VoidTD.Units
-- с атрибутами UnitId Level OwnerId OwnerName Position Rotation TargetMode Spent Damage [Rune Storm].

return function(Sim)
	local Config, Path, S = Sim.Config, Sim.Path, Sim.S
	local units = Sim.units
	local flat = Path.FlatDistance

	local function isFinite(n)
		return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
	end

	local function counts(player, unitId)
		local total, same = 0, 0
		for _, u in pairs(units) do
			if u.Owner == player then
				total += 1
				if u.Id == unitId then
					same += 1
				end
			end
		end
		return total, same
	end

	function Sim.RemoveUnit(u)
		u.Alive = false
		units[u.Uid] = nil
		if u.Folder then
			u.Folder:Destroy()
		end
		-- проданный юнит забирает своих союзников; его зоны и DoT гаснут сами
		for _, a in pairs(Sim.allies) do
			if a.Owner == u then
				Sim.RemoveAlly(a, "sold")
			end
		end
	end

	function Sim.RemovePlayerUnits(player)
		for _, u in pairs(units) do
			if u.Owner == player then
				Sim.RemoveUnit(u)
			end
		end
	end

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Include

	-- Проверка фазы и участия в матче — Match.CanPlace (Router вызывает до этого)
	function Sim.PlaceUnit(player, unitId, pos, rotation)
		local def = type(unitId) == "string" and Config.Units[unitId]
		if not def or typeof(pos) ~= "Vector3" then
			return false, "Неверный запрос"
		end
		if not (isFinite(pos.X) and isFinite(pos.Y) and isFinite(pos.Z)) then
			return false, "Неверная позиция"
		end
		if not Sim.Data.IsEquipped(player, unitId) then
			return false, "Юнит не экипирован"
		end
		local cost = def.Levels[1].Cost
		if not Sim.Economy.Has(player, cost) then
			return false, "Недостаточно денег"
		end
		local total, same = counts(player, unitId)
		if total >= S.MaxUnitsPerPlayer then
			return false, "Лимит юнитов: " .. S.MaxUnitsPerPlayer
		end
		local rarity = Config.Rarities[def.Rarity]
		local limit = rarity and rarity.PlacementLimit or 1
		if same >= limit then
			return false, "Лимит " .. def.Name .. ": " .. limit
		end
		local ok, why = Path.IsPlacementClear(pos)
		if not ok then
			return false, why
		end
		-- под ногами — остров текущей карты
		local mapModel = Sim.Maps[Sim.Mode]
		if not mapModel then
			return false, "Сюда ставить нельзя"
		end
		rayParams.FilterDescendantsInstances = { mapModel }
		local hit = workspace:Raycast(Vector3.new(pos.X, Path.Map.GroundY + 30, pos.Z), Vector3.new(0, -60, 0), rayParams)
		if not hit or not hit.Instance:GetAttribute("Placeable") then
			return false, "Сюда ставить нельзя"
		end
		local ground = Vector3.new(pos.X, hit.Position.Y, pos.Z)
		for _, o in pairs(units) do
			if flat(o.Pos, ground) < S.PlacementSpacing then
				return false, "Слишком близко к другому юниту"
			end
		end
		rotation = tonumber(rotation)
		if not isFinite(rotation) then
			rotation = 0
		end
		rotation = rotation % 360

		Sim.Economy.Add(player, -cost)
		Sim.ids.Unit += 1
		local t = Sim.now()
		local u = {
			Uid = Sim.ids.Unit,
			Id = unitId,
			Def = def,
			Owner = player,
			Level = 1,
			Pos = ground,
			Rotation = rotation,
			TargetMode = def.DefaultTarget or "First",
			NextAttack = t + 0.6,
			NextAbility = t + 1.5,
			PlacedAt = t,
			Spent = cost,
			DamageDealt = 0,
			Alive = true,
		}
		local f = Instance.new("Folder")
		f.Name = tostring(u.Uid)
		f:SetAttribute("UnitId", unitId)
		f:SetAttribute("Level", 1)
		f:SetAttribute("OwnerId", player.UserId)
		f:SetAttribute("OwnerName", player.DisplayName)
		f:SetAttribute("Position", ground)
		f:SetAttribute("Rotation", rotation)
		f:SetAttribute("TargetMode", u.TargetMode)
		f:SetAttribute("Spent", cost)
		f:SetAttribute("Damage", 0)
		u.Folder = f
		-- таймеры способностей времени стартуют после установки
		if def.TimeHaste then
			u.NextHaste = t + def.TimeHaste.FirstDelay
		end
		if def.TimeStorm then
			u.NextStorm = t + def.TimeStorm.FirstDelay
			f:SetAttribute("Storm", false)
		end
		-- призыв союзников: первый — через интервал 1-го уровня
		if def.Summon then
			u.NextSummon = t + def.Summon.Levels[1].Interval
			u.SummonCount = 0
		end
		-- руна читается из профиля в момент установки
		u.Rune = Sim.Data.GetRune(player, unitId)
		if u.Rune then
			f:SetAttribute("Rune", u.Rune)
			if u.Rune == "CursedThreads" then
				u.NextRuneSummon = t + Config.Runes.CursedThreads.Summon.Interval
			end
		end
		f.Parent = Sim.UnitsFolder
		units[u.Uid] = u
		return true, u.Uid
	end

	local function ownedUnit(player, uid)
		uid = tonumber(uid)
		local u = isFinite(uid) and units[uid]
		if not u then
			return nil, "Юнит не найден"
		end
		if u.Owner ~= player then
			return nil, "Это не твой юнит"
		end
		return u
	end

	function Sim.UpgradeUnit(player, uid)
		local u, err = ownedUnit(player, uid)
		if not u then
			return false, err
		end
		if u.Level >= #u.Def.Levels then
			return false, "Максимальный уровень"
		end
		local cost = u.Def.Levels[u.Level + 1].Cost
		if not Sim.Economy.Has(player, cost) then
			return false, "Недостаточно денег"
		end
		Sim.Economy.Add(player, -cost)
		u.Level += 1
		u.Spent += cost
		u.Folder:SetAttribute("Level", u.Level)
		u.Folder:SetAttribute("Spent", u.Spent)
		return true, u.Level
	end

	function Sim.SellUnit(player, uid)
		local u, err = ownedUnit(player, uid)
		if not u then
			return false, err
		end
		local refund = math.floor(u.Spent * S.SellRefund)
		Sim.Economy.Add(player, refund)
		Sim.RemoveUnit(u)
		return true, refund
	end

	function Sim.SetTargetMode(player, uid, mode)
		local u, err = ownedUnit(player, uid)
		if not u then
			return false, err
		end
		if type(mode) ~= "string" or not table.find(Config.TargetModes, mode) then
			return false, "Неверный режим"
		end
		u.TargetMode = mode
		u.Folder:SetAttribute("TargetMode", mode)
		return true
	end

	------------------------------------------------------------------------
	-- ТАКТ ЮНИТОВ
	------------------------------------------------------------------------
	local function normalAttack(u, stats, list)
		Sim.DoAttack(u, stats, list)
		if u.Rune then
			Sim.RuneAfterAttack(u, stats, list)
		end
	end

	local function tickUnit(u, t)
		local def = u.Def
		local stats = def.Levels[u.Level]
		if stats.BlackHole and t >= u.NextAbility then
			local list = Sim.Candidates(u, stats.Range + (def.BlackHoleExtraRange or 6))
			if #list > 0 then
				Sim.CastBlackHole(u, stats, list)
				u.NextAbility = t + stats.BlackHole.Cooldown
				u.NextAttack = math.max(u.NextAttack, t + 0.9)
			end
		end
		if stats.BloodMoon and t >= u.NextAbility then
			local list = Sim.Candidates(u, stats.Range + (def.AbilityExtraRange or 6))
			if #list > 0 then
				Sim.CastBloodMoon(u, stats, list)
				u.NextAbility = t + stats.BloodMoon.Cooldown
				u.NextAttack = math.max(u.NextAttack, t + 1.0)
			end
		end
		if def.TimeHaste or def.TimeStorm then
			Sim.UpdateChrono(u, stats, t)
		end
		if def.Summon and t >= u.NextSummon then
			Sim.CastSummon(u, t)
		end
		if u.NextRuneSummon and t >= u.NextRuneSummon then
			Sim.RuneSummon(u, t)
		end
		if t >= u.NextAttack then
			local list = Sim.Candidates(u, stats.Range)
			if #list > 0 then
				-- ускорение времени: атакует чаще, урон за удар прежний
				local cd = stats.Cooldown
				if (u.HasteUntil or 0) > t then
					cd /= 1 + (u.Haste or 0)
				end
				u.NextAttack = t + cd
				local P = def.Power
				if P then
					u.PowerCount = (u.PowerCount or 0) + 1
				end
				if P and u.PowerCount % P.N == 0 then
					Sim.CastPower(u, stats, list)
				else
					normalAttack(u, stats, list)
				end
			end
		end
	end

	-- ошибка одного юнита не останавливает остальных (warn не чаще раза в 5 с)
	local lastWarn = -math.huge
	function Sim.UpdateUnits(t)
		for _, u in pairs(units) do
			if u.Alive then
				local ok, err = pcall(tickUnit, u, t)
				if not ok and os.clock() - lastWarn > 5 then
					lastWarn = os.clock()
					warn("[VOID TD] unit " .. tostring(u.Id) .. ": " .. tostring(err))
				end
			end
		end
	end
end
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX5DE38580031D573325284BA6FC1F2E85">
				<Properties>
					<string name="Name">World</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: World
-- World.Build() строит (или переиспользует уже стоящие в workspace) все корни мира и освещение:
--   VoidTDMap (карта Void), VoidTDLobby (+ HalloweenGate), VoidTDHalloween (остров), VoidTDHalloweenMap.
-- Каждый корень собирается без родителя и кладётся в workspace последним. Ошибка Хэллоуина не ломает Void.

local Lighting = require(script:WaitForChild("Lighting"))
local VoidMap = require(script:WaitForChild("VoidMap"))
local Lobby = require(script:WaitForChild("Lobby"))
local Halloween = require(script:WaitForChild("Halloween"))

local World = {}

local function existing(name)
	local m = workspace:FindFirstChild(name)
	return m and m:IsA("Model") and m or nil
end

local function try(label, fn)
	local ok, res = pcall(fn)
	if not ok then
		warn("[VOID TD] " .. label .. " не построен: " .. tostring(res))
		return nil
	end
	return res
end

function World.Build()
	local out = {}
	out.Void = existing("VoidTDMap") or VoidMap()
	out.Lobby = existing("VoidTDLobby") or Lobby()
	try("Свет", Lighting)
	try("Хэллоуин-ворота", function()
		return Halloween.BuildGate(out.Lobby)
	end)
	out.Island = try("Хэллоуин-остров", Halloween.BuildIsland)
	out.Halloween = try("Хэллоуин-мир", Halloween.BuildMap)
	return out
end

return World
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX1F236E623F3E39450ADF8CEC9958F64D">
					<Properties>
						<string name="Name">Halloween</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: World.Halloween
-- Хэллоуин-мир: ворота HALLOWEEN EVENT в лобби (VoidTDLobby.HalloweenGate), остров (VoidTDHalloween)
-- с кейсом, очередью на 4 квадратах, статуями и бестиарием, и карта «Haunted Hollow» (VoidTDHalloweenMap).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))
local Path = require(Shared:WaitForChild("Path"))

local Kit = require(script.Parent:WaitForChild("Kit"))

local V, CF, ANG, rad = Vector3.new, CFrame.new, CFrame.Angles, math.rad
local rgb = Color3.fromRGB
local H = Kit.H
local block, neon, wedge, light, emitter, cylY = Kit.Block, Kit.Neon, Kit.Wedge, Kit.Light, Kit.Emitter, Kit.CylY

local HW = {}

local I = Config.HalloweenIsland
local HM = Config.Maps.Halloween
local GREEN_FOG = rgb(120, 200, 130)

local function flat(a, b)
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

local function outDir(offset)
	local o = V(offset.X, 0, offset.Z)
	return o.Magnitude > 0 and o.Unit or V(0, 0, 1)
end

-- невидимый блок тумана (не мешает рейкастам постановки)
local function fogBlock(parent, size, pos, color, rate, sz)
	local p = Kit.Ghost(parent, size, pos, "FogArea")
	Kit.Fog(p, color, rate, sz)
	return p
end

local function bossLabel(key)
	return "босс " .. ({ Easy = "ЛЁГКОЙ", Medium = "СРЕДНЕЙ", Hard = "СЛОЖНОЙ" })[key]
end

local function coinsText()
	local lines = {}
	for _, key in ipairs(Config.Halloween.Difficulties) do
		lines[#lines + 1] = Config.Difficulties[key].Name .. " — " .. (Config.Halloween.Coins[key] or 0) .. " 🎃"
	end
	lines[#lines + 1] = "только за победу"
	return table.concat(lines, "\n")
end

------------------------------------------------------------------------
-- ВОРОТА В ЛОББИ
------------------------------------------------------------------------
function HW.BuildGate(lobby)
	local z = Config.Lobby.Zones.HalloweenPortal
	if not lobby or not z or lobby:FindFirstChild("HalloweenGate") then
		return lobby and lobby:FindFirstChild("HalloweenGate")
	end
	local gate = Instance.new("Model")
	gate.Name = "HalloweenGate"
	local zc = Config.Lobby.Center + z.Offset
	local out = outDir(z.Offset)
	local pc = zc + out * 9
	local face = CFrame.lookAt(pc, pc - out) -- лицом к центру лобби
	local R = 13
	for i = 0, 19 do
		local a = i / 20 * math.pi * 2
		local cf = face * CF(math.cos(a) * R, R + 1 + math.sin(a) * R, 0) * ANG(0, 0, a)
		block(gate, V(4, 3.4, 3), cf, i % 2 == 0 and H.Stone2 or H.Black)
		if i % 2 == 0 then
			wedge(gate, V(1.2, 2.4, 1.2), cf * CF(1.8, 0, 0) * ANG(0, 0, rad(-90)), H.Black)
		end
		if i % 5 == 0 then
			neon(gate, V(0.6, 1.4, 0.3), cf * CF(0, 0, -1.6), H.Orange)
		end
	end
	local disc = Kit.Cyl(gate, "PortalDisc", V(0.4, 23, 23), face * CF(0, R + 1, 0) * ANG(0, rad(90), 0), rgb(150, 60, 20), Enum.Material.Neon, { CanCollide = false, Transparency = 0.25 })
	light(disc, H.Orange, 50, 3)
	emitter(disc, H.Orange, { Rate = 26, Size = 0.7, SpeedMin = 2, SpeedMax = 5 })
	for i = 1, 3 do
		local s = neon(gate, V(0.7, R * 1.7, 0.6), face * CF(0, R + 1, -0.4) * ANG(0, 0, rad(i * 60)), i == 1 and H.Purple or H.Orange, { Transparency = 0.35 })
		Kit.Spin(s, -1.2 - 0.3 * i, "Z")
	end
	local slab = block(gate, V(20, 1, 6), face * CF(0, 0.5, 0), H.Stone2)
	Kit.Fog(slab, H.Fog, 3, 7)
	for sx = -1, 1, 2 do
		Kit.Pumpkin(gate, (face * CF(16 * sx, 0, 2)).Position, 2.2, true, math.atan2(-out.X, -out.Z) + math.pi)
		Kit.Pumpkin(gate, (face * CF(19 * sx, 0, -1)).Position, 1.4, true, math.atan2(-out.X, -out.Z) + math.pi + 0.5 * sx)
		Kit.LanternPost(gate, (face * CF(12 * sx, 0, 5)).Position, 9)
	end
	-- вывеска лицом к лобби (в legacy была развёрнута текстом от игроков)
	Kit.Sign(gate, face * CF(0, 2 * R + 7, 0), V(30, 7, 1), "HALLOWEEN EVENT", "🎃 остров, кейс, боссы и Halloween Coins", H.Orange, H.Orange)
	for i = 1, 3 do
		Kit.Bat(gate, zc + V(0, 22 + 3 * i, 0), 8 + 3 * i, 0.6 + 0.2 * i)
	end
	Kit.Calm(gate)
	gate.Parent = lobby
	return gate
end

------------------------------------------------------------------------
-- ОСТРОВ
------------------------------------------------------------------------
local function castle(m, c)
	local cz = c + V(0, 0, -90)
	block(m, V(46, 22, 16), CF(cz + V(0, 11, 0)), H.Stone2, nil, { Name = "Hall" })
	block(m, V(48, 1.5, 18), CF(cz + V(0, 22.7, 0)), H.Stone)
	for i = -5, 5 do
		block(m, V(2.4, 2.4, 2), CF(cz + V(4.2 * i, 24.6, -8.2)), H.Stone2)
	end
	Kit.Tower(m, cz + V(0, 0, 2), 12, 36, false)
	Kit.Tower(m, cz + V(-25, 0, 2), 9, 30, false)
	Kit.Tower(m, cz + V(25, 0, 2), 9, 30, false)
	for sx = -1, 1, 2 do
		for k = 0, 3 do
			local cf = CF(cz + V(sx * (6 + 4.5 * k), 9, -8.05))
			neon(m, V(1.6, 4, 0.1), cf, H.Window)
			wedge(m, V(1.6, 1.2, 0.12), cf * CF(0, 2.6, 0), H.Window, Enum.Material.Neon)
		end
	end
	block(m, V(8, 11, 0.6), CF(cz + V(0, 5.5, -8.3)), H.Bark, Enum.Material.Wood, { Name = "Gate" })
	neon(m, V(1, 1, 0.1), CF(cz + V(0, 7, -8.65)) * ANG(0, 0, rad(45)), H.Orange)
	Kit.Sign(m, CF(cz + V(0, 30, -9)) * ANG(0, math.pi, 0), V(26, 6, 1), "HAUNTED HOLLOW", "Хэллоуин-остров VOID TD", H.Orange, H.Burgundy)
end

local function caseStand(m, z, zc)
	local out = outDir(z.Offset)
	local sp = zc + out * 13
	local vert = ANG(0, 0, rad(90))
	Kit.Cyl(m, "CaseStand", V(2.5, 10, 10), CF(sp + V(0, 1.25, 0)) * vert, H.Black)
	Kit.Cyl(m, "CaseStandRing", V(0.3, 10.4, 10.4), CF(sp + V(0, 2.4, 0)) * vert, H.Gold, Enum.Material.Neon, { CanCollide = false })
	local CaseModels = Kit.Model("Cases")
	if CaseModels then
		local ok, built = pcall(CaseModels.Build, z.Case)
		if ok and built and built.Model then
			local cm = built.Model
			cm:ScaleTo(1.7)
			cm:PivotTo(CF(sp + V(0, 2.6, 0)) * CFrame.lookAt(V(), -out).Rotation)
			Kit.Spin(cm, 0.4, "Y")
			cm.Parent = m
		end
	end
	light(Kit.Ghost(m, V(0.5, 0.5, 0.5), sp + V(0, 6, 0), "CaseGlow"), H.Orange, 24, 2)
	local case = Config.Cases[z.Case]
	Kit.Billboard(m, sp + V(0, 13.5, 0), case and case.Name or z.Title, "🎃 " .. (case and case.Cost1 or 0) .. " Halloween Coins", H.Orange, 14)
	for i = 0, 5 do
		local a = rad(i * 60)
		Kit.Pumpkin(m, sp + V(math.cos(a) * 7.5, 0, math.sin(a) * 7.5), 1 + 0.4 * (i % 2), i % 2 == 0, a)
	end
end

local function queueArea(m, c)
	local Q = I.Queue
	local qc = c + Q.Offset
	block(m, V(30, 0.6, 22), CF(qc + V(0, 0.3, 0)), H.Black, nil, { Name = "QueueBase" })
	for i, off in ipairs(Q.Pads) do
		local p = qc + off
		neon(m, V(Q.Pad + 0.6, 0.65, Q.Pad + 0.6), CF(p + V(0, 0.33, 0)), H.Orange, { CanCollide = true })
		local pad = block(m, V(Q.Pad, 0.7, Q.Pad), CF(p + V(0, 0.36, 0)), rgb(40, 16, 10), Enum.Material.Glass, { Name = "QueuePad" .. i, Transparency = 0.15 })
		light(pad, H.Orange, 14, 1.5)
		emitter(pad, H.Orange, { Rate = 10, Size = 0.4, SpeedMin = 2, SpeedMax = 4, Spread = 15, Dir = Enum.NormalId.Top, LifeMin = 1, LifeMax = 2 })
		local beam = neon(m, V(Q.Pad - 1.4, 18, Q.Pad - 1.4), CF(p + V(0, 9, 0)), H.Orange, { Transparency = 0.9, Query = false })
		beam.CastShadow = false
	end
	for sx = -1, 1, 2 do
		block(m, V(2.4, 16, 2.4), CF(qc + V(16 * sx, 8, -12)), H.Stone2)
		Kit.Pumpkin(m, qc + V(16 * sx, 16, -12), 1.6, true, math.pi)
	end
	block(m, V(34, 2, 2.4), CF(qc + V(0, 15, -12)), H.Stone2)
	Kit.Sign(m, CF(qc + V(0, 20, -12)) * ANG(0, math.pi, 0), V(26, 6, 1), "HALLOWEEN TD",
		"встань на квадрат • до " .. Q.MaxPlayers .. " игроков • хост выбирает сложность", H.Orange, H.Orange)
	Kit.Billboard(m, qc + V(0, 7, 0), "ВХОД В БОЙ", "встань на светящийся квадрат", H.Orange, 13)
	Kit.Sign(m, CF(qc + V(24, 6, 6)) * ANG(0, rad(-90), 0) * ANG(0, math.pi, 0), V(12, 9, 0.8), "НАГРАДЫ", coinsText(), H.Gold, H.Gold)
	block(m, V(0.8, 2, 0.8), CF(qc + V(24, 1, 6)), H.Black)
end

local function eventStatues(m, c)
	local uz = c + I.Zones.HalloweenUnits.Offset
	for i, id in ipairs({ "LanternKing", "HalloweenPuppeteer", "HeadlessExecutioner", "PlagueDoctor", "PhantomKnight" }) do
		local a = rad(140 + 25 * (i - 1))
		Kit.Statue(m, id, uz + V(math.cos(a) * 15, 0, math.sin(a) * 15), uz, i == 1 and 4 or 3)
	end
end

local function bestiary(m, c)
	local EnemyModels = Kit.Model("Enemies")
	if not EnemyModels then
		return
	end
	local bz = c + I.Zones.Bestiary.Offset
	local rims = { rgb(90, 220, 120), rgb(255, 205, 70), rgb(255, 90, 80) }
	for i, key in ipairs(Config.Halloween.Difficulties) do
		local id = Config.Halloween.Bosses[key]
		local pos = bz + V(16, 0, 12 * (i - 2))
		block(m, V(7, 3, 7), CF(pos + V(0, 1.5, 0)), H.Stone2, nil, { Name = "Pedestal" })
		neon(m, V(7.4, 0.25, 7.4), CF(pos + V(0, 2.6, 0)), rims[i])
		local ok, rig = pcall(EnemyModels.Build, id)
		if ok and rig and rig.Model then
			local em = rig.Model
			em:ScaleTo(0.75)
			local base = pos + V(0, 3 + (rig.HipHeight or 3) * 0.75, 0)
			em:PivotTo(CFrame.lookAt(base, V(bz.X, base.Y, bz.Z)))
			Kit.AnchorAll(em)
			em.Name = "Bestiary_" .. id
			em.Parent = m
		end
		Kit.Billboard(m, pos + V(0, 13, 0), Config.Enemies[id] and Config.Enemies[id].Name or id, bossLabel(key), rims[i], 10)
	end
end

local function graveyard(m, c, rng)
	local g = c + V(52, 0, 44)
	for x = 0, 3 do
		for zz = 0, 2 do
			Kit.Tombstone(m, rng, g + V(6 * x - 9, 0, 7 * zz - 7), rng:NextNumber(-0.3, 0.3))
		end
	end
	Kit.Fence(m, g + V(-14, 0, -12), g + V(14, 0, -12))
	Kit.Fence(m, g + V(14, 0, -12), g + V(14, 0, 14))
	Kit.Fence(m, g + V(-14, 0, 14), g + V(14, 0, 14))
	Kit.Crow(m, g + V(14, 2.9, 2), rad(-90))
	Kit.Crow(m, g + V(-6, 2.9, -12), 0)
	Kit.GhostFigure(m, g + V(2, 2, 2), 1.1)
	fogBlock(m, V(26, 1, 24), g + V(0, 0.5, 0), GREEN_FOG, 2, 6)
end

local function pumpkinField(m, c, rng)
	local f = c + V(-50, 0, 58)
	block(m, V(30, 0.25, 20), CF(f + V(0, 0.12, 0)), rgb(40, 28, 20), Enum.Material.Ground, { CanCollide = false, Name = "Soil" })
	for x = 0, 4 do
		for zz = 0, 3 do
			local p = f + V(6 * x - 12 + rng:NextNumber(-1, 1), 0, 5 * zz - 7.5 + rng:NextNumber(-1, 1))
			Kit.Pumpkin(m, p, rng:NextNumber(0.8, 1.5), rng:NextInteger(1, 4) == 1, rng:NextNumber(0, 6))
		end
	end
	local sc = f + V(0, 0, -11)
	block(m, V(0.5, 8, 0.5), CF(sc + V(0, 4, 0)), H.Bark, Enum.Material.Wood)
	block(m, V(6, 0.5, 0.5), CF(sc + V(0, 6, 0)), H.Bark, Enum.Material.Wood)
	block(m, V(2.2, 3, 1.2), CF(sc + V(0, 5, 0)), rgb(90, 60, 40), Enum.Material.Fabric)
	Kit.Pumpkin(m, sc + V(0, 6.6, 0), 1.5, true, math.pi)
	Kit.Crow(m, sc + V(2.6, 6.3, 0), 0.4)
end

local function bridge(m, c, rng)
	local a = c + V(-96, 0, -20)
	local b = a + V(-28, 0, -6)
	local cf = CFrame.lookAt((a + b) / 2, b)
	for i = -6, 6 do
		block(m, V(5, 0.4, 1.8), cf * CF(0, -0.1 + 0.08 * math.abs(i), 2.1 * i), H.Bark, Enum.Material.WoodPlanks)
	end
	for sx = -1, 1, 2 do
		block(m, V(0.2, 0.2, 28), cf * CF(2.4 * sx, 1.6, 0), H.Bark, Enum.Material.Wood, { CanCollide = false })
	end
	local isl = b + V(-8, 0, -2)
	cylY(m, "Islet", 12, 4, isl - V(0, 2, 0), H.Ground)
	cylY(m, "IsletRock", 8, 12, isl - V(0, 10, 0), H.Rock)
	Kit.Tower(m, isl, 7, 14, true, rng)
	Kit.RuneCircle(m, isl + V(0, 0, 8), 4, H.Rune)
end

local function returnPortal(m, c)
	local z = I.Zones.ReturnPortal
	local zc = c + z.Offset
	local face = CFrame.lookAt(zc + V(0, 0, 8), zc)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		block(m, V(2.6, 2.2, 1.8), face * CF(7 * math.cos(a), 8 + 7 * math.sin(a), 0) * ANG(0, 0, a), i % 2 == 0 and H.Stone or H.Stone2)
	end
	local disc = Kit.Cyl(m, "ReturnDisc", V(0.4, 12, 12), face * CF(0, 8, 0) * ANG(0, rad(90), 0), rgb(120, 40, 210), Enum.Material.Neon, { CanCollide = false, Transparency = 0.25 })
	light(disc, rgb(170, 80, 255), 24, 2)
end

function HW.BuildIsland()
	local existing = workspace:FindFirstChild("VoidTDHalloween")
	if existing then
		return existing
	end
	local rng = Random.new(1031)
	local c = I.Center
	local m = Instance.new("Model")
	m.Name = "VoidTDHalloween"
	Kit.IslandDisc(m, c, I.Radius, rng, false)
	Kit.Patches(m, c, I.Radius, rng, 14, false)
	local moon = Kit.Ball(m, "Moon", 70, c + V(-40, 150, -330), H.Moon)
	light(moon, H.Moon, 60, 1)
	Kit.Ball(m, "MoonShade", 68, c + V(-22, 156, -318), rgb(20, 12, 28), Enum.Material.SmoothPlastic, { Transparency = 0.25 })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		fogBlock(m, V(30, 1, 30), c + V(math.cos(a) * 55, 0.5, math.sin(a) * 55), H.Fog, 1.5, 9)
	end
	castle(m, c)
	Kit.Tower(m, c + V(-78, 0, -48), 8, 18, true, rng)
	Kit.Tower(m, c + V(80, 0, -44), 8, 22, true, rng)
	local zones = Instance.new("Folder")
	zones.Name = "Zones"
	zones.Parent = m
	local taken = { c + V(0, 0, 70), c + I.Queue.Offset }
	for key, z in pairs(I.Zones) do
		local zc = c + z.Offset
		local sub = z.Case and ((Config.Cases[z.Case] and Config.Cases[z.Case].Cost1 or 0) .. " 🎃 Halloween Coins") or nil
		Kit.ZoneCircle(zones, key, z, zc, sub, rgb(30, 14, 18))
		taken[#taken + 1] = zc
	end
	caseStand(m, I.Zones.Case_Halloween, c + I.Zones.Case_Halloween.Offset)
	queueArea(m, c)
	eventStatues(m, c)
	bestiary(m, c)
	graveyard(m, c, rng)
	pumpkinField(m, c, rng)
	Kit.House(m, c + V(-80, 0, 0), rad(80), 1)
	Kit.House(m, c + V(78, 0, 8), rad(-85), 0.9)
	bridge(m, c, rng)
	for _ = 1, 26 do
		local a, d = rng:NextNumber(0, math.pi * 2), rng:NextNumber(70, 94)
		local p = c + V(math.cos(a) * d, 0, math.sin(a) * d)
		local ok = p.Z > c.Z - 70
		for _, q in ipairs(taken) do
			if not ok then
				break
			end
			ok = flat(p, q) >= 15
		end
		if ok then
			taken[#taken + 1] = p
			Kit.DeadTree(m, rng, p, rng:NextNumber(0.9, 1.3))
		end
	end
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2 + 0.2
		Kit.LanternPost(m, c + V(math.cos(a) * 34, 0, math.sin(a) * 34), 7)
	end
	Kit.GhostFigure(m, c + V(-30, 3, -40), 1.3)
	Kit.GhostFigure(m, c + V(36, 4, -60), 1)
	Kit.GhostFigure(m, c + V(-70, 2, 30), 0.9)
	for _ = 1, 6 do
		local p = c + V(rng:NextNumber(-60, 60), rng:NextNumber(26, 40), rng:NextNumber(-70, 40))
		Kit.Bat(m, p, rng:NextNumber(8, 18), rng:NextNumber(0.5, 1.2))
	end
	Kit.RuneCircle(m, c + V(0, 0, 18), 8, H.Rune)
	Kit.RuneCircle(m, c + V(-20, 0, -64), 5, H.Orange)
	block(m, V(10, 1, 10), CF(I.Spawn + V(0, 0.5, 0)), rgb(60, 26, 20), nil, { Name = "ArrivalPad" })
	cylY(m, "SpawnGlow", 4.6, 0.08, I.Spawn + V(0, 1.03, 0), H.Orange, Enum.Material.Neon, { CanCollide = false, Transparency = 0.5 })
	returnPortal(m, c)
	m.WorldPivot = CF(c)
	Kit.Calm(m)
	m.Parent = workspace
	return m
end

------------------------------------------------------------------------
-- КАРТА HAUNTED HOLLOW
------------------------------------------------------------------------
local function mapPortal(map, pts)
	local m = Instance.new("Model")
	m.Name = "VoidPortal"
	local start = pts[1]
	local dir = (pts[2] - start).Unit
	local R = 10
	local center = start - dir * 4 + V(0, R + 1, 0)
	local face = CFrame.lookAt(center, center + dir)
	for i = 0, 17 do
		local a = i / 18 * math.pi * 2
		local cf = face * CF(math.cos(a) * R, math.sin(a) * R, 0) * ANG(0, 0, a)
		block(m, V(3.4, 3, 2.6), cf, i % 2 == 0 and H.Stone2 or H.Black)
		if i % 3 == 0 then
			wedge(m, V(1, 2.2, 1), cf * CF(1.6, 0, 0) * ANG(0, 0, rad(-90)), H.Bone, Enum.Material.SmoothPlastic)
		end
	end
	local disc = Kit.Cyl(m, "PortalDisc", V(0.4, 17.6, 17.6), face * ANG(0, rad(90), 0), rgb(140, 50, 20), Enum.Material.Neon, { CanCollide = false, Transparency = 0.2 })
	local core = neon(m, V(2, 2, 2), face * CF(0, 0, -0.3) * ANG(rad(45), rad(45), 0), H.Orange, { Name = "PortalCore" })
	light(core, H.Orange, 40, 3)
	emitter(disc, H.Ember, { Rate = 26, Size = 0.7, SpeedMin = 2, SpeedMax = 5 })
	Kit.Fog(disc, H.Fog, 3, 6)
	for i = 1, 3 do
		local s = neon(m, V(0.6, 16, 0.7), face * ANG(0, 0, rad(i * 60)) * CF(0, 0, -0.4), i == 1 and H.Purple or H.Orange, { Transparency = 0.35 })
		Kit.Spin(s, -1.4 - 0.3 * i, "Z")
	end
	m.Parent = map
end

local function mapCore(map, pts)
	local m = Instance.new("Model")
	m.Name = "VoidCore"
	local pos = pts[#pts]
	cylY(m, "CoreBase", 9, 1.5, pos + V(0, 0.75, 0), H.Stone2)
	cylY(m, "CoreRing", 9.4, 0.4, pos + V(0, 1.6, 0), H.Gold, Enum.Material.Neon, { CanCollide = false })
	for k = 0, 3 do
		local a = rad(45 + 90 * k)
		local p = pos + V(math.cos(a) * 6.5, 0, math.sin(a) * 6.5)
		block(m, V(1.6, 14, 1.6), CF(p + V(0, 7, 0)), H.Black, Enum.Material.Metal)
		Kit.Pumpkin(m, p + V(0, 14, 0), 1.3, true, a)
	end
	block(m, V(10, 1, 10), CF(pos + V(0, 14.5, 0)) * ANG(0, rad(45), 0), H.Black, Enum.Material.Metal)
	Kit.Spire(m, CF(pos + V(0, 15, 0)), 9, 9, H.Burgundy)
	local flame = neon(m, V(4, 6, 4), CF(pos + V(0, 8, 0)) * ANG(0, rad(45), 0), H.Orange, { Name = "CoreCrystal", Transparency = 0.15 })
	Kit.Spin(flame, 0.6, "Y")
	light(flame, H.Orange, 40, 3)
	emitter(flame, H.Ember, { Rate = 20, Size = 0.6, SpeedMin = 1, SpeedMax = 3, Accel = V(0, 3, 0) })
	m:SetAttribute("CoreCenter", pos + V(0, 8, 0))
	m.Parent = map
end

local function mapDecor(map, c, road, rng)
	local f = Instance.new("Folder")
	f.Name = "Decor"
	f.Parent = map
	local pts = road.Points
	local taken = { pts[1], pts[#pts], HM.BattleSpawn }
	local hx, hz = HM.IslandSize.X / 2, HM.IslandSize.Y / 2
	local function spot(pathDist, sep, tries)
		for _ = 1, tries or 40 do
			local p = V(c.X + rng:NextNumber(-hx, hx), HM.GroundY, c.Z + rng:NextNumber(-hz, hz))
			local ok = road.DistanceToPath(p) >= pathDist and math.abs(p.X - c.X) <= hx - 6 and math.abs(p.Z - c.Z) <= hz - 6
			for _, q in ipairs(taken) do
				if not ok then
					break
				end
				ok = flat(p, q) >= sep
			end
			if ok then
				taken[#taken + 1] = p
				return p
			end
		end
		return nil
	end
	for _ = 1, 3 do
		local g = spot(16, 26)
		if g then
			for _ = 1, 6 do
				Kit.Tombstone(f, rng, g + V(rng:NextNumber(-7, 7), 0, rng:NextNumber(-7, 7)), rng:NextNumber(-0.4, 0.4))
			end
			if rng:NextInteger(1, 2) == 1 then
				Kit.Crow(f, g + V(0, 0, 0), rng:NextNumber(0, 6)) -- на земле, не в воздухе
			end
			fogBlock(f, V(16, 1, 16), g + V(0, 0.5, 0), GREEN_FOG, 1, 5)
		end
	end
	for _ = 1, 4 do
		local p = spot(12, 20)
		if p then
			for _ = 1, 7 do
				Kit.Pumpkin(f, p + V(rng:NextNumber(-6, 6), 0, rng:NextNumber(-6, 6)), rng:NextNumber(0.8, 1.6), rng:NextInteger(1, 3) == 1, rng:NextNumber(0, 6))
			end
		end
	end
	for k = 1, 3 do
		local p = spot(22, 34)
		if p then
			if k == 1 then
				Kit.Tower(f, p, 10, 26, false, rng)
			elseif k == 2 then
				Kit.House(f, p, rng:NextNumber(0, 6), 1.1)
			else
				Kit.Tower(f, p, 8, 16, true, rng)
			end
		end
	end
	for _ = 1, 30 do
		local p = spot(9, 9, 12)
		if p then
			Kit.DeadTree(f, rng, p, rng:NextNumber(0.8, 1.3))
		end
	end
	for _ = 1, 4 do
		local p = spot(10, 12, 12)
		if p then
			Kit.GhostFigure(f, p + V(0, 3, 0), rng:NextNumber(0.8, 1.2))
		end
	end
	for _ = 1, 6 do
		local p = V(c.X + rng:NextNumber(-110, 110), HM.GroundY + rng:NextNumber(24, 40), c.Z + rng:NextNumber(-90, 90))
		Kit.Bat(f, p, rng:NextNumber(8, 16), rng:NextNumber(0.5, 1.2))
	end
	for i = 0, 5 do
		fogBlock(f, V(40, 1, 40), V(c.X + 85 * (i % 3 - 1), HM.GroundY + 0.5, c.Z + (i < 3 and -50 or 50)), H.Fog, 1.2, 9)
	end
	local moon = Kit.Ball(f, "Moon", 60, c + V(60, 140, -300), H.Moon)
	light(moon, H.Moon, 60, 1)
end

function HW.BuildMap()
	local existing = workspace:FindFirstChild("VoidTDHalloweenMap")
	if existing then
		return existing
	end
	local rng = Random.new(666)
	local c = HM.Center
	local GY = HM.GroundY
	local road = Path.Get("Halloween") -- своя дорога, активная карта Path не меняется
	local pts = road.Points
	local map = Instance.new("Model")
	map.Name = "VoidTDHalloweenMap"

	local g = Instance.new("Folder")
	g.Name = "Ground"
	g.Parent = map
	local SX, SZ = HM.IslandSize.X, HM.IslandSize.Y
	local top = block(g, V(SX, 4, SZ), CF(c.X, GY - 2, c.Z), H.Ground, nil, { Name = "IslandTop" })
	top:SetAttribute("Placeable", true)
	for i = 1, 22 do
		local w, d = rng:NextNumber(14, 34), rng:NextNumber(14, 30)
		local x = rng:NextNumber(-SX / 2 + w / 2 + 2, SX / 2 - w / 2 - 2)
		local z = rng:NextNumber(-SZ / 2 + d / 2 + 2, SZ / 2 - d / 2 - 2)
		local p = Kit.Part(g, {
			Name = "Patch", Size = V(w, 0.2, d), CFrame = CF(c.X + x, GY + 0.02 + 0.004 * i, c.Z + z) * ANG(0, rad(rng:NextNumber(-20, 20)), 0),
			Color = i % 3 == 0 and H.GrassP or (i % 3 == 1 and H.Grass or H.Ground2), Material = Enum.Material.Grass, CastShadow = false,
		})
		p:SetAttribute("Placeable", true)
	end

	local u = Instance.new("Folder")
	u.Name = "Underside"
	u.Parent = map
	for i, L in ipairs({ { 0.92, 12, -9 }, { 0.72, 16, -22 }, { 0.5, 18, -38 }, { 0.28, 18, -55 } }) do
		block(u, V(SX * L[1], L[2], SZ * L[1]), CF(c.X + rng:NextNumber(-6, 6), GY + L[3], c.Z + rng:NextNumber(-6, 6)) * ANG(0, rad(rng:NextNumber(-8, 8)), 0), i % 2 == 0 and H.Rock or H.Rock2)
	end
	local function edgeRock(x, z, color)
		local s = rng:NextNumber(10, 18)
		block(u, V(s, rng:NextNumber(5, 8), s), CF(x, GY - 3.5, z) * ANG(0, rng:NextNumber(0, 2), 0), color, nil, { Name = "EdgeRock" })
	end
	for x = -SX / 2, SX / 2 - 1, 18 do
		edgeRock(c.X + x, c.Z - SZ / 2, H.Rock2)
		edgeRock(c.X + x, c.Z + SZ / 2, H.Rock2)
	end
	for z = -SZ / 2 + 18, SZ / 2 - 18, 18 do
		edgeRock(c.X - SX / 2, c.Z + z, H.Rock)
		edgeRock(c.X + SX / 2, c.Z + z, H.Rock)
	end

	local pf = Instance.new("Folder")
	pf.Name = "Path"
	pf.Parent = map
	local w = HM.PathWidth
	Kit.Road(pf, pts, GY, w, H.Road, H.RoadEdge, function(i, a, b, cf, len, dir)
		if i % 2 == 0 then
			neon(pf, V(0.35, 0.05, math.min(0.4 * len, 12)), cf * CF(rng:NextNumber(-2, 2), 0.16, 0) * ANG(0, rad(rng:NextNumber(-25, 25)), 0), H.Ember, { Name = "Crack" })
		end
		local right = V(-dir.Z, 0, dir.X)
		local steps = math.floor(len / 26)
		for s2 = 1, steps do
			local side = s2 % 2 == 0 and 1 or -1
			local p = a:Lerp(b, s2 / (steps + 1)) + right * side * (w / 2 + 2)
			Kit.LanternPost(pf, V(p.X, GY, p.Z), 6, -right * side) -- кронштейн к дороге
		end
	end)

	mapPortal(map, pts)
	mapCore(map, pts)
	mapDecor(map, c, road, rng)
	local bs = HM.BattleSpawn
	block(map, V(8, 1, 8), CF(bs.X, GY + 0.5, bs.Z), rgb(60, 26, 20), nil, { Name = "BattlePad" })
	neon(map, V(7, 0.05, 7), CF(bs.X, GY + 1.03, bs.Z), H.Orange, { Name = "BattlePadGlow", Transparency = 0.6 })
	map.WorldPivot = CF(c)
	Kit.Calm(map)
	map.Parent = workspace
	return map
end

return HW
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX4A4E23C576A34D17E2269F1E0DA76989">
					<Properties>
						<string name="Name">Kit</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: World.Kit
-- Строительные помощники мира: детали, свет, частицы, вывески, круги зон, статуи юнитов,
-- приглушение неона (Calm) и общий декор (кристаллы, деревья, руины, тыквы, надгробия, фонари...).
-- Всё из примитивов; единственная текстура — встроенный дым.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")

local Kit = {}

local V, CF, ANG, rad = Vector3.new, CFrame.new, CFrame.Angles, math.rad
local rgb = Color3.fromRGB
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

-- палитра Void
Kit.C = {
	Ground = rgb(38, 34, 48), Ground2 = rgb(46, 38, 60), Moss = rgb(52, 34, 72), Rock = rgb(30, 27, 38),
	Rock2 = rgb(44, 40, 54), Path = rgb(72, 64, 84), PathEdge = rgb(56, 50, 66), Stone = rgb(88, 84, 98),
	Stone2 = rgb(64, 60, 74), Neon = rgb(170, 70, 255), NeonPink = rgb(255, 70, 180), NeonSoft = rgb(210, 150, 255),
	Bark = rgb(28, 22, 30), Leaf = rgb(46, 22, 64), Leaf2 = rgb(30, 16, 44), Black = rgb(12, 8, 18),
}
-- палитра Хэллоуина
Kit.H = {
	Black = rgb(14, 10, 16), Ground = rgb(34, 26, 36), Ground2 = rgb(44, 30, 40), Grass = rgb(46, 34, 30), GrassP = rgb(42, 24, 54),
	Rock = rgb(30, 24, 32), Rock2 = rgb(44, 36, 46), Stone = rgb(78, 70, 82), Stone2 = rgb(58, 52, 64), Road = rgb(64, 54, 58),
	RoadEdge = rgb(44, 36, 42), Purple = rgb(70, 30, 110), DeepPurple = rgb(36, 18, 56), Orange = rgb(255, 130, 30),
	Ember = rgb(255, 90, 20), Pumpkin = rgb(220, 110, 30), PumpkinD = rgb(170, 70, 20), Stem = rgb(60, 70, 30),
	Burgundy = rgb(100, 20, 34), Gold = rgb(200, 156, 60), Bark = rgb(32, 24, 26), Bone = rgb(200, 192, 176),
	Ghost = rgb(220, 225, 255), Fog = rgb(150, 140, 170), Moon = rgb(255, 214, 150), Window = rgb(255, 160, 60), Rune = rgb(170, 70, 255),
}
local C, H = Kit.C, Kit.H

------------------------------------------------------------------------
-- БАЗА
------------------------------------------------------------------------
-- деталь: Class Size CFrame Color Material Shape Transparency CanCollide CastShadow Name (+ Query=false — не мешает рейкастам)
function Kit.Part(parent, o)
	local p = Instance.new(o.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = o.Material or Enum.Material.SmoothPlastic
	p.Color = o.Color or C.Ground
	if o.Shape then
		p.Shape = o.Shape
	end
	p.Size = o.Size or V(4, 4, 4)
	p.CFrame = o.CFrame or CF()
	p.Transparency = o.Transparency or 0
	p.CanCollide = o.CanCollide ~= false
	p.CastShadow = o.CastShadow ~= false and p.Material ~= Enum.Material.Neon
	if o.Query == false then
		p.CanQuery = false
		p.CanTouch = false
	end
	p.Name = o.Name or "Part"
	p.Parent = parent
	return p
end
local part = Kit.Part

-- сокращения: блок, неон (без коллизии), клин
function Kit.Block(parent, size, cf, color, mat, extra)
	local o = { Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.Slate }
	if extra then
		for k, v in pairs(extra) do
			o[k] = v
		end
	end
	return part(parent, o)
end
local block = Kit.Block

function Kit.Neon(parent, size, cf, color, extra)
	local o = { CanCollide = false }
	if extra then
		for k, v in pairs(extra) do
			o[k] = v
		end
	end
	return block(parent, size, cf, color, Enum.Material.Neon, o)
end
local neon = Kit.Neon

function Kit.Wedge(parent, size, cf, color, mat, collide)
	return part(parent, { Class = "WedgePart", Size = size, CFrame = cf, Color = color, Material = mat or Enum.Material.Slate, CanCollide = collide == true })
end
local wedge = Kit.Wedge

-- невидимый помощник (свет/частицы): не мешает ни коллизии, ни рейкастам
function Kit.Ghost(parent, size, pos, name)
	return part(parent, { Size = size, CFrame = CF(pos), Transparency = 1, CanCollide = false, Query = false, CastShadow = false, Name = name or "Helper" })
end

function Kit.Light(p, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = p
	return l
end
local light = Kit.Light

function Kit.Emitter(p, color, o)
	o = o or {}
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Rate = o.Rate or 10
	e.Lifetime = NumberRange.new(o.LifeMin or 1, o.LifeMax or 2)
	e.Speed = NumberRange.new(o.SpeedMin or 1, o.SpeedMax or 3)
	e.SpreadAngle = Vector2.new(o.Spread or 180, o.Spread or 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, o.Size or 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	if o.Accel then
		e.Acceleration = o.Accel
	end
	if o.Dir then
		e.EmissionDirection = o.Dir
	end
	e.Parent = p
	return e
end
local emitter = Kit.Emitter

-- стелющийся туман (встроенная текстура дыма)
function Kit.Fog(p, color, rate, size)
	size = size or 6
	local e = Instance.new("ParticleEmitter")
	e.Name = "Fog"
	e.Texture = SMOKE
	e.Color = ColorSequence.new(color or H.Fog)
	e.LightEmission = 0.1
	e.LightInfluence = 0.6
	e.Rate = rate or 2
	e.Lifetime = NumberRange.new(5, 8)
	e.Speed = NumberRange.new(0.3, 1)
	e.SpreadAngle = Vector2.new(180, 10)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-10, 10)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size), NumberSequenceKeypoint.new(1, size * 1.8) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.75), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = p
	return e
end

-- вертикальный диск (ось цилиндра = X детали; локальный +X смотрит вверх)
function Kit.CylY(parent, name, r, h, center, color, mat, o)
	o = o or {}
	return part(parent, {
		Name = name, Shape = Enum.PartType.Cylinder, Size = V(h, r * 2, r * 2), CFrame = CF(center) * ANG(0, 0, rad(90)),
		Color = color, Material = mat or Enum.Material.Slate, CanCollide = o.CanCollide, Transparency = o.Transparency,
		Query = o.Query,
	})
end
local cylY = Kit.CylY

function Kit.Cyl(parent, name, size, cf, color, mat, o)
	o = o or {}
	return part(parent, {
		Name = name, Shape = Enum.PartType.Cylinder, Size = size, CFrame = cf, Color = color,
		Material = mat or Enum.Material.Slate, CanCollide = o.CanCollide, Transparency = o.Transparency,
	})
end

function Kit.Ball(parent, name, d, pos, color, mat, o)
	o = o or {}
	return part(parent, {
		Name = name, Shape = Enum.PartType.Ball, Size = V(d, d, d), CFrame = CF(pos), Color = color,
		Material = mat or Enum.Material.Neon, CanCollide = o.CanCollide == true, Transparency = o.Transparency,
	})
end

local function textLabel(parent, text, color, font)
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = font
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color
	t.TextStrokeTransparency = 0
	t.Parent = parent
	return t
end

-- парящая подпись над точкой
function Kit.Billboard(parent, pos, title, subtitle, color, size)
	size = size or 14
	local anchor = Kit.Ghost(parent, V(1, 1, 1), pos, "Label")
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(size, 0, size * 0.4, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 250
	bb.Parent = anchor
	local t = textLabel(bb, title, color, Enum.Font.FredokaOne)
	t.TextStrokeColor3 = rgb(15, 0, 25)
	t.Size = UDim2.fromScale(1, subtitle and 0.65 or 1)
	if subtitle then
		local s = textLabel(bb, subtitle, rgb(235, 225, 255), Enum.Font.GothamBold)
		s.TextStrokeColor3 = rgb(15, 0, 25)
		s.Position = UDim2.fromScale(0, 0.65)
		s.Size = UDim2.fromScale(1, 0.35)
	end
	return anchor
end

-- вывеска: чёрная плита, неоновая рамка сзади, текст на лицевой (Front = LookVector) стороне
function Kit.Sign(parent, cf, size, title, sub, titleColor, frameColor, subColor)
	local p = block(parent, size, cf, H.Black, Enum.Material.Slate, { Name = "Sign" })
	neon(parent, V(size.X + 1, size.Y + 1, 0.3), cf * CF(0, 0, size.Z / 2 + 0.1), frameColor or H.Orange, { Name = "SignFrame" })
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.LightInfluence = 0
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 30
	g.Parent = p
	local t = textLabel(g, title, titleColor or H.Orange, Enum.Font.FredokaOne)
	t.RichText = true
	t.Size = UDim2.fromScale(1, sub and 0.62 or 1)
	if sub then
		local s = textLabel(g, sub, subColor or rgb(245, 230, 210), Enum.Font.GothamBold)
		s.RichText = true
		s.Position = UDim2.fromScale(0.04, 0.62)
		s.Size = UDim2.fromScale(0.92, 0.34)
	end
	return p
end

-- Модуль модели по имени (без вечного ожидания); nil — нет или упал
local function model(name)
	local models = Shared:FindFirstChild("Models")
	local m = models and models:FindFirstChild(name)
	if not m then
		return nil
	end
	local ok, res = pcall(require, m)
	return ok and res or nil
end
Kit.Model = model

local function anchorAll(m)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
		end
	end
end
Kit.AnchorAll = anchorAll

-- статуя юнита (уровень 5) на постаменте, повёрнута к lookAt (только по рысканью)
function Kit.Statue(parent, unitId, pos, lookAt, pedH)
	pedH = pedH or 3
	local UnitModels = model("Units")
	if not UnitModels then
		return nil
	end
	local ok, rig = pcall(UnitModels.Build, unitId, 5)
	if not ok or not rig then
		warn("[VOID TD] Статуя " .. tostring(unitId) .. " не построена: " .. tostring(rig))
		return nil
	end
	block(parent, V(5, pedH, 5), CF(pos + V(0, pedH / 2, 0)), C.Stone2, nil, { Name = "Pedestal" })
	block(parent, V(5.6, 0.5, 5.6), CF(pos + V(0, pedH + 0.25, 0)), C.Stone, nil, { Name = "PedestalTop" })
	neon(parent, V(5.7, 0.25, 5.7), CF(pos + V(0, pedH - 0.6, 0)), C.Neon, { Name = "PedestalRune" })
	local m = rig.Model
	m.Name = "Statue_" .. unitId
	local base = pos + V(0, pedH + 0.5 + (rig.HipHeight or 0), 0)
	m:PivotTo(CFrame.lookAt(base, V(lookAt.X, base.Y, lookAt.Z)))
	anchorAll(m)
	m.Parent = parent
	return m
end

-- приглушение неона и света (один раз на корень)
local CALM_TO = rgb(14, 10, 22)
function Kit.Calm(root)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and d.Material == Enum.Material.Neon then
			d.Color = d.Color:Lerp(CALM_TO, 0.3)
		elseif d:IsA("PointLight") then
			d.Brightness *= 0.65
		end
	end
end

-- вращение/покачивание (клиент читает атрибуты)
function Kit.Spin(obj, spin, axis, bobAmp, bobSpeed)
	if spin then
		obj:SetAttribute("Spin", spin)
		obj:SetAttribute("SpinAxis", axis or "Y")
	end
	if bobAmp then
		obj:SetAttribute("BobAmp", bobAmp)
	end
	if bobSpeed then
		obj:SetAttribute("BobSpeed", bobSpeed)
	end
	return obj
end
local spinAttr = Kit.Spin

-- круг зоны: каменная база, неоновый край, стеклянная площадка, столб света, подпись
function Kit.ZoneCircle(parent, key, z, zc, subtitle, padColor)
	local zm = Instance.new("Model")
	zm.Name = key
	cylY(zm, "PadBase", z.Radius + 1.2, 0.6, zc + V(0, 0.3, 0), C.Stone2)
	cylY(zm, "PadEdge", z.Radius + 0.5, 0.65, zc + V(0, 0.33, 0), z.Color, Enum.Material.Neon)
	local pad = cylY(zm, "Pad", z.Radius, 0.7, zc + V(0, 0.36, 0), padColor or rgb(25, 15, 40), Enum.Material.Glass, { Transparency = 0.15 })
	local beam = cylY(zm, "LightBeam", z.Radius * 0.9, 26, zc + V(0, 13, 0), z.Color, Enum.Material.Neon, { CanCollide = false, Transparency = 0.88, Query = false })
	beam.CastShadow = false
	emitter(pad, z.Color, { Rate = 14, Size = 0.5, SpeedMin = 2, SpeedMax = 4, Spread = 10, Dir = Enum.NormalId.Right, LifeMin = 1.5, LifeMax = 2.5 })
	light(pad, z.Color, 18, 2)
	Kit.Billboard(zm, zc + V(0, 8.5, 0), z.Title, subtitle or (z.Teleport and "войди в портал" or "встань в круг"), z.Color, 12)
	zm:SetAttribute("Zone", key)
	zm.Parent = parent
	return zm
end

-- каменное кольцо-портал (декор) с вихрем
function Kit.RingPortal(parent, center, facing)
	local R = 9
	local base = CFrame.lookAt(center, center + facing)
	local rng = Random.new(7)
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		local off = CF(math.cos(a) * R, math.sin(a) * R, 0)
		block(parent, V(3.4, 3, 2.6), base * off * ANG(0, 0, a + rad(rng:NextNumber(-3, 3))), i % 2 == 0 and C.Stone or C.Stone2, nil, { Name = "PortalStone" })
		if i % 4 == 0 then
			neon(parent, V(0.6, 1.3, 0.3), base * off * ANG(0, 0, a) * CF(0, 0, -1.35), C.Neon, { Name = "Rune" })
		end
	end
	local disc = Kit.Cyl(parent, "PortalDisc", V(0.4, 15.6, 15.6), base * ANG(0, rad(90), 0), rgb(120, 40, 210), Enum.Material.Neon, { CanCollide = false, Transparency = 0.2 })
	for i = 1, 3 do
		local s = neon(parent, V(0.6, 14.4, 0.7), base * ANG(0, 0, rad(i * 60)) * CF(0, 0, -0.4), C.NeonSoft, { Name = "Swirl", Transparency = 0.35 })
		spinAttr(s, -1.4 - i * 0.3, "Z")
	end
	light(disc, C.Neon, 40, 4)
	emitter(disc, C.Neon, { Rate = 30, Size = 0.7, SpeedMin = 2, SpeedMax = 5 })
	return disc
end

------------------------------------------------------------------------
-- ДЕКОР VOID
------------------------------------------------------------------------
function Kit.CrystalCluster(parent, rng, p, scale)
	local m = Instance.new("Model")
	m.Name = "CrystalCluster"
	local colors = { C.Neon, C.NeonSoft, C.NeonPink }
	local first
	for i = 1, rng:NextInteger(3, 5) do
		local h = rng:NextNumber(2.5, 6) * scale * (i == 1 and 1.4 or 1)
		local w = h * rng:NextNumber(0.25, 0.4)
		local off = V(rng:NextNumber(-1.6, 1.6), 0, rng:NextNumber(-1.6, 1.6)) * scale
		local cf = CF(p + off + V(0, h * 0.4, 0)) * ANG(rad(rng:NextNumber(-25, 25)), rad(rng:NextNumber(0, 90)), rad(rng:NextNumber(-25, 25)))
		local cr = part(m, { Name = "Crystal", Size = V(w, h, w), CFrame = cf, Material = Enum.Material.Neon, Color = colors[rng:NextInteger(1, i == 1 and 1 or 3)] })
		first = first or cr
	end
	block(m, V(3.5, 1.2, 3) * scale, CF(p + V(0, 0.4, 0)) * ANG(0, rad(rng:NextNumber(0, 90)), 0), C.Rock2, nil, { Name = "Rock" })
	light(first, C.Neon, 16 * scale, 1.6)
	m.Parent = parent
	return m
end

local function sphereMesh(p)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Parent = p
end

function Kit.DarkTree(parent, rng, p)
	local m = Instance.new("Model")
	m.Name = "DarkTree"
	local wood = Enum.Material.Wood
	local h = rng:NextNumber(9, 14)
	local lean = rad(rng:NextNumber(-8, 8))
	local trunkCF = CF(p + V(0, h / 2, 0)) * ANG(lean, rad(rng:NextNumber(0, 180)), lean * 0.5)
	block(m, V(1.6, h, 1.6), trunkCF, C.Bark, wood, { Name = "Trunk" })
	block(m, V(3.2, 1, 3.2), CF(p + V(0, 0.4, 0)) * ANG(0, rad(rng:NextNumber(0, 90)), 0), C.Bark, wood, { Name = "Root" })
	local topCF = trunkCF * CF(0, h / 2, 0)
	for i = 1, 3 do
		local a = rad(i * 120 + rng:NextNumber(-20, 20))
		local len = rng:NextNumber(3, 5)
		local br = topCF * ANG(0, a, 0) * CF(0, -0.6 * i, 0) * ANG(rad(55), 0, 0) * CF(0, len / 2, 0)
		block(m, V(0.7, len, 0.7), br, C.Bark, wood, { Name = "Branch" })
		local size = V(rng:NextNumber(3.5, 5.5), rng:NextNumber(2.5, 3.5), rng:NextNumber(3.5, 5.5))
		local lf = block(m, size, br * CF(0, len / 2 + 0.6, 0) * ANG(rad(rng:NextNumber(-15, 15)), rad(rng:NextNumber(0, 90)), 0), i % 2 == 0 and C.Leaf or C.Leaf2, Enum.Material.Grass, { Name = "Leaves" })
		sphereMesh(lf)
	end
	local crown = block(m, V(5.5, 4, 5.5), topCF * CF(0, 1.4, 0) * ANG(0, rad(rng:NextNumber(0, 90)), rad(rng:NextNumber(-8, 8))), C.Leaf, Enum.Material.Grass, { Name = "Crown" })
	sphereMesh(crown)
	if rng:NextNumber() < 0.5 then
		local g = part(m, { Name = "Glow", Shape = Enum.PartType.Ball, Size = V(0.8, 0.8, 0.8), CFrame = topCF * CF(1.5, 0, -1.8), Material = Enum.Material.Neon, Color = C.NeonPink, CanCollide = false })
		light(g, C.NeonPink, 8, 1)
	end
	m.Parent = parent
	return m
end

function Kit.Ruin(parent, rng, p)
	local m = Instance.new("Model")
	m.Name = "Ruins"
	local base = CF(p) * ANG(0, rad(rng:NextNumber(0, 180)), 0)
	local cols = rng:NextInteger(3, 5)
	local heights = {}
	for x = 1, cols do
		local hh = rng:NextInteger(1, 4)
		heights[x] = hh
		for y = 1, hh do
			if not (x == 2 and y <= 2) then -- проём
				block(m, V(2.8, 1.6, 1.6), base * CF((x - cols / 2) * 2.9, 0.8 + (y - 1) * 1.65, 0) * ANG(0, rad(rng:NextNumber(-4, 4)), 0), (x + y) % 2 == 0 and C.Stone or C.Stone2, nil, { Name = "Brick" })
			end
		end
	end
	block(m, V(6.2, 1.2, 1.8), base * CF((2 - cols / 2) * 2.9, 4.0, 0) * ANG(0, 0, rad(rng:NextNumber(-6, 6))), C.Stone, nil, { Name = "Lintel" })
	for _ = 1, 4 do
		local s = rng:NextNumber(0.8, 1.8)
		block(m, V(1.6 * s, s, 1.2 * s), base * CF(rng:NextNumber(-6, 6), s / 2, rng:NextNumber(1.5, 4)) * ANG(rad(rng:NextNumber(-20, 20)), rad(rng:NextNumber(0, 90)), rad(rng:NextNumber(-20, 20))), C.Stone2, nil, { Name = "Rubble" })
	end
	-- руна на последней колонне (не висит в воздухе: на уровне её верха)
	local runeY = math.min(2.2, 0.8 + (heights[cols] - 1) * 1.65)
	local rune = neon(m, V(1, 1, 0.2), base * CF((cols - cols / 2) * 2.9, runeY, -0.85), C.Neon, { Name = "Rune" })
	light(rune, C.Neon, 8, 1)
	m.Parent = parent
	return m
end

function Kit.BrokenColumn(parent, rng, p)
	local m = Instance.new("Model")
	m.Name = "BrokenColumn"
	local h = rng:NextNumber(4, 12)
	block(m, V(4, 1, 4), CF(p + V(0, 0.5, 0)), C.Stone2, nil, { Name = "Base" })
	Kit.Cyl(m, "Shaft", V(h, 2.6, 2.6), CF(p + V(0, 1 + h / 2, 0)) * ANG(0, 0, rad(90)) * ANG(rad(rng:NextNumber(-3, 3)), 0, 0), C.Stone)
	block(m, V(2.4, 0.9, 2.4), CF(p + V(0.3, 1 + h + 0.2, 0)) * ANG(rad(14), rad(30), rad(-10)), C.Stone2, nil, { Name = "Break" })
	local len = rng:NextNumber(3, 6)
	local a = rad(rng:NextNumber(0, 360))
	Kit.Cyl(m, "FallenPiece", V(len, 2.4, 2.4), CF(p + V(math.cos(a) * 4, 1.2, math.sin(a) * 4)) * ANG(0, a, 0), C.Stone2)
	m.Parent = parent
	return m
end

function Kit.FloatingIsland(parent, rng, p, s)
	local m = Instance.new("Model")
	m.Name = "FloatingIsland"
	block(m, V(14, 3, 12) * s, CF(p) * ANG(0, rad(rng:NextNumber(0, 90)), 0), C.Ground2, nil, { Name = "Top" })
	block(m, V(10, 5, 8) * s, CF(p - V(0, 3.5 * s, 0)) * ANG(0, rad(rng:NextNumber(0, 90)), 0), C.Rock, nil, { Name = "Mid" })
	block(m, V(5, 6, 4) * s, CF(p - V(0, 8 * s, 0)) * ANG(rad(10), rad(rng:NextNumber(0, 90)), 0), C.Rock2, nil, { Name = "Bottom" })
	Kit.CrystalCluster(m, rng, p + V(0, 1.5 * s, 0), s)
	spinAttr(m, nil, nil, rng:NextNumber(1.2, 2.5), rng:NextNumber(0.3, 0.6))
	m.WorldPivot = CF(p)
	m.Parent = parent
	return m
end

------------------------------------------------------------------------
-- ДЕКОР ХЭЛЛОУИНА
------------------------------------------------------------------------
function Kit.Pumpkin(parent, pos, s, carved, yaw)
	local m = Instance.new("Model")
	m.Name = "Pumpkin"
	local base = CF(pos + V(0, 0.55 * s, 0)) * ANG(0, yaw or 0, 0)
	local first
	for i = 0, 5 do
		local p = block(m, V(0.62 * s, 1.0 * s, 0.62 * s), base * ANG(0, rad(i * 60), 0) * CF(0, 0, -0.38 * s), i % 2 == 0 and H.Pumpkin or H.PumpkinD, Enum.Material.SmoothPlastic, { CanCollide = false })
		first = first or p
	end
	block(m, V(0.18 * s, 0.4 * s, 0.18 * s), base * CF(0, 0.62 * s, 0) * ANG(0, 0, rad(12)), H.Stem, Enum.Material.Wood, { CanCollide = false })
	if carved then
		local f = base * CF(0, 0, -0.72 * s)
		for sx = -1, 1, 2 do
			neon(m, V(0.2 * s, 0.2 * s, 0.06), f * CF(sx * 0.2 * s, 0.15 * s, 0) * ANG(0, 0, rad(45)), H.Orange)
		end
		neon(m, V(0.5 * s, 0.1 * s, 0.06), f * CF(0, -0.2 * s, 0), H.Orange)
		if s >= 1.2 then
			light(first, H.Orange, 8 * s, 0.8)
		end
	end
	m.Parent = parent
	return m
end

function Kit.DeadTree(parent, rng, pos, s)
	s = s or 1
	local m = Instance.new("Model")
	m.Name = "DeadTree"
	local wood = Enum.Material.Wood
	local h = rng:NextNumber(9, 14) * s
	local lean = rad(rng:NextNumber(-6, 6))
	local trunk = CF(pos) * ANG(lean, rng:NextNumber(0, 6), lean * 0.5)
	block(m, V(1.4 * s, h, 1.4 * s), trunk * CF(0, h / 2, 0), H.Bark, wood)
	block(m, V(2.4 * s, 1.2 * s, 2.4 * s), trunk * CF(0, 0.4 * s, 0) * ANG(0, rad(45), 0), H.Bark, wood)
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2 + rng:NextNumber(-0.4, 0.4)
		local y = h * rng:NextNumber(0.5, 0.95)
		local L = rng:NextNumber(3, 5.5) * s
		local br = trunk * CF(0, y, 0) * ANG(0, a, 0) * ANG(0, 0, rad(rng:NextNumber(45, 65)))
		block(m, V(0.5 * s, L, 0.5 * s), br * CF(0, L / 2, 0), H.Bark, wood, { CanCollide = false })
		block(m, V(0.3 * s, 0.5 * L, 0.3 * s), br * CF(0, L, 0) * ANG(0, 0, rad(-35)) * CF(0, 0.25 * L, 0), H.Bark, wood, { CanCollide = false })
	end
	m.Parent = parent
	return m
end

function Kit.Tombstone(parent, rng, pos, yaw)
	local kind = rng:NextInteger(1, 3)
	local cf = CF(pos) * ANG(rad(rng:NextNumber(-6, 6)), yaw, rad(rng:NextNumber(-8, 8)))
	if kind == 1 then
		block(parent, V(2, 2.6, 0.5), cf * CF(0, 1.3, 0), H.Stone2)
		block(parent, V(1.6, 0.6, 0.5), cf * CF(0, 2.8, 0) * ANG(0, 0, rad(45)), H.Stone2)
	elseif kind == 2 then
		block(parent, V(0.45, 3.2, 0.45), cf * CF(0, 1.6, 0), H.Stone)
		block(parent, V(1.8, 0.45, 0.45), cf * CF(0, 2.3, 0), H.Stone)
	else
		block(parent, V(2.4, 1.6, 0.7), cf * CF(0, 0.8, 0), H.Stone2)
		block(parent, V(2.6, 0.3, 0.9), cf * CF(0, 1.7, 0), H.Stone)
	end
	block(parent, V(2.2, 0.4, 3.6), cf * CF(0, 0.15, 1.9), H.Grass, Enum.Material.Ground, { CanCollide = false })
end

function Kit.Fence(parent, a, b, color)
	color = color or H.Black
	local d = b - a
	local n = math.max(1, math.floor(d.Magnitude / 2.2))
	for i = 0, n do
		local p = a + d * (i / n)
		block(parent, V(0.3, 2.6, 0.3), CF(p + V(0, 1.3, 0)), color, Enum.Material.Metal)
		wedge(parent, V(0.3, 0.5, 0.3), CF(p + V(0, 2.85, 0)), color, Enum.Material.Metal)
	end
	local mid = (a + b) / 2
	for _, y in ipairs({ 2.1, 0.8 }) do
		block(parent, V(0.18, 0.18, d.Magnitude), CFrame.lookAt(mid + V(0, y, 0), b + V(0, y, 0)), color, Enum.Material.Metal)
	end
end

-- фонарь на столбе; dir — куда смотрит кронштейн (по умолчанию +X)
function Kit.LanternPost(parent, pos, h, dir)
	h = h or 7
	local metal = Enum.Material.Metal
	local base = CF(pos)
	if dir and dir.Magnitude > 0 then
		base = CFrame.lookAt(pos, pos + V(dir.Z, 0, -dir.X)) -- локальный +X = dir
	end
	block(parent, V(0.5, h, 0.5), base * CF(0, h / 2, 0), H.Black, metal)
	block(parent, V(1.8, 0.3, 0.3), base * CF(0.6, h - 0.3, 0), H.Black, metal)
	local cage = block(parent, V(0.9, 1.1, 0.9), base * CF(1.3, h - 1.2, 0), H.Black, metal, { Transparency = 0.2, CanCollide = false })
	local flame = neon(parent, V(0.55, 0.7, 0.55), base * CF(1.3, h - 1.2, 0), H.Orange)
	light(flame, H.Orange, 16, 1.4)
	wedge(parent, V(1.1, 0.5, 1.1), base * CF(1.3, h - 0.45, 0), H.Black, metal)
	return cage
end

-- летучая мышь кружит вокруг pos: опорная точка модели — центр орбиты (PrimaryPart не ставим)
function Kit.Bat(parent, pos, r, speed)
	local m = Instance.new("Model")
	m.Name = "Bat"
	block(m, V(0.6, 0.5, 0.9), CF(pos + V(r, 0, 0)), H.Black, Enum.Material.SmoothPlastic, { CanCollide = false, Name = "Body" })
	for s = -1, 1, 2 do
		local w = wedge(m, V(0.1, 0.6, 1.6), CF(pos + V(r + s * 0.9, 0.1, 0)) * ANG(0, 0, rad(-70 * s)), H.Black, Enum.Material.SmoothPlastic)
		w.Name = "Wing"
	end
	neon(m, V(0.3, 0.1, 0.05), CF(pos + V(r, 0.08, -0.46)), H.Ember, { Name = "Eyes" })
	m.WorldPivot = CF(pos)
	spinAttr(m, speed, "Y", 0.8, 2.2)
	m.Parent = parent
	return m
end

function Kit.Crow(parent, pos, yaw)
	local cf = CF(pos) * ANG(0, yaw or 0, 0)
	local sp = Enum.Material.SmoothPlastic
	block(parent, V(0.5, 0.5, 0.9), cf * CF(0, 0.35, 0), H.Black, sp, { CanCollide = false })
	block(parent, V(0.4, 0.4, 0.4), cf * CF(0, 0.75, -0.4), H.Black, sp, { CanCollide = false })
	wedge(parent, V(0.15, 0.15, 0.4), cf * CF(0, 0.7, -0.75) * ANG(rad(90), 0, 0), H.Gold, sp)
	wedge(parent, V(0.3, 0.12, 0.6), cf * CF(0, 0.3, 0.6) * ANG(rad(180), 0, 0), H.Black, sp)
end

function Kit.GhostFigure(parent, pos, s)
	s = s or 1
	local m = Instance.new("Model")
	m.Name = "Ghost"
	local cf = CF(pos)
	local o = { Transparency = 0.55, CanCollide = false }
	local sp = Enum.Material.SmoothPlastic
	local body = block(m, V(2.2 * s, 2.4 * s, 1.8 * s), cf * CF(0, 1.6 * s, 0), H.Ghost, sp, o)
	block(m, V(1.8 * s, 1.6 * s, 1.6 * s), cf * CF(0, 3.4 * s, 0), H.Ghost, sp, o)
	for i = -1, 1 do
		local w = wedge(m, V(0.7 * s, 0.9 * s, 1.6 * s), cf * CF(i * 0.7 * s, 0.05, 0) * ANG(0, 0, rad(180)), H.Ghost, sp)
		w.Transparency = 0.55
	end
	for sx = -1, 1, 2 do
		block(m, V(0.3 * s, 0.45 * s, 0.05), cf * CF(sx * 0.35 * s, 3.5 * s, -0.81 * s), H.Black, sp, { CanCollide = false })
	end
	m.PrimaryPart = body
	spinAttr(m, nil, nil, 1.2, 1.1)
	m.Parent = parent
	return m
end

function Kit.Spire(parent, cf, w, h, color)
	color = color or H.DeepPurple
	for i = 0, 4 do
		local k = 1 - i / 5
		block(parent, V(w * k, h / 5, w * k), cf * CF(0, h / 5 * (i + 0.5), 0) * ANG(0, i % 2 == 1 and rad(45) or 0, 0), color)
	end
	block(parent, V(0.3, 0.35 * h, 0.3), cf * CF(0, h + 0.17 * h, 0), H.Gold, Enum.Material.Metal, { CanCollide = false })
end

function Kit.Tower(parent, base, w, h, ruined, rng)
	block(parent, V(w, h, w), CF(base + V(0, h / 2, 0)), H.Stone2)
	for i = 1, math.floor(h / 7) do
		for k = 0, 3 do
			local cf = CF(base + V(0, 7 * i - 2, 0)) * ANG(0, rad(k * 90), 0) * CF(0, 0, -w / 2 - 0.05)
			neon(parent, V(1.1, 2.2, 0.1), cf, H.Window)
			local wg = wedge(parent, V(1.1, 0.7, 0.12), cf * CF(0, 1.45, 0), H.Window, Enum.Material.Neon)
			wg.CastShadow = false
		end
	end
	if ruined then
		for i = 1, 5 do
			local a = i / 5 * math.pi * 2
			local hh = rng:NextNumber(1, 4)
			block(parent, V(w * 0.35, hh, w * 0.35), CF(base + V(math.cos(a) * 0.35 * w, h + hh / 2, math.sin(a) * 0.35 * w)) * ANG(0, a, rad(rng:NextNumber(-10, 10))), H.Stone2)
		end
	else
		block(parent, V(w + 1.2, 1, w + 1.2), CF(base + V(0, h + 0.5, 0)), H.Stone)
		Kit.Spire(parent, CF(base + V(0, h + 1, 0)), w + 0.4, 2.2 * w, H.DeepPurple)
	end
end

function Kit.House(parent, pos, yaw, s)
	s = s or 1
	local cf = CF(pos) * ANG(0, yaw, 0)
	block(parent, V(10 * s, 7 * s, 8 * s), cf * CF(0, 3.5 * s, 0), H.Rock2, Enum.Material.WoodPlanks)
	for side = -1, 1, 2 do
		wedge(parent, V(10.6 * s, 4.5 * s, 4.6 * s), cf * CF(0, 9.25 * s, side * 2.3 * s) * ANG(0, side > 0 and math.pi or 0, 0), H.Burgundy, Enum.Material.Slate, true)
	end
	block(parent, V(1.2 * s, 4 * s, 1.2 * s), cf * CF(3 * s, 10 * s, 1.5 * s), H.Stone2)
	block(parent, V(2.2 * s, 3.8 * s, 0.2), cf * CF(0, 1.9 * s, -4.05 * s), H.Bark, Enum.Material.Wood)
	for sx = -1, 1, 2 do
		neon(parent, V(1.6 * s, 1.6 * s, 0.1), cf * CF(sx * 3 * s, 4 * s, -4.05 * s), H.Window)
	end
	local g = Kit.Ghost(parent, V(0.5, 0.5, 0.5), (cf * CF(0, 4 * s, -5 * s)).Position)
	light(g, H.Window, 14, 1)
end

function Kit.RuneCircle(parent, pos, r, color)
	color = color or H.Rune
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		neon(parent, V(0.5, 0.06, 1.4), CF(pos + V(math.cos(a) * r, 0.06, math.sin(a) * r)) * ANG(0, -a, 0), color)
	end
	for i = 0, 2 do
		neon(parent, V(1.6 * r, 0.05, 0.25), CF(pos + V(0, 0.05, 0)) * ANG(0, rad(i * 60), 0), color, { Transparency = 0.3 })
	end
end

-- круглый остров с ярусами снизу, кромкой и светящимся кончиком
function Kit.IslandDisc(parent, center, R, rng, placeable)
	local top = cylY(parent, "IslandTop", R, 4, center - V(0, 2, 0), H.Ground)
	if placeable then
		top:SetAttribute("Placeable", true)
	end
	local layers = { { 0.95, 10, -8 }, { 0.78, 14, -19 }, { 0.56, 16, -33 }, { 0.32, 16, -48 }, { 0.14, 14, -62 } }
	for i, L in ipairs(layers) do
		cylY(parent, "Bedrock" .. i, R * L[1], L[2], center + V(rng:NextNumber(-4, 4), L[3], rng:NextNumber(-4, 4)), i % 2 == 0 and H.Rock or H.Rock2)
	end
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		local s = rng:NextNumber(10, 18)
		block(parent, V(s, rng:NextNumber(5, 8), s), CF(center + V(math.cos(a) * (R - 4), -3.5, math.sin(a) * (R - 4))) * ANG(0, a + rng:NextNumber(-0.3, 0.3), 0), i % 2 == 0 and H.Rock or H.Rock2, nil, { Name = "EdgeRock" })
	end
	local tip = neon(parent, V(8, 18, 8), CF(center - V(0, 76, 0)) * ANG(rad(8), rad(45), 0), H.Ember, { Name = "IslandTip" })
	light(tip, H.Orange, 40, 2)
	return top
end

-- пятна травы на круглом острове
function Kit.Patches(parent, center, R, rng, n, placeable)
	for i = 1, n do
		local a, d = rng:NextNumber(0, math.pi * 2), rng:NextNumber(0, R - 14)
		local w, l = rng:NextNumber(10, 26), rng:NextNumber(10, 22)
		local p = part(parent, {
			Name = "Patch", Size = V(w, 0.2, l), CFrame = CF(center + V(math.cos(a) * d, 0.02 + 0.004 * i, math.sin(a) * d)) * ANG(0, rng:NextNumber(0, 3), 0),
			Color = i % 3 == 0 and H.GrassP or (i % 3 == 1 and H.Grass or H.Ground2), Material = Enum.Material.Grass, CastShadow = false,
		})
		if placeable then
			p:SetAttribute("Placeable", true)
		end
	end
end

-- дорога по точкам: полотно + бордюр; extra(i, a, b, cf, len, dir) — украшения сегмента
function Kit.Road(parent, points, y, w, roadColor, edgeColor, extra)
	for i = 2, #points do
		local a, b = points[i - 1], points[i]
		local mid = (a + b) / 2
		local len = (b - a).Magnitude
		local cf = CFrame.lookAt(V(mid.X, y + 0.15, mid.Z), V(b.X, y + 0.15, b.Z))
		block(parent, V(w, 0.3, len + w), cf, roadColor, Enum.Material.Cobblestone, { Name = "Road" })
		block(parent, V(w + 1.6, 0.22, len + w + 1.6), cf * CF(0, -0.06, 0), edgeColor, Enum.Material.Slate, { Name = "RoadEdge" })
		if extra then
			extra(i, a, b, cf, len, (b - a).Unit)
		end
	end
end

-- телепорт-подсказка: квадрат прибытия со свечением
function Kit.ArrivalPad(parent, pos, color, glow)
	block(parent, V(8, 1, 8), CF(pos + V(0, 0.5, 0)), color, nil, { Name = "BattlePad" })
	neon(parent, V(7, 0.05, 7), CF(pos + V(0, 1.03, 0)), glow, { Name = "BattlePadGlow", Transparency = 0.6 })
end

return Kit
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXC040D3F8CAED32179F6690563B00C03A">
					<Properties>
						<string name="Name">Lighting</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: World.Lighting
-- Ночное небо Пустоты: атмосфера, звёзды, мягкий bloom (клиент выключает VoidBloom в Lite), цветокоррекция.

local LightingService = game:GetService("Lighting")

local rgb = Color3.fromRGB

local function new(class, name, props)
	local o = Instance.new(class)
	o.Name = name
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = LightingService
	return o
end

return function()
	local L = LightingService
	L.ClockTime = 0.2
	L.Brightness = 2
	L.Ambient = rgb(58, 40, 86)
	L.OutdoorAmbient = rgb(86, 64, 120)
	L.ColorShift_Top = rgb(120, 80, 200)
	L.EnvironmentDiffuseScale = 0.4
	L.EnvironmentSpecularScale = 0.6
	L.GlobalShadows = true
	-- туман Lighting игнорируется при Atmosphere, но пусть совпадает по цвету
	L.FogColor = rgb(40, 20, 70)
	L.FogStart = 150
	L.FogEnd = 900
	pcall(function()
		L.Technology = Enum.Technology.Future -- из скрипта может быть недоступно — тогда как сохранено в месте
	end)
	for _, name in ipairs({ "VoidAtmosphere", "VoidBloom", "VoidColor", "VoidSky", "VoidRays" }) do
		local o = L:FindFirstChild(name)
		if o then
			o:Destroy()
		end
	end
	for _, ch in ipairs(L:GetChildren()) do
		if ch:IsA("Atmosphere") or ch:IsA("Sky") then
			ch:Destroy()
		end
	end
	new("Atmosphere", "VoidAtmosphere", {
		Density = 0.38, Offset = 0.15, Color = rgb(110, 60, 170), Decay = rgb(40, 10, 60), Glare = 0.3, Haze = 2.2,
	})
	new("Sky", "VoidSky", { StarCount = 5000, CelestialBodiesShown = true, MoonAngularSize = 18 })
	new("BloomEffect", "VoidBloom", { Intensity = 0.35, Size = 18, Threshold = 1.4 })
	new("ColorCorrectionEffect", "VoidColor", { Brightness = 0.02, Contrast = 0.12, Saturation = 0.12, TintColor = rgb(240, 225, 255) })
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX031243C8CD6874AFAC7E88DA1604B286">
					<Properties>
						<string name="Name">Lobby</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: World.Lobby
-- Главное лобби (workspace.VoidTDLobby): круглая платформа, круги зон (Zones), стойки кейсов,
-- статуи юнитов, декоративный портал ИГРАТЬ с вывеской, деревья/кристаллы, точка появления.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Kit = require(script.Parent:WaitForChild("Kit"))

local V, CF, ANG, rad = Vector3.new, CFrame.new, CFrame.Angles, math.rad
local rgb = Color3.fromRGB
local C = Kit.C
local block, neon, light, emitter, cylY = Kit.Block, Kit.Neon, Kit.Light, Kit.Emitter, Kit.CylY

local L = Config.Lobby

local function flat(a, b)
	return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude
end

local function outDir(offset)
	local o = V(offset.X, 0, offset.Z)
	return o.Magnitude > 0 and o.Unit or V(0, 0, 1)
end

local function platform(m, c, R, rng)
	local floor = cylY(m, "Floor", R, 4, c - V(0, 2, 0), C.Ground)
	floor:SetAttribute("Placeable", false)
	-- инкрустация: каждый слой чуть выше предыдущего (без z-fighting), сверху — центральный круг
	local inlays = {
		{ "OuterRing", R - 4, C.Neon, Enum.Material.Neon, 0.6 },
		{ "OuterFloor", R - 4.4, C.Ground, Enum.Material.Slate, 0 },
		{ "MidRing", 55.6, C.Neon, Enum.Material.Neon, 0.7 },
		{ "MidFloor", 55, C.Ground, Enum.Material.Slate, 0 },
		{ "InnerRing", 30.6, C.Neon, Enum.Material.Neon, 0.3 },
		{ "FloorInlay", 30, C.Ground2, Enum.Material.Slate, 0 },
	}
	for i, d in ipairs(inlays) do
		local top = 0.02 * i
		cylY(m, d[1], d[2], 0.1, c + V(0, top - 0.05, 0), d[3], d[4], { CanCollide = false, Transparency = d[5] })
	end
	local under = { { 0.9, 10, -8 }, { 0.68, 14, -19 }, { 0.45, 16, -33 }, { 0.22, 16, -48 } }
	for i, u in ipairs(under) do
		cylY(m, "Under" .. i, R * u[1], u[2], c + V(rng:NextNumber(-3, 3), u[3], rng:NextNumber(-3, 3)), i % 2 == 0 and C.Rock or C.Rock2)
	end
	local root = neon(m, V(7, 16, 7), CF(c + V(0, -62, 0)) * ANG(rad(6), rad(45), 0), C.Neon, { Name = "CrystalRoot", CanCollide = true })
	light(root, C.Neon, 40, 3)
	for i = 0, 35 do
		local a = i / 36 * math.pi * 2
		local s = rng:NextNumber(4, 7)
		local h = rng:NextNumber(1, 2.5)
		local p = c + V(math.cos(a) * (R - 1), 0, math.sin(a) * (R - 1))
		block(m, V(s, h, s), CF(p) * ANG(0, rad(rng:NextNumber(0, 90)), 0), C.Rock2, nil, { Name = "EdgeRock" })
		if i % 3 == 0 then
			local ph = rng:NextNumber(6, 10)
			local pp = c + V(math.cos(a) * (R - 3), 0, math.sin(a) * (R - 3))
			block(m, V(2.2, ph, 2.2), CF(pp + V(0, ph / 2, 0)) * ANG(0, a, 0), C.Stone2, nil, { Name = "Pillar" })
			local gem = neon(m, V(1, 1.6, 1), CF(pp + V(0, ph + 1.4, 0)) * ANG(0, rad(45), rad(45)), C.Neon, { Name = "PillarGem" })
			Kit.Spin(gem, 1.5, "Y")
			light(gem, C.Neon, 14, 1.2)
		end
	end
end

local function caseStand(m, key, z, zc)
	local out = outDir(z.Offset)
	local sp = zc + out * 13
	local vert = ANG(0, 0, rad(90))
	Kit.Cyl(m, "CaseStand", V(2.5, 9, 9), CF(sp + V(0, 1.25, 0)) * vert, C.Stone2)
	Kit.Cyl(m, "CaseStandRing", V(0.3, 9.4, 9.4), CF(sp + V(0, 2.4, 0)) * vert, z.Color, Enum.Material.Neon, { CanCollide = false })
	local CaseModels = Kit.Model("Cases")
	if CaseModels then
		local ok, built = pcall(CaseModels.Build, z.Case)
		if ok and built and built.Model then
			local cm = built.Model
			cm:ScaleTo(1.6)
			cm:PivotTo(CF(sp + V(0, 2.6, 0)) * CFrame.lookAt(V(), -out).Rotation)
			Kit.Spin(cm, 0.5, "Y")
			cm.Parent = m
		end
	end
	local glow = Kit.Ghost(m, V(0.5, 0.5, 0.5), sp + V(0, 6, 0), "CaseGlow")
	light(glow, z.Color, 22, 2)
	emitter(glow, z.Color, { Rate = 8, Size = 0.4, SpeedMin = 1, SpeedMax = 2 })
	local case = Config.Cases[z.Case]
	if case then
		Kit.Billboard(m, sp + V(0, 13, 0), case.Name, "💎" .. case.Cost1 .. " / x10 💎" .. case.Cost10, z.Color, 14)
	end
	return sp
end

local function statues(m, c)
	local uz = c + L.Zones.Units.Offset
	for _, s in ipairs({ { "VoidSoldier", V(13, 0, -9) }, { "ShadowArcher", V(15, 0, 0) }, { "LostMage", V(13, 0, 9) } }) do
		Kit.Statue(m, s[1], uz + s[2], uz, 2.5)
	end
	local pz = c + L.Zones.Play.Offset
	for _, s in ipairs({ { "VoidEmperor", V(-17, 0, -6) }, { "AbyssOverlord", V(17, 0, -6) }, { "RiftMonarch", V(-32, 0, 2) }, { "LunarSeraph", V(32, 0, 2) } }) do
		Kit.Statue(m, s[1], pz + s[2], c, 4)
	end
	for _, s in ipairs({ { "FallenAngel", V(-24, 0, 50) }, { "EclipseGuardian", V(24, 0, 50) }, { "Starbreaker", V(-42, 0, 42) }, { "BloodfangWarlord", V(42, 0, 42) } }) do
		Kit.Statue(m, s[1], c + s[2], c, 3)
	end
	for _, s in ipairs({ { "RealityDestroyer", V(-8, 0, 0) }, { "CrimsonEclipse", V(8, 0, 0) } }) do
		Kit.Statue(m, s[1], c + s[2], c + V(0, 0, 60), 5)
	end
	Kit.Billboard(m, c + V(0, 17, 0), "SECRET", "шанс 0.1% в новых кейсах", rgb(255, 40, 60), 12)
end

local function playPortal(m, c)
	local pz = c + L.Zones.Play.Offset
	Kit.RingPortal(m, pz + V(0, 10.5, -11), V(0, 0, 1))
	block(m, V(24, 1, 8), CF(pz + V(0, 0.5, -11)), C.Stone2, nil, { Name = "PortalBase" })
	local sign = block(m, V(30, 8, 1), CF(pz + V(0, 27, -12)) * ANG(0, math.pi, 0), C.Black, nil, { Name = "Sign" })
	neon(m, V(31, 9, 0.6), CF(pz + V(0, 27, -12.4)), C.Neon, { Name = "SignFrame" })
	local g = Instance.new("SurfaceGui")
	g.Face = Enum.NormalId.Front
	g.LightInfluence = 0
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = 30
	g.Parent = sign
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = "VOID TD"
	t.TextColor3 = rgb(200, 120, 255)
	t.TextStrokeTransparency = 0
	t.Size = UDim2.fromScale(1, 0.7)
	t.Parent = g
	local s = t:Clone()
	s.Text = "THE FORGOTTEN REALM"
	s.Font = Enum.Font.GothamBold
	s.TextColor3 = rgb(235, 225, 255)
	s.Position = UDim2.fromScale(0, 0.68)
	s.Size = UDim2.fromScale(1, 0.28)
	s.Parent = g
end

local function decor(m, c, R, rng, taken)
	for _, off in ipairs({ V(-24, 0, 50), V(24, 0, 50), V(-42, 0, 42), V(42, 0, 42), V(0, 0, 0), V(77, 0, 8), V(-32, 0, -60), V(32, 0, -60), V(0, 0, -73), V(-17, 0, -68), V(17, 0, -68) }) do
		taken[#taken + 1] = c + off
	end
	for i = 1, 24 do
		local a, d = rng:NextNumber(0, math.pi * 2), rng:NextNumber(36, R - 8)
		local p = c + V(math.cos(a) * d, 0, math.sin(a) * d)
		local ok = flat(p, L.Spawn) > 12
		for _, q in ipairs(taken) do
			if not ok then
				break
			end
			ok = flat(p, q) >= 16
		end
		if ok then
			taken[#taken + 1] = p
			if i % 2 == 0 then
				Kit.DarkTree(m, rng, p)
			else
				Kit.CrystalCluster(m, rng, p, rng:NextNumber(0.9, 1.4))
			end
		end
	end
end

return function()
	local rng = Random.new(4242)
	local c, R = L.Center, L.Radius
	local m = Instance.new("Model")
	m.Name = "VoidTDLobby"
	platform(m, c, R, rng)
	local zones = Instance.new("Folder")
	zones.Name = "Zones"
	zones.Parent = m
	local taken = {}
	for key, z in pairs(L.Zones) do
		local zc = c + z.Offset
		Kit.ZoneCircle(zones, key, z, zc)
		taken[#taken + 1] = zc
		if z.Case then
			taken[#taken + 1] = caseStand(m, key, z, zc)
		end
		if z.Teleport then
			-- место под ворота Хэллоуина (строятся отдельно)
			taken[#taken + 1] = zc + outDir(z.Offset) * 9
		end
	end
	statues(m, c)
	playPortal(m, c)
	decor(m, c, R, rng, taken)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "LobbySpawn"
	spawn.Anchored = true
	spawn.Size = V(10, 1, 10)
	spawn.CFrame = CF(L.Spawn + V(0, 0.5, 0))
	spawn.Color = rgb(70, 40, 110)
	spawn.Material = Enum.Material.Slate
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.BottomSurface = Enum.SurfaceType.Smooth
	spawn.Parent = m
	cylY(m, "SpawnGlow", 4.6, 0.08, L.Spawn + V(0, 1.03, 0), C.Neon, Enum.Material.Neon, { CanCollide = false, Transparency = 0.5 })
	m.WorldPivot = CF(c)
	Kit.Calm(m)
	m.Parent = workspace
	return m
end
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXB1BE0EB3959601254FEFBE1D0B1692DC">
					<Properties>
						<string name="Name">VoidMap</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: World.VoidMap
-- Карта «The Forgotten Realm» (workspace.VoidTDMap): парящий остров, дорога, портал врагов,
-- ядро игрока, декор, летающие островки, площадка прибытия.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))
local Path = require(Shared:WaitForChild("Path"))

local Kit = require(script.Parent:WaitForChild("Kit"))

local V, CF, ANG, rad = Vector3.new, CFrame.new, CFrame.Angles, math.rad
local rgb = Color3.fromRGB
local C = Kit.C
local block, neon, light, emitter, spin = Kit.Block, Kit.Neon, Kit.Light, Kit.Emitter, Kit.Spin

local MAP = Config.Map
local GY = MAP.GroundY
local SX, SZ = MAP.IslandSize.X, MAP.IslandSize.Y

local function folder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function buildIsland(map, rng)
	local g = folder(map, "Ground")
	local top = block(g, V(SX, 4, SZ), CF(0, GY - 2, 0), C.Ground, nil, { Name = "IslandTop" })
	top:SetAttribute("Placeable", true)
	for i = 1, 18 do
		local w, d = rng:NextNumber(14, 34), rng:NextNumber(14, 30)
		local x = rng:NextNumber(-SX / 2 + w / 2 + 2, SX / 2 - w / 2 - 2)
		local z = rng:NextNumber(-SZ / 2 + d / 2 + 2, SZ / 2 - d / 2 - 2)
		local p = Kit.Part(g, {
			Name = "Moss", Size = V(w, 0.2, d), CFrame = CF(x, GY + 0.02 + i * 0.004, z) * ANG(0, rad(rng:NextNumber(-20, 20)), 0),
			Color = i % 2 == 0 and C.Moss or C.Ground2, Material = Enum.Material.Grass, CastShadow = false,
		})
		p:SetAttribute("Placeable", true)
	end

	local u = folder(map, "Underside")
	local edge = {}
	for x = -SX / 2, SX / 2 - 1, 16 do
		edge[#edge + 1] = V(x, 0, -SZ / 2)
		edge[#edge + 1] = V(x, 0, SZ / 2)
	end
	for z = -SZ / 2 + 16, SZ / 2 - 16, 16 do
		edge[#edge + 1] = V(-SX / 2, 0, z)
		edge[#edge + 1] = V(SX / 2, 0, z)
	end
	for _, p in ipairs(edge) do
		local s, h = rng:NextNumber(10, 20), rng:NextNumber(5, 9)
		local size = V(s, h, s * rng:NextNumber(0.7, 1.2))
		local y = GY - h / 2 + rng:NextNumber(-1.5, 0.2)
		local rot = ANG(rad(rng:NextNumber(-6, 6)), rad(rng:NextNumber(0, 90)), rad(rng:NextNumber(-6, 6)))
		block(u, size, CF(p.X, y, p.Z) * rot, rng:NextInteger(1, 2) == 1 and C.Rock or C.Rock2, nil, { Name = "EdgeRock" })
	end
	local layers = { { 0.92, 12, -9 }, { 0.75, 16, -22 }, { 0.55, 18, -38 }, { 0.32, 20, -55 }, { 0.14, 18, -72 } }
	for i, L in ipairs(layers) do
		local s, h, yOff = L[1], L[2], L[3]
		local cx, cz = rng:NextNumber(-6, 6), rng:NextNumber(-6, 6)
		local yaw = rad(rng:NextNumber(-8, 8))
		local layerCF = CF(cx, GY + yOff, cz) * ANG(0, yaw, 0)
		block(u, V(SX * s, h, SZ * s), layerCF, i % 2 == 0 and C.Rock or C.Rock2, nil, { Name = "Bedrock" .. i })
		if i <= 4 then
			-- светящаяся жила на боку яруса (вместе с его смещением и поворотом)
			neon(u, V(SX * s * 0.6, 0.6, 0.6), layerCF * CF(0, rng:NextNumber(-3, 3), -SZ * s / 2 - 0.1) * ANG(0, 0, rad(rng:NextNumber(-12, 12))), C.Neon, { Name = "Vein" })
		end
	end
	local root = neon(u, V(10, 22, 10), CF(0, GY - 92, 0) * ANG(rad(8), rad(45), 0), C.Neon, { Name = "Crystal Root", CanCollide = true })
	light(root, C.Neon, 40, 3)
end

local function buildPath(map, rng)
	local f = folder(map, "Path")
	local w = MAP.PathWidth
	Kit.Road(f, Path.Get("Void").Points, GY, w, C.Path, C.PathEdge, function(i, a, b, cf, len, dir)
		local right = V(-dir.Z, 0, dir.X)
		local steps = math.floor(len / 14)
		for s = 1, steps do
			local t = s / (steps + 1)
			local side = s % 2 == 0 and 1 or -1
			local p = a:Lerp(b, t) + right * side * (w / 2 + 1.2)
			local sz = rng:NextNumber(0.8, 1.6)
			block(f, V(sz, 0.7 * sz, 1.2 * sz), CF(p.X, GY + 0.3 * sz, p.Z) * ANG(rad(rng:NextNumber(-20, 20)), rad(rng:NextNumber(0, 180)), 0), C.Stone2, nil, { Name = "Pebble", CanCollide = false })
		end
		if i % 2 == 0 then
			local mid = (a + b) / 2
			local rot = CFrame.lookAt(V(), b - a).Rotation
			neon(f, V(0.35, 0.05, math.min(len * 0.4, 12)), CF(mid.X + rng:NextNumber(-2, 2), GY + 0.31, mid.Z + rng:NextNumber(-2, 2)) * rot * ANG(0, rad(rng:NextNumber(-25, 25)), 0), C.Neon, { Name = "Crack" })
		end
	end)
end

local function buildPortal(map, rng)
	local m = Instance.new("Model")
	m.Name = "VoidPortal"
	local pts = Path.Get("Void").Points
	local start = pts[1]
	local dir = (pts[2] - start).Unit
	local R = 10
	local foot = start - dir * 4
	local center = foot + V(0, R + 1, 0)
	local base = CFrame.lookAt(center, center + dir)
	block(m, V(26, 1.2, 12), CF(foot.X, GY + 0.4, foot.Z) * base.Rotation, C.Stone2, nil, { Name = "Base" })
	block(m, V(22, 1.2, 9), CF(foot.X, GY + 1.2, foot.Z) * base.Rotation, C.Stone, nil, { Name = "Base2" })
	for i = 0, 17 do
		if i ~= 4 then -- выпавший камень
			local a = i / 18 * math.pi * 2
			local off = CF(math.cos(a) * R, math.sin(a) * R, 0)
			block(m, V(3.6, 3.2 + rng:NextNumber(-0.4, 0.4), 3), base * off * ANG(0, 0, a + rad(rng:NextNumber(-4, 4))), i % 3 == 0 and C.Stone or C.Stone2, nil, { Name = "RingStone" })
			if i % 3 == 0 then
				neon(m, V(0.6, 1.4, 0.3), base * off * ANG(0, 0, a) * CF(0, 0, -1.55), C.Neon, { Name = "Rune" })
			end
		end
	end
	block(m, V(3.4, 2.8, 3), CF(center.X + 6, GY + 1.4, center.Z + 9) * ANG(rad(20), rad(30), rad(10)), C.Stone2, nil, { Name = "Fallen" })
	local discCF = base * ANG(0, rad(90), 0)
	local disc = Kit.Cyl(m, "PortalDisc", V(0.4, 2 * R - 2.5, 2 * R - 2.5), discCF, rgb(110, 30, 190), Enum.Material.Neon, { CanCollide = false, Transparency = 0.15 })
	local core = Kit.Cyl(m, "PortalCore", V(0.5, 11, 11), discCF, rgb(15, 0, 30), Enum.Material.Neon, { CanCollide = false })
	for i = 1, 3 do
		local s = neon(m, V(0.6, 16, 0.7), base * ANG(0, 0, rad(i * 60)) * CF(0, 0, -0.4), C.NeonSoft, { Name = "Swirl", Transparency = 0.35 })
		spin(s, 1.6 + 0.4 * (i - 1), "Z")
	end
	light(core, C.Neon, 45, 4)
	emitter(disc, C.Neon, { Rate = 40, Size = 0.8, SpeedMin = 2, SpeedMax = 6, LifeMin = 1, LifeMax = 2 })
	m.Parent = map
	return m
end

local function buildCore(map, rng)
	local m = Instance.new("Model")
	m.Name = "VoidCore"
	local last = Path.Get("Void").Points
	last = last[#last]
	local c = V(last.X, GY, last.Z)
	local vert = ANG(0, 0, rad(90))
	Kit.Cyl(m, "Plinth1", V(1.4, 30, 30), CF(c + V(0, 0.5, 0)) * vert, C.Stone2)
	Kit.Cyl(m, "Plinth2", V(1.4, 22, 22), CF(c + V(0, 1.7, 0)) * vert, C.Stone)
	Kit.Cyl(m, "GlowRing", V(0.2, 23, 23), CF(c + V(0, 1.15, 0)) * vert, C.Neon, Enum.Material.Neon, { CanCollide = false })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local h = i == 2 and 5 or 11 + rng:NextNumber(-1, 1) -- сломанная колонна
		local pc = c + V(math.cos(a) * 12, 0, math.sin(a) * 12)
		block(m, V(2.4, h, 2.4), CF(pc + V(0, 2.4 + h / 2, 0)) * ANG(0, a, i == 4 and rad(4) or 0), C.Stone2, nil, { Name = "Pillar" })
		if i ~= 2 then
			local gem = neon(m, V(1.2, 1.8, 1.2), CF(pc + V(0, 2.4 + h + 1.2, 0)) * ANG(0, rad(45), rad(45)), C.Neon, { Name = "PillarGem" })
			spin(gem, 1.2, "Y")
		end
	end
	local cc = CF(c + V(0, 13, 0)) * ANG(rad(45), 0, rad(45))
	local crystal = neon(m, V(6, 6, 6), cc, rgb(190, 90, 255), { Name = "CoreCrystal" })
	spin(crystal, 0.8, "Y", 1.2)
	light(crystal, rgb(190, 90, 255), 50, 5)
	emitter(crystal, C.NeonSoft, { Rate = 25, Size = 0.7, SpeedMin = 2, SpeedMax = 5 })
	local shell = block(m, V(9, 9, 9), cc, rgb(120, 60, 200), Enum.Material.Glass, { Name = "CoreShell", Transparency = 0.7, CanCollide = false })
	spin(shell, -0.5, "Y", 1.2)
	for k = 1, 2 do
		local ring = Instance.new("Model")
		ring.Name = "OrbitRing"
		local rr = 7 + 1.8 * k
		local tilt = k == 1 and ANG(rad(20), 0, rad(10)) or ANG(rad(-25), 0, rad(-12))
		local pivot = CF(c + V(0, 13, 0)) * tilt
		for i = 0, 15 do
			local a = i / 16 * math.pi * 2
			neon(ring, V(0.4, 0.4, 2.6), pivot * CF(math.cos(a) * rr, 0, math.sin(a) * rr) * ANG(0, -a, 0), k == 1 and C.Neon or C.NeonPink, { Name = "Seg" })
		end
		ring.WorldPivot = pivot
		spin(ring, k == 1 and 0.9 or -0.7, "Y")
		ring.Parent = m
	end
	m:SetAttribute("CoreCenter", c + V(0, 13, 0))
	m.Parent = map
	return m
end

local function buildDecor(map, rng)
	local f = folder(map, "Decor")
	local road = Path.Get("Void")
	local pts = road.Points
	local taken = { MAP.BattleSpawn }
	local function freeSpot(minPath, minSep)
		for _ = 1, 60 do
			local p = V(rng:NextNumber(-119, 119), GY, rng:NextNumber(-92, 92))
			local ok = road.DistanceToPath(p) > minPath and Path.FlatDistance(p, pts[1]) > 22 and Path.FlatDistance(p, pts[#pts]) > 22
				and Path.FlatDistance(p, MAP.Center) > 14
			if ok then
				for _, q in ipairs(taken) do
					if Path.FlatDistance(p, q) < minSep then
						ok = false
						break
					end
				end
			end
			if ok then
				taken[#taken + 1] = p
				return p
			end
		end
		return nil
	end
	for _ = 1, 10 do
		local p = freeSpot(11, 14)
		if p then
			Kit.CrystalCluster(f, rng, p, rng:NextNumber(0.9, 1.6))
		end
	end
	for _ = 1, 14 do
		local p = freeSpot(12, 12)
		if p then
			Kit.DarkTree(f, rng, p)
		end
	end
	for _ = 1, 4 do
		local p = freeSpot(14, 18)
		if p then
			Kit.Ruin(f, rng, p)
		end
	end
	for _ = 1, 6 do
		local p = freeSpot(11, 12)
		if p then
			Kit.BrokenColumn(f, rng, p)
		end
	end
	local sky = folder(map, "Sky")
	local spots = { V(-170, 25, -60), V(-150, 40, 90), V(10, 35, -150), V(170, 20, 40), V(140, 45, -120), V(-40, 50, 150), V(90, 30, 150) }
	for i, p in ipairs(spots) do
		Kit.FloatingIsland(sky, rng, p + V(0, GY, 0), i % 3 == 0 and 1.5 or 1)
	end
end

return function()
	local rng = Random.new(1337)
	local map = Instance.new("Model")
	map.Name = "VoidTDMap"
	buildIsland(map, rng)
	buildPath(map, rng)
	buildPortal(map, rng)
	buildCore(map, rng)
	buildDecor(map, rng)
	local bs = MAP.BattleSpawn
	block(map, V(8, 1, 8), CF(bs.X, GY + 0.5, bs.Z), rgb(70, 40, 110), nil, { Name = "BattlePad" })
	neon(map, V(7, 0.05, 7), CF(bs.X, GY + 1.03, bs.Z), C.Neon, { Name = "BattlePadGlow", Transparency = 0.6 })
	Kit.Calm(map)
	map.WorldPivot = CF(MAP.Center)
	map.Parent = workspace
	return map
end
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX6608B3506A23002BFA3FC182FAB89A06">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX0E8379FC9437CE022ED61BE62F36879A">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="LocalScript" referent="RBX77611F322CF069DE6E42019D76913304">
				<Properties>
					<string name="Name">VoidTDClient</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: клиент (бутстрап)
-- Собирает ctx, запускает модули (FX, Render, UI, Placement, Zones, Input), подключает сеть,
-- держит лёгкую графику мира, вращение декора и смену карты. Вся логика — в модулях.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))
local Path = require(Shared:WaitForChild("Path"))
local Util = require(Shared:WaitForChild("Util"))
local SharedNet = require(Shared:WaitForChild("Net"))
local ModelsFolder = Shared:WaitForChild("Models")
local UnitModels = require(ModelsFolder:WaitForChild("Units"))
local EnemyModels = require(ModelsFolder:WaitForChild("Enemies"))
local CaseModels = require(ModelsFolder:WaitForChild("Cases"))

local Net = require(script:WaitForChild("Net"))
local Anims = require(script:WaitForChild("Anims"))
local FX = require(script:WaitForChild("FX"))
local Renderer = require(script:WaitForChild("Render"))
local UI = require(script:WaitForChild("UI"))
local Placement = require(script:WaitForChild("Placement"))
local Zones = require(script:WaitForChild("Zones"))
local Input = require(script:WaitForChild("Input"))

local Remotes = SharedNet.Remotes()
local State = Shared:WaitForChild("State")
local UnitsFolder = Shared:WaitForChild("Units")

local ctx = {
	Config = Config, Path = Path, Util = Util,
	UnitModels = UnitModels, EnemyModels = EnemyModels, CaseModels = CaseModels,
	FX = FX, Anims = Anims, Renderer = Renderer, UI = UI, Placement = Placement, Zones = Zones, Input = Input,
	Remotes = Remotes, State = State, UnitsFolder = UnitsFolder,
	Profile = nil, Lite = false, Player = player,
}
ctx.Request = Net.Init(ctx)

------------------------------------------------------------------------
-- ЛЁГКАЯ ГРАФИКА МИРА (запоминаем исходное состояние, чтобы вернуть как было)
------------------------------------------------------------------------
local WORLD_ROOTS = { "VoidTDMap", "VoidTDLobby", "VoidTDHalloween", "VoidTDHalloweenMap" }
local saved = setmetatable({}, { __mode = "k" })

local function liteObject(d, on)
	if d:IsA("ParticleEmitter") or d:IsA("PointLight") then
		if on then
			if saved[d] == nil then
				saved[d] = d.Enabled
			end
			d.Enabled = d:IsA("PointLight") and d.Range >= 30 and saved[d] or false
		elseif saved[d] ~= nil then
			d.Enabled = saved[d]
			saved[d] = nil
		end
	end
end

local function applyWorldLite(on)
	for _, name in ipairs(WORLD_ROOTS) do
		local root = workspace:FindFirstChild(name)
		if root then
			for _, d in ipairs(root:GetDescendants()) do
				liteObject(d, on)
			end
		end
	end
	Lighting.GlobalShadows = not on
	local bloom = Lighting:FindFirstChild("VoidBloom")
	if bloom then
		bloom.Enabled = not on
	end
end

function ctx.SetLite(on, save)
	on = on == true
	ctx.Lite = on
	UnitModels.Lite = on
	FX.SetLite(on)
	applyWorldLite(on)
	Renderer.RebuildUnits()
	UI.SetLiteText(on)
	if save then
		ctx.Request("SetLite", { On = on })
		UI.Toast(on and "Лёгкая графика включена" or "Полная графика включена", "good")
	end
end

------------------------------------------------------------------------
-- ДЕКОР: вращение и покачивание (атрибуты Spin SpinAxis BobAmp BobSpeed)
------------------------------------------------------------------------
local spinners = {}
local spinnerSet = setmetatable({}, { __mode = "k" })

local function addSpinner(obj)
	if spinnerSet[obj] then
		return
	end
	if not (obj:IsA("BasePart") or obj:IsA("Model")) then
		return
	end
	if obj:GetAttribute("Spin") == nil and obj:GetAttribute("BobAmp") == nil then
		return
	end
	spinnerSet[obj] = true
	spinners[#spinners + 1] = {
		Obj = obj,
		IsModel = obj:IsA("Model"),
		Base = obj:IsA("Model") and obj:GetPivot() or obj.CFrame,
		Spin = obj:GetAttribute("Spin") or 0,
		Axis = obj:GetAttribute("SpinAxis") or "Y",
		Bob = obj:GetAttribute("BobAmp") or 0,
		BobSpeed = obj:GetAttribute("BobSpeed") or 1,
		Phase = math.random() * 6,
	}
end

local function collectSpinners(root)
	addSpinner(root)
	for _, d in ipairs(root:GetDescendants()) do
		addSpinner(d)
	end
end

local function updateSpinners(t)
	for i = #spinners, 1, -1 do
		local s = spinners[i]
		local obj = s.Obj
		if not obj.Parent then
			-- объект удалён — убираем из списка
			spinners[i] = spinners[#spinners]
			spinners[#spinners] = nil
		else
			local a = t * s.Spin
			local rot = s.Axis == "X" and CFrame.Angles(a, 0, 0) or (s.Axis == "Z" and CFrame.Angles(0, 0, a) or CFrame.Angles(0, a, 0))
			local cf = CFrame.new(0, math.sin(t * s.BobSpeed + s.Phase) * s.Bob, 0) * s.Base * rot
			if s.IsModel then
				obj:PivotTo(cf)
			else
				obj.CFrame = cf
			end
		end
	end
end

-- корни мира: при появлении — собрать декор (после секунды на достройку) и применить лёгкую графику
local function onWorldRoot(root)
	if not table.find(WORLD_ROOTS, root.Name) then
		return
	end
	task.delay(1, function()
		if root.Parent then
			collectSpinners(root)
			if ctx.Lite then
				applyWorldLite(true)
			end
		end
	end)
end
for _, name in ipairs(WORLD_ROOTS) do
	local r = workspace:FindFirstChild(name)
	if r then
		onWorldRoot(r)
	end
end
workspace.ChildAdded:Connect(onWorldRoot)

------------------------------------------------------------------------
-- ЗАПУСК МОДУЛЕЙ
------------------------------------------------------------------------
FX.Init(ctx)
Renderer.Init(ctx)
UI.Init(ctx)
Placement.Init(ctx)
Zones.Init(ctx)
Input.Init(ctx)
Net.Connect(ctx)

-- смена карты боя (Void / Halloween)
local function applyMap()
	local key = State:GetAttribute("Map") or "Void"
	if Path.MapKey ~= key then
		Renderer.ClearEnemies()
		Renderer.ClearAllies()
		Path.SetMap(key)
	end
	UI.SetMapMode(key)
end
State:GetAttributeChangedSignal("Map"):Connect(applyMap)
applyMap()

-- главный цикл
RunService.RenderStepped:Connect(function(dt)
	Renderer.Update(dt)
	UI.Update(dt)
	updateSpinners(os.clock())
	Zones.Update()
	Input.Update(dt)
end)

------------------------------------------------------------------------
-- ПРОФИЛЬ И СОСТОЯНИЕ
------------------------------------------------------------------------
while not player:GetAttribute("VoidReady") do
	task.wait(0.1)
end

local okP, prof = ctx.Request("GetProfile")
if okP and type(prof) == "table" then
	UI.SetProfile(prof)
end

-- лёгкая графика: сохранённая настройка, иначе — по умолчанию на телефонах
do
	local savedLite = ctx.Profile and ctx.Profile.Settings and ctx.Profile.Settings.Lite
	local mobile = UserInputService.TouchEnabled and not UserInputService.MouseEnabled
	local on = (savedLite == nil and mobile) or savedLite == true
	ctx.SetLite(on, false)
end

local okE, list = ctx.Request("GetEnemies")
if okE and type(list) == "table" then
	for _, e in ipairs(list) do
		Renderer.SpawnEnemy(e)
	end
end

for _, f in ipairs(UnitsFolder:GetChildren()) do
	Renderer.AddUnit(f)
end
UnitsFolder.ChildAdded:Connect(function(f)
	task.defer(Renderer.AddUnit, f, true)
end)
UnitsFolder.ChildRemoved:Connect(function(f)
	Renderer.RemoveUnit(f)
end)

UI.Toast("Добро пожаловать в VOID TD! Встань в круг ИГРАТЬ, чтобы начать бой", "good")
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBX6A51EA28B4810D72F750D7E2F60C1B1B">
					<Properties>
						<string name="Name">Anims</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Anims (клиент)
-- Анимации юнитов ключевыми кадрами (углы в градусах) и вторичное движение (дыхание, крылья,
-- шея, плащи, орбиты, шестерёнки). Те же позы и тайминги, что в легаси Renderer + HalloweenAnims.
--
-- ФОРМАТ КЛИПА
--   Anims.Clips[name](h, hits, interval) -> frames
--   frames = { { time, { Joint = { xDeg, yDeg, zDeg [, dy] } } }, ... }, время по возрастанию,
--   первый кадр {0, {}}, последний обычно {T, {}} (возврат в idle). Клип заканчивается, когда
--   прошло >= времени последнего кадра. Сустав, которого нет в кадре, берётся из rig.Idle
--   (а если и там нет — {0,0,0,0}). Суставы: RS LS Neck Root WingR WingL; у Root 4-е число —
--   смещение по вертикали (в studs, умножается на rig.Scale).
--   h = HitDelay (момент удара). Способности (TimeBreak, LanternBeam, ...) h игнорируют.
--
-- API
--   Anims.Clips[name]                         -- все клипы (атаки, способности, разминки, PowerUp/Land/Cheer)
--   Anims.Fidgets[attackAnim] = { names }     -- разминки в простое по def.Anim юнита
--   Anims.Has(name) -> bool
--   Anims.FidgetsFor(attackAnim) -> { names } -- список или { "LookAround" }
--   Anims.PickFidget(attackAnim) -> name      -- случайная разминка (math.random)
--   Anims.Play(state, name, h, hits, interval [, start]) -> bool
--        state.Anim = { Start = start or os.clock(), Frames = clip(h, hits, interval), Name = name }
--   Anims.PlayFidget(state, attackAnim [, start]) -> name
--   Anims.Stop(state)                         -- state.Anim = nil
--   Anims.IsPlaying(state) -> bool
--   Anims.Eval(state, t) -> pose              -- state = { Rig, Anim = {Start, Frames}, Phase };
--        по окончании клипа сбрасывает state.Anim = nil и возвращает rig.Idle.
--        Возвращаемая поза — переиспользуемый буфер state.PoseBuf (валиден до следующего Eval).
--   Anims.Apply(rig, pose, t, phase)          -- пишет motor.C0 всех моторов rig.Motors (от rig.Base):
--        Root: dy*Scale + дыхание; RS/LS: дыхание; Wing*: взмахи; Neck: покачивание;
--        Cape/Scarf/Cape2: колыхание + порыв rig.Gust; Orbit*: вращение по Y;
--        rig.SpinRates[motor] (рад/с, Clock*/Gear*): накопленный угол по Z, ×3 при rig.Storm,
--        ×6 пока os.clock() < rig.SpinBoostUntil. Пишет rig.SpinT, rig.SpinAngle.
--   Anims.Step(state, t)                      -- Apply(state.Rig, Eval(state, t), t, state.Phase or 0)
--   Anims.Register(name, builder [, fidgets]) -- добавить/заменить клип
--   Anims.Ease(a)                             -- smoothstep a*a*(3-2a)
--   t — os.clock() (тот же источник времени, что Start и SpinBoostUntil).
--   Для совместимости Anims[name] тоже отдаёт клип (Anims.Slash == Anims.Clips.Slash).

local Anims = {}
local Clips = {}
local Fidgets = {}
Anims.Clips = Clips
Anims.Fidgets = Fidgets

local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local sin = math.sin
local clamp = math.clamp

local EMPTY = {}
local ZERO = { 0, 0, 0, 0 }
local DEFAULT_FIDGETS = { "LookAround" }

------------------------------------------------------------------------
-- АТАКИ (h = HitDelay)
------------------------------------------------------------------------
function Clips.Slash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.75, { RS = { 150, 0, 12 }, Root = { 0, -15, 0 } } },
		{ h, { RS = { 25, 0, -12 }, LS = { -20, 0, 0 }, Root = { 4, 15, 0 } } },
		{ h + 0.2, { RS = { 15, 0, -5 } } },
		{ h + 0.5, {} },
	}
end

function Clips.HeavySlash(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.8, { RS = { 168, 0, 15 }, LS = { 40, 0, -10 }, Root = { -8, -22, 0 } } },
		{ h, { RS = { 18, 0, -15 }, LS = { 30, 0, 0 }, Root = { 12, 20, 0, -0.15 } } },
		{ h + 0.3, { RS = { 15, 0, -5 }, Root = { 6, 10, 0 } } },
		{ h + 0.65, {} },
	}
end

function Clips.Bow(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.6, { LS = { 90, 0, 0 }, RS = { 90, 0, -30 }, Root = { 0, -20, 0 } } },
		{ h, { LS = { 90, 0, 0 }, RS = { 75, 0, -65 }, Root = { 0, -20, 0 } } },
		{ h + 0.06, { LS = { 92, 0, 0 }, RS = { 95, 0, -15 }, Root = { 0, -20, 0 } } },
		{ h + 0.45, {} },
	}
end

function Clips.Cast(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 145, 0, 0 }, LS = { 30, 0, -20 }, Neck = { 12, 0, 0 } } },
		{ h, { RS = { 90, 0, 0 }, LS = { 55, 0, -25 } } },
		{ h + 0.45, {} },
	}
end

function Clips.Gun(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h, { RS = { 92, 0, 0 }, LS = { 88, 0, -30 } } },
		{ h + 0.05, { RS = { 104, 0, 0 }, LS = { 98, 0, -30 }, Root = { -5, 0, 0 } } },
		{ h + 0.18, { RS = { 92, 0, 0 }, LS = { 88, 0, -30 } } },
		{ h + 0.5, {} },
	}
end

function Clips.Reap(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.7, { RS = { 60, 0, 25 }, LS = { 50, 0, -10 }, Root = { 0, -70, 0 } } },
		{ h, { RS = { 75, 0, -15 }, LS = { 65, 0, 10 }, Root = { 6, 80, 0 } } },
		{ h + 0.25, { RS = { 60, 0, -10 }, Root = { 3, 60, 0 } } },
		{ h + 0.65, {} },
	}
end

-- серия ударов: каждый следующий — в обратную сторону
function Clips.Katana(h, hits, interval)
	h = h or 0.2
	hits = math.max(1, math.floor(hits or 1))
	interval = interval or 0.16
	local k = { { 0, {} }, { h * 0.7, { RS = { 125, 0, 40 }, Root = { 0, -25, 0 } } } }
	for i = 1, hits do
		local t = h + (i - 1) * interval
		local dir = (i % 2 == 1) and 1 or -1
		k[#k + 1] = { t, { RS = { 45, 0, -50 * dir }, Root = { 4, 30 * dir, 0 } } }
		if i < hits then
			k[#k + 1] = { t + interval * 0.6, { RS = { 120, 0, 40 * -dir }, Root = { 0, -20 * dir, 0 } } }
		end
	end
	local last = h + (hits - 1) * interval
	k[#k + 1] = { last + 0.15, { RS = { 30, 0, -30 } } }
	k[#k + 1] = { last + 0.4, {} }
	return k
end

function Clips.Slam(h)
	h = h or 0.2
	return {
		{ 0, {} },
		{ h * 0.65, { RS = { 172, 0, 10 }, LS = { 165, 0, -10 }, Root = { -10, 0, 0, 0.15 }, Neck = { -10, 0, 0 } } },
		{ h, { RS = { 55, 0, 0 }, LS = { 50, 0, 0 }, Root = { 16, 0, 0, -0.45 } } },
		{ h + 0.35, { RS = { 48, 0, 0 }, LS = { 45, 0, 0 }, Root = { 12, 0, 0, -0.35 } } },
		{ h + 0.85, {} },
	}
end

