			<Item class="ModuleScript" referent="RBX86C1642D981D9BE14836714115F4BF82">
				<Properties>
					<string name="Name">Config</string>
					<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Config
-- Все цифры баланса собраны здесь. Меняй смело — остальной код читает только эту таблицу.
-- Таблица собирается из дочерних модулей (каждый возвращает свои ключи верхнего уровня):
--   Settings     — Settings
--   Rarities     — RarityOrder, Rarities
--   Cases        — CaseOrder, Cases
--   Shop         — Shop
--   Sounds       — Sounds
--   Difficulties — TargetModes, DifficultyOrder, Difficulties
--   World        — Lobby, BattleSpawn, Events, HalloweenIsland, Halloween, Map, Maps
--   Runes        — RuneRarity, RuneOrder, Runes, AllyOrder, Allies
--   Units        — UnitOrder, Units
--   Enemies      — EnemyOrder, Enemies
--   Waves        — Waves (карта Void; волны Хэллоуина — Maps.Halloween.Waves)

local Config = {}

Config.GameName = "VOID TD"

local PARTS = { "Settings", "Rarities", "Cases", "Shop", "Sounds", "Difficulties", "World", "Runes", "Units", "Enemies", "Waves" }

for _, name in ipairs(PARTS) do
	local part = require(script:WaitForChild(name))
	for key, value in pairs(part) do
		assert(Config[key] == nil, "[Config] ключ задан дважды: " .. tostring(key) .. " (" .. name .. ")")
		Config[key] = value
	end
end

-- Maps.Void — это та же самая таблица, что и Config.Map
assert(Config.Maps.Void == Config.Map, "[Config] Maps.Void должна быть Config.Map")

------------------------------------------------------------------------
-- Проверка ссылок между таблицами (опечатка в id ломает игру молча — здесь пишем warn)
------------------------------------------------------------------------
local function validate()
	local warnFn = warn or print
	local function check(ok, msg)
		if not ok then warnFn("[Config] " .. msg) end
	end
	local function sameSet(order, dict, what)
		local listed = {}
		for _, id in ipairs(order) do
			check(dict[id] ~= nil, what .. ": нет определения " .. tostring(id))
			listed[id] = true
		end
		for id in pairs(dict) do
			check(listed[id], what .. ": нет в порядке " .. tostring(id))
		end
	end
	sameSet(Config.RarityOrder, Config.Rarities, "Rarities")
	sameSet(Config.DifficultyOrder, Config.Difficulties, "Difficulties")
	sameSet(Config.EnemyOrder, Config.Enemies, "Enemies")
	sameSet(Config.RuneOrder, Config.Runes, "Runes")
	sameSet(Config.AllyOrder, Config.Allies, "Allies")

	for id, def in pairs(Config.Units) do
		check(Config.Rarities[def.Rarity] ~= nil, "юнит " .. id .. ": неизвестная редкость " .. tostring(def.Rarity))
		check(type(def.Levels) == "table" and #def.Levels >= 1, "юнит " .. id .. ": нет Levels")
		local summon = def.Summon
		if summon then
			for _, lv in ipairs(summon.Levels) do
				check(Config.Allies[lv.Ally] ~= nil, "юнит " .. id .. ": неизвестный союзник " .. tostring(lv.Ally))
			end
			check(not summon.Golden or Config.Allies[summon.Golden.Ally] ~= nil, "юнит " .. id .. ": неизвестный Golden")
		end
	end
	for _, list in ipairs({ Config.Settings.StarterUnits, Config.Settings.StudioGrantUnits }) do
		for _, id in ipairs(list) do
			check(Config.Units[id] ~= nil, "Settings: неизвестный юнит " .. tostring(id))
		end
	end
	for _, d in ipairs(Config.Halloween.Difficulties) do
		check(Config.Difficulties[d] ~= nil, "Halloween: неизвестная сложность " .. tostring(d))
	end
	for _, rune in pairs(Config.Runes) do
		for _, lv in ipairs(rune.Summon and rune.Summon.Levels or {}) do
			check(Config.Allies[lv.Ally] ~= nil, "руна: неизвестный союзник " .. tostring(lv.Ally))
		end
	end

	for key, case in pairs(Config.Cases) do
		local inUnits = {}
		for _, id in ipairs(case.Units) do
			check(Config.Units[id] ~= nil, "кейс " .. key .. ": неизвестный юнит " .. tostring(id))
			inUnits[id] = true
		end
		if case.Rewards then
			local inRewards = {}
			for _, r in ipairs(case.Rewards) do
				if r.Rune then
					check(Config.Runes[r.Rune] ~= nil, "кейс " .. key .. ": неизвестная руна " .. tostring(r.Rune))
				else
					check(Config.Units[r.Unit] ~= nil, "кейс " .. key .. ": неизвестный юнит " .. tostring(r.Unit))
					check(inUnits[r.Unit], "кейс " .. key .. ": " .. tostring(r.Unit) .. " есть в Rewards, но не в Units")
					inRewards[r.Unit] = true
				end
			end
			for id in pairs(inUnits) do
				check(inRewards[id], "кейс " .. key .. ": " .. id .. " показан, но не выпадает (нет в Rewards)")
			end
		end
	end
	for _, key in ipairs(Config.CaseOrder) do
		check(Config.Cases[key] ~= nil, "CaseOrder: неизвестный кейс " .. tostring(key))
	end

	local function enemy(id, where)
		check(Config.Enemies[id] ~= nil, where .. ": неизвестный враг " .. tostring(id))
	end
	local function waves(list, where)
		for w, groups in ipairs(list) do
			for _, g in ipairs(groups) do
				if g[1] ~= "BOSS" then enemy(g[1], where .. " волна " .. w) end
			end
		end
	end
	waves(Config.Waves, "Waves")
	for key, map in pairs(Config.Maps) do
		check(type(map.Path) == "table" and #map.Path >= 2, "карта " .. key .. ": в дороге меньше 2 точек")
		if map.Waves then waves(map.Waves, "Maps." .. key) end
	end
	for _, id in pairs(Config.Halloween.Bosses) do
		enemy(id, "Halloween.Bosses")
	end
	for id, def in pairs(Config.Enemies) do
		if def.Summon then enemy(def.Summon.Enemy, id .. ".Summon") end
		if def.OnDeath then enemy(def.OnDeath.Enemy, id .. ".OnDeath") end
		if def.Enrage and def.Enrage.Spawn then enemy(def.Enrage.Spawn[1], id .. ".Enrage") end
	end
end
validate()

------------------------------------------------------------------------
-- Утилиты
------------------------------------------------------------------------

-- Статы уровня юнита (уровень зажимается в 1..#Levels). nil — нет такого юнита.
function Config.GetUnitStats(unitId, level)
	local def = Config.Units[unitId]
	if not def then return nil end
	local lv = math.floor(tonumber(level) or 1)
	if lv ~= lv then lv = 1 end -- NaN
	return def.Levels[math.clamp(lv, 1, #def.Levels)]
end

-- Множитель HP врагов на волне: (1 + L*(w-1) + Q*(w-1)^2) * EnemyHealthMult
function Config.WaveHPMult(wave)
	local s = Config.Settings
	local w = math.max((tonumber(wave) or 1) - 1, 0)
	return (1 + s.EnemyHPScaleLinear * w + s.EnemyHPScaleQuad * w * w) * (s.EnemyHealthMult or 1)
end

-- 1234 -> "1,234"; 15000 -> "15.0K"; 1500000 -> "1.5M"; отрицательные — со знаком минус
function Config.FormatNumber(n)
	n = math.floor((tonumber(n) or 0) + 0.5)
	if n ~= n then return "0" end -- NaN
	if n < 0 then
		return "-" .. Config.FormatNumber(-n)
	end
	-- с 999 950 "%.1fK" дал бы "1000.0K" — сразу переходим на M
	if n >= 999950 then
		return string.format("%.1fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	end
	local s = tostring(n)
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then formatted = formatted:sub(2) end
	return formatted
end

return Config
]]></ProtectedString>
				</Properties>
				<Item class="ModuleScript" referent="RBXE17C6F71F39DD1F5A588DBB23E4E8FFE">
					<Properties>
						<string name="Name">Cases</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Config.Cases
-- Кейсы (Summon). Rates — шансы редкостей в процентах (сумма = 100), юнит внутри редкости — равновероятно.
-- Rewards — полный список наград с шансами (одна награда за открытие). Результат считается на сервере.
-- Поля: Name, Color, Description, Cost1, Cost10?, Rates?, Units, Currency? (= "Gems"), Single?, Rewards?, Enabled?

return {
	-- порядок в меню кейсов и в лобби. Blood Moon убран из лобби и меню кейсов,
	-- его юниты остаются у игроков и в игре.
	CaseOrder = { "VoidCase", "ShatteredReality" },

	Cases = {
		VoidCase = {
			Name = "VOID CASE", Color = Color3.fromRGB(170, 80, 255),
			Description = "Оригинальные воины Пустоты.",
			Cost1 = 50, Cost10 = 450,
			Rates = { Common = 72, Rare = 21, Epic = 5.5, Legendary = 1.3, Mythic = 0.2 },
			Units = {
				"VoidSoldier", "ShadowArcher", "LostMage", "VoidKnight", "DarkGunner", "AbyssReaper",
				"CorruptedSamurai", "EclipseGuardian", "FallenAngel", "VoidEmperor", "AbyssOverlord",
			},
		},

		ShatteredReality = {
			Name = "SHATTERED REALITY", Color = Color3.fromRGB(120, 40, 210),
			Description = "Расколотая реальность. Шанс SECRET: 0.1%",
			Cost1 = 80, Cost10 = 720,
			Rates = { Common = 70, Rare = 21, Epic = 6.4, Legendary = 2, Mythic = 0.5, Secret = 0.1 },
			Units = { "RiftScout", "CrystalHunter", "VoidPuppeteer", "Starbreaker", "RiftMonarch", "RealityDestroyer" },
		},

		-- HALLOWEEN CASE: только на Хэллоуин-острове, за Halloween Coins, одна награда за открытие
		Halloween = {
			Name = "HALLOWEEN CASE", Color = Color3.fromRGB(255, 130, 30),
			Description = "Проклятый сундук. 11 хэллоуинских юнитов, Проклятый часовщик и 3 руны.",
			Currency = "HalloweenCoins",
			Cost1 = 500,
			Single = true,
			Rewards = {
				{ Unit = "LanternKing", Rate = 0.1 },
				{ Unit = "CursedClockmaker", Rate = 0.2 },
				{ Unit = "HalloweenPuppeteer", Rate = 2 },
				{ Unit = "HeadlessExecutioner", Rate = 2 },
				{ Unit = "PlagueDoctor", Rate = 5 },
				{ Unit = "PhantomKnight", Rate = 5 },
				{ Unit = "DarkIllusionist", Rate = 5 },
				{ Unit = "CursedSheriff", Rate = 10 },
				{ Unit = "MidnightBellringer", Rate = 10 },
				{ Unit = "Gravedigger", Rate = 14 },
				{ Unit = "CursedScarecrow", Rate = 14 },
				{ Unit = "NightWatchman", Rate = 24.7 },
				{ Rune = "LanternHeart", Rate = 2.5 },
				{ Rune = "CursedThreads", Rate = 3 },
				{ Rune = "PhantomCrown", Rate = 2.5 },
			},
			-- список для показа (от редких к частым); должен совпадать с юнитами в Rewards
			Units = {
				"LanternKing", "CursedClockmaker", "HalloweenPuppeteer", "HeadlessExecutioner", "PlagueDoctor",
				"PhantomKnight", "DarkIllusionist", "CursedSheriff", "MidnightBellringer", "Gravedigger",
				"CursedScarecrow", "NightWatchman",
			},
		},

		-- Blood Moon: кейс отключён и убран из лобби (юниты остаются в инвентаре)
		BloodMoon = {
			Name = "BLOOD MOON", Color = Color3.fromRGB(210, 30, 50),
			Enabled = false,
			Description = "Кровавая луна. Шанс SECRET: 0.1%",
			Cost1 = 100, Cost10 = 900,
			Rates = { Common = 70, Rare = 21, Epic = 6.4, Legendary = 2, Mythic = 0.5, Secret = 0.1 },
			Units = { "BloodAcolyte", "CrimsonGunslinger", "MoonWitch", "BloodfangWarlord", "LunarSeraph", "CrimsonEclipse" },
		},
	},
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBXA0261AAE69739AB52BB3AD88E3F5D060">
					<Properties>
						<string name="Name">Difficulties</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Config.Difficulties
-- Сложность выбирается в портале PLAY в лобби.
-- HP / Speed — множители врагов, Money — множитель денег, Gems — множитель кристаллов,
-- CoreHP — здоровье ядра, Intermission — секунд между волнами.
-- Здесь же режимы прицеливания юнитов.

return {
	TargetModes = { "First", "Last", "Strongest", "Weakest", "Closest" },

	DifficultyOrder = { "Easy", "Medium", "Hard", "Hardcore" },

	Difficulties = {
		Easy = {
			Name = "ЛЁГКАЯ", Color = Color3.fromRGB(90, 220, 120),
			HP = 0.55, Speed = 0.9, Money = 1.3, Gems = 0.6, CoreHP = 150, Intermission = 18,
			Description = "Для новичков. Враги слабее, денег больше.",
		},
		Medium = {
			Name = "СРЕДНЯЯ", Color = Color3.fromRGB(255, 205, 70),
			HP = 1.0, Speed = 1.0, Money = 1.0, Gems = 1.0, CoreHP = 100, Intermission = 15,
			Description = "Стандартный баланс.",
		},
		Hard = {
			Name = "СЛОЖНАЯ", Color = Color3.fromRGB(255, 90, 80),
			HP = 1.2, Speed = 1.05, Money = 1.0, Gems = 1.6, CoreHP = 100, Intermission = 12,
			Description = "Враги крепче и быстрее. Награда x1.6.",
		},
		Hardcore = {
			Name = "ХАРДКОР", Color = Color3.fromRGB(200, 40, 255),
			HP = 1.4, Speed = 1.1, Money = 1.0, Gems = 2.5, CoreHP = 50, Intermission = 10,
			Description = "Только для лучших. Слабое ядро, быстрые враги. Награда x2.5.",
		},
	},
}
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX1883B1969DCCA8383ABB544716B101BA">
					<Properties>
						<string name="Name">Enemies</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: Config.Enemies
-- Health — базовое HP (умножается на множитель волны и HP сложности).
-- Armor — доля поглощаемого урона, Dodge — шанс уклониться. CoreDamage — урон ядру.
-- Reward — деньги за убийство, BossGems — кристаллы всем игрокам за босса.
-- Поведение (Хэллоуин): Phase, ArmorBreak, OnDeath, Fog, Shield, Haste, Enrage, ArmorZones, FireAura, ArmorScale.
-- SpawnStyle — анимация появления на клиенте.

return {
	EnemyOrder = {
		"LostSoul", "VoidCrawler", "ShadowBeast", "ArmoredHorror", "RiftPhantom",
		"AbyssBrute", "CorruptedTitan", "VoidDevourer", "TheEntity",
		-- Хэллоуин
		"CursedDead", "PumpkinRunner", "PhantomWarrior", "BoneGuard", "LivingScarecrow", "StrawMinion",
		"FogWarlock", "PumpkinBrute", "NightReaper", "GraveWarden", "FogReaper", "CursedMonarch",
	},

	Enemies = {
		----------------------------------------------------------------
		-- ПУСТОТА (карта Void)
		----------------------------------------------------------------
		LostSoul       = { Name = "Lost Soul",       Health = 12,   Speed = 10.5, Reward = 10,   CoreDamage = 1,   Scale = 0.85 },
		VoidCrawler    = { Name = "Void Crawler",    Health = 33,   Speed = 9,    Reward = 18,   CoreDamage = 2,   Scale = 1.0 },
		ShadowBeast    = { Name = "Shadow Beast",    Health = 30,   Speed = 16,   Reward = 21,   CoreDamage = 2,   Scale = 1.0 },
		ArmoredHorror  = { Name = "Armored Horror",  Health = 120,  Speed = 7,    Reward = 45,   CoreDamage = 4,   Scale = 1.15, Armor = 0.3 },
		RiftPhantom    = { Name = "Rift Phantom",    Health = 85,   Speed = 11.5, Reward = 40,   CoreDamage = 3,   Scale = 1.05, Dodge = 0.2 },
		AbyssBrute     = { Name = "Abyss Brute",     Health = 510,  Speed = 6,    Reward = 105,  CoreDamage = 8,   Scale = 1.5 },
		CorruptedTitan = {
			Name = "Corrupted Titan", Health = 1200, Speed = 5, Reward = 500, CoreDamage = 25, Scale = 2.2,
			Armor = 0.15, IsBoss = true, BossGems = 50,
		},
		VoidDevourer = {
			Name = "Void Devourer", Health = 3000, Speed = 4.5, Reward = 1500, CoreDamage = 50, Scale = 2.6,
			IsBoss = true, BossGems = 150,
		},
		TheEntity = {
			Name = "The Entity", Health = 8400, Speed = 4, Reward = 3000, CoreDamage = 100, Scale = 3.0,
			Armor = 0.1, IsBoss = true, BossGems = 500,
			-- каждые Interval с призывает Count врагов позади себя
			Summon = { Enemy = "LostSoul", Count = 3, Interval = 7 },
		},

		----------------------------------------------------------------
		-- ХЭЛЛОУИН (только на карте Haunted Hollow)
		----------------------------------------------------------------
		CursedDead = {
			Name = "Cursed Dead", Health = 32, Speed = 6.5, Reward = 10, CoreDamage = 1, Scale = 1.0, Event = "Halloween",
			Description = "Медленный проклятый мертвец. После смерти рассыпается в зелёный дым.",
		},
		PumpkinRunner = {
			Name = "Pumpkin Runner", Health = 20, Speed = 16, Reward = 9, CoreDamage = 1, Scale = 0.9, Event = "Halloween",
			Description = "Очень быстрый, но хрупкий. Оставляет оранжевые искры.",
		},
		PhantomWarrior = {
			Name = "Phantom Warrior", Health = 85, Speed = 10.5, Reward = 32, CoreDamage = 3, Scale = 1.05, Event = "Halloween",
			Description = "Периодически становится почти невидимым и получает вдвое меньше урона.",
			Phase = { Every = 6, Duration = 1.5, Taken = 0.5 },
		},
		BoneGuard = {
			Name = "Bone Guard", Health = 240, Speed = 5.5, Reward = 60, CoreDamage = 4, Scale = 1.15, Armor = 0.4, Event = "Halloween",
			Description = "Медленный и крепкий. На половине HP броня ломается (40% → 10%).",
			ArmorBreak = { At = 0.5, Armor = 0.1 },
		},
		LivingScarecrow = {
			Name = "Living Scarecrow", Health = 120, Speed = 8.5, Reward = 38, CoreDamage = 3, Scale = 1.1, Event = "Halloween",
			Description = "После смерти из него выбегают 2 соломенных существа.",
			OnDeath = { Enemy = "StrawMinion", Count = 2 },
		},
		StrawMinion = {
			Name = "Straw Creature", Health = 18, Speed = 12, Reward = 4, CoreDamage = 1, Scale = 0.6, Event = "Halloween",
			Minion = true,
			Description = "Соломенное существо из Живого пугала.",
		},
		FogWarlock = {
			Name = "Fog Warlock", Health = 150, Speed = 7.5, Reward = 55, CoreDamage = 4, Scale = 1.1, Event = "Halloween",
			Description = "Создаёт туман: враги рядом ускоряются на 30% на 2.5 с.",
			Fog = { Every = 6, Radius = 9, Speed = 0.3, Duration = 2.5 },
		},
		PumpkinBrute = {
			Name = "Pumpkin Brute", Health = 560, Speed = 5, Reward = 110, CoreDamage = 8, Scale = 1.55, Event = "Halloween",
			Description = "Огромный тыквенный громила. Много HP, медленный.",
		},
		NightReaper = {
			Name = "Night Reaper", Health = 1500, Speed = 6, Reward = 380, CoreDamage = 20, Scale = 1.8, Armor = 0.2,
			Event = "Halloween", MiniBoss = true, -- мини-босс: только подпись в бестиарии, не IsBoss
			Description = "Мини-босс. Каждые 10 с на 3 с ставит защиту: получает вдвое меньше урона.",
			Shield = { Every = 10, Duration = 3, Taken = 0.5 },
		},

		-- ФИНАЛЬНЫЕ БОССЫ (по одному на сложность)
		GraveWarden = {
			Name = "Grave Warden", Health = 3000, Speed = 4.2, Reward = 2500, CoreDamage = 100, Scale = 2.4, Armor = 0.5,
			IsBoss = true, BossGems = 150, Event = "Halloween",
			Description = "Босс ЛЁГКОЙ сложности. Мощная броня трескается по мере потери HP. Медленный.",
			ArmorScale = true, -- броня = базовая × доля HP
			SpawnStyle = "Grave",
		},
		FogReaper = {
			Name = "Fog Reaper", Health = 4500, Speed = 5, Reward = 3500, CoreDamage = 100, Scale = 2.5, Armor = 0.15,
			IsBoss = true, BossGems = 250, Event = "Halloween",
			Description = "Босс СРЕДНЕЙ сложности. Ускоряется, создаёт туман, ставит защиту. На 50% HP — красное свечение.",
			Haste = { Every = 12, Duration = 3, Speed = 0.6 },
			Fog = { Every = 8, Radius = 10, Speed = 0.3, Duration = 3 },
			Shield = { Every = 15, Duration = 3, Taken = 0.5 },
			Enrage = { At = 0.5, Speed = 0.15 },
			SpawnStyle = "FogVortex",
		},
		CursedMonarch = {
			Name = "Cursed Monarch", Health = 7000, Speed = 4.2, Reward = 5000, CoreDamage = 100, Scale = 2.7, Armor = 0.15,
			IsBoss = true, BossGems = 400, Event = "Halloween",
			Description = "Босс СЛОЖНОЙ сложности. Огненная аура, защита на участках дороги, на 50% HP — вторая фаза и 2 Тыквенных громилы.",
			-- участки дороги { от, до, +броня } (доля длины пути), где броня монарха +35%
			ArmorZones = { { 0.28, 0.40, 0.35 }, { 0.60, 0.72, 0.35 } },
			FireAura = 1.5, -- союзники при столкновении теряют в 1.5 раза больше HP
			Enrage = { At = 0.5, Spawn = { "PumpkinBrute", 2 } },
			SpawnStyle = "Portal",
		},
	},
}
