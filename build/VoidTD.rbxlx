------------------------------------------------------------------------
-- ВОСПРОИЗВЕДЕНИЕ
------------------------------------------------------------------------
local function ease(a)
	return a * a * (3 - 2 * a)
end
Anims.Ease = ease

function Anims.Has(name)
	return name ~= nil and Clips[name] ~= nil
end

function Anims.FidgetsFor(attackAnim)
	local list = attackAnim and Fidgets[attackAnim]
	if list and #list > 0 then
		return list
	end
	return DEFAULT_FIDGETS
end

function Anims.PickFidget(attackAnim)
	local list = Anims.FidgetsFor(attackAnim)
	return list[math.random(1, #list)]
end

function Anims.Play(state, name, h, hits, interval, start)
	local clip = name and Clips[name]
	if not state or not clip then
		return false
	end
	state.Anim = { Start = start or os.clock(), Frames = clip(h, hits, interval), Name = name }
	return true
end

function Anims.PlayFidget(state, attackAnim, start)
	local name = Anims.PickFidget(attackAnim)
	Anims.Play(state, name, nil, nil, nil, start)
	return name
end

function Anims.Stop(state)
	if state then
		state.Anim = nil
	end
end

function Anims.IsPlaying(state)
	return state ~= nil and state.Anim ~= nil
end

function Anims.Register(name, builder, fidgets)
	Clips[name] = builder
	if fidgets then
		Fidgets[name] = fidgets
	end
end

-- запись интерполированного сустава в буфер; [5] — метка кадра (для чистки устаревших суставов)
local function mix(buf, joint, p0, p1, a, stamp)
	p0 = p0 or ZERO
	p1 = p1 or ZERO
	local d = buf[joint]
	if not d then
		d = { 0, 0, 0, 0, 0 }
		buf[joint] = d
	end
	local x0, y0, z0, w0 = p0[1] or 0, p0[2] or 0, p0[3] or 0, p0[4] or 0
	d[1] = x0 + ((p1[1] or 0) - x0) * a
	d[2] = y0 + ((p1[2] or 0) - y0) * a
	d[3] = z0 + ((p1[3] or 0) - z0) * a
	d[4] = w0 + ((p1[4] or 0) - w0) * a
	d[5] = stamp
end

-- Поза в момент t: сглаженная (smoothstep) интерполяция между соседними кадрами,
-- суставы = кадр0 ∪ кадр1 ∪ idle
function Anims.Eval(state, t)
	local rig = state.Rig
	local idle = (rig and rig.Idle) or EMPTY
	local anim = state.Anim
	if not anim then
		return idle
	end
	local frames = anim.Frames
	local n = frames and #frames or 0
	if n == 0 then
		state.Anim = nil
		return idle
	end
	local el = t - (anim.Start or t)
	if el >= frames[n][1] then
		state.Anim = nil
		return idle
	end
	local k = 1
	for i = 1, n - 1 do
		if el >= frames[i][1] then
			k = i
		end
	end
	local f0 = frames[k]
	local f1 = frames[k + 1] or f0
	local span = math.max(f1[1] - f0[1], 0.001)
	local a = ease(clamp((el - f0[1]) / span, 0, 1))
	local p0s, p1s = f0[2] or EMPTY, f1[2] or EMPTY

	local buf = state.PoseBuf
	if not buf then
		buf = {}
		state.PoseBuf = buf
	end
	local stamp = (state.PoseStamp or 0) + 1
	state.PoseStamp = stamp
	for j, v in pairs(p0s) do
		mix(buf, j, v, p1s[j] or idle[j], a, stamp)
	end
	for j, v in pairs(p1s) do
		if p0s[j] == nil then
			mix(buf, j, idle[j], v, a, stamp)
		end
	end
	for j, v in pairs(idle) do
		if p0s[j] == nil and p1s[j] == nil then
			mix(buf, j, v, v, a, stamp)
		end
	end
	for j, v in pairs(buf) do
		if v[5] ~= stamp then
			buf[j] = nil
		end
	end
	return buf
end

------------------------------------------------------------------------
-- ВТОРИЧНОЕ ДВИЖЕНИЕ
------------------------------------------------------------------------
-- вид мотора (порядок проверок как в легаси: RS/LS → Wing* → Neck → Cape/Scarf → Cape2 → Orbit* → SpinRates)
local K_OTHER, K_ARM, K_WING, K_NECK, K_CAPE, K_CAPE2, K_ORBIT = 0, 1, 2, 3, 4, 5, 6

local function classify(name)
	if name == "RS" then
		return K_ARM, 1
	elseif name == "LS" then
		return K_ARM, -1
	elseif string.sub(name, 1, 4) == "Wing" then
		return K_WING, (string.sub(name, 5, 5) == "R") and 1 or -1
	elseif name == "Neck" then
		return K_NECK, 0
	elseif name == "Cape" or name == "Scarf" then
		return K_CAPE, 0
	elseif name == "Cape2" then
		return K_CAPE2, 0
	elseif string.sub(name, 1, 5) == "Orbit" then
		return K_ORBIT, 0
	end
	return K_OTHER, 0
end

-- кэш видов моторов на риге (имена не меняются; новые моторы классифицируются при первой встрече)
local function kindsOf(rig)
	local kinds = rig.AnimKinds
	if not kinds then
		kinds = { Kind = {}, Side = {} }
		rig.AnimKinds = kinds
	end
	return kinds
end

function Anims.Apply(rig, pose, t, phase)
	local motors = rig and rig.Motors
	if not motors then
		return
	end
	local base = rig.Base or EMPTY
	pose = pose or EMPTY
	phase = phase or 0
	local s = rig.Scale or 1
	local breathe = sin(t * 2 + phase)

	-- стрелки и шестерёнки (Clock*/Gear*): быстрее в бурю и во время способностей
	local spinRates = rig.SpinRates
	local spinDt = 0
	local spinAngle
	if spinRates then
		spinDt = clamp(t - (rig.SpinT or t), 0, 0.1)
		rig.SpinT = t
		spinAngle = rig.SpinAngle
		if not spinAngle then
			spinAngle = {}
			rig.SpinAngle = spinAngle
		end
		local boost = rig.Storm and 3 or 1
		if os.clock() < (rig.SpinBoostUntil or 0) then
			boost = math.max(boost, 6)
		end
		spinDt *= boost
	end

	local kinds = kindsOf(rig)
	local kindOf, sideOf = kinds.Kind, kinds.Side
	local armX, armZ = rad(breathe * 2), rad(breathe * 1.5)
	local wing = sin(t * 2.4 + phase)
	local neckYaw = sin(t * 0.7 + phase) * 0.08
	local gust = rig.Gust or 0
	local capeX = rad(6 + sin(t * 1.7 + phase) * 4 + gust * 22)
	local capeZ = rad(sin(t * 1.1 + phase) * 3)
	local cape2X = rad(5 + sin(t * 1.7 + phase - 0.8) * 7 + gust * 28)
	local cape2Z = rad(sin(t * 1.1 + phase - 0.6) * 5)
	local orbitY = t * 1.4 + phase

	for name, motor in pairs(motors) do
		local b = base[name]
		if b then
			local kind = kindOf[name]
			if kind == nil then
				local side
				kind, side = classify(name)
				kindOf[name], sideOf[name] = kind, side
			end
			local p = pose[name]
			local cf = b
			if name == "Root" then
				-- дыхание корпуса всегда, даже без позы
				cf = b * CF(0, ((p and p[4]) or 0) * s + breathe * 0.04 * s, 0)
			end
			if p then
				cf = cf * ANG(rad(p[1] or 0), rad(p[2] or 0), rad(p[3] or 0))
			end
			if kind == K_ARM then
				cf = cf * ANG(armX, 0, armZ * sideOf[name])
			elseif kind == K_WING then
				local side = sideOf[name]
				cf = cf * ANG(0, wing * 0.12 * side, wing * 0.1 * side)
			elseif kind == K_NECK then
				cf = cf * ANG(0, neckYaw, 0)
			elseif kind == K_CAPE then
				cf = cf * ANG(capeX, 0, capeZ)
			elseif kind == K_CAPE2 then
				-- нижняя часть плаща догоняет верхнюю с запаздыванием
				cf = cf * ANG(cape2X, 0, cape2Z)
			elseif kind == K_ORBIT then
				cf = cf * ANG(0, orbitY, 0)
			elseif spinRates then
				local rate = spinRates[name]
				if rate then
					-- накопленный угол: минус = по часовой
					local ang = (spinAngle[name] or 0) - rate * spinDt
					spinAngle[name] = ang
					cf = cf * ANG(0, 0, ang)
				end
			end
			motor.C0 = cf
		end
	end
end

function Anims.Step(state, t)
	Anims.Apply(state.Rig, Anims.Eval(state, t), t, state.Phase or 0)
end

-- Anims.Slash и т.п. — как в легаси-таблице Anims
setmetatable(Anims, {
	__index = function(_, k)
		return Clips[k]
	end,
})

return Anims
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX252225134A9E090BABE18ABBA7DB7B0E">
					<Properties>
						<string name="Name">FX</string>
						<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: FX (клиент) — ядро эффектов
-- Только картинка и звук: урон/броски считает сервер. Эффекты способностей пишутся в детях
-- FX/Void.lua, FX/Chrono.lua, FX/Halloween.lua (каждый `return function(FX) ... end`), которые
-- подключаются в FX.Init и регистрируют свои функции (FX.Xxx / FX.Fn.Xxx / FX.RegisterImpact).
--
-- ПОЛЯ
--   FX.Lite                     -- облегчённый режим (меньше частиц/обломков), ставит ctx.SetLite
--   FX.Colors                   -- Neon Soft Pink White Red Gold Blue Orange (+ CGold Bronze Dial Dust)
--   FX.Folder                   -- workspace.VoidTD_FX (создаётся лениво / в Init)
--   FX.Env                      -- { Renderer, Config, Path, Ctx }; недостающее берётся из ctx
--   FX.Fn                       -- именованные эффекты детей (FX.Fn.GearDisc, FX.Fn.EchoGhost, ...)
--   FX.ProjectileMakers[kind]   -- function(lv) -> part, trailColor?, tipOffset? (CFrame детали "Tip"
--                                  относительно снаряда; по умолчанию CFrame.new(0, 0, -Size.Z/2))
--   FX.Rng                      -- общий Random
--
-- ИНФРАСТРУКТУРА
--   FX.Init(ctx?)                         -- папка, тряска камеры, FX.Env, дети Void/Chrono/Halloween (один раз)
--   FX.SetLite(on)
--   FX.Sound(name, volume?, pitch?, pos?) -- Config.Sounds[name] {Id, Volume, Pitch, Custom}; volume/pitch —
--        множители; pos -> затухание по расстоянию до камеры (>140 studs — тишина); троттлинг 0.07 с на имя
--   FX.Shake(mag, dur)                    -- тряски складываются по максимуму (сильная короткая не теряется)
--   FX.Tween(obj, time, goal, style=Quad, dir=Out) -> Tween
--   FX.Part(props) -> BasePart            -- Class="Part", Anchored, без коллизий/запросов/тени, Neon,
--        Color=Neon, Size=1, Shape?, Transparency=0, CFrame, Parent=FX.Folder; прочие ключи props — как свойства
--   FX.Light(parent, color, range, brightness, life?) -> PointLight (life: яркость гаснет до 0)
--   FX.Cleanup(obj, t)                    -- уничтожить через t с
--   FX.Fade(part, life, goal?)            -- твин goal + Transparency=1, уничтожить через life+0.05
--   FX.Run(fn) -> job                     -- fn(elapsed, dt, now) каждый кадр (общий RenderStepped);
--        вернуть true = закончить; job:Stop(). Ошибка в fn пишет warn и снимает задачу.
--   FX.Ground(pos) -> Vector3             -- (x, Map.GroundY + 0.15, z) активной карты
--   FX.CamFacing(pos) -> CFrame           -- в pos, лицевая сторона (-Z) смотрит на камеру (по горизонтали)
--   FX.EnemyCenter(id), FX.EnemyPosition(id), FX.UnitView(uid), FX.MuzzlePos(view) -- через FX.Env.Renderer
--
-- БАЗОВЫЕ ЭФФЕКТЫ
--   FX.Burst(pos, color=Neon, count=8, size=0.4, speed=6, life=0.45)
--   FX.Ring(pos, radius, color=Neon, life=0.5, height=0.3, startRadius=0.5, transparency=0.15) -> part
--   FX.Sphere(pos, radius, color=Neon, life, material=Neon, startT=0.1) -> part
--   FX.Arc(cf, radius, a0, a1, color=Neon, thickness=0.35, life=0.35, horizontal?)
--   FX.SlashMark(pos, angle, length, width, color=Neon, life=0.35)
--   FX.Cracks(pos, radius, color=Neon, count=8, life=1.4)        -- в Lite не рисуется
--   FX.Projectile(kind, from, getTarget, travel, onHit?, lv=1) -> part
--        getTarget() -> Vector3|nil (или сразу Vector3); встроенные kind: Arrow Orb Crystal Bullet Moon,
--        остальные (Bolt, ...) — стандартный болт; FX.ProjectileMakers[kind] имеют приоритет
--   FX.Beam(from, to, width, color=Neon, life=0.45, big?)
--   FX.Thread(from, to, color=Soft)
--   FX.Poof(pos, color=Neon, size=1)
--   FX.Place(pos) ; FX.LevelUp(pos, color=Neon) ; FX.Summon(pos, radius=6)
--   FX.DamageNumber(pos, amount, flag)    -- flag 1 крит ("N!"), 2 фаза ("PHASE"), иначе обычный
--   FX.Debris(pos, color, count, size, speed, life, material=Slate) -- куски с гравитацией до земли
--   FX.Smoke(pos, color, n, size, life, rise=2)
--   FX.Flash(pos, color, radius, life)    -- шар + вспышка света
--   FX.RuneRing(pos, r, color, life) -> { parts }
--   FX.PortalDisc(pos, r, color, life, edge=(255,235,170))
--
-- УДАРЫ (Impact)
--   FX.RegisterImpact(kind, fn(p))        -- p = payload Impact {K, P, R, L, U, ...}
--   FX.Impact(p) -> handled               -- вызывает зарегистрированный обработчик (pcall)
--   Ядро само регистрирует Smash и Summon (дети могут переопределить).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local FX = {}
FX.Lite = false
FX.Fn = {}
FX.ProjectileMakers = {}
FX.Rng = Random.new()

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local rad = math.rad
local rng = FX.Rng

local NEON = Color3.fromRGB(180, 80, 255)
local SOFT = Color3.fromRGB(215, 160, 255)
local PINK = Color3.fromRGB(255, 60, 170)
local WHITE = Color3.fromRGB(250, 245, 255)
local RED = Color3.fromRGB(255, 35, 55)
local GOLD = Color3.fromRGB(255, 205, 80)
local BLUE = Color3.fromRGB(90, 180, 255)
local ORANGE = Color3.fromRGB(255, 140, 40)
local PORTAL_EDGE = Color3.fromRGB(255, 235, 170)
FX.Colors = {
	Neon = NEON, Soft = SOFT, Pink = PINK, White = WHITE, Red = RED, Gold = GOLD, Blue = BLUE, Orange = ORANGE,
	CGold = Color3.fromRGB(230, 178, 74), Bronze = Color3.fromRGB(170, 112, 52), Dial = Color3.fromRGB(16, 12, 20),
	Dust = Color3.fromRGB(70, 60, 82),
}

------------------------------------------------------------------------
-- ОКРУЖЕНИЕ (Renderer/Config/Path для эффектов, которым нужны позиции врагов)
------------------------------------------------------------------------
FX.Env = setmetatable({ Config = Config }, {
	__index = function(env, k)
		local c = rawget(env, "Ctx")
		if c and c[k] ~= nil then
			return c[k]
		end
		if k == "Path" then
			local p = require(Shared:WaitForChild("Path"))
			rawset(env, "Path", p)
			return p
		end
		-- Init без ctx: Renderer — соседний модуль Render (к моменту эффектов уже загружен)
		if k == "Renderer" then
			local mod = script.Parent and script.Parent:FindFirstChild("Render")
			if mod and mod:IsA("ModuleScript") then
				local ok, r = pcall(require, mod)
				if ok and type(r) == "table" then
					rawset(env, "Renderer", r)
					return r
				end
			end
		end
		return nil
	end,
})

local function groundY()
	local path = FX.Env.Path
	local map = path and path.Map
	return (map and map.GroundY) or (Config.Map and Config.Map.GroundY) or 0
end

function FX.Ground(pos)
	return V(pos.X, groundY() + 0.15, pos.Z)
end

-- позиции врагов/юнитов через Renderer (nil, если его ещё нет или объекта нет)
local function rend(key)
	local r = FX.Env.Renderer
	return r and r[key]
end
function FX.EnemyCenter(id) local f = rend("EnemyCenter"); return f and f(id) or nil end
function FX.EnemyPosition(id) local f = rend("EnemyPosition"); return f and f(id) or nil end
function FX.UnitView(uid) local t = rend("UnitViews"); return t and t[uid] or nil end
function FX.MuzzlePos(view) local f = rend("MuzzlePos"); return (f and view and view.Rig) and f(view) or nil end

function FX.CamFacing(pos)
	local cam = workspace.CurrentCamera
	local c = cam and cam.CFrame.Position or (pos + V(0, 10, 20))
	local flat = V(c.X, pos.Y, c.Z)
	if (flat - pos).Magnitude < 0.1 then
		return CF(pos)
	end
	return CFrame.lookAt(pos, flat)
end

------------------------------------------------------------------------
-- ИНФРАСТРУКТУРА
------------------------------------------------------------------------
local function getFolder()
	local f = FX.Folder
	if f and f.Parent then
		return f
	end
	f = workspace:FindFirstChild("VoidTD_FX")
	if not f then
		f = Instance.new("Folder")
		f.Name = "VoidTD_FX"
		f.Parent = workspace
	end
	FX.Folder = f
	return f
end

function FX.SetLite(on)
	FX.Lite = on and true or false
end

local function tween(obj, time, goal, style, dir)
	local tw = TweenService:Create(obj, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
FX.Tween = tween

local PART_KEYS = { Class = true, Parent = true, Shape = true, Size = true, Material = true, Color = true, Transparency = true, CFrame = true }

function FX.Part(props)
	props = props or {}
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if props.Shape and p:IsA("Part") then
		p.Shape = props.Shape
	end
	p.Material = props.Material or Enum.Material.Neon
	p.Color = props.Color or NEON
	p.Size = props.Size or V(1, 1, 1)
	p.Transparency = props.Transparency or 0
	p.CFrame = props.CFrame or CF()
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		if not PART_KEYS[k] then
			p[k] = v
		end
	end
	p.Parent = props.Parent or getFolder()
	return p
end

local function cleanup(obj, t)
	task.delay(t, function()
		if obj then
			obj:Destroy()
		end
	end)
end
FX.Cleanup = cleanup

local function light(parent, color, range, brightness, life)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Shadows = false
	l.Parent = parent
	if life then
		tween(l, life, { Brightness = 0 })
	end
	return l
end
FX.Light = light

function FX.Fade(p, life, goal)
	goal = goal or {}
	goal.Transparency = 1
	tween(p, life, goal)
	cleanup(p, life + 0.05)
end

-- Общий покадровый цикл: одна подписка RenderStepped на все движущиеся эффекты
local jobs = {}
local stepConn

local function stopJob(job)
	job.Dead = true
end

local function stepJobs(dt)
	local now = os.clock()
	local i = 1
	while i <= #jobs do
		local job = jobs[i]
		local done = job.Dead
		if not done then
			local ok, res = pcall(job.Fn, now - job.T0, dt, now)
			if not ok then
				warn("[FX] " .. tostring(res))
				done = true
			else
				done = res == true
			end
		end
		if done then
			job.Dead = true
			jobs[i] = jobs[#jobs]
			jobs[#jobs] = nil
		else
			i += 1
		end
	end
end

function FX.Run(fn)
	local job = { Fn = fn, T0 = os.clock(), Dead = false, Stop = stopJob }
	jobs[#jobs + 1] = job
	if not stepConn then
		stepConn = RunService.RenderStepped:Connect(stepJobs)
	end
	return job
end

------------------------------------------------------------------------
-- ЗВУКИ (встроенные звуки Roblox; Custom = свой ассет)
------------------------------------------------------------------------
local lastSound = {}

function FX.Sound(name, volume, pitch, pos)
	local def = Config.Sounds and Config.Sounds[name]
	if not def then
		return
	end
	local t = os.clock()
	local last = lastSound[name]
	if last and t - last < 0.07 then
		return
	end
	volume = (volume or 1) * (def.Volume or 0.4)
	-- далёкие звуки тише
	if pos then
		local cam = workspace.CurrentCamera
		local d = cam and (cam.CFrame.Position - pos).Magnitude or 0
		if d > 140 then
			return
		end
		volume *= math.clamp(1 - d / 140, 0.15, 1)
	end
	lastSound[name] = t
	local custom = type(def.Custom) == "string" and def.Custom ~= ""
	local s = Instance.new("Sound")
	s.Name = "VoidTD_" .. tostring(name)
	s.SoundId = custom and def.Custom or (def.Id or "")
	s.Volume = volume
	s.PlaybackSpeed = (pitch or 1) * (custom and 1 or (def.Pitch or 1))
	s.Parent = SoundService
	s:Play()
	cleanup(s, 4)
end

------------------------------------------------------------------------
-- ТРЯСКА КАМЕРЫ
------------------------------------------------------------------------
-- активные тряски; сила в момент t = (Until - t) / Dur * Mag, итог — максимум
local shakes = {}
local MAX_SHAKES = 8
local shakeOffset, shakeApplied -- что добавили к камере в этом кадре (снимаем в начале следующего)

function FX.Shake(mag, dur)
	if type(mag) ~= "number" or type(dur) ~= "number" or mag <= 0 or dur <= 0 then
		return
	end
	local t = os.clock()
	for i = #shakes, 1, -1 do
		if t >= shakes[i].Until then
			table.remove(shakes, i)
		end
	end
	if #shakes >= MAX_SHAKES then
		table.remove(shakes, 1) -- самая старая
	end
	shakes[#shakes + 1] = { Until = t + dur, Dur = dur, Mag = mag }
end

local function shakeAmount(t)
	local k = 0
	for i = #shakes, 1, -1 do
		local s = shakes[i]
		if t >= s.Until then
			table.remove(shakes, i)
		else
			local v = (s.Until - t) / s.Dur * s.Mag
			if v > k then
				k = v
			end
		end
	end
	return k
end

local function sameCFrame(a, b)
	return (a.Position - b.Position).Magnitude < 1e-3 and a.LookVector:Dot(b.LookVector) > 0.99999 and a.UpVector:Dot(b.UpVector) > 0.99999
end

-- до камерных скриптов: снять прошлое смещение (иначе Scriptable-камера «уплывает»)
local function shakeUndo()
	local cam = workspace.CurrentCamera
	if shakeApplied and cam and sameCFrame(cam.CFrame, shakeApplied) then
		cam.CFrame = shakeApplied * shakeOffset:Inverse()
	end
	shakeApplied, shakeOffset = nil, nil
end

-- после камерных скриптов: добавить смещение
local function shakeApply()
	local k = shakeAmount(os.clock())
	if k <= 0 then
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local off = CF(rng:NextNumber(-k, k), rng:NextNumber(-k, k), 0) * ANG(0, 0, rng:NextNumber(-k, k) * 0.03)
	local cf = cam.CFrame * off
	cam.CFrame = cf
	shakeOffset, shakeApplied = off, cf
end

------------------------------------------------------------------------
-- БАЗОВЫЕ ЭФФЕКТЫ
------------------------------------------------------------------------
function FX.Burst(pos, color, count, size, speed, life)
	count = count or 8
	if FX.Lite then
		count = math.min(math.ceil(count / 3), 4)
	end
	size = size or 0.4
	speed = speed or 6
	life = life or 0.45
	for _ = 1, count do
		local dir = V(rng:NextNumber(-1, 1), rng:NextNumber(-0.2, 1), rng:NextNumber(-1, 1)).Unit
		local p = FX.Part({ Size = V(size, size, size), CFrame = CF(pos) * ANG(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0), Color = color or NEON })
		tween(p, life, {
			CFrame = CF(pos + dir * speed * life) * ANG(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0),
			Transparency = 1,
			Size = V(0.05, 0.05, 0.05),
		})
		cleanup(p, life + 0.05)
	end
end

-- плоское кольцо, расширяющееся по земле
function FX.Ring(pos, radius, color, life, height, startRadius, transparency)
	life = life or 0.5
	height = height or 0.3
	local r0 = startRadius or 0.5
	local p = FX.Part({
		Shape = Enum.PartType.Cylinder,
		Size = V(height, r0 * 2, r0 * 2),
		CFrame = CF(pos) * ANG(0, 0, rad(90)),
		Color = color or NEON,
		Transparency = transparency or 0.15,
	})
	tween(p, life, { Size = V(height * 0.4, radius * 2, radius * 2), Transparency = 1 })
	cleanup(p, life + 0.05)
	return p
end

function FX.Sphere(pos, radius, color, life, material, startT)
	life = life or 0.35
	local p = FX.Part({
		Shape = Enum.PartType.Ball,
		Size = V(0.5, 0.5, 0.5),
		CFrame = CF(pos),
		Color = color or NEON,
		Material = material or Enum.Material.Neon,
		Transparency = startT or 0.1,
	})
	tween(p, life, { Size = V(radius * 2, radius * 2, radius * 2), Transparency = 1 })
	cleanup(p, life + 0.05)
	return p
end

-- дуга из 9 сегментов (след оружия); horizontal — в плоскости XZ кадра cf
function FX.Arc(cf, radius, a0, a1, color, thickness, life, horizontal)
	local segs = 9
	thickness = thickness or 0.35
	life = life or 0.35
	local prev
	for i = 0, segs do
		local a = a0 + (a1 - a0) * (i / segs)
		local pt
		if horizontal then
			pt = (cf * CF(math.sin(a) * radius, 0, -math.cos(a) * radius)).Position
		else
			pt = (cf * CF(0, math.cos(a) * radius, -math.sin(a) * radius)).Position
		end
		if prev then
			local len = (pt - prev).Magnitude
			local w = thickness * (0.35 + 0.65 * math.sin(math.pi * i / segs))
			local p = FX.Part({ Size = V(w, w * 0.5, len + w), CFrame = CFrame.lookAt((pt + prev) / 2, pt), Color = color or NEON, Transparency = 0.05 })
			local delay = i / segs * 0.06
			task.delay(delay, function()
				tween(p, life, { Transparency = 1, Size = V(w * 0.2, w * 0.1, len) })
			end)
			cleanup(p, life + delay + 0.05)
		end
		prev = pt
	end
end

-- полоса-разрез с белой сердцевиной
function FX.SlashMark(pos, angle, length, width, color, life)
	life = life or 0.35
	local cf = CF(pos) * ANG(0, rng:NextNumber(0, math.pi), 0) * ANG(0, 0, angle)
	local p = FX.Part({ Size = V(width, length * 0.3, 0.12), CFrame = cf, Color = color or NEON })
	local core = FX.Part({ Size = V(width * 0.35, length * 0.3, 0.14), CFrame = cf, Color = WHITE })
	tween(p, life * 0.35, { Size = V(width, length, 0.12) }, Enum.EasingStyle.Back)
	tween(core, life * 0.35, { Size = V(width * 0.35, length, 0.14) }, Enum.EasingStyle.Back)
	task.delay(life * 0.35, function()
		tween(p, life * 0.65, { Transparency = 1, Size = V(0.05, length * 1.1, 0.05) })
		tween(core, life * 0.65, { Transparency = 1, Size = V(0.02, length * 1.1, 0.02) })
	end)
	cleanup(p, life + 0.05)
	cleanup(core, life + 0.05)
end

-- трещины в земле с ответвлениями и тёмное пятно
function FX.Cracks(pos, radius, color, count, life)
	if FX.Lite then
		return
	end
	count = count or 8
	life = life or 1.4
	for i = 1, count do
		local a = (i / count) * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local len = radius * rng:NextNumber(0.5, 0.95)
		local dir = V(math.cos(a), 0, math.sin(a))
		local mid = pos + dir * (len / 2 + 0.6)
		local p = FX.Part({
			Size = V(rng:NextNumber(0.25, 0.5), 0.08, len),
			CFrame = CFrame.lookAt(mid, mid + dir) * ANG(0, rng:NextNumber(-0.15, 0.15), 0),
			Color = color or NEON,
		})
		local bdir = (dir + V(-dir.Z, 0, dir.X) * rng:NextNumber(-0.8, 0.8)).Unit
		local bmid = pos + dir * len * 0.6 + bdir * len * 0.2
		local b = FX.Part({ Size = V(0.2, 0.08, len * 0.4), CFrame = CFrame.lookAt(bmid, bmid + bdir), Color = color or NEON })
		task.delay(life * 0.5, function()
			tween(p, life * 0.5, { Transparency = 1 })
			tween(b, life * 0.5, { Transparency = 1 })
		end)
		cleanup(p, life + 0.05)
		cleanup(b, life + 0.05)
	end
	local scorch = FX.Part({
		Shape = Enum.PartType.Cylinder,
		Size = V(0.06, radius * 0.9, radius * 0.9),
		CFrame = CF(pos) * ANG(0, 0, rad(90)),
		Color = Color3.fromRGB(10, 5, 15),
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.3,
	})
	tween(scorch, life, { Transparency = 1 })
	cleanup(scorch, life + 0.05)
end

------------------------------------------------------------------------
-- СНАРЯДЫ И ЛУЧИ
------------------------------------------------------------------------
local function tipPart(parent, size, color)
	local tip = FX.Part({ Size = size, Color = color, Parent = parent })
	tip.Name = "Tip"
	return tip
end

-- встроенные снаряды легаси
local function builtinProjectile(kind, lv)
	if kind == "Arrow" then
		local p = FX.Part({ Size = V(0.18, 0.18, 2.2), Color = lv >= 4 and NEON or SOFT })
		tipPart(p, V(0.35, 0.35, 0.35), NEON)
		return p
	elseif kind == "Orb" then
		local s = 0.7 + lv * 0.1
		local p = FX.Part({ Shape = Enum.PartType.Ball, Size = V(s, s, s), Color = NEON })
		light(p, NEON, 8, 2)
		return p
	elseif kind == "Crystal" then
		local p = FX.Part({ Size = V(0.4, 0.4, 1.3), Color = Color3.fromRGB(110, 190, 255) })
		light(p, Color3.fromRGB(80, 170, 255), 7, 2)
		return p
	elseif kind == "Bullet" then
		return FX.Part({ Size = V(0.15, 0.15, 0.9), Color = Color3.fromRGB(255, 90, 80) })
	elseif kind == "Moon" then
		local p = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.2, 1.2, 1.2), Color = Color3.fromRGB(255, 200, 215) })
		light(p, Color3.fromRGB(255, 120, 150), 8, 2)
		return p
	end
	-- Bolt и прочие
	return FX.Part({ Size = V(0.25, 0.25, 1.4 + lv * 0.15), Color = lv >= 5 and PINK or SOFT })
end

-- getTarget() -> Vector3|nil (текущая позиция цели) или Vector3
function FX.Projectile(kind, from, getTarget, travel, onHit, lv)
	lv = lv or 1
	local p, trailColor, tipOffset
	local maker = FX.ProjectileMakers[kind]
	if maker then
		p, trailColor, tipOffset = maker(lv)
	end
	if not p then
		p = builtinProjectile(kind, lv)
	end
	local a0 = Instance.new("Attachment")
	a0.Position = V(0, 0.12, 0)
	a0.Parent = p
	local a1 = Instance.new("Attachment")
	a1.Position = V(0, -0.12, 0)
	a1.Parent = p
	local trail = Instance.new("Trail")
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Color = ColorSequence.new(trailColor or (kind == "Orb" and NEON or SOFT))
	trail.LightEmission = 1
	trail.Lifetime = 0.18
	trail.Transparency = NumberSequence.new(0.2, 1)
	trail.WidthScale = NumberSequence.new(kind == "Orb" and 3 or 1, 0)
	trail.Parent = p

	-- деталь "Tip" (наконечник/лицо/пробка) якорная — двигаем вручную вместе со снарядом
	local tip = p:FindFirstChild("Tip")
	if tip then
		tipOffset = tipOffset or CF(0, 0, -p.Size.Z / 2)
	end
	local fixed = typeof(getTarget) == "Vector3" and getTarget or nil
	local function target()
		if fixed then
			return fixed
		end
		return getTarget and getTarget() or nil
	end
	local function place(pos, aim)
		local cf = ((aim - pos).Magnitude > 0.01) and CFrame.lookAt(pos, aim) or CF(pos)
		p.CFrame = cf
		if tip then
			tip.CFrame = cf * tipOffset
		end
	end

	local last = target() or from
	place(from, last)
	local arc = kind == "Arrow"
	local dur = math.max(travel or 0.2, 0.01)
	FX.Run(function(el)
		if not p.Parent then
			return true
		end
		local alpha = math.clamp(el / dur, 0, 1)
		local tg = target() or last
		last = tg
		local pos = from:Lerp(tg, alpha)
		if arc then
			pos += V(0, math.sin(alpha * math.pi) * 1.2, 0)
		end
		place(pos, tg)
		if alpha >= 1 then
			p:Destroy()
			if onHit then
				onHit(tg)
			end
			return true
		end
		return false
	end)
	return p
end

function FX.Beam(from, to, width, color, life, big)
	life = life or 0.45
	color = color or NEON
	local len = (to - from).Magnitude
	local cf = CFrame.lookAt((from + to) / 2, to) * ANG(0, rad(90), 0)
	local outer = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(len, width * 0.2, width * 0.2), CFrame = cf, Color = color, Transparency = 0.15 })
	local inner = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(len, width * 0.1, width * 0.1), CFrame = cf, Color = WHITE })
	tween(outer, 0.1, { Size = V(len, width, width) }, Enum.EasingStyle.Back)
	tween(inner, 0.1, { Size = V(len, width * 0.45, width * 0.45) }, Enum.EasingStyle.Back)
	light(inner, color, 16, 4, life)
	task.delay(0.12, function()
		tween(outer, life, { Size = V(len, 0.05, 0.05), Transparency = 1 })
		tween(inner, life, { Size = V(len, 0.02, 0.02), Transparency = 1 })
	end)
	cleanup(outer, life + 0.2)
	cleanup(inner, life + 0.2)
	-- кольца вдоль луча
	local rings = FX.Lite and 1 or (big and 6 or 3)
	for i = 1, rings do
		local pt = from:Lerp(to, i / (rings + 1))
		local ring = FX.Part({
			Shape = Enum.PartType.Cylinder,
			Size = V(0.15, width * 1.6, width * 1.6),
			CFrame = (((to - pt).Magnitude > 0.01) and CFrame.lookAt(pt, to) or CF(pt)) * ANG(0, rad(90), 0),
			Color = color,
			Transparency = 0.3,
		})
		tween(ring, life, { Size = V(0.05, width * 3.5, width * 3.5), Transparency = 1 })
		cleanup(ring, life + 0.05)
	end
	FX.Sphere(to, width * 1.8, color, 0.35)
	FX.Burst(to, color, big and 16 or 8, 0.5, 10)
	FX.Sphere(from, width, WHITE, 0.25)
end

-- нить от руки к цели
function FX.Thread(from, to, color)
	local len = (to - from).Magnitude
	if len < 0.1 then
		return
	end
	local p = FX.Part({ Size = V(0.08, 0.08, len), CFrame = CFrame.lookAt((from + to) / 2, to), Color = color or SOFT })
	tween(p, 0.5, { Transparency = 1, Size = V(0.02, 0.02, len) })
	cleanup(p, 0.55)
	FX.Ring(to - V(0, 1, 0), 2, color or NEON, 0.35, 0.2)
end

------------------------------------------------------------------------
-- ОБЩИЕ СОБЫТИЯ
------------------------------------------------------------------------
function FX.Summon(pos, radius)
	FX.Ring(V(pos.X, pos.Y + 0.2, pos.Z), radius or 6, NEON, 0.6, 0.4)
	FX.Burst(pos + V(0, 1, 0), NEON, 12, 0.5, 8)
end

function FX.Poof(pos, color, size)
	size = size or 1
	FX.Sphere(pos, 1.5 * size, color or NEON, 0.35)
	FX.Burst(pos, color or NEON, math.floor(6 + size * 4), 0.35 * size, 6 * size, 0.5)
end

function FX.LevelUp(pos, color)
	FX.Sound("Upgrade", 1, 1, pos)
	FX.Ring(pos + V(0, 0.2, 0), 4, color or NEON, 0.6, 0.3)
	local col = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.2, 3, 3), CFrame = CF(pos + V(0, 0.3, 0)) * ANG(0, 0, rad(90)), Color = color or NEON, Transparency = 0.2 })
	tween(col, 0.7, { CFrame = CF(pos + V(0, 7, 0)) * ANG(0, 0, rad(90)), Transparency = 1, Size = V(0.1, 4.5, 4.5) })
	cleanup(col, 0.75)
	FX.Burst(pos + V(0, 3, 0), color or SOFT, 14, 0.35, 7, 0.7)
end

function FX.Place(pos)
	FX.Sound("Place", 1, 1, pos)
	FX.Ring(pos + V(0, 0.2, 0), 3.5, SOFT, 0.45, 0.25)
	FX.Burst(pos + V(0, 0.5, 0), Color3.fromRGB(70, 60, 80), 8, 0.4, 5)
end

------------------------------------------------------------------------
-- ЦИФРЫ УРОНА
------------------------------------------------------------------------
local numberCount = 0
local NUMBER_STYLE = {
	[0] = { Suffix = "", Color = Color3.fromRGB(240, 220, 255), Size = UDim2.fromOffset(90, 30) },
	[1] = { Suffix = "!", Color = Color3.fromRGB(255, 210, 70), Size = UDim2.fromOffset(150, 50) },
	[2] = { Suffix = "", Color = Color3.fromRGB(170, 170, 200), Size = UDim2.fromOffset(80, 26) },
}

function FX.DamageNumber(pos, amount, flag)
	if numberCount > (FX.Lite and 20 or 70) then
		return
	end
	numberCount += 1
	local anchor = FX.Part({ Size = V(0.1, 0.1, 0.1), CFrame = CF(pos), Transparency = 1 })
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 40)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.MaxDistance = 220
	gui.StudsOffsetWorldSpace = V(rng:NextNumber(-0.8, 0.8), 0, rng:NextNumber(-0.8, 0.8))
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = Color3.fromRGB(20, 0, 30)
	-- 2 = уклонение фазой, 1 = крит, иначе обычный урон
	local st = NUMBER_STYLE[flag] or NUMBER_STYLE[0]
	label.Text = flag == 2 and "PHASE" or (tostring(amount) .. st.Suffix)
	label.TextColor3 = st.Color
	gui.Size = st.Size
	label.Parent = gui
	gui.Parent = anchor
	tween(gui, 0.8, { StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + V(0, 2.5, 0) })
	task.delay(0.35, function()
		tween(label, 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	task.delay(0.85, function()
		numberCount -= 1
		anchor:Destroy()
	end)
end

------------------------------------------------------------------------
-- ОБЛОМКИ, ДЫМ, ВСПЫШКИ, РУНЫ, ПОРТАЛЫ
------------------------------------------------------------------------
-- куски с гравитацией (камни, кость, солома, щепки); не проваливаются ниже земли
function FX.Debris(pos, color, count, size, speed, life, material)
	count = count or 6
	if FX.Lite then
		count = math.min(3, count)
	end
	size = size or 0.5
	speed = speed or 8
	life = life or 0.9
	local floor = groundY()
	local pieces = {}
	for i = 1, count do
		local s = size * rng:NextNumber(0.6, 1.3)
		pieces[i] = {
			P = FX.Part({ Size = V(s, s * 0.8, s * 1.1), CFrame = CF(pos) * ANG(rng:NextNumber(0, 6), rng:NextNumber(0, 6), 0), Color = color, Material = material or Enum.Material.Slate }),
			S = s,
			Vel = V(rng:NextNumber(-1, 1), rng:NextNumber(0.6, 1.4), rng:NextNumber(-1, 1)) * speed,
			SpinX = rng:NextNumber(-8, 8),
			SpinY = rng:NextNumber(-8, 8),
		}
	end
	local fadeFrom = life * 0.6
	FX.Run(function(t)
		local over = t >= life
		for _, d in ipairs(pieces) do
			local p = d.P
			if over then
				p:Destroy()
			elseif p.Parent then
				local q = pos + d.Vel * t + V(0, -30 * t * t, 0)
				q = V(q.X, math.max(q.Y, floor + d.S * 0.4), q.Z)
				p.CFrame = CF(q) * ANG(d.SpinX * t, d.SpinY * t, 0)
				if t > fadeFrom then
					p.Transparency = (t - fadeFrom) / (life * 0.4)
				end
			end
		end
		return over
	end)
end

-- дымное облако из полупрозрачных шаров
function FX.Smoke(pos, color, n, size, life, rise)
	n = n or 3
	if FX.Lite then
		n = math.min(n, 2)
	end
	size = size or 2
	life = life or 1
	for _ = 1, n do
		local s = size * rng:NextNumber(0.7, 1.2)
		local p = FX.Part({
			Shape = Enum.PartType.Ball,
			Size = V(s, s, s),
			CFrame = CF(pos + V(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)) * size * 0.4),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 0.45,
		})
		FX.Fade(p, life * rng:NextNumber(0.8, 1.2), { Size = V(s, s, s) * 1.9, CFrame = p.CFrame + V(rng:NextNumber(-1, 1), rise or 2, rng:NextNumber(-1, 1)) })
	end
end

-- вспышка: шар + точечный свет
function FX.Flash(pos, color, radius, life)
	FX.Sphere(pos, radius, color, life or 0.3)
	local a = FX.Part({ Size = V(0.2, 0.2, 0.2), CFrame = CF(pos), Transparency = 1 })
	light(a, color, radius * 4, 4, life or 0.35)
	cleanup(a, (life or 0.35) + 0.05)
end

-- кольцо рун на земле: 8 знаков, крест и диск; гаснет в последние 40% жизни
function FX.RuneRing(pos, r, color, life)
	local g = FX.Ground(pos)
	local list = {}
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		list[#list + 1] = FX.Part({ Size = V(0.4, 0.06, 1.2), CFrame = CF(g + V(math.cos(a) * r, 0.05, math.sin(a) * r)) * ANG(0, -a, 0), Color = color })
	end
	for i = 0, 1 do
		list[#list + 1] = FX.Part({ Size = V(r * 1.5, 0.05, 0.22), CFrame = CF(g + V(0, 0.04, 0)) * ANG(0, i * math.pi / 2 + rad(45), 0), Color = color, Transparency = 0.3 })
	end
	list[#list + 1] = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.06, r * 2.2, r * 2.2), CFrame = CF(g) * ANG(0, 0, rad(90)), Color = color, Transparency = 0.55 })
	task.delay(life * 0.6, function()
		for _, p in ipairs(list) do
			FX.Fade(p, life * 0.4)
		end
	end)
	return list
end

-- вертикальный диск портала, повёрнутый к камере
function FX.PortalDisc(pos, r, color, life, edge)
	local cam = workspace.CurrentCamera
	local look = cam and (cam.CFrame.Position - pos) or V(0, 0, 1)
	local flat = V(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = V(0, 0, 1)
	end
	local cf = CFrame.lookAt(pos, pos + flat) * ANG(0, rad(90), 0)
	local disc = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.2, 0.2, 0.2), CFrame = cf, Color = color, Transparency = 0.2 })
	tween(disc, 0.25, { Size = V(0.2, r * 2, r * 2) }, Enum.EasingStyle.Back)
	local rim = FX.Part({ Shape = Enum.PartType.Cylinder, Size = V(0.15, 0.3, 0.3), CFrame = cf * CF(-0.05, 0, 0), Color = edge or PORTAL_EDGE, Transparency = 0.1 })
	tween(rim, 0.25, { Size = V(0.15, r * 2.25, r * 2.25) }, Enum.EasingStyle.Back)
	light(disc, color, r * 5, 3, life)
	task.delay(life * 0.7, function()
		FX.Fade(disc, life * 0.3, { Size = V(0.2, 0.2, 0.2) })
		FX.Fade(rim, life * 0.3, { Size = V(0.15, 0.3, 0.3) })
	end)
	return disc, rim
end

------------------------------------------------------------------------
-- РЕЕСТР УДАРОВ (Impact)
------------------------------------------------------------------------
local impacts = {}
FX.Impacts = impacts

function FX.RegisterImpact(kind, fn)
	impacts[kind] = fn
end

function FX.Impact(p)
	if type(p) ~= "table" or p.K == nil then
		return false
	end
	local fn = impacts[p.K]
	if not fn then
		return false
	end
	local ok, err = pcall(fn, p)
	if not ok then
		warn("[FX] Impact " .. tostring(p.K) .. ": " .. tostring(err))
	end
	return true
end

-- удары, которым хватает ядра (дети могут переопределить)
FX.RegisterImpact("Smash", function(p)
	local lv = p.L or 1
	local R = p.R or 6
	local g = V(p.P.X, p.P.Y + 0.2, p.P.Z)
	FX.Ring(g, R, NEON, 0.4, 0.4, 1, 0.1)
	FX.Cracks(g, R, NEON, 5 + lv, 1.0)
	FX.Burst(g + V(0, 1, 0), Color3.fromRGB(60, 50, 70), 8 + lv, 0.5, 9)
end)

FX.RegisterImpact("Summon", function(p)
	FX.Summon(p.P, p.R)
end)

------------------------------------------------------------------------
-- ИНИЦИАЛИЗАЦИЯ
------------------------------------------------------------------------
local CHILDREN = { "Void", "Chrono", "Halloween" }
local inited = false

function FX.Init(ctx)
	local env = FX.Env
	if ctx then
		rawset(env, "Ctx", ctx)
		for _, k in ipairs({ "Config", "Path", "Renderer" }) do
			if ctx[k] then
				rawset(env, k, ctx[k])
			end
		end
		if ctx.Lite ~= nil then
			FX.SetLite(ctx.Lite)
		end
	end
	getFolder()
	if inited then
		return FX
	end
	inited = true
	if RunService:IsClient() then
		RunService:BindToRenderStep("VoidTD_ShakeUndo", Enum.RenderPriority.First.Value, shakeUndo)
		RunService:BindToRenderStep("VoidTD_Shake", Enum.RenderPriority.Camera.Value + 1, shakeApply)
	end
	-- эффекты способностей
	for _, name in ipairs(CHILDREN) do
		local mod = script:FindFirstChild(name)
		if mod and mod:IsA("ModuleScript") then
			local ok, install = pcall(require, mod)
			if not ok then
				warn("[FX] " .. name .. ": " .. tostring(install))
			elseif type(install) == "function" then
				local ok2, err = pcall(install, FX)
				if not ok2 then
					warn("[FX] " .. name .. ": " .. tostring(err))
				end
			end
		end
	end
	return FX
end

-- локальный игрок (нужен эффектам, которые реагируют только на свои юниты)
FX.LocalPlayer = Players.LocalPlayer

return FX
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="Folder" referent="RBX8959391D0E44981EF6F09C8608809CED">
					<Properties>
						<string name="Name">UI</string>
					</Properties>
					<Item class="ModuleScript" referent="RBXBF8658C63611D6B53A19895BF059F1A5">
						<Properties>
							<string name="Name">Kit</string>
							<ProtectedString name="Source"><![CDATA[--!nocheck
-- VOID TD :: UI.Kit (клиент) — тема, конструкторы, нарисованные иконки, 3D-превью, теги события
-- Весь интерфейс создаётся кодом: без картинок и эмодзи в иконках (иконки — из Frame).
--
-- ПОДКЛЮЧЕНИЕ
--   local Kit = require(script.Kit); Kit.Build(UI, ctx)   -- первым из детей UI
--   Build: Kit.UI = UI; UI.Kit = Kit; UI.Theme = Kit.Theme; UI.Modals = UI.Modals or {} (Kit.Modals — та же
--   таблица); модели берутся из ctx (UnitModels, EnemyModels, CaseModels), иначе из ReplicatedStorage.VoidTD.Models.
--   Окна (modal) кладутся в UI.Root (или Kit.Root, если задан); Kit.SetRoot(frame) — сменить вручную.
--
-- ТЕМА
--   Kit.Theme = { BG BG2 BG3 Accent AccentDark Text Dim Good Bad Gold Pink, Orange (255,130,30) HGold (255,205,80) }
--
-- КОНСТРУКТОРЫ (props — свойства экземпляра; Parent ставится ПОСЛЕДНИМ; служебные ключи
--   Radius / StrokeColor / StrokeThickness не пишутся в экземпляр)
--   Kit.new(class, props?, children?) -> Instance
--   Kit.corner(r=8) -> UICorner (offset)
--   Kit.stroke(color=Accent, th=2, transparency=0) -> UIStroke Name="Border" (Border mode; код меняет obj.Border.Color)
--   Kit.textStroke(th=1.5) -> UIStroke (10,0,20) Contextual
--   Kit.pad(px) -> UIPadding со всех сторон
--   Kit.tween(obj, t, goal, style=Quad, dir=Out) -> Tween (уже запущен)
--   Kit.panel(props) -> Frame  BG, прозрачность 0.12, угол Radius|10, рамка Border StrokeColor|AccentDark (2)
--   Kit.label(props) -> TextLabel  без фона, FredokaOne, цвет Text, TextScaled (если не false), обводка StrokeThickness
--   Kit.button(props, onClick?) -> TextButton  BG3, FredokaOne, угол Radius|8, рамка Border StrokeColor|Accent,
--        UIScale с анимацией наведения (1.06 / 1 / 0.94 / 1.04); onClick — на Activated
--   Kit.shape(parent, x, y, w, h, color, rot?, round?, z?, props?) -> Frame  фигура в долях контейнера (центр x,y)
--   Kit.shade(frame, top, bottom, rot=90) -> UIGradient
--
-- ИКОНКИ
--   Kit.icon(kind, parent, props?) -> Frame "Icon"..kind (квадрат, UIAspectRatioConstraint)
--        props: Size (по умолчанию scale 1,1), Position, AnchorPoint, ZIndex (фигуры рисуются с ZIndex+1..)
--        kind: Gem Coin Helmet Gear Back Pumpkin Rune; Kit.Icons[kind] = function(container, z) — свои иконки
--   Kit.iconButton(parent, order, kind, caption, top, bottom, edge, onClick?, size=76) -> button, captionLabel
--        TextButton Name = kind.."Button", градиент top->bottom, рамка edge, блик, иконка 0.72, подпись снизу
--
-- ОКНА
--   Kit.modal(name, title, size, iconKind?, parent?) -> Frame
--        панель по центру (ZIndex 5, скрыта, UIScale для анимации открытия), иконка 38x38, заголовок
--        (прямой ребёнок окна — по нему тесты ищут окна), кнопка "✕" прячет окно; регистрируется в UI.Modals[name]
--
-- 3D-ПРЕВЬЮ (ViewportFrame; частицы, свет, шлейфы, огонь/дым убираются — во ViewportFrame они не рисуются)
--   Kit.unitViewport(parent, unitId, level=1, props?) -> vf, rig|nil   (props.Silhouette — чёрный силуэт)
--   Kit.enemyViewport(parent, enemyId, props?) -> vf, rig|nil
--   Kit.runeViewport(parent, runeId, props?) -> vf, r|nil   (вращается в Kit.StepSpins; vf:GetAttribute("Spin"))
--   Kit.caseViewport(parent, caseId, props?) -> r   (r = CaseModels.Build(caseId) + r.Viewport; при ошибке —
--        заглушка { Model = пустая Model, Base = {}, Shards = {}, Cracks = {}, Failed = true, Viewport })
--   props: Size (scale 1,1), Position, AnchorPoint, ZIndex. Kit.viewport = Kit.unitViewport (как в легаси).
--
-- ПРОЧЕЕ
--   Kit.rarityColor(unitId) -> Color3 (цвет редкости; неизвестный юнит — Theme.Dim)
--   Kit.eventTag(parent, unitId, z=1, textPos?, textSize?)  -- только для юнитов события (def.Event):
--        тыква 22x22 в углу, подпись Events[ev].Tag (если textPos), 4 искры. Рамка остаётся цветом редкости.
--   Kit.eventSparks(parent, z, n=4)
--   Kit.StepSparks(t=os.clock())  -- каждый кадр из UI.Update: искры поднимаются и гаснут; также крутит руны
--   Kit.StepSpins(t=os.clock())   -- только вращение 3D-рун (видимых)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("VoidTD")
local Config = require(Shared:WaitForChild("Config"))

local Kit = {}
Kit.Modals = {}

local V2 = Vector2.new
local V3 = Vector3.new
local rgb = Color3.fromRGB
local WHITE = Color3.new(1, 1, 1)

local Theme = {
	BG = rgb(16, 10, 26),
	BG2 = rgb(32, 20, 50),
	BG3 = rgb(48, 30, 72),
	Accent = rgb(170, 80, 255),
	AccentDark = rgb(90, 40, 150),
	Text = rgb(242, 234, 255),
	Dim = rgb(170, 155, 195),
	Good = rgb(90, 220, 140),
	Bad = rgb(255, 80, 110),
	Gold = rgb(255, 205, 70),
	Pink = rgb(255, 70, 170),
	-- цвета события Хэллоуин
	Orange = rgb(255, 130, 30),
	HGold = rgb(255, 205, 80),
}
Kit.Theme = Theme

------------------------------------------------------------------------
-- ПОДКЛЮЧЕНИЕ
------------------------------------------------------------------------
local ctx

function Kit.Build(UI, c)
	ctx = c or ctx
	if UI then
		Kit.UI = UI
		UI.Kit = Kit
		UI.Theme = Theme
		local modals = UI.Modals or {}
		for name, m in pairs(Kit.Modals) do
			if modals[name] == nil then
				modals[name] = m
			end
		end
		UI.Modals = modals
		Kit.Modals = modals
	end
	return Kit
end

function Kit.SetRoot(frame)
	Kit.Root = frame
end

-- модели: из ctx, иначе напрямую из ReplicatedStorage
local function models(key, child)
	local m = ctx and ctx[key]
	if m then
		return m
	end
	local folder = Shared:FindFirstChild("Models")
	local mod = folder and folder:FindFirstChild(child)
	if mod then
		local ok, res = pcall(require, mod)
		if ok then
			return res
		end
	end
	return nil
end

------------------------------------------------------------------------
-- КОНСТРУКТОРЫ
------------------------------------------------------------------------
local CUSTOM = { Parent = true, Radius = true, StrokeColor = true, StrokeThickness = true }

local function new(class, props, children)
	local o = Instance.new(class)
	if props then
		for k, v in pairs(props) do
			if not CUSTOM[k] then
				o[k] = v
			end
		end
	end
	if children then
		for _, c in ipairs(children) do
			c.Parent = o
		end
	end
	if props and props.Parent then
		o.Parent = props.Parent
	end
	return o
end
Kit.new = new

-- копия props с значениями по умолчанию (исходную таблицу не трогаем)
local function with(props, defaults)
	local o = {}
	for k, v in pairs(defaults) do
		o[k] = v
	end
	if props then
		for k, v in pairs(props) do
			o[k] = v
		end
	end
	return o
end

function Kit.corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

function Kit.stroke(color, th, transparency)
	return new("UIStroke", {
		Name = "Border",
		Color = color or Theme.Accent,
		Thickness = th or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Kit.textStroke(th)
	return new("UIStroke", { Color = rgb(10, 0, 20), Thickness = th or 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

function Kit.pad(px)
	local u = UDim.new(0, px or 0)
	return new("UIPadding", { PaddingLeft = u, PaddingRight = u, PaddingTop = u, PaddingBottom = u })
end

local function tween(o, t, goal, style, dir)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end
Kit.tween = tween

function Kit.panel(props)
	props = props or {}
	local p = with(props, { BackgroundColor3 = Theme.BG, BackgroundTransparency = 0.12 })
	p.BorderSizePixel = 0
	local parent = p.Parent
	p.Parent = nil
	local f = new("Frame", p)
	Kit.corner(props.Radius or 10).Parent = f
	Kit.stroke(props.StrokeColor or Theme.AccentDark, 2).Parent = f
	f.Parent = parent
	return f
end

function Kit.label(props)
	props = props or {}
	local p = with(props, { Font = Enum.Font.FredokaOne, TextColor3 = Theme.Text, TextScaled = true })
	p.BackgroundTransparency = 1
	local parent = p.Parent
	p.Parent = nil
	local l = new("TextLabel", p)
	Kit.textStroke(props.StrokeThickness).Parent = l
	l.Parent = parent
	return l
end

-- анимация наведения/нажатия через UIScale
local function hoverScale(b, over, down)
	local sc = new("UIScale", { Parent = b })
	b.MouseEnter:Connect(function()
		tween(sc, 0.12, { Scale = over })
	end)
	b.MouseLeave:Connect(function()
		tween(sc, 0.12, { Scale = 1 })
	end)
	b.MouseButton1Down:Connect(function()
		tween(sc, 0.06, { Scale = down })
	end)
	b.MouseButton1Up:Connect(function()
		tween(sc, 0.1, { Scale = 1.04 })
	end)
	return sc
end

function Kit.button(props, onClick)
	props = props or {}
	local p = with(props, { BackgroundColor3 = Theme.BG3, Font = Enum.Font.FredokaOne, TextColor3 = Theme.Text, TextScaled = true })
	p.BorderSizePixel = 0
	p.AutoButtonColor = false
	local parent = p.Parent
	p.Parent = nil
	local b = new("TextButton", p)
	Kit.corner(props.Radius or 8).Parent = b
	Kit.stroke(props.StrokeColor or Theme.Accent, 2).Parent = b
	Kit.textStroke().Parent = b
	hoverScale(b, 1.06, 0.94)
	if onClick then
		b.Activated:Connect(onClick)
	end
	b.Parent = parent
	return b
end

------------------------------------------------------------------------
-- ИКОНКИ ИЗ ФИГУР
------------------------------------------------------------------------
-- фигура в долях контейнера: центр (x, y), размер (w, h), поворот, скругление (доля)
local function shape(parent, x, y, w, h, color, rot, round, z, props)
	local f = new("Frame", {
		AnchorPoint = V2(0.5, 0.5),
		Position = UDim2.fromScale(x, y),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Rotation = rot or 0,
		ZIndex = z or 1,
	})
	if round then
		new("UICorner", { Parent = f, CornerRadius = UDim.new(round, 0) })
	end
	if props then
		for k, v in pairs(props) do
			f[k] = v
		end
	end
	f.Parent = parent
	return f
end
Kit.shape = shape

local function shade(f, top, bottom, rot)
	return new("UIGradient", { Parent = f, Rotation = rot or 90, Color = ColorSequence.new(top, bottom) })
end
Kit.shade = shade

local function edge(f, color, th)
	new("UIStroke", { Parent = f, Color = color, Thickness = th })
end

local Icons = {}
Kit.Icons = Icons

-- кристалл: огранённый ромб с бликом
function Icons.Gem(c, z)
	local o = shape(c, 0.5, 0.52, 0.6, 0.6, WHITE, 45, 0.12, z)
	shade(o, rgb(150, 210, 255), rgb(80, 70, 220), 45)
	edge(o, rgb(20, 14, 50), 2)
	shape(c, 0.5, 0.4, 0.28, 0.28, rgb(215, 240, 255), 45, 0.1, z + 1, { BackgroundTransparency = 0.15 })
	shape(c, 0.38, 0.38, 0.08, 0.16, WHITE, 45, 0.5, z + 2, { BackgroundTransparency = 0.1 })
end

-- монета со знаком $
function Icons.Coin(c, z)
	local o = shape(c, 0.5, 0.5, 0.74, 0.74, WHITE, 0, 0.5, z)
	shade(o, rgb(255, 225, 110), rgb(190, 120, 30))
	edge(o, rgb(70, 40, 10), 2)
	local i = shape(c, 0.5, 0.5, 0.5, 0.5, rgb(215, 150, 45), 0, 0.5, z + 1)
	new("TextLabel", {
		Parent = i,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "$",
		TextScaled = true,
		Font = Enum.Font.FredokaOne,
		TextColor3 = rgb(90, 50, 10),
		ZIndex = z + 2,
	})
end

-- шлем рыцаря Пустоты: рога, купол, гребень, Т-визор
function Icons.Helmet(c, z)
	local acc = rgb(196, 130, 255)
	for _, sx in ipairs({ -1, 1 }) do
		shape(c, 0.5 + 0.26 * sx, 0.26, 0.09, 0.3, rgb(215, 205, 190), 28 * sx, 0.3, z)
	end
	local h = shape(c, 0.5, 0.55, 0.54, 0.62, WHITE, 0, 0.22, z + 1)
	shade(h, rgb(110, 106, 130), rgb(40, 36, 54))
	edge(h, rgb(16, 12, 24), 2)
	shape(c, 0.5, 0.2, 0.1, 0.18, rgb(90, 86, 110), 0, 0.3, z)
	shape(c, 0.5, 0.48, 0.38, 0.07, acc, 0, 0.5, z + 2)
	shape(c, 0.5, 0.6, 0.07, 0.24, acc, 0, 0.5, z + 2)
end

-- шестерёнка настроек: 8 зубцов, диск, отверстие
function Icons.Gear(c, z)
	local col = rgb(190, 186, 210)
	for k = 0, 7 do
		local a = k / 8 * math.pi * 2
		shape(c, 0.5 + math.cos(a) * 0.3, 0.5 + math.sin(a) * 0.3, 0.16, 0.16, col, math.deg(a), 0.15, z)
	end
	shape(c, 0.5, 0.5, 0.6, 0.6, col, 0, 0.5, z + 1)
	shape(c, 0.5, 0.5, 0.26, 0.26, rgb(34, 30, 48), 0, 0.5, z + 2)
end

-- стрелка «назад»
function Icons.Back(c, z)
	local col = rgb(255, 235, 240)
	shape(c, 0.56, 0.5, 0.5, 0.12, col, 0, 0.5, z)
	shape(c, 0.34, 0.37, 0.32, 0.12, col, -42, 0.5, z)
	shape(c, 0.34, 0.63, 0.32, 0.12, col, 42, 0.5, z)
end

-- тыква: три дольки, хвостик, вырезанное лицо
function Icons.Pumpkin(c, z)
	for i, x in ipairs({ 0.3, 0.7, 0.5 }) do
		local mid = i == 3
		local o = shape(c, x, 0.58, mid and 0.42 or 0.38, 0.6, WHITE, 0, 0.45, z + (mid and 1 or 0))
		shade(o, rgb(255, 165, 60), rgb(190, 80, 20))
		edge(o, rgb(70, 25, 5), 1.5)
	end
	shape(c, 0.52, 0.22, 0.1, 0.18, rgb(80, 110, 40), 14, 0.3, z + 2)
	local eye = rgb(255, 230, 120)
	for _, x in ipairs({ 0.38, 0.62 }) do
		shape(c, x, 0.52, 0.12, 0.12, eye, 45, 0.1, z + 3)
	end
	shape(c, 0.5, 0.7, 0.34, 0.08, eye, 0, 0.4, z + 3)
end

-- руна: камень-ромб с символом
function Icons.Rune(c, z)
	local o = shape(c, 0.5, 0.5, 0.62, 0.62, WHITE, 45, 0.15, z)
	shade(o, rgb(255, 160, 60), rgb(120, 30, 40), 45)
	edge(o, rgb(40, 10, 10), 2)
	local glyph = rgb(255, 240, 200)
	shape(c, 0.5, 0.5, 0.08, 0.42, glyph, 0, 0.5, z + 1)
	shape(c, 0.5, 0.4, 0.3, 0.07, glyph, 30, 0.5, z + 1)
	shape(c, 0.5, 0.6, 0.3, 0.07, glyph, -30, 0.5, z + 1)
end

-- квадратный контейнер с иконкой
function Kit.icon(kind, parent, props)
	props = props or {}
	local z = props.ZIndex or 1
	local c = new("Frame", {
		Name = "Icon" .. tostring(kind),
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or V2(0, 0),
		ZIndex = z,
	})
	new("UIAspectRatioConstraint", { Parent = c })
	local draw = Icons[kind]
	if draw then
		draw(c, z + 1)
	else
		warn("[UI.Kit] нет иконки " .. tostring(kind))
	end
	c.Parent = parent
	return c
end

-- квадратная кнопка-иконка с подписью (панель справа)
function Kit.iconButton(parent, order, kind, caption, top, bottom, edgeColor, onClick, size)
	size = size or 76
	local b = new("TextButton", {
		Name = kind .. "Button",
		LayoutOrder = order or 0,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
	})
	Kit.corner(16).Parent = b
	Kit.stroke(edgeColor, 2).Parent = b
	new("UIGradient", { Parent = b, Rotation = 90, Color = ColorSequence.new(top, bottom) })
	-- мягкий блик сверху
	local shine = new("Frame", {
		Parent = b,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 0.4, 0),
	})
	Kit.corner(12).Parent = shine
	Kit.icon(kind, b, { Size = UDim2.fromScale(0.72, 0.72), Position = UDim2.fromScale(0.5, 0.48), AnchorPoint = V2(0.5, 0.5), ZIndex = 2 })
	local cap = Kit.label({
		Parent = b,
		AnchorPoint = V2(0.5, 0),
		Position = UDim2.new(0.5, 0, 1, 3),
		Size = UDim2.new(1, 16, 0, math.max(14, size * 0.2)),
		Text = caption or "",
		Font = Enum.Font.GothamBold,
	})
	hoverScale(b, 1.08, 0.93)
	if onClick then
		b.Activated:Connect(onClick)
	end
	b.Parent = parent
	return b, cap
end

------------------------------------------------------------------------
-- МОДАЛЬНЫЕ ОКНА
------------------------------------------------------------------------
local function rootFrame()
	local ui = Kit.UI
	return (ui and ui.Root) or Kit.Root
end

function Kit.modal(name, title, size, iconKind, parent)
	local m = Kit.panel({
		Name = "Modal_" .. tostring(name),
		AnchorPoint = V2(0.5, 0.5),
		Size = size,
		Position = UDim2.fromScale(0.5, 0.5),
		Visible = false,
		BackgroundTransparency = 0.04,
		ZIndex = 5,
	})
	new("UIScale", { Parent = m })
	local x = 18
	if iconKind then
		Kit.icon(iconKind, m, { Size = UDim2.fromOffset(38, 38), Position = UDim2.fromOffset(16, 13), ZIndex = 6 })
		x = 62
	end
	-- заголовок — прямой ребёнок окна (тесты ищут окно по нему)
	Kit.label({
		Parent = m,
		Name = "Title",
		Size = UDim2.new(1, -80 - x, 0, 44),
		Position = UDim2.fromOffset(x, 10),
		Text = title or "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Accent,
	})
	Kit.button({
		Parent = m,
		Name = "Close",
		Size = UDim2.fromOffset(40, 40),
		Position = UDim2.new(1, -52, 0, 12),
		Text = "✕",
		BackgroundColor3 = rgb(120, 30, 50),
	}, function()
		m.Visible = false
	end)
	Kit.Modals[name] = m
	m.Parent = parent or rootFrame()
	return m
end

------------------------------------------------------------------------
-- 3D-ПРЕВЬЮ
------------------------------------------------------------------------
-- во ViewportFrame не рисуются частицы, свет, шлейфы — убираем, чтобы не тратить память
local function strip(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
			d:Destroy()
		end
	end
end
Kit.StripModel = strip

local function viewportFrame(parent, props, ambient, lightColor, lightDir)
	props = props or {}
	return new("ViewportFrame", {
		Parent = parent,
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.fromScale(1, 1),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or V2(0, 0),
		Ambient = ambient,
		LightColor = lightColor,
		LightDirection = lightDir,
		ZIndex = props.ZIndex or 1,
	})
end

local function camera(vf, fov, cf)
	local cam = Instance.new("Camera")
	cam.FieldOfView = fov
	cam.CFrame = cf
	cam.Parent = vf
	vf.CurrentCamera = cam
	return cam
end

-- юнит: камера сбоку-спереди, дальше — чтобы оружие помещалось целиком
function Kit.unitViewport(parent, unitId, level, props)
	props = props or {}
	local vf = viewportFrame(parent, props, rgb(150, 130, 185), rgb(255, 245, 255), V3(-0.6, -1, -0.8))
	if props.Silhouette then
		vf.ImageColor3 = rgb(0, 0, 0)
		vf.ImageTransparency = 0.2
	end
	local UnitModels = models("UnitModels", "Units")
	if not UnitModels or not UnitModels.Build then
		return vf
	end
	local ok, rig = pcall(UnitModels.Build, unitId, level or 1)
	if not ok or type(rig) ~= "table" or not rig.Model then
		if not ok then
			warn("[UI.Kit] превью " .. tostring(unitId) .. ": " .. tostring(rig))
		end
		return vf
	end
	strip(rig.Model)
	rig.Model.Parent = vf
	local s = rig.Scale or 1
	local center = V3(0, -0.1 * s, 0)
	camera(vf, 34, CFrame.lookAt(center + V3(5.6, 2.6, -14.5) * s, center))
	return vf, rig
end
Kit.viewport = Kit.unitViewport

-- враг (бестиарий): камера по высоте модели
function Kit.enemyViewport(parent, enemyId, props)
	local vf = viewportFrame(parent, props, rgb(150, 130, 160), rgb(255, 240, 230), V3(-0.5, -1, -0.8))
	local EnemyModels = models("EnemyModels", "Enemies")
	if not EnemyModels or not EnemyModels.Build then
		return vf
	end
	local ok, rig = pcall(EnemyModels.Build, enemyId)
	if not ok or type(rig) ~= "table" or not rig.Model then
		if not ok then
			warn("[UI.Kit] превью врага " .. tostring(enemyId) .. ": " .. tostring(rig))
		end
		return vf
	end
	strip(rig.Model)
	rig.Model.Parent = vf
	local h = rig.Height or 5
	local c = V3(0, h * 0.5 - (rig.HipHeight or 0), 0)
	camera(vf, 34, CFrame.lookAt(c + V3(h * 0.45, h * 0.25, -h * 1.7), c))
	return vf, rig
end

-- руны медленно вращаются (Kit.StepSpins)
local spins = {}

function Kit.runeViewport(parent, runeId, props)
	local vf = viewportFrame(parent, props, rgb(170, 140, 130), rgb(255, 240, 220), V3(-0.5, -1, -0.7))
	local UnitModels = models("UnitModels", "Units")
	if not UnitModels or not UnitModels.BuildRune then
		return vf
	end
	local ok, r = pcall(UnitModels.BuildRune, runeId)
	if not ok or type(r) ~= "table" or not r.Model then
		if not ok then
			warn("[UI.Kit] руна " .. tostring(runeId) .. ": " .. tostring(r))
		end
		return vf
	end
	strip(r.Model)
	r.Model.Parent = vf
	camera(vf, 30, CFrame.lookAt(V3(2.2, 1.4, -6.5), V3(0, 0, 0)))
	vf:SetAttribute("Spin", true)
	spins[#spins + 1] = { Model = r.Model, VF = vf, Vis = true, Next = 0 }
	return vf, r
end

-- кейс: модель собирает CaseModels (части анимируются напрямую через CFrame)
function Kit.caseViewport(parent, caseId, props)
	local vf = viewportFrame(parent, props, rgb(160, 140, 190), rgb(255, 245, 255), V3(-0.5, -1, -0.7))
	local CaseModels = models("CaseModels", "Cases")
	local ok, r = false, nil
	if CaseModels and CaseModels.Build then
		ok, r = pcall(CaseModels.Build, caseId)
	end
	if not ok or type(r) ~= "table" or not r.Model then
		if CaseModels then
			warn("[UI.Kit] кейс " .. tostring(caseId) .. ": " .. tostring(r))
		end
		r = { Model = Instance.new("Model"), Base = {}, Shards = {}, Cracks = {}, Failed = true }
	end
	r.Base = r.Base or {}
	r.Shards = r.Shards or {}
	r.Cracks = r.Cracks or {}
	r.Model.Parent = vf
	camera(vf, 40, CFrame.lookAt(V3(0, 4.5, -13), V3(0, 2.6, 0)))
	r.Viewport = vf
	return r
end

------------------------------------------------------------------------
-- РЕДКОСТЬ И ТЕГ СОБЫТИЯ
------------------------------------------------------------------------
function Kit.rarityColor(unitId)
	local def = Config.Units and Config.Units[unitId]
	local r = def and Config.Rarities and Config.Rarities[def.Rarity]
	return (r and r.Color) or Theme.Dim
end

-- лёгкие оранжевые искры на карточках юнитов события (двигаются в Kit.StepSparks)
local sparks = {}
local SPARK = rgb(255, 160, 60)

function Kit.eventSparks(parent, z, n)
	for _ = 1, n or 4 do
		local f = new("Frame", {
			Name = "Spark",
			BackgroundColor3 = SPARK,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(3, 3),
			Rotation = 45,
			ZIndex = z or 1,
			BackgroundTransparency = 0.2,
		})
		local sp = { F = f, X = math.random(), P = math.random() * 3, S = 0.25 + math.random() * 0.25, Vis = true, Next = 0 }
		f.Position = UDim2.fromScale(sp.X, 1)
		f.Parent = parent
		sparks[#sparks + 1] = sp
	end
end

-- значок-тыква, подпись события и искры; рамка карточки остаётся цветом редкости
function Kit.eventTag(parent, unitId, z, textPos, textSize)
	local def = Config.Units and Config.Units[unitId]
	local ev = def and def.Event and Config.Events and Config.Events[def.Event]
	if not ev then
		return nil
	end
	z = z or 1
	local ic = Kit.icon("Pumpkin", parent, { Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(4, 4), ZIndex = z + 2 })
	local tag
	if textPos then
		tag = Kit.label({
			Parent = parent,
			Name = "EventTag",
			Size = textSize or UDim2.new(1, -8, 0, 13),
			Position = textPos,
			Text = ev.Tag,
			TextColor3 = ev.Color,
			Font = Enum.Font.GothamBold,
			ZIndex = z + 1,
		})
	end
	Kit.eventSparks(parent, z + 1, 4)
	return ic, tag
end

------------------------------------------------------------------------
-- ПОКАДРОВОЕ ОБНОВЛЕНИЕ
------------------------------------------------------------------------
-- виден ли элемент на экране (все GuiObject-предки Visible, есть ScreenGui/LayerCollector)
local function onScreen(obj)
	local o = obj
	while o do
		if o:IsA("LayerCollector") then
			return o.Enabled ~= false
		end
		if o:IsA("GuiObject") and not o.Visible then
			return false
		end
		o = o.Parent
	end
	return false
end

-- проверка видимости раз в 0.25 с, чтобы не обходить предков каждый кадр
local function visibleCached(it, t)
	if t >= it.Next then
		it.Next = t + 0.25
		it.Vis = onScreen(it.F or it.VF)
	end
	return it.Vis
end

function Kit.StepSpins(t)
	t = t or os.clock()
	local cf
	for i = #spins, 1, -1 do
		local it = spins[i]
		if not it.VF.Parent or not it.Model.Parent then
			spins[i] = spins[#spins]
			spins[#spins] = nil
		elseif visibleCached(it, t) then
			cf = cf or (CFrame.new(0, math.sin(t * 1.6) * 0.08, 0) * CFrame.Angles(0, t * 0.9, 0))
			it.Model:PivotTo(cf)
		end
	end
end

function Kit.StepSparks(t)
	t = t or os.clock()
	for i = #sparks, 1, -1 do
		local sp = sparks[i]
		local f = sp.F
		if not f.Parent then
			sparks[i] = sparks[#sparks]
			sparks[#sparks] = nil
		elseif visibleCached(sp, t) then
			-- поднимаются снизу вверх, покачиваясь, и гаснут
			local a = (t * sp.S + sp.P) % 1
			f.Position = UDim2.fromScale(sp.X + math.sin(t * 2 + sp.P) * 0.04, 1 - a)
			f.BackgroundTransparency = 0.2 + a * 0.8
		end
	end
	Kit.StepSpins(t)
end

function Kit.Step(t)
	Kit.StepSparks(t)
end

-- локальный игрок (для модулей UI)
Kit.Player = Players.LocalPlayer

return Kit
