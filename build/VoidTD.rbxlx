	<Item class="ReplicatedStorage" referent="RBX77809C301E1D0216B238FE91EC625FA6">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX5DCB94D82888D5A9D5A4C709219CB6F9">
			<Properties>
				<string name="Name">VoidTD</string>
