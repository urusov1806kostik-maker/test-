	"id": "shadowvisuals",
	"version": "${version}",
	"name": "Shadow Visuals",
	"description": "A modern client-side visual enhancement suite: HUD, interface, rendering and quality-of-life visuals.",
	"authors": [
		"Shadow Visuals Team"
	],
	"license": "All-Rights-Reserved",
	"icon": "assets/shadowvisuals/icon.png",
